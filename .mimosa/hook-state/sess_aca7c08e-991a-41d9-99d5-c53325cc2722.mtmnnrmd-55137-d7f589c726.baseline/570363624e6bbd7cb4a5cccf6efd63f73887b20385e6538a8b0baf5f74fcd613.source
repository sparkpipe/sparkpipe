#pragma once
#include <stdint.h>
#include "inference/kernels/layer_kind.cuh"

#define QWEN38_HIDDEN 8192u
#define QWEN38_LAYERS 92u
#define QWEN38_VOCAB 248320u
#define QWEN38_RMS_EPSILON 1e-06f

#define QWEN38_ATTENTION_PERIOD 4u
#define QWEN38_FULL_PHASE 3u
#define QWEN38_LAYER_IS_LINEAR(layer) (((layer) % QWEN38_ATTENTION_PERIOD) != QWEN38_FULL_PHASE)

#define QWEN38_ATTN_HEADS 64u
#define QWEN38_KV_HEADS 4u
#define QWEN38_HEAD_DIM 256u
#define QWEN38_ROPE_DIM 64u
#define QWEN38_NOPE_DIM (QWEN38_HEAD_DIM - QWEN38_ROPE_DIM)
#define QWEN38_ROPE_THETA 10000000.0f
#define QWEN38_QK_SCALE 0.0625f
#define QWEN38_ATTN_OUTPUT_GATE 1u
#define QWEN38_QKV_DIM (((2u * QWEN38_ATTN_HEADS) + (2u * QWEN38_KV_HEADS)) * QWEN38_HEAD_DIM)

#define QWEN38_GDN_KEY_HEADS 16u
#define QWEN38_GDN_VALUE_HEADS 128u
#define QWEN38_GDN_KEY_DIM 128u
#define QWEN38_GDN_VALUE_DIM 128u
#define QWEN38_GDN_CONV_KERNEL 4u

#define QWEN38_GDN_STATE_ELEMENT_BYTES 4u
#define QWEN38_GDN_STATE_BYTES 	((QWEN38_GDN_VALUE_HEADS * QWEN38_GDN_KEY_DIM * QWEN38_GDN_VALUE_DIM 		* QWEN38_GDN_STATE_ELEMENT_BYTES) 	 + (QWEN38_GDN_QKV_DIM * QWEN38_GDN_CONV_KERNEL * 2u))

#define QWEN38_EXPERTS 512u
#define QWEN38_TOP_K 10u
#define QWEN38_EXPERT_INTERMEDIATE 2048u
#define QWEN38_SHARED_EXPERTS 1u

#define QWEN38_MTP_LAYERS 1u
#define QWEN38_KV_BITS 16u
#define QWEN38_KV_PAGE_SLOTS 64u

#define QWEN38_LAYER_KIND(layer) 	(QWEN38_LAYER_IS_LINEAR(layer) ? LM_LAYER_RECURRENT : LM_LAYER_FULL)
