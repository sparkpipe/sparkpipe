import "stdlib/math.skl2";

const BLOCK = 256;
const RQ_NEG_INF = 0xFF800000;
const RQ_POS_INF = 0x7F800000;
const RQ_NO_ROW = 0xFFFFFFFF;
const RQ_KV_FP4_FLOOR = 0.01171875f;
const RQ_EXPERTS = 384;
const RQ_TOPK = 6;

@concept(route_topk)
template kernel[BLOCK, REGS] router_softmax_256_t<IS_BF16, REGS>(
    if (IS_BF16 == 0) global f32* logits, if (IS_BF16 == 1) global u32* logits_bf16,
    global f32* probs, u32 rows
) {
    reg u32 row = (ctaid_x() << 3) + warp_id();
    if (row >= rows) { return; }
    reg u32 lane = lane_id(); ureg u64 out_row = ptr_add(probs, row * 256, 4);
    reg f32 f[8];
    if constexpr (IS_BF16 == 0) {
        reg u32x8 v = ldg256_persist(ptr_add(ptr_add(logits, row * 256, 4), lane, 32));
        unroll (i = 0..8) { f[i] = u32_as_f32(v[i]); }
    } else {
        reg u32x4 v = ldg128_persist(ptr_add(ptr_add(logits_bf16, row * 32, 16), lane, 16));
        unroll (i = 0..4) { f[i * 2] = bf16_lo(v[i]); f[i * 2 + 1] = bf16_hi(v[i]); }
    }
    reg f32 m0 = maxf(maxf(f[0], f[1]), maxf(f[2], f[3])); reg f32 m1 = maxf(maxf(f[4], f[5]), maxf(f[6], f[7]));
    reg f32 rmax = warp_max(maxf(m0, m1)); reg f32 e[8];
    unroll (i = 0..8) { e[i] = expf_fast(f[i] - rmax); }
    reg f32 s = ((e[0] + e[1]) + (e[2] + e[3])) + ((e[4] + e[5]) + (e[6] + e[7]));
    reg f32 inv_sum = rcp(warp_sum(s)); reg u32x8 ov;
    unroll (i = 0..8) { ov[i] = f32_as_u32(e[i] * inv_sum); }
    stg256(ptr_add(out_row, lane, 32), ov);
}

instantiate router_softmax_256_t<0, 32> as router_softmax_256;
instantiate router_softmax_256_t<1, 80> as router_softmax_bf16_256;

@concept(linear)
kernel[BLOCK, 96] mx_quantize_e4m3_ue8m0(
    global u32* src_bf16, global u32* dst_fp8, global u8* dst_scales, u32 total_blocks
) {
    reg u32 tid = ctaid_x() * BLOCK + tid_x(); reg u32 blk = tid >> 2;
    if (blk >= total_blocks) { return; }
    reg u32x4 v = ldg128_stream(ptr_add(src_bf16, tid, 16));
    reg f32 f[8]; unroll (i = 0..4) { f[i * 2] = bf16_lo(v[i]); f[i * 2 + 1] = bf16_hi(v[i]); }
    reg f32 lmax = maxf(maxf(fabsf(f[0]), fabsf(f[1])), maxf(fabsf(f[2]), fabsf(f[3])));
    lmax = maxf(lmax, maxf(maxf(fabsf(f[4]), fabsf(f[5])), maxf(fabsf(f[6]), fabsf(f[7]))));
    reg u32 e8m0 = pow2_ceil_e8m0_bits(quad_max(lmax));
    reg f32 inv_s = (e8m0 == 0) ? 0.0f : u32_as_f32((254 - e8m0) << 23);
    reg u32 p0 = cvt_f32x2_e4m3x2(f[0] * inv_s, f[1] * inv_s); reg u32 p1 = cvt_f32x2_e4m3x2(f[2] * inv_s, f[3] * inv_s);
    reg u32 p2 = cvt_f32x2_e4m3x2(f[4] * inv_s, f[5] * inv_s); reg u32 p3 = cvt_f32x2_e4m3x2(f[6] * inv_s, f[7] * inv_s);
    stg64(ptr_add(dst_fp8, tid, 8), pack_u32x2(pack_u16x2(p0, p1), pack_u16x2(p2, p3)));
    if ((tid & 3) == 0) { stg8(ptr_add(dst_scales, blk, 1), e8m0); }
}

macro rq_e2m1_round_f32(val, out_f) {
    reg u32 sgn_ = f32_as_u32(val) & 0x80000000; reg f32 a_ = fabsf(val); reg f32 m_ = 6.0f;
    if (a_ <= 0.25f) { m_ = 0.0f; } else if (a_ < 0.75f) { m_ = 0.5f; } else if (a_ <= 1.25f) { m_ = 1.0f; }
    else if (a_ < 1.75f) { m_ = 1.5f; } else if (a_ <= 2.5f) { m_ = 2.0f; } else if (a_ < 3.5f) { m_ = 3.0f; }
    else if (a_ <= 5.0f) { m_ = 4.0f; }
    out_f = u32_as_f32(sgn_ | f32_as_u32(m_));
}

macro rq_f32_to_e2m1_nib(val, out_nib) {
    reg u32 sgn_ = (f32_as_u32(val) >> 28) & 8; reg f32 a_ = fabsf(val); reg u32 m_ = 7;
    if (a_ <= 0.25f) { m_ = 0; } else if (a_ < 0.75f) { m_ = 1; } else if (a_ <= 1.25f) { m_ = 2; }
    else if (a_ < 1.75f) { m_ = 3; } else if (a_ <= 2.5f) { m_ = 4; } else if (a_ < 3.5f) { m_ = 5; }
    else if (a_ <= 5.0f) { m_ = 6; }
    out_nib = sgn_ | m_;
}

macro rq_amax8(raw, out_am) {
    reg f32 m0_ = maxf(maxf(fabsf(bf16_lo(raw[0])), fabsf(bf16_hi(raw[0]))), maxf(fabsf(bf16_lo(raw[1])), fabsf(bf16_hi(raw[1]))));
    reg f32 m1_ = maxf(maxf(fabsf(bf16_lo(raw[2])), fabsf(bf16_hi(raw[2]))), maxf(fabsf(bf16_lo(raw[3])), fabsf(bf16_hi(raw[3]))));
    out_am = maxf(m0_, m1_);
}

macro rq_e2m1_qdq8_scale(raw, sc, inv, EXACT_DIV, out_u4) {
    reg f32 v_[8];
    unroll (qi_ = 0..4) {
        v_[qi_ * 2] = bf16_lo(raw[qi_]); v_[qi_ * 2 + 1] = bf16_hi(raw[qi_]);
        if constexpr (EXACT_DIV == 1) { div_nr1_f32(v_[qi_ * 2], sc, inv, v_[qi_ * 2]); div_nr1_f32(v_[qi_ * 2 + 1], sc, inv, v_[qi_ * 2 + 1]); }
        else { v_[qi_ * 2] = v_[qi_ * 2] * inv; v_[qi_ * 2 + 1] = v_[qi_ * 2 + 1] * inv; }
        rq_e2m1_round_f32(minf(maxf(v_[qi_ * 2], -6.0f), 6.0f), v_[qi_ * 2]);
        rq_e2m1_round_f32(minf(maxf(v_[qi_ * 2 + 1], -6.0f), 6.0f), v_[qi_ * 2 + 1]);
        out_u4[qi_] = pack_bf16x2(v_[qi_ * 2] * sc, v_[qi_ * 2 + 1] * sc);
    }
}

macro rq_fp4_qdq8(POW2, raw, out_v) {
    reg f32 am_ = 0.0f; rq_amax8(raw, am_); am_ = maxf(am_, shfl_xor(am_, 1));
    if constexpr (POW2 == 0) {
        reg f32 inv6_ = 0.0f; rcp_nr1_f32(6.0f, inv6_);
        reg f32 qsc_ = 0.0f; div_nr1_f32(maxf(am_, RQ_KV_FP4_FLOOR), 6.0f, inv6_, qsc_);
        reg f32 sc_ = e4m3_to_f32(cvt_f32x2_e4m3x2(qsc_, 0.0f) & 0xFF);
        reg f32 inv_ = 0.0f; rcp_nr1_f32(sc_, inv_);
        rq_e2m1_qdq8_scale(raw, sc_, inv_, 1, out_v);
    } else {
        am_ = maxf(am_, shfl_xor(am_, 2));
        reg u32 sbits_ = (f32_as_u32(maxf(am_, 6.0f * 1.1754943508222875e-38f) * (1.0f / 6.0f)) + 0x007FFFFF) & 0xFF800000;
        rq_e2m1_qdq8_scale(raw, u32_as_f32(sbits_), u32_as_f32(0x7F000000 - sbits_), 0, out_v);
    }
}

macro rq_pack_fp4_block8(raw, out_nibbles, out_scale) {
    reg f32 am_ = 0.0f; rq_amax8(raw, am_);
    am_ = maxf(am_, shfl_xor(am_, 1)); am_ = maxf(am_, shfl_xor(am_, 2));
    reg u32 sbits_ = (f32_as_u32(maxf(am_, 6.0f * 1.1754943508222875e-38f) * (1.0f / 6.0f)) + 0x007FFFFF) & 0xFF800000;
    reg f32 inv_ = u32_as_f32(0x7F000000 - sbits_);
    reg u32 pk_ = 0;
    unroll (qi_ = 0..4) {
        reg u32 n0_ = 0; reg u32 n1_ = 0;
        rq_f32_to_e2m1_nib(minf(maxf(bf16_lo(raw[qi_]) * inv_, -6.0f), 6.0f), n0_);
        rq_f32_to_e2m1_nib(minf(maxf(bf16_hi(raw[qi_]) * inv_, -6.0f), 6.0f), n1_);
        pk_ = pk_ | (n0_ << (qi_ * 8)) | (n1_ << (qi_ * 8 + 4));
    }
    out_nibbles = pk_; out_scale = (sbits_ >> 23) & 0xFF;
}

@pdl
@concept(quant)
template kernel[BLOCK, 48] fp4_qdq_vec_tpl<POW2>(
    global u32* data_bf16,
    if (POW2 == 0) u64 row_stride, if (POW2 == 0) u32 row_count, if (POW2 == 0) u32 width,
    if (POW2 == 1) u64 octets
) {
    acqbulk();
    reg u32 idx = ctaid_x() * ntid_x() + tid_x(); reg u64 p = 0;
    if constexpr (POW2 == 0) {
        reg u32 oct_row = width >> 3; if (idx >= row_count * oct_row) { preexit(); return; }
        reg u32 r = 0; reg u32 c = 0; u32_divmod(idx, oct_row, r, c);
        p = ptr_add(ptr_add(data_bf16, r, row_stride[0] << 1), c, 16);
    } else {
        if (idx >= octets[0]) { preexit(); return; }
        p = ptr_add(data_bf16, idx, 16);
    }
    reg u32x4 raw = ldg128_stream(p); reg u32x4 out_v = pack_u32x4(0, 0, 0, 0);
    rq_fp4_qdq8(POW2, raw, out_v); stg128(p, out_v);
    preexit();
}

instantiate fp4_qdq_vec_tpl<0> as d41_kv_fp4_qdq_vec_256;
instantiate fp4_qdq_vec_tpl<1> as d41_fp4_pow2_qdq_vec_256;

@pdl
@concept(quant)
template kernel[BLOCK, 40] quant_group_qdq_tpl<MODE>(
    global u32* data_bf16,
    if (MODE == 0) u64 row_stride, if (MODE == 2) global f32* out_f32,
    u32 count_a, u32 count_b
) {
    acqbulk();
    reg u32 grp = ctaid_x() * ntid_x() + tid_x();
    reg u64 base = 0; reg u64 dst = 0; reg u32 gsz = 16;
    if constexpr (MODE == 0) {
        reg u32 gpr = count_b >> 4; if (grp >= count_a * gpr) { preexit(); return; }
        reg u32 r = 0; reg u32 c = 0; u32_divmod(grp, gpr, r, c);
        base = ptr_add(ptr_add(data_bf16, r, row_stride[0] << 1), c << 4, 2);
    } else if constexpr (MODE == 1) {
        if (grp >= count_a) { preexit(); return; }
        gsz = count_b; base = ptr_add(data_bf16, grp, gsz << 1);
    } else {
        gsz = 32; reg u32 groups = count_b >> 5; if (grp >= count_a * groups) { preexit(); return; }
        reg u32 r = 0; reg u32 g = 0; u32_divmod(grp, groups, r, g);
        base = ptr_add(ptr_add(data_bf16, r, count_b << 1), g << 5, 2);
        dst = ptr_add(ptr_add(out_f32, r, count_b << 2), g << 5, 4);
    }
    reg f32 am = 0.0f;
    for (reg u32 e = 0; e < gsz; e += 1) { am = maxf(am, fabsf(bf16_lo(ldg16_stream(ptr_add(base, e, 2))))); }
    reg f32 sc = 0.0f; reg f32 inv = 0.0f;
    if constexpr (MODE == 0) {
        reg f32 inv6 = 0.0f; rcp_nr1_f32(6.0f, inv6); reg f32 qsc = 0.0f; div_nr1_f32(maxf(am, RQ_KV_FP4_FLOOR), 6.0f, inv6, qsc);
        sc = e4m3_to_f32(cvt_f32x2_e4m3x2(qsc, 0.0f) & 0xFF); rcp_nr1_f32(sc, inv);
    } else if constexpr (MODE == 1) {
        reg u32 sb = (f32_as_u32(maxf(am, 6.0f * 1.1754943508222875e-38f) * (1.0f / 6.0f)) + 0x007FFFFF) & 0xFF800000;
        sc = u32_as_f32(sb); inv = u32_as_f32(0x7F000000 - sb);
    } else {
        reg u32 sb = pow2_ceil_e8m0_bits(maxf(am, 1.0e-4f)) << 23;
        sc = u32_as_f32(sb); inv = u32_as_f32(0x7F000000 - sb);
    }
    for (reg u32 e = 0; e < gsz; e += 1) {
        reg f32 v = bf16_lo(ldg16_stream(ptr_add(base, e, 2)));
        if constexpr (MODE == 2) {
            reg u32 q = cvt_f32x2_e4m3x2(minf(maxf(v * inv, -448.0f), 448.0f), 0.0f);
            stg32(ptr_add(dst, e, 4), f32_as_u32(e4m3_to_f32(q & 0xFF) * sc));
        } else {
            reg f32 qv = v * inv; if constexpr (MODE == 0) { div_nr1_f32(v, sc, inv, qv); }
            reg f32 rv = 0.0f; rq_e2m1_round_f32(minf(maxf(qv, -6.0f), 6.0f), rv);
            stg16(ptr_add(base, e, 2), f32_to_bf16(rv * sc));
        }
    }
    preexit();
}

instantiate quant_group_qdq_tpl<0> as d41_kv_fp4_qdq_256;
instantiate quant_group_qdq_tpl<1> as d41_fp4_pow2_qdq_256;
instantiate quant_group_qdq_tpl<2> as d41_act_quant_256;

@pdl
@concept(quant)
kernel[BLOCK, 32] d41_fp8_qdq_256(global u32* source_bf16, global u32* data_bf16, u32 group_count) {
    acqbulk();
    reg u32 grp = ctaid_x() * 8 + warp_id();
    if (grp >= group_count) { preexit(); return; }
    reg u32 off = (grp << 5) + lane_id(); reg u32 qb = 0;
    fp8_e4m3_qdq_lane_bf16(bf16_lo(ldg16_stream(ptr_add(source_bf16, off, 2))), qb);
    stg16(ptr_add(data_bf16, off, 2), qb);
    preexit();
}

@pdl
@concept(quant)
kernel[BLOCK, 48] d41_pack_index_queries_mxfp4_256(global u32* src, global u32* codes, global u8* scales, u64 octets) {
    acqbulk();
    reg u32 q = ctaid_x() * ntid_x() + tid_x();
    if (q >= octets[0]) { preexit(); return; }
    reg u32 packed = 0; reg u32 sc = 0;
    rq_pack_fp4_block8(ldg128_stream(ptr_add(src, q, 16)), packed, sc);
    stg32(ptr_add(codes, q, 4), packed);
    if ((q & 3) == 0) { stg8(ptr_add(scales, q >> 2, 1), sc); }
    preexit();
}

@pdl
@concept(quant)
kernel[BLOCK, 56] d41_pack_index_keys_mxfp4_256(
    blob[56, 8] view, global u32* seq_of_row, global u32* length, u32 stride,
    global u32* out_codes, global u32* out_scales, u32 page_slots, u32 slot_bytes
) {
    acqbulk();
    reg u32 key = (ctaid_x() * ntid_x() + tid_x()) >> 4; reg u32 lane16 = tid_x() & 15;
    if (key >= stride) { preexit(); return; }
    reg u32 seq = ldg32_persist(seq_of_row);
    reg u32 deg = param_u32(view, 40); reg u32 rk = param_u32(view, 44); reg u32 gr = param_u32(view, 48);
    reg u32 lim = 0; kv_shard_local_keys(deg, rk, gr, ldg32_persist(ptr_add(length, seq, 4)), lim);
    if (key >= lim) { preexit(); return; }
    reg u32 lpos = 0; kv_shard_local_pos(deg, rk, gr, key, lpos);
    reg u64 slot = 0; reg u32 ok = 0; kv_shard_slot_addr_gen(view, seq, lpos, page_slots, slot_bytes, slot, ok);
    reg u32x4 raw = pack_u32x4(0, 0, 0, 0); if (ok != 0) { raw = ldg128_stream(ptr_add(slot, lane16, 16)); }
    reg u32 packed = 0; reg u32 sc = 0; rq_pack_fp4_block8(raw, packed, sc);
    stg32(ptr_add(out_codes, key * 16 + lane16, 4), packed);
    reg u32 s4 = shfl_down(sc, 4); reg u32 s8 = shfl_down(sc, 8); reg u32 s12 = shfl_down(sc, 12);
    if (lane16 == 0) { stg32(ptr_add(out_scales, key, 4), sc | (s4 << 8) | (s8 << 16) | (s12 << 24)); }
    preexit();
}

macro rq_rope_smem_pair(s_arr, word_idx, sn, cs) {
    reg u32 rot_ = 0; rope_pair_bf16_u32(lds32(s_arr, word_idx), sn, cs, rot_); sts32(s_arr, word_idx, rot_);
}

@pdl
@concept(quant)
kernel[BLOCK, 80] d41_compress_finish_store_256(
    blob[56, 8] view, global u32* latent, global u16* index_key, global u16* idx_kn,
    global u32* positions, i32 shift, global f32* freq, global u32* emit_row,
    global u32* seq_of_row, u32 index_width, f32 eps, u32 page_slots, u32 slot_bytes
) {
    shared f32 s_idx[128]; shared f32 s_red[8]; shared u32 s_lat[256]; shared u32 s_k[64];
    reg u32 row = 0; reg u64 target = 0;
    kv_emit_slot_addr(view, emit_row, seq_of_row, page_slots, slot_bytes, row, target);
    reg u32 tid = tid_x();
    reg f32 ss = 0.0f;
    if (tid < index_width) { reg f32 v = bf16_lo(ldg16_stream(ptr_add(index_key, row * index_width + tid, 2))); sts32(s_idx, tid, v); ss = v * v; }
    if (tid < 64) { sts128(s_lat, tid << 2, ldg128_stream(ptr_add(ptr_add(latent, row, 1024), tid, 16))); }
    reg f32 tot = 0.0f; reg f32 rsc = 0.0f;
    block_reduce_sum_exact(ss, s_red, warp_id(), lane_id(), tot); rsqrt_exact_div(tot, u32_to_f32(index_width), eps, rsc);
    if (tid < (index_width >> 1)) {
        reg u32 i0 = tid << 1;
        sts32(s_k, tid, pack_bf16x2(lds32(s_idx, i0) * rsc * bf16_lo(ldg16_persist(ptr_add(idx_kn, i0, 2))), lds32(s_idx, i0 + 1) * rsc * bf16_lo(ldg16_persist(ptr_add(idx_kn, i0 + 1, 2)))));
    }
    barrier();
    if (tid < 32) {
        reg u32 pval = ldg32_persist(ptr_add(positions, row, 4)); reg f32 pf = 0.0f;
        if (shift < 0) { reg u32 ns = 0 - shift; pf = (pval >= ns) ? u32_to_f32(pval - ns) : (0.0f - u32_to_f32(ns - pval)); }
        else { pf = u32_to_f32(pval + shift); }
        reg f32 sn = 0.0f; reg f32 cs = 0.0f; sincos_exact_f32(pf * u32_as_f32(ldg32_persist(ptr_add(freq, tid, 4))), sn, cs);
        rq_rope_smem_pair(s_k, (index_width >> 1) - 32 + tid, sn, cs); rq_rope_smem_pair(s_lat, 224 + tid, sn, cs);
    }
    barrier();
    if (tid < 64) { reg u32x4 out_v = pack_u32x4(0, 0, 0, 0); rq_fp4_qdq8(0, lds128(s_lat, tid << 2), out_v); stg128(ptr_add(target, tid, 16), out_v); }
    else if (tid < 80) { reg u32 q = tid - 64; reg u32x4 out_v = pack_u32x4(0, 0, 0, 0); rq_fp4_qdq8(1, lds128(s_k, q << 2), out_v); stg128(ptr_add(ptr_add(target, 512, 2), q, 16), out_v); }
    preexit();
}

@pdl
@concept(quant)
kernel[64, 72] d41_index_query_prep_64(
    global u16* query, global u16* weight, global u32* positions, global f32* freq,
    u32 heads, u32 dim, f32 weight_scale, global u32* skip_seq, global u32* skip_len,
    global u32* skip_bound, u32 skip_max_context, global u32* rope_sc
) {
    shared u32 s_q[64];
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 head = ctaid_y(); reg u32 tid = tid_x();
    if (skip_max_context != 0 && (skip_seq[0] | skip_seq[1]) != 0 && (skip_len[0] | skip_len[1]) != 0) {
        reg u32 b = 0; row_active_keys(row, skip_seq, skip_len, skip_bound, b);
        if (b <= skip_max_context) { preexit(); return; }
    }
    reg u64 dst = ptr_add(query, (row * heads + head) * dim, 2);
    if (tid < 16) { sts128(s_q, tid << 2, ldg128_stream(ptr_add(dst, tid, 16))); }
    barrier();
    if (tid < 32) {
        reg f32 sn = 0.0f; reg f32 cs = 0.0f;
        if ((rope_sc[0] | rope_sc[1]) != 0) { reg u32x2 sc = ldg64_persist(ptr_add(rope_sc, row * 32 + tid, 8)); sn = u32_as_f32(sc[0]); cs = u32_as_f32(sc[1]); }
        else { sincos_exact_f32(u32_to_f32(ldg32_persist(ptr_add(positions, row, 4))) * u32_as_f32(ldg32_persist(ptr_add(freq, tid, 4))), sn, cs); }
        rq_rope_smem_pair(s_q, (dim >> 1) - 32 + tid, sn, cs);
    }
    barrier();
    if (tid < 16) { reg u32x4 out_v = pack_u32x4(0, 0, 0, 0); rq_fp4_qdq8(1, lds128(s_q, tid << 2), out_v); stg128(ptr_add(dst, tid, 16), out_v); }
    if (head == 0 && (weight[0] | weight[1]) != 0 && tid < heads) {
        reg u64 wp = ptr_add(weight, row * heads + tid, 2); stg16(wp, f32_to_bf16(bf16_lo(ldg16_stream(wp)) * weight_scale));
    }
    preexit();
}

macro rq_block_sum_u32(val, scratch, wid, lane, out_sum) {
    reg u32 v_ = val;
    unroll (bi_ = 0..5) { v_ = v_ + shfl_down(v_, 16 >> bi_); }
    if (lane == 0) { sts32(scratch, wid, v_); }
    barrier();
    reg u32 b_ = 0; if (lane < 8) { b_ = lds32(scratch, lane); }
    b_ = b_ + shfl_down(b_, 4); b_ = b_ + shfl_down(b_, 2); b_ = b_ + shfl_down(b_, 1);
    out_sum = shfl_idx(b_, 0);
}

macro rq_cand_filter(blocks, blk_cnt, topk_blocks, s_cnt, s_thr, tid, wid, lane, ninf) {
    reg u32 prefix = 0;
    for (reg u32 b = 0; b < 32; b += 1) {
        reg u32 cand = prefix | (1 << (31 - b)); reg u32 gr = 0;
        for (reg u32 blk = tid; blk < blk_cnt; blk += 256) { reg u32 ok = 0; f32_topk_key(u32_as_f32(ldg32_stream(ptr_add(blocks, blk, 4))), ok); if (ok >= cand) { gr = gr + 1; } }
        reg u32 tot = 0; rq_block_sum_u32(gr, s_cnt, wid, lane, tot); barrier();
        if (tot >= topk_blocks) { prefix = cand; }
    }
    if (tid == 0) { sts32(s_thr, 0, prefix); }
    barrier();
    reg u32 thr = lds32(s_thr, 0); reg u32 gr = 0;
    for (reg u32 blk = tid; blk < blk_cnt; blk += 256) { reg u32 ok = 0; f32_topk_key(u32_as_f32(ldg32_stream(ptr_add(blocks, blk, 4))), ok); if (ok > thr) { gr = gr + 1; } }
    reg u32 tot_g = 0; rq_block_sum_u32(gr, s_cnt, wid, lane, tot_g); barrier();
    if (tid == 0) {
        reg u32 taken = 0; reg u32 need = topk_blocks - tot_g;
        for (reg u32 blk = 0; blk < blk_cnt; blk += 1) {
            reg f32 bv = u32_as_f32(ldg32_stream(ptr_add(blocks, blk, 4))); reg u32 ok = 0; f32_topk_key(bv, ok);
            if (ok == thr) { reg u32 ki = (taken < need) ? ((bv > ninf) ? 1 : 0) : 0; taken = taken + ki; stg32(ptr_add(blocks, blk, 4), (ki != 0) ? RQ_POS_INF : RQ_NEG_INF); }
            else if (ok < thr) { stg32(ptr_add(blocks, blk, 4), RQ_NEG_INF); }
        }
    }
    barrier();
}

@pdl
@concept(route_topk)
kernel[BLOCK, 48] d41_candidate_mask_256(
    global f32* scores_f32, global u32* widths, u64 row_stride,
    global f32* block_scores_f32, u64 block_stride, u32 block_size, u32 topk_blocks
) {
    shared u32 s_cnt[8]; shared u32 s_thr[1];
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u32 width = ldg32_persist(ptr_add(widths, row, 4));
    if (width == 0) { preexit(); return; }
    reg u64 scores = ptr_add(scores_f32, row, row_stride[0] << 2); reg u64 blocks = ptr_add(block_scores_f32, row, block_stride[0] << 2);
    reg u32 blk_cnt = 0; reg u32 rem = 0; u32_divmod(width + block_size - 1, block_size, blk_cnt, rem);
    reg f32 ninf = u32_as_f32(RQ_NEG_INF);
    for (reg u32 blk = tid; blk < blk_cnt; blk += 256) {
        reg f32 best = ninf; reg u32 end_e = ((blk + 1) * block_size < width) ? ((blk + 1) * block_size) : width;
        for (reg u32 e = blk * block_size; e < end_e; e += 1) { best = maxf(best, u32_as_f32(ldg32_stream(ptr_add(scores, e, 4)))); }
        stg32(ptr_add(blocks, blk, 4), (blk == blk_cnt - 1) ? RQ_POS_INF : f32_as_u32(best));
    }
    barrier();
    if (blk_cnt > topk_blocks) { rq_cand_filter(blocks, blk_cnt, topk_blocks, s_cnt, s_thr, tid, wid, lane, ninf); }
    for (reg u32 e = tid; e < width; e += 256) {
        reg u32 qb = 0; reg u32 rb = 0; u32_divmod(e, block_size, qb, rb);
        if (u32_as_f32(ldg32_stream(ptr_add(blocks, qb, 4))) <= ninf) { stg32(ptr_add(scores, e, 4), RQ_NEG_INF); }
    }
    preexit();
}

@pdl
@concept(route_topk)
kernel[BLOCK, 48] d41_shard_block_max_256(
    global f32* scores_f32, u64 score_stride, blob[12, 4] shard,
    global u32* seq_of_row, global u32* ctx_len, global u32* row_pos,
    global f32* block_scores_f32, u32 block_stride
) {
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x();
    reg u64 scores = ptr_add(scores_f32, row, score_stride[0] << 2); reg u64 blocks = ptr_add(block_scores_f32, row, block_stride << 2);
    reg u32 reach = ldg32_persist(ptr_add(ctx_len, ldg32_persist(ptr_add(seq_of_row, row, 4)), 4));
    reg u32 rp = ldg32_persist(ptr_add(row_pos, row, 4)); if (rp + 1 < reach) { reach = rp + 1; }
    reg u32 deg = param_u32(shard, 0); reg u32 rk = param_u32(shard, 4); reg u32 gr = param_u32(shard, 8);
    reg u32 local = 0; kv_shard_local_keys(deg, rk, gr, reach, local);
    reg u32 pinned = RQ_NO_ROW; if (reach != 0) { reg u32 rem = 0; u32_divmod(reach - 1, gr, pinned, rem); }
    for (reg u32 blk = tid; blk < block_stride; blk += 256) {
        reg f32 best = u32_as_f32(RQ_NEG_INF); reg u32 beg = blk * gr; reg u32 end_e = (beg + gr < local) ? (beg + gr) : local;
        for (reg u32 e = beg; e < end_e; e += 1) { best = maxf(best, u32_as_f32(ldg32_stream(ptr_add(scores, e, 4)))); }
        reg u32 is_pin = (beg < local) ? ((blk * deg + rk == pinned) ? 1 : 0) : 0;
        stg32(ptr_add(blocks, blk, 4), (is_pin != 0) ? RQ_POS_INF : f32_as_u32(best));
    }
    preexit();
}

@pdl
@concept(route_topk)
kernel[BLOCK, 32] d41_shard_block_mask_256(
    u32 global_stride, global u32* selected, u32 keep, blob[12, 4] blocks, global u8* mask, u32 block_stride
) {
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x(); reg u64 line = ptr_add(mask, row, block_stride);
    for (reg u32 blk = tid; blk < block_stride; blk += 256) { stg8(ptr_add(line, blk, 1), 0); }
    barrier();
    reg u32 deg = param_u32(blocks, 0); reg u32 rk = param_u32(blocks, 4); reg u64 sel_row = ptr_add(selected, row, keep << 2);
    for (reg u32 e = tid; e < keep; e += 256) {
        reg u32 blk = ldg32_stream(ptr_add(sel_row, e, 4));
        if (blk < global_stride) { reg u32 q = 0; reg u32 r = 0; u32_divmod(blk, deg, q, r); if (r == rk && q < block_stride) { stg8(ptr_add(line, q, 1), 1); } }
    }
    preexit();
}

@pdl
@concept(route_topk)
kernel[BLOCK, 32] d41_shard_block_apply_256(
    global f32* scores_f32, u64 score_stride, u32 grain, global u8* mask, u32 block_stride
) {
    acqbulk();
    reg u32 row = ctaid_y(); reg u64 scores = ptr_add(scores_f32, row, score_stride[0] << 2);
    reg u64 line = ptr_add(mask, row, block_stride); reg u32 step = grid_x() * ntid_x(); reg u32 sstride = score_stride[0];
    for (reg u32 e = ctaid_x() * ntid_x() + tid_x(); e < sstride; e += step) {
        reg u32 qb = 0; reg u32 rb = 0; u32_divmod(e, grain, qb, rb);
        reg u32 keep_b = 0; if (qb < block_stride) { keep_b = ldg8_stream(ptr_add(line, qb, 1)); }
        if (keep_b == 0) { stg32(ptr_add(scores, e, 4), RQ_NEG_INF); }
    }
    preexit();
}

macro rq_gate_pick_one(scores, bias_f32, chosen, expert_count, pick, ninf, out_best) {
    out_best = RQ_NO_ROW; reg f32 best_v = ninf;
    for (reg u32 exp = 0; exp < expert_count; exp += 1) {
        reg f32 v = lds32(scores, exp) + u32_as_f32(ldg32_persist(ptr_add(bias_f32, exp, 4)));
        for (reg u32 p = 0; p < pick; p += 1) { if (lds32(chosen, p) == exp) { v = ninf; } }
        if (v > best_v) { best_v = v; out_best = exp; }
    }
}

@pdl
@concept(route_topk)
kernel[BLOCK, 48] d41_gate_256(
    global u32* input_bf16, global u32* weight_bf16, global f32* bias_f32,
    global u32* indices_out, global f32* weights_out, u32 expert_count, u32 dimension, u32 topk, f32 route_scale
) {
    shared f32 scores[512]; shared u32 chosen[16];
    acqbulk();
    reg u32 lane = lane_id();
    for (reg u32 exp = warp_id(); exp < expert_count; exp += 8) {
        reg f32 total = 0.0f; reg u64 wp = ptr_add(weight_bf16, exp, dimension << 1);
        for (reg u32 e = lane; e < dimension; e += 32) { total = fma(bf16_lo(ldg16_persist(ptr_add(input_bf16, e, 2))), bf16_lo(ldg16_stream(ptr_add(wp, e, 2))), total); }
        warp_sum_down(total);
        if (lane == 0) { reg f32 sp = 0.0f; reg f32 sq = 0.0f; softplus_exact_f32(total, sp); sqrt_nr1_f32(maxf(sp, 0.0f), sq); sts32(scores, exp, sq); }
    }
    barrier();
    if (tid_x() == 0) {
        reg f32 sum = 0.0f; reg f32 ninf = u32_as_f32(RQ_NEG_INF);
        for (reg u32 pick = 0; pick < topk; pick += 1) {
            reg u32 best = RQ_NO_ROW; rq_gate_pick_one(scores, bias_f32, chosen, expert_count, pick, ninf, best);
            sts32(chosen, pick, best); sum = sum + lds32(scores, best);
        }
        reg f32 denom = sum + 1.0e-20f; reg f32 inv_d = 0.0f; rcp_nr1_f32(denom, inv_d);
        for (reg u32 pick = 0; pick < topk; pick += 1) {
            reg u32 ch = lds32(chosen, pick); reg f32 q = 0.0f; div_nr1_f32(lds32(scores, ch), denom, inv_d, q);
            stg32(ptr_add(indices_out, pick, 4), ch); stg32(ptr_add(weights_out, pick, 4), f32_as_u32(q * route_scale));
        }
    }
    preexit();
}

macro rq_ex_counts_expert(RANKS, my_e, my_own, cnt, top_k, s_re, s_twice, s_tgt, rt_acc, ds_acc, sole_acc) {
    for (reg u32 t = 0; t < cnt; t += 1) {
        reg u32 hit = 0; for (reg u32 k = 0; k < top_k; k += 1) { if (lds32(s_re, t * 8 + k) == my_e) { hit = hit + 1; } }
        if (hit != 0) {
            rt_acc = rt_acc + hit;
            if (((lds32(s_twice, t) >> my_own) & 1) == 0) {
                ds_acc = ds_acc + hit; reg u32 tg = lds32(s_tgt, t);
                unroll (r = 0..RANKS) { sole_acc[r] = sole_acc[r] + ((tg == r) ? hit : 0); }
            }
        }
    }
}

@pdl
@concept(route_topk)
template kernel[1024, 64] d41_exchange_counts_tpl<RANKS>(
    global u32* route_expert, u32 rows, u32 first, u32 top_k, global u8* owner, u32 backups, global u8* counts
) {
    shared u32 s_mask[256]; shared u32 s_twice[256]; shared u32 s_tgt[256]; shared u32 s_re[2048]; shared u32 s_pair[RANKS * RANKS];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 pair_acc = 0; reg u32 rt_acc = 0; reg u32 ds_acc = 0;
    reg u32 is_ex = 0; if (backups != 0 && tid >= 256 && tid < 256 + RQ_EXPERTS) { is_ex = 1; }
    reg u32 sole_acc[RANKS]; unroll (r = 0..RANKS) { sole_acc[r] = 0; }
    for (reg u32 base = 0; base < rows; base += 256) {
        reg u32 cnt = (rows - base < 256) ? (rows - base) : 256;
        if (tid < cnt) {
            reg u32 row = base + tid; reg u32 qf = 0; reg u32 tgt = 0; u32_divmod(first + row, RANKS, qf, tgt); sts32(s_tgt, tid, tgt);
            reg u32 mask = 0; reg u32 twice = 0;
            for (reg u32 k = 0; k < top_k; k += 1) {
                reg u32 e = ldg32_persist(ptr_add(route_expert, row * top_k + k, 4)); sts32(s_re, tid * 8 + k, e);
                reg u32 hm = 1 << ldg8_persist(ptr_add(owner, e, 1)); twice = twice | (mask & hm); mask = mask | hm;
            }
            sts32(s_mask, tid, mask); sts32(s_twice, tid, twice);
        }
        barrier();
        if (tid < RANKS * RANKS) {
            reg u32 my_t = 0; reg u32 my_r = 0; u32_divmod(tid, RANKS, my_t, my_r);
            for (reg u32 t = 0; t < cnt; t += 1) { if (lds32(s_tgt, t) == my_t && ((lds32(s_mask, t) >> my_r) & 1) != 0) { pair_acc = pair_acc + 1; } }
        }
        if (is_ex != 0) {
            reg u32 my_e = tid - 256;
            rq_ex_counts_expert(RANKS, my_e, ldg8_persist(ptr_add(owner, my_e, 1)), cnt, top_k, s_re, s_twice, s_tgt, rt_acc, ds_acc, sole_acc);
        }
        barrier();
    }
    if (tid < RANKS * RANKS) { sts32(s_pair, tid, pair_acc); stg32(ptr_add(counts, tid, 4), pair_acc); }
    barrier();
    if (tid < RANKS) { reg u32 dp = 0; unroll (t = 0..RANKS) { dp = dp + lds32(s_pair, t * RANKS + tid); } stg32(ptr_add(counts, RANKS * RANKS + tid, 4), dp); }
    if (is_ex != 0) {
        reg u32 my_e = tid - 256; reg u32 off_rt = (RANKS * RANKS + RANKS) * 4;
        stg16(ptr_add(ptr_add(counts, off_rt, 1), my_e, 2), rt_acc); stg16(ptr_add(ptr_add(counts, off_rt + 768, 1), my_e, 2), ds_acc);
        reg u64 sole_p = ptr_add(counts, off_rt + 1536, 1); unroll (r = 0..RANKS) { stg8(ptr_add(sole_p, r * RQ_EXPERTS + my_e, 1), sole_acc[r]); }
    }
    preexit();
}

instantiate d41_exchange_counts_tpl<4> as d41_exchange_counts_r4_e384;
instantiate d41_exchange_counts_tpl<16> as d41_exchange_counts_r16_e384;

macro rq_warp32_col_prefix(COLS, s_tbl, s_base, tid) {
    barrier();
    if (tid < COLS) {
        reg u32 run_ = lds32(s_base, tid);
        for (reg u32 ww_ = 0; ww_ < 32; ww_ += 1) {
            reg u32 h_ = lds32(s_tbl, ww_ * COLS + tid); sts32(s_tbl, ww_ * COLS + tid, run_); run_ = run_ + h_;
        }
        sts32(s_base, tid, run_);
    }
    barrier();
}

macro rq_slots_pick_backup(ce, place, copies, owner, backup, quota, target) {
    reg u32 home = ldg8_persist(ptr_add(owner, ce, 1)); reg u32 bnd = 0;
    unroll (cp = 0..2) {
        if (cp < copies) {
            reg u32 st = bnd; bnd = bnd + ldg16_persist(ptr_add(quota, cp * RQ_EXPERTS + ce, 2));
            if (place >= st && place < bnd) {
                reg u32 bk = ldg8_persist(ptr_add(backup, cp * RQ_EXPERTS + ce, 1)); reg u32 sh = home << 2;
                if (sh < 32) { target[0] = (target[0] & (0xFFFFFFFF ^ (0xF << sh))) | (bk << sh); }
                else { reg u32 s2 = sh - 32; target[1] = (target[1] & (0xFFFFFFFF ^ (0xF << s2))) | (bk << s2); }
            }
        }
    }
}

macro rq_slots_sole_half(half_id, wid, tid, has_q, copies, cand, bef, peers, s_sr, s_sb, owner, backup, quota, target) {
    for (reg u32 i = tid; i < 16 * RQ_EXPERTS; i += 1024) { sts32(s_sr, i, 0); }
    barrier();
    if ((wid >> 4) == half_id) {
        reg u32 lw = wid & 15;
        unroll (k = 0..RQ_TOPK) { if (cand[k] != RQ_EXPERTS && bef[k] == 0) { sts32(s_sr, lw * RQ_EXPERTS + cand[k], peers[k]); } }
    }
    barrier();
    if (has_q != 0 && tid < RQ_EXPERTS) {
        reg u32 run = lds32(s_sb, tid);
        for (reg u32 w = 0; w < 16; w += 1) { reg u32 h = lds32(s_sr, w * RQ_EXPERTS + tid); sts32(s_sr, w * RQ_EXPERTS + tid, run); run = run + h; }
        sts32(s_sb, tid, run);
    }
    barrier();
    if ((wid >> 4) == half_id) {
        reg u32 lw = wid & 15;
        unroll (k = 0..RQ_TOPK) {
            if (cand[k] != RQ_EXPERTS) {
                rq_slots_pick_backup(cand[k], lds32(s_sr, lw * RQ_EXPERTS + cand[k]) + bef[k], copies, owner, backup, quota, target);
            }
        }
    }
    barrier();
}

macro rq_slots_build_cands(row, rows, has_q, copies, route_expert, owner, quota, mask, cand, bef, peers) {
    reg u32 exp[RQ_TOPK]; reg u32 twice = 0; mask = 0;
    unroll (k = 0..RQ_TOPK) {
        reg u32 e = RQ_EXPERTS; if (row < rows) { e = ldg32_persist(ptr_add(route_expert, row * RQ_TOPK + k, 4)); }
        exp[k] = e; if (e < RQ_EXPERTS) { reg u32 hm = 1 << ldg8_persist(ptr_add(owner, e, 1)); twice = twice | (mask & hm); mask = mask | hm; }
    }
    unroll (k = 0..RQ_TOPK) {
        reg u32 pl = 0;
        if (has_q != 0 && exp[k] < RQ_EXPERTS) { unroll (cp = 0..2) { if (cp < copies) { pl = pl + ldg16_persist(ptr_add(quota, cp * RQ_EXPERTS + exp[k], 2)); } } }
        reg u32 ok = 0; if (pl != 0 && exp[k] < RQ_EXPERTS) { if (((twice >> ldg8_persist(ptr_add(owner, exp[k], 1))) & 1) == 0) { ok = 1; } }
        cand[k] = (ok != 0) ? exp[k] : RQ_EXPERTS; bef[k] = 0; peers[k] = 0;
    }
}

macro rq_slots_count_and_emit(RANKS, WORDS, row, rows, capacity, mask, target, lane, wid, tid, s_tr, s_tb, slot) {
    reg u32 cnt_w[WORDS]; reg u32 inc_w[WORDS]; unroll (w = 0..WORDS) { cnt_w[w] = 0; }
    unroll (hm = 0..RANKS) {
        if (((mask >> hm) & 1) != 0) {
            reg u32 to = ((hm < 8) ? (target[0] >> (hm * 4)) : (target[1] >> ((hm - 8) * 4))) & 0xF;
            unroll (w = 0..WORDS) { cnt_w[w] = cnt_w[w] + (((to >> 2) == w) ? (1 << ((to & 3) << 3)) : 0); }
        }
    }
    unroll (w = 0..WORDS) { reg u32 iv = cnt_w[w]; warp_prefix_u32(iv, lane); inc_w[w] = iv; }
    if (lane == 31) { unroll (w = 0..WORDS) { unroll (b = 0..4) { sts32(s_tr, wid * RANKS + w * 4 + b, (inc_w[w] >> (b * 8)) & 0xFF); } } }
    rq_warp32_col_prefix(RANKS, s_tr, s_tb, tid);
    if (row < rows) {
        reg u32 used_w[WORDS]; unroll (w = 0..WORDS) { used_w[w] = inc_w[w] - cnt_w[w]; }
        unroll (hm = 0..RANKS) {
            reg u32 at = RQ_NO_ROW;
            if (((mask >> hm) & 1) != 0) {
                reg u32 to = ((hm < 8) ? (target[0] >> (hm * 4)) : (target[1] >> ((hm - 8) * 4))) & 0xF;
                reg u32 uv = 0;
                unroll (w = 0..WORDS) {
                    reg u32 hit_w = ((to >> 2) == w) ? 1 : 0;
                    uv = (hit_w != 0) ? ((used_w[w] >> ((to & 3) << 3)) & 0xFF) : uv;
                    used_w[w] = used_w[w] + ((hit_w != 0) ? (1 << ((to & 3) << 3)) : 0);
                }
                at = to * capacity + lds32(s_tr, wid * RANKS + to) + uv;
            }
            stg32(ptr_add(slot, row * RANKS + hm, 4), at);
        }
    }
}

macro rq_slots_warp_peers(lane, cand, bef, peers) {
    for (reg u32 src = 0; src < 32; src += 1) {
        unroll (j = 0..RQ_TOPK) {
            reg u32 oth = shfl_idx(cand[j], src);
            unroll (k = 0..RQ_TOPK) {
                if (cand[k] != RQ_EXPERTS && oth == cand[k]) {
                    bef[k] = bef[k] + ((src < lane) ? 1 : 0); peers[k] = peers[k] + 1;
                }
            }
        }
    }
}

@pdl
@concept(route_topk)
template kernel[1024, 64] d41_exchange_slots_tpl<RANKS, WORDS>(
    global u32* route_expert, u32 rows, global u8* owner, global u8* backup,
    global u32* quota, u32 capacity, global u32* slot, global u32* count, u32 copies
) {
    shared u32 s_sr[16 * RQ_EXPERTS]; shared u32 s_sb[RQ_EXPERTS]; shared u32 s_tr[32 * RANKS]; shared u32 s_tb[RANKS];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 lane = lane_id(); reg u32 wid = warp_id(); reg u32 has_q = quota[0] | quota[1];
    if (tid < RQ_EXPERTS) { sts32(s_sb, tid, 0); }
    if (tid < RANKS) { sts32(s_tb, tid, 0); }
    barrier();
    for (reg u32 chunk = 0; chunk < rows; chunk += 1024) {
        reg u32 row = chunk + tid; reg u32 cand[RQ_TOPK]; reg u32 bef[RQ_TOPK]; reg u32 peers[RQ_TOPK]; reg u32 mask = 0;
        rq_slots_build_cands(row, rows, has_q, copies, route_expert, owner, quota, mask, cand, bef, peers);
        reg u64 target; target[0] = 0x76543210; target[1] = 0xFEDCBA98;
        if (has_q != 0) { rq_slots_warp_peers(lane, cand, bef, peers); }
        rq_slots_sole_half(0, wid, tid, has_q, copies, cand, bef, peers, s_sr, s_sb, owner, backup, quota, target);
        rq_slots_sole_half(1, wid, tid, has_q, copies, cand, bef, peers, s_sr, s_sb, owner, backup, quota, target);
        rq_slots_count_and_emit(RANKS, WORDS, row, rows, capacity, mask, target, lane, wid, tid, s_tr, s_tb, slot);
        barrier();
    }
    if (tid < RANKS) { stg32(ptr_add(count, tid, 4), lds32(s_tb, tid)); }
    preexit();
}

instantiate d41_exchange_slots_tpl<4, 1> as d41_exchange_slots_r4_e384;
instantiate d41_exchange_slots_tpl<16, 4> as d41_exchange_slots_r16_e384;

@pdl
@concept(route_topk)
template kernel[1024, 48] d41_engram_slots_tpl<RANKS>(
    global u64* ids, u32 rows, u32 own, u32 columns, u64 part, u64 table_rows, global u32* slot, global u32* counts
) {
    shared u32 s_tot[32 * RANKS]; shared u32 s_base[RANKS];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 lane = lane_id(); reg u32 wid = warp_id(); reg u32 owner = ctaid_x();
    reg u32 first = (owner * own < rows) ? (owner * own) : rows;
    reg u32 begin = first * columns; reg u32 end = ((first + own < rows) ? (first + own) : rows) * columns;
    if (tid < RANKS) { sts32(s_base, tid, 0); }
    barrier();
    for (reg u32 chunk = begin; chunk < end; chunk += 1024) {
        reg u32 entry = chunk + tid; reg u32 src = RQ_NO_ROW;
        if (entry < end) { reg u64 idv = ldg64_persist(ptr_add(ids, entry, 8)); engram_source_rank(idv, part, table_rows, src); }
        reg u32 before = 0;
        for (reg u32 rk = 0; rk < RANKS; rk += 1) {
            reg u32 m = (src == rk) ? 1 : 0; reg u32 inc = m; warp_prefix_u32(inc, lane);
            if (m != 0) { before = inc - 1; }
            if (lane == 31) { sts32(s_tot, wid * RANKS + rk, inc); }
        }
        rq_warp32_col_prefix(RANKS, s_tot, s_base, tid);
        if (entry < end) { reg u32 sv = RQ_NO_ROW; if (src < RANKS) { sv = lds32(s_tot, wid * RANKS + src) + before; } stg32(ptr_add(slot, entry, 4), sv); }
        barrier();
    }
    if (tid < RANKS) { stg32(ptr_add(counts, tid * RANKS + owner, 4), lds32(s_base, tid)); }
    preexit();
}

instantiate d41_engram_slots_tpl<4> as d41_engram_slots_r4;
instantiate d41_engram_slots_tpl<16> as d41_engram_slots_r16;

macro rq_topk_row_active(row, n, seq, len, bound, dense_limit, pool_stride, out_eff, out_skip) {
    out_skip = 0; out_eff = n;
    if (dense_limit != 0 && (seq[0] | seq[1]) != 0) {
        if ((len[0] | len[1]) != 0) {
            reg u32 b_ = ldg32_persist(ptr_add(len, ldg32_persist(ptr_add(seq, row, 4)), 4));
            if ((bound[0] | bound[1]) != 0) { reg u32 rp1_ = ldg32_persist(ptr_add(bound, row, 4)) + 1; if (rp1_ < b_) { b_ = rp1_; } }
            if (b_ <= dense_limit) { out_skip = 1; out_eff = 0; }
            else { reg u32 act_ = b_; if (pool_stride > 1) { reg u32 qr_ = 0; u32_divmod(b_, pool_stride, act_, qr_); } out_eff = (act_ < n) ? act_ : n; }
        }
    }
}

macro rq_topk_load4(row_ptr, idx, eff_n, aligned16, kv) {
    unroll (ti_ = 0..4) { kv[ti_] = 0; }
    reg u32 fast_ = (aligned16 != 0) ? ((idx + 3 < eff_n) ? 1 : 0) : 0;
    if (fast_ != 0) {
        reg u32x4 v_ = ldg128_persist(ptr_add(row_ptr, idx, 4));
        unroll (ti_ = 0..4) { kv[ti_] = ((v_[ti_] & 0x80000000) != 0) ? (v_[ti_] ^ 0xFFFFFFFF) : (v_[ti_] | 0x80000000); }
    } else {
        unroll (ti_ = 0..4) { if (idx + ti_ < eff_n) { reg u32 b_ = ldg32_persist(ptr_add(row_ptr, idx + ti_, 4)); kv[ti_] = ((b_ & 0x80000000) != 0) ? (b_ ^ 0xFFFFFFFF) : (b_ | 0x80000000); } }
    }
}

macro rq_topk_hist4(kv, bidx, eff_n, mask, prefix, shift, tid, s_mem) {
    unroll (ti_ = 0..4) {
        if (bidx + ti_ < eff_n && (kv[ti_] & mask) == prefix) { reg u32 p_ = (((kv[ti_] >> shift) & 15) << 8) + tid; sts32(s_mem, p_, lds32(s_mem, p_) + 1); }
    }
}

macro rq_topk_pass_finish(s_mem, shift, lane, tid, prefix, mask, need, done) {
    barrier();
    reg u32 b_ = tid >> 4; reg u32 sub_ = tid & 15; reg u32 sum_ = 0;
    unroll (di_ = 0..16) { sum_ = sum_ + lds32(s_mem, (b_ << 8) + (di_ << 4) + sub_); }
    sum_ = sum_ + shfl_xor(sum_, 8); sum_ = sum_ + shfl_xor(sum_, 4); sum_ = sum_ + shfl_xor(sum_, 2); sum_ = sum_ + shfl_xor(sum_, 1);
    if (sub_ == 0) { sts32(s_mem, 4096 + b_, sum_); }
    barrier();
    if (tid < 32) {
        reg u32 cnt_ = 0; if (tid < 16) { cnt_ = lds32(s_mem, 4096 + (15 - tid)); } reg u32 inc_ = cnt_; warp_prefix_u32(inc_, lane);
        if (tid < 16 && inc_ >= need) { if (inc_ - cnt_ < need) { sts32(s_mem, 4112, 15 - tid); sts32(s_mem, 4113, inc_ - cnt_); sts32(s_mem, 4114, cnt_); } }
    }
    barrier();
    prefix = prefix | (lds32(s_mem, 4112) << shift); mask = mask | (15 << shift);
    need = need - lds32(s_mem, 4113); if (lds32(s_mem, 4114) == need) { done = 1; }
}

macro rq_topk_emit4(MODE, kv, base_idx, eff_n, mask, prefix, need, first, wid, lane, s_mem, out, val_out, row_pos, emitted, seen_eq) {
    reg u32 gv_[4]; reg u32 ev_[4]; reg u32 gc_ = 0; reg u32 ec_ = 0;
    unroll (ti_ = 0..4) {
        gv_[ti_] = 0; ev_[ti_] = 0;
        if (base_idx + ti_ < eff_n) { reg u32 km_ = kv[ti_] & mask; if (km_ > prefix) { gv_[ti_] = 1; gc_ = gc_ + 1; } else if (km_ == prefix) { ev_[ti_] = 1; ec_ = ec_ + 1; } }
    }
    reg u32 gi_ = gc_; reg u32 ei_ = ec_; warp_prefix_u32(gi_, lane); warp_prefix_u32(ei_, lane);
    if (lane == 31) { sts32(s_mem, 4116 + wid, gi_); sts32(s_mem, 4124 + wid, ei_); }
    barrier();
    reg u32 gb_ = gi_ - gc_; reg u32 eb_ = ei_ - ec_; reg u32 gtot_ = 0; reg u32 etot_ = 0;
    unroll (w_ = 0..8) {
        reg u32 gw_ = lds32(s_mem, 4116 + w_); reg u32 ew_ = lds32(s_mem, 4124 + w_);
        if (w_ < wid) { gb_ = gb_ + gw_; eb_ = eb_ + ew_; }
        gtot_ = gtot_ + gw_; etot_ = etot_ + ew_;
    }
    reg u32 rem_ = (need > seen_eq) ? (need - seen_eq) : 0; reg u32 em_ = emitted;
    unroll (ti_ = 0..4) {
        reg u32 do_w_ = 0; reg u32 sl_ = 0;
        if (gv_[ti_] != 0) { do_w_ = 1; sl_ = em_ + gb_ + ((eb_ < rem_) ? eb_ : rem_); }
        else { if (ev_[ti_] != 0 && eb_ < rem_) { do_w_ = 1; sl_ = em_ + gb_ + eb_; } }
        if (do_w_ != 0) {
            if constexpr (MODE == 0) { stg32(ptr_add(out, sl_, 4), base_idx + ti_); }
            else if constexpr (MODE == 1) {
                reg u32 vb_ = ((kv[ti_] & 0x80000000) != 0) ? (kv[ti_] ^ 0x80000000) : (kv[ti_] ^ 0xFFFFFFFF);
                stg32(ptr_add(val_out, sl_, 4), vb_); stg32(ptr_add(out, sl_, 4), first + base_idx + ti_);
            } else { stg32(ptr_add(out, sl_, 4), ldg32_persist(ptr_add(row_pos, base_idx + ti_, 4))); }
        }
        gb_ = gb_ + gv_[ti_]; eb_ = eb_ + ev_[ti_];
    }
    emitted = em_ + gtot_ + ((etot_ < rem_) ? etot_ : rem_); seen_eq = seen_eq + etot_;
    barrier();
}

macro rq_topk_select_reg(MODE, row_ptr, eff_n, k, al16, first, out, val_out, row_pos, wid, lane, tid, s_mem) {
    reg u32 rk_[16]; reg u32 tmp_[4];
    unroll (c_ = 0..4) { rq_topk_load4(row_ptr, c_ * 1024 + tid * 4, eff_n, al16, tmp_); unroll (j_ = 0..4) { rk_[c_ * 4 + j_] = tmp_[j_]; } }
    reg u32 prefix_ = 0; reg u32 mask_ = 0; reg u32 need_ = k; reg u32 done_ = 0; reg u32 emitted_ = 0; reg u32 seen_eq_ = 0;
    for (reg u32 pass_ = 0; pass_ < 8; pass_ += 1) {
        if (done_ == 0) {
            reg u32 sh_ = 28 - (pass_ << 2); unroll (p_ = 0..16) { sts32(s_mem, (p_ << 8) + tid, 0); }
            unroll (c_ = 0..4) { unroll (j_ = 0..4) { tmp_[j_] = rk_[c_ * 4 + j_]; } rq_topk_hist4(tmp_, c_ * 1024 + tid * 4, eff_n, mask_, prefix_, sh_, tid, s_mem); }
            rq_topk_pass_finish(s_mem, sh_, lane, tid, prefix_, mask_, need_, done_);
        }
    }
    unroll (c_ = 0..4) { if (c_ * 1024 < eff_n) { unroll (j_ = 0..4) { tmp_[j_] = rk_[c_ * 4 + j_]; } rq_topk_emit4(MODE, tmp_, c_ * 1024 + tid * 4, eff_n, mask_, prefix_, need_, first, wid, lane, s_mem, out, val_out, row_pos, emitted_, seen_eq_); } }
}

macro rq_topk_select_stream(MODE, row_ptr, eff_n, k, al16, first, out, val_out, row_pos, wid, lane, tid, s_mem) {
    reg u32 prefix_ = 0; reg u32 mask_ = 0; reg u32 need_ = k; reg u32 done_ = 0; reg u32 emitted_ = 0; reg u32 seen_eq_ = 0;
    for (reg u32 pass_ = 0; pass_ < 8; pass_ += 1) {
        if (done_ == 0) {
            reg u32 sh_ = 28 - (pass_ << 2); unroll (p_ = 0..16) { sts32(s_mem, (p_ << 8) + tid, 0); }
            for (reg u32 base_ = 0; base_ < eff_n; base_ += 1024) { reg u32 kv_[4]; rq_topk_load4(row_ptr, base_ + tid * 4, eff_n, al16, kv_); rq_topk_hist4(kv_, base_ + tid * 4, eff_n, mask_, prefix_, sh_, tid, s_mem); }
            rq_topk_pass_finish(s_mem, sh_, lane, tid, prefix_, mask_, need_, done_);
        }
    }
    for (reg u32 base_ = 0; base_ < eff_n; base_ += 1024) { reg u32 kv_[4]; rq_topk_load4(row_ptr, base_ + tid * 4, eff_n, al16, kv_); rq_topk_emit4(MODE, kv_, base_ + tid * 4, eff_n, mask_, prefix_, need_, first, wid, lane, s_mem, out, val_out, row_pos, emitted_, seen_eq_); }
}

macro rq_topk_select(MODE, row_ptr, eff_n, k, first, out, val_out, row_pos, wid, lane, tid, s_mem) {
    reg u32 al16_ = ((row_ptr[0] & 15) == 0) ? 1 : 0;
    if (eff_n <= 4096) { rq_topk_select_reg(MODE, row_ptr, eff_n, k, al16_, first, out, val_out, row_pos, wid, lane, tid, s_mem); }
    else { rq_topk_select_stream(MODE, row_ptr, eff_n, k, al16_, first, out, val_out, row_pos, wid, lane, tid, s_mem); }
}

macro rq_topk_chunk_body(scores, values, positions, n, k, chunk, max_chunks, seq, len, bound, dense_limit, pool_stride, tid, s_mem) {
    reg u32 row_idx = ctaid_y(); reg u32 cid = ctaid_x(); reg u32 first = cid * chunk;
    reg u32 eff_n = 0; reg u32 skip = 0; rq_topk_row_active(row_idx, n, seq, len, bound, dense_limit, pool_stride, eff_n, skip);
    reg u32 act = (skip == 0) ? ((eff_n > k) ? 1 : 0) : 0;
    if (act != 0 && first < eff_n) {
        reg u32 length = (eff_n - first < chunk) ? (eff_n - first) : chunk;
        reg u64 row_ptr = ptr_add(ptr_add(scores, row_idx, n << 2), first, 4);
        reg u64 pos_out = ptr_add(positions, row_idx * max_chunks + cid, k << 2);
        reg u64 val_out = ptr_add(values, row_idx * max_chunks + cid, k << 2);
        if (length <= k) {
            for (reg u32 i = tid; i < k; i += 256) {
                reg u32 vb = RQ_NEG_INF; reg u32 pv = RQ_NO_ROW; if (i < length) { vb = ldg32_persist(ptr_add(row_ptr, i, 4)); pv = first + i; }
                stg32(ptr_add(val_out, i, 4), vb); stg32(ptr_add(pos_out, i, 4), pv);
            }
        } else { rq_topk_select(1, row_ptr, length, k, first, pos_out, val_out, pos_out, warp_id(), lane_id(), tid, s_mem); }
    }
}

@pdl
@concept(route_topk)
template kernel[BLOCK, 104] d41_topk_exact_tpl<MODE>(
    global f32* scores, global f32* values, global u32* positions,
    u32 n, u32 k, u32 chunk, u32 max_chunks, global u32* out_indices,
    global u32* seq, global u32* len, global u32* bound, u32 dense_limit, u32 pool_stride
) {
    shared u32 s_mem[4132];
    acqbulk();
    reg u32 tid = tid_x();
    if constexpr (MODE == 1) {
        rq_topk_chunk_body(scores, values, positions, n, k, chunk, max_chunks, seq, len, bound, dense_limit, pool_stride, tid, s_mem);
    } else {
        reg u32 row_idx = ctaid_x(); reg u32 eff_n = 0; reg u32 skip = 0;
        rq_topk_row_active(row_idx, n, seq, len, bound, dense_limit, pool_stride, eff_n, skip);
        reg u64 out = ptr_add(out_indices, row_idx, k << 2);
        if (skip != 0) { preexit(); return; }
        if (eff_n <= k) { for (reg u32 i = tid; i < k; i += 256) { stg32(ptr_add(out, i, 4), (i < eff_n) ? i : RQ_NO_ROW); } preexit(); return; }
        if constexpr (MODE == 0) {
            rq_topk_select(0, ptr_add(scores, row_idx, n << 2), eff_n, k, 0, out, out, out, warp_id(), lane_id(), tid, s_mem);
        } else {
            reg u32 ac = 0; reg u32 acr = 0; u32_divmod(eff_n + chunk - 1, chunk, ac, acr);
            reg u64 rvals = ptr_add(values, row_idx * max_chunks, k << 2); reg u64 rpos = ptr_add(positions, row_idx * max_chunks, k << 2);
            if (ac == 1) { for (reg u32 i = tid; i < k; i += 256) { stg32(ptr_add(out, i, 4), ldg32_persist(ptr_add(rpos, i, 4))); } }
            else { rq_topk_select(2, rvals, ac * k, k, 0, out, out, rpos, warp_id(), lane_id(), tid, s_mem); }
        }
    }
    preexit();
}

instantiate d41_topk_exact_tpl<0> as d41_topk_exact_fast_256;
instantiate d41_topk_exact_tpl<1> as d41_topk_exact_chunk_reg_256;
instantiate d41_topk_exact_tpl<2> as d41_topk_exact_gather_reg_256;
