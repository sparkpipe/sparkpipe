macro moe_nvfp4_w2_load_ws(wb, sb, glob, idx, vw, sc0, sc1) {
    vw = ldg128_stream(ptr_add(wb, idx, 16));
    reg u32 sr = ldg16_persist(ptr_add(sb, idx, 2));
    nvfp4_ue4m3_decode(sr, glob, sc0); nvfp4_ue4m3_decode(sr >> 8, glob, sc1);
}

@pdl
@concept(moe)
template kernel[MMOE_BLK256, REGS] moe_nvfp4_skinny_w2_tpl<IS_BATCHED, LANES, REGS>(
    global u32* w2, global u8* w2_scale_blob, global u32* act, global u32* group_row_offset,
    if (IS_BATCHED == 0) global u32* packed_expert, global u32* output, u32 k_dim, u32 n_dim, u32 groups
) {
    acqbulk();
    reg u32 m[6];
    if constexpr (IS_BATCHED == 0) { moe_skinny_grid_setup(0, MMOE_BLK256, LANES, 2, group_row_offset, packed_expert, groups, n_dim, m); }
    else { moe_skinny_grid_setup(1, MMOE_BLK256, LANES, 2, group_row_offset, group_row_offset, groups, n_dim, m); }
    if (m[5] == 0) { preexit(); return; }
    reg u32 chunks = k_dim >> 5;
    reg u32 off0 = (m[2] * n_dim + m[0]) * chunks;
    reg u64 wb = ptr_add(w2, off0, 16); reg u64 sb = ptr_add(ptr_add(w2_scale_blob, groups, 4), off0, 2);
    reg f32 glob = u32_as_f32(ldg32_persist(ptr_add(w2_scale_blob, m[2], 4)));
    reg u32 k_lim = (n_dim - m[0] < 4) ? (n_dim - m[0]) : 4;
    if constexpr (IS_BATCHED == 0) {
        reg u64 act_row = ptr_add(act, ctaid_y() * (chunks << 2), 16);
        reg f32 acc[4]; unroll (k = 0..4) { acc[k] = 0.0f; }
        for (reg u32 c = m[1]; c < chunks; c += LANES) {
            reg u32x4 a0 = ldg128_persist(ptr_add(act_row, c << 2, 16)); reg u32x4 a1 = ldg128_persist(ptr_add(act_row, (c << 2) + 1, 16));
            reg u32x4 a2 = ldg128_persist(ptr_add(act_row, (c << 2) + 2, 16)); reg u32x4 a3 = ldg128_persist(ptr_add(act_row, (c << 2) + 3, 16));
            unroll (k = 0..4) {
                if (k < k_lim) {
                    reg u32x4 vw; reg f32 sc0 = 0.0f; reg f32 sc1 = 0.0f; reg f32 d0 = 0.0f; reg f32 d1 = 0.0f;
                    moe_nvfp4_w2_load_ws(wb, sb, glob, k * chunks + c, vw, sc0, sc1);
                    nvfp4_e2m1_dot16(vw[0], vw[1], a0, a1, d0); nvfp4_e2m1_dot16(vw[2], vw[3], a2, a3, d1);
                    acc[k] = fma(sc1, d1, fma(sc0, d0, acc[k]));
                }
            }
        }
        unroll (k = 0..4) { lanes_reduce_sum(LANES, acc[k]); }
        if (m[1] == 0) { unroll (k = 0..4) { if (k < k_lim) { stg16(ptr_add(output, ctaid_y() * n_dim + m[0] + k, 2), f32_to_bf16(acc[k])); } } }
    } else {
        reg u32 total_bk = ((m[4] - m[3] + 3) >> 2) * k_lim;
        for (reg u32 bk = 0; bk < total_bk; bk += 1) {
            reg u32 bi = 0; reg u32 k = 0; u32_divmod(bk, k_lim, bi, k);
            reg u32 first = m[3] + (bi << 2); reg u32 cnt = (m[4] - first < 4) ? (m[4] - first) : 4;
            reg u64 pa[4]; reg f32 acc[4];
            unroll (r = 0..4) { pa[r] = ptr_add(act, (first + ((r < cnt) ? r : 0)) * (chunks << 2), 16); acc[r] = 0.0f; }
            for (reg u32 c = m[1]; c < chunks; c += LANES) {
                reg u32x4 vw; reg f32 sc0 = 0.0f; reg f32 sc1 = 0.0f;
                moe_nvfp4_w2_load_ws(wb, sb, glob, k * chunks + c, vw, sc0, sc1);
                unroll (r = 0..4) {
                    reg f32 d0 = 0.0f; reg f32 d1 = 0.0f;
                    nvfp4_e2m1_dot16(vw[0], vw[1], ldg128_persist(ptr_add(pa[r], c << 2, 16)), ldg128_persist(ptr_add(pa[r], (c << 2) + 1, 16)), d0);
                    nvfp4_e2m1_dot16(vw[2], vw[3], ldg128_persist(ptr_add(pa[r], (c << 2) + 2, 16)), ldg128_persist(ptr_add(pa[r], (c << 2) + 3, 16)), d1);
                    acc[r] = fma(sc1, d1, fma(sc0, d0, acc[r]));
                }
            }
            unroll (r = 0..4) {
                lanes_reduce_sum(LANES, acc[r]);
                if (m[1] == 0 && r < cnt) { stg16(ptr_add(output, (first + r) * n_dim + m[0] + k, 2), f32_to_bf16(acc[r])); }
            }
        }
    }
    preexit();
}

