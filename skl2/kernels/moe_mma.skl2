@pdl
@concept(moe)
template kernel[MMOE_BLK128, REGS] moe_shared_down_finalize_tpl<LANES, REGS>(
    global u32* packed, global u32* route_packed_row, global u32* route_expert,
    global u32* shared_gate_up, global u32* shared_down, global u32* shared_logit,
    global u32* output, u32 rows, u32 hidden, u32 shared_rows, u32 top_k, u32 local_experts
) {
    shared u32 s_act[64];
    shared u32 active_rows[32];
    shared u32 active_count[1];
    acqbulk();
    reg u32 row = ctaid_y();
    if (row >= rows) { preexit(); return; }
    reg u32 tid = tid_x(); reg u32 chunks = shared_rows >> 3;
    if (tid < chunks) {
        reg u64 gu_base = ptr_add(shared_gate_up, row * (shared_rows << 1), 2);
        reg u32x4 gv = ldg128_persist(ptr_add(gu_base, tid, 16));
        reg u32x4 uv = ldg128_persist(ptr_add(ptr_add(gu_base, shared_rows, 2), tid, 16));
        reg u32x4 av;
        unroll (k = 0..4) {
            reg f32 s0 = 0.0f; reg f32 s1 = 0.0f;
            silu_exact_f32(bf16_lo(gv[k]), s0); silu_exact_f32(bf16_hi(gv[k]), s1);
            av[k] = pack_bf16x2(s0 * bf16_lo(uv[k]), s1 * bf16_hi(uv[k]));
        }
        sts128(s_act, tid << 2, av);
    }
    if (tid == 0) {
        reg u32 cnt = 0;
        for (reg u32 k = 0; k < top_k; k += 1) {
            reg u32 route = row * top_k + k;
            if (ldg32_persist(ptr_add(route_expert, route, 4)) < local_experts) {
                sts32(active_rows, cnt, ldg32_persist(ptr_add(route_packed_row, route, 4)));
                cnt = cnt + 1;
            }
        }
        sts32(active_count, 0, cnt);
    }
    barrier();
    reg u32 col = ctaid_x() * (MMOE_BLK128 >> (3 + (LANES >> 4))) + (tid >> (3 + (LANES >> 4)));
    reg u32 sub = tid & (LANES - 1);
    if (col < hidden) {
        reg u64 w = ptr_add(shared_down, col * chunks, 16);
        reg f32 acc = 0.0f;
        for (reg u32 c = sub; c < chunks; c += LANES) { bf16_dot8_acc(acc, ldg128_stream(ptr_add(w, c, 16)), lds128(s_act, c << 2)); }
        lanes_reduce_sum(LANES, acc);
        if (sub == 0) {
            reg u32 count = lds32(active_count, 0); reg f32 total = 0.0f;
            for (reg u32 k = 0; k < count; k += 1) { total = total + bf16_lo(ldg16_persist(ptr_add(packed, lds32(active_rows, k) * hidden + col, 2))); }
            reg f32 gate = 0.0f; sigmoid_exact_f32(bf16_lo(ldg16_persist(ptr_add(shared_logit, row, 2))), gate);
            stg16(ptr_add(output, row * hidden + col, 2), f32_to_bf16(total + bf16_lo(f32_to_bf16(bf16_lo(f32_to_bf16(acc)) * gate))));
        }
    }
    preexit();
}

instantiate moe_shared_down_finalize_tpl<8, 64> as moe_shared_down_finalize_l8;
instantiate moe_shared_down_finalize_tpl<16, 64> as moe_shared_down_finalize_l16;

macro moe_g5n_w1_dot_rows(C, BATCH, exp_w1, exp_s1, exp_base, inter, ch, lane, a_ptr, a_up, a_gt) {
    if constexpr (C.code == 1) {
        reg u64 wu_b = ptr_add(exp_w1, exp_base + ch, 4096); reg u64 wg_b = ptr_add(exp_w1, exp_base + inter + ch, 4096);
        reg u64 su_b = ptr_add(exp_s1, exp_base + ch, 128); reg u64 sg_b = ptr_add(exp_s1, exp_base + inter + ch, 128);
        for (reg u32 c = lane; c < 256; c += 32) {
            reg f32 su = u32_as_f32(ldg32_persist(ptr_add(su_b, c >> 3, 4)));
            reg f32 sg = u32_as_f32(ldg32_persist(ptr_add(sg_b, c >> 3, 4)));
            reg f32x4 u0; reg f32x4 u1; reg f32x4 u2; reg f32x4 u3;
            reg f32x4 g0; reg f32x4 g1; reg f32x4 g2; reg f32x4 g3;
            moe_fp8_dec4(ldg128_stream(ptr_add(wu_b, c, 16)), u0, u1, u2, u3);
            moe_fp8_dec4(ldg128_stream(ptr_add(wg_b, c, 16)), g0, g1, g2, g3);
            unroll (r = 0..BATCH) {
                reg u32x4 alo = ldg128_persist(ptr_add(a_ptr[r], c << 1, 16));
                reg u32x4 ahi = ldg128_persist(ptr_add(a_ptr[r], (c << 1) + 1, 16));
                reg f32 du = 0.0f; reg f32 dg = 0.0f;
                moe_fp8_dot16_dec(u0, u1, u2, u3, alo, ahi, du);
                moe_fp8_dot16_dec(g0, g1, g2, g3, alo, ahi, dg);
                a_up[r] = fma(su, du, a_up[r]); a_gt[r] = fma(sg, dg, a_gt[r]);
            }
        }
    } else {
        reg u64 wu_b = ptr_add(exp_w1, exp_base + ch, 8192); reg u64 wg_b = ptr_add(exp_w1, exp_base + inter + ch, 8192);
        for (reg u32 c = lane; c < 512; c += 32) {
            reg u32x4 wu = ldg128_stream(ptr_add(wu_b, c, 16)); reg u32x4 wg = ldg128_stream(ptr_add(wg_b, c, 16));
            unroll (r = 0..BATCH) {
                reg u32x4 va = ldg128_persist(ptr_add(a_ptr[r], c, 16));
                bf16_dot8_acc(a_up[r], wu, va); bf16_dot8_acc(a_gt[r], wg, va);
            }
        }
    }
}

macro moe_g5n_w2_smem_dot(C, BATCH, exp_w2, exp_s2, s_act, s_row0, ridx, lane, out_dots) {
    if constexpr (C.code == 1) {
        reg f32 sc = u32_as_f32(ldg32_persist(ptr_add(exp_s2, ridx, 4)));
        reg f32x4 d0; reg f32x4 d1; reg f32x4 d2; reg f32x4 d3;
        moe_fp8_dec4(ldg128_stream(ptr_add(ptr_add(exp_w2, ridx, 128), lane, 16)), d0, d1, d2, d3);
        unroll (r = 0..BATCH) {
            reg f32 dot = 0.0f;
            moe_fp8_dot16_dec(d0, d1, d2, d3, lds128(s_act, ((s_row0 + r) << 6) + (lane << 3)), lds128(s_act, ((s_row0 + r) << 6) + (lane << 3) + 4), dot);
            out_dots[r] = oct_sum(fma(sc, dot, 0.0f));
        }
    } else {
        reg u32x4 w = ldg128_stream(ptr_add(ptr_add(exp_w2, ridx, 256), lane, 16));
        unroll (r = 0..BATCH) {
            reg f32 dot = 0.0f;
            bf16_dot8_acc(dot, w, lds128(s_act, ((s_row0 + r) << 6) + (lane << 2)));
            lanes_reduce_sum(16, dot);
            out_dots[r] = dot;
        }
    }
}

@pdl
@concept(moe)
template kernel[MMOE_BLK128, REGS] moe_g5n_exact_w1_act_tpl<C, REGS>(
    global u8* exp_w1, global f32* exp_s1, global u32* act,
    global u32* group_row_offset, global u32* route_src, global u32* inter_out
) {
    acqbulk();
    reg u32 exp = ctaid_y();
    reg u32 first = ldg32_persist(ptr_add(group_row_offset, exp, 4));
    reg u32 end = ldg32_persist(ptr_add(group_row_offset, exp + 1, 4));
    if (first >= end) { preexit(); return; }
    reg u32 ch = (ctaid_x() << 2) + warp_id(); reg u32 lane = lane_id();
    for (reg u32 base = first; base < end; base += 8) {
        reg u32 cnt = (end - base < 8) ? (end - base) : 8;
        reg u64 a_ptr[8]; reg f32 a_up[8]; reg f32 a_gt[8];
        unroll (r = 0..8) {
            a_ptr[r] = ptr_add(act, ldg32_persist(ptr_add(route_src, base + ((r < cnt) ? r : 0), 4)), 8192);
            a_up[r] = 0.0f; a_gt[r] = 0.0f;
        }
        moe_g5n_w1_dot_rows(C, 8, exp_w1, exp_s1, exp * 256, 128, ch, lane, a_ptr, a_up, a_gt);
        unroll (r = 0..8) {
            reg f32 su = warp_sum(a_up[r]); reg f32 sg = warp_sum(a_gt[r]);
            if (r < cnt && lane == 0) {
                reg f32 v = 0.0f; moe_clamped_swiglu_r(sg, su, v);
                stg16(ptr_add(ptr_add(inter_out, base + r, 256), ch, 2), f32_to_bf16(v));
            }
        }
    }
    preexit();
}

instantiate moe_g5n_exact_w1_act_tpl<FP8_E4M3, 128> as g5n_moe_exact_w1_act_fp8;
instantiate moe_g5n_exact_w1_act_tpl<BF16, 96> as g5n_moe_exact_w1_act_bf16;

@pdl
@concept(moe)
template kernel[MMOE_BLK256, REGS] moe_g5n_exact_w2_tpl<C, REGS>(
    global u8* exp_w2, global f32* exp_s2, global u32* inter_in, global u32* group_row_offset, global u32* out_bf16
) {
    shared u32 s_act[512];
    acqbulk();
    reg u32 exp = ctaid_y();
    reg u32 first = ldg32_persist(ptr_add(group_row_offset, exp, 4));
    reg u32 end = ldg32_persist(ptr_add(group_row_offset, exp + 1, 4));
    if (first >= end) { preexit(); return; }
    reg u32 tid = tid_x();
    reg u32 grp = tid >> 4; reg u32 lane = tid & 15; reg u32 cols_blk = 16;
    if constexpr (C.code == 1) { grp = tid >> 3; lane = tid & 7; cols_blk = 32; }
    for (reg u32 base = first; base < end; base += 8) {
        reg u32 cnt = (end - base < 8) ? (end - base) : 8;
        if (tid < (cnt << 4)) { sts128(s_act, tid << 2, ldg128_persist(ptr_add(ptr_add(inter_in, base, 256), tid, 16))); }
        barrier();
        unroll (ci = 0..2) {
            reg u32 col = ((ctaid_x() << 1) + ci) * cols_blk + grp;
            reg f32 dots[8];
            moe_g5n_w2_smem_dot(C, 8, exp_w2, exp_s2, s_act, 0, exp * G5N_HIDDEN + col, lane, dots);
            unroll (r = 0..8) {
                if (r < cnt && lane == 0) { stg16(ptr_add(ptr_add(out_bf16, base + r, 8192), col, 2), f32_to_bf16(dots[r])); }
            }
        }
        if (base + 8 < end) { barrier(); }
    }
    preexit();
}

instantiate moe_g5n_exact_w2_tpl<FP8_E4M3, 80> as g5n_moe_exact_w2_fp8;
instantiate moe_g5n_exact_w2_tpl<BF16, 64> as g5n_moe_exact_w2_bf16;

macro moe_g5n_shared_w1_2col(MAX_R, shared_w1, act, out_bf16, partial, inter, ch0, r0, cnt, tid, wid, lane) {
    reg u64 wu0 = ptr_add(shared_w1, ch0, 8192); reg u64 wg0 = ptr_add(shared_w1, inter + ch0, 8192);
    reg u64 wu1 = ptr_add(shared_w1, ch0 + 1, 8192); reg u64 wg1 = ptr_add(shared_w1, inter + ch0 + 1, 8192);
    reg f32 acc[MAX_R * 4];
    unroll (i = 0..(MAX_R * 4)) { acc[i] = 0.0f; }
    for (reg u32 c = (wid << 6) + lane; c < (wid << 6) + 64; c += 32) {
        reg u32x4 vu0 = ldg128_stream(ptr_add(wu0, c, 16)); reg u32x4 vg0 = ldg128_stream(ptr_add(wg0, c, 16));
        reg u32x4 vu1 = ldg128_stream(ptr_add(wu1, c, 16)); reg u32x4 vg1 = ldg128_stream(ptr_add(wg1, c, 16));
        unroll (r = 0..MAX_R) {
            if (r < cnt) {
                reg u32x4 va = ldg128_persist(ptr_add(ptr_add(act, r0 + r, 8192), c, 16));
                bf16_dot8_acc(acc[r * 4], vu0, va); bf16_dot8_acc(acc[r * 4 + 1], vg0, va);
                bf16_dot8_acc(acc[r * 4 + 2], vu1, va); bf16_dot8_acc(acc[r * 4 + 3], vg1, va);
            }
        }
    }
    unroll (r = 0..MAX_R) {
        reg f32 su0 = warp_sum(acc[r * 4]); reg f32 sg0 = warp_sum(acc[r * 4 + 1]);
        reg f32 su1 = warp_sum(acc[r * 4 + 2]); reg f32 sg1 = warp_sum(acc[r * 4 + 3]);
        if (r < cnt && lane == 0) {
            sts32(partial, (r << 5) + wid, su0); sts32(partial, (r << 5) + 8 + wid, sg0);
            sts32(partial, (r << 5) + 16 + wid, su1); sts32(partial, (r << 5) + 24 + wid, sg1);
        }
    }
    barrier();
    if (tid < (cnt << 1)) {
        reg u32 orow = tid >> 1; reg u32 oc = tid & 1;
        reg f32 tu = 0.0f; reg f32 tg = 0.0f;
        unroll (w = 0..8) { tu = tu + lds32(partial, (orow << 5) + (oc << 4) + w); tg = tg + lds32(partial, (orow << 5) + (oc << 4) + 8 + w); }
        reg f32 ov = 0.0f; moe_clamped_swiglu_r(tg, tu, ov);
        stg16(ptr_add(ptr_add(out_bf16, r0 + orow, inter << 1), ch0 + oc, 2), f32_to_bf16(ov));
    }
}

@pdl
@concept(moe)
template kernel[MMOE_BLK256, REGS] moe_g5n_shared_w1_act_tile_tpl<MAX_R, REGS>(
    global u32* shared_w1, global u32* act, global u32* out_bf16, u32 rows
) {
    shared f32 partial[MAX_R * 32];
    acqbulk();
    reg u32 r0 = ctaid_y() * MAX_R;
    reg u32 cnt = (r0 < rows) ? ((rows - r0 < MAX_R) ? (rows - r0) : MAX_R) : 0;
    if (cnt != 0) {
        moe_g5n_shared_w1_2col(MAX_R, shared_w1, act, out_bf16, partial, 128, ctaid_x() << 1, r0, cnt, tid_x(), warp_id(), lane_id());
    }
    preexit();
}

instantiate moe_g5n_shared_w1_act_tile_tpl<4, 80> as g5n_shared_w1_act_tile_r4;
instantiate moe_g5n_shared_w1_act_tile_tpl<8, 112> as g5n_shared_w1_act_tile_r8;

@pdl
@concept(moe)
template kernel[MMOE_BLK256, REGS] moe_g5n_b1_w1_act_tpl<C, REGS>(
    global u8* exp_w1, global f32* exp_s1, global u32* shared_w1, global u32* act,
    global u32* route_expert, global u32* inter_out, global u32* shared_inter_out, u32 inter
) {
    shared f32 partial[32];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u32 bpe = inter >> 3; reg u32 exp_blks = bpe << 3;
    if (ctaid_x() >= exp_blks) {
        moe_g5n_shared_w1_2col(1, shared_w1, act, shared_inter_out, partial, inter, (ctaid_x() - exp_blks) << 1, 0, 1, tid, wid, lane);
        preexit(); return;
    }
    reg u32 slot = 0; reg u32 bi = 0; u32_divmod(ctaid_x(), bpe, slot, bi);
    reg u32 ch = (bi << 3) + wid;
    reg u64 a_ptr[1]; a_ptr[0] = act;
    reg f32 a_up[1]; a_up[0] = 0.0f; reg f32 a_gt[1]; a_gt[0] = 0.0f;
    moe_g5n_w1_dot_rows(C, 1, exp_w1, exp_s1, ldg32_persist(ptr_add(route_expert, slot, 4)) * (inter << 1), inter, ch, lane, a_ptr, a_up, a_gt);
    reg f32 su = warp_sum(a_up[0]); reg f32 sg = warp_sum(a_gt[0]);
    if (lane == 0) {
        reg f32 ov = 0.0f; moe_clamped_swiglu_r(sg, su, ov);
        stg16(ptr_add(inter_out, slot * inter + ch, 2), f32_to_bf16(ov));
    }
    preexit();
}

instantiate moe_g5n_b1_w1_act_tpl<FP8_E4M3, 80> as g5n_moe_b1_w1_act_fp8;
instantiate moe_g5n_b1_w1_act_tpl<BF16, 64> as g5n_moe_b1_w1_act_bf16;

@pdl
@concept(moe)
template kernel[MMOE_BLK256, REGS] moe_g5n_w2_finalize_tpl<C, IS_B1, REGS>(
    global u8* exp_w2, global f32* exp_s2, global u32* shared_w2,
    global u32* inter_in, global u32* shared_inter_in, global u32* route_expert,
    if (IS_B1 == 0) global u32* route_packed_row,
    global f32* route_weight, global u32* out_bf16
) {
    shared u32 s_inter[576];
    shared u32 s_expert[8];
    if constexpr (IS_B1 == 0) { shared u32 s_packed[8]; }
    shared f32 s_weight[8];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 row = ctaid_y();
    if constexpr (IS_B1 == 1) { row = 0; }
    reg u32 lane = tid & 15; reg u32 out_row = (ctaid_x() << 4) + (tid >> 4);
    if constexpr (C.code == 1) { lane = tid & 7; out_row = (ctaid_x() << 5) + (tid >> 3); }
    if (tid < 8) {
        reg u32 sl = (row << 3) + tid;
        sts32(s_expert, tid, ldg32_persist(ptr_add(route_expert, sl, 4)));
        if constexpr (IS_B1 == 0) { sts32(s_packed, tid, ldg32_persist(ptr_add(route_packed_row, sl, 4))); }
        sts32(s_weight, tid, u32_as_f32(ldg32_persist(ptr_add(route_weight, sl, 4))));
    }
    if constexpr (IS_B1 == 0) { barrier(); }
    if (tid < 128) {
        if constexpr (IS_B1 == 1) { sts128(s_inter, tid << 2, ldg128_persist(ptr_add(inter_in, tid, 16))); }
        else { sts128(s_inter, tid << 2, ldg128_persist(ptr_add(ptr_add(inter_in, lds32(s_packed, tid >> 4), 256), tid & 15, 16))); }
    }
    if (tid < 16) { sts128(s_inter, 512 + (tid << 2), ldg128_persist(ptr_add(ptr_add(shared_inter_in, row, 256), tid, 16))); }
    barrier();
    reg f32 acc = 0.0f;
    for (reg u32 slot = 0; slot < 8; slot += 1) {
        reg f32 dot_a[1];
        moe_g5n_w2_smem_dot(C, 1, exp_w2, exp_s2, s_inter, slot, lds32(s_expert, slot) * G5N_HIDDEN + out_row, lane, dot_a);
        if (lane == 0) { acc = fma(bf16_lo(f32_to_bf16(dot_a[0])), lds32(s_weight, slot), acc); }
    }
    reg u64 sw = ptr_add(shared_w2, out_row, 256);
    reg f32 sdot = 0.0f;
    if constexpr (C.code == 1) {
        reg f32 d0 = 0.0f; reg f32 d1 = 0.0f;
        bf16_dot8_acc(d0, ldg128_stream(ptr_add(sw, lane, 16)), lds128(s_inter, 512 + (lane << 2)));
        bf16_dot8_acc(d1, ldg128_stream(ptr_add(sw, lane + 8, 16)), lds128(s_inter, 512 + ((lane + 8) << 2)));
        sdot = oct_sum(d0 + d1);
    } else {
        bf16_dot8_acc(sdot, ldg128_stream(ptr_add(sw, lane, 16)), lds128(s_inter, 512 + (lane << 2)));
        lanes_reduce_sum(16, sdot);
    }
    if (lane == 0) {
        stg16(ptr_add(ptr_add(out_bf16, row, 8192), out_row, 2), f32_to_bf16(bf16_lo(f32_to_bf16(acc)) + bf16_lo(f32_to_bf16(sdot))));
    }
    preexit();
}

instantiate moe_g5n_w2_finalize_tpl<FP8_E4M3, 0, 80> as g5n_moe_small_w2_finalize_fp8;
instantiate moe_g5n_w2_finalize_tpl<BF16, 0, 64> as g5n_moe_small_w2_finalize_bf16;
instantiate moe_g5n_w2_finalize_tpl<FP8_E4M3, 1, 80> as g5n_moe_b1_w2_finalize_fp8;
instantiate moe_g5n_w2_finalize_tpl<BF16, 1, 64> as g5n_moe_b1_w2_finalize_bf16;

@pdl
@concept(moe)
kernel[MMOE_BLK256, 64] g5n_shared_down_finalize_exact_r8(
    global u32* shared_w2, global u32* shared_inter, global u32* expert_out,
    global u32* route_packed_row, global f32* route_weight, global u32* out_bf16, u32 rows
) {
    shared u32 s_sh[512];
    shared u32 s_pr[64];
    shared f32 s_wt[64];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 lane = tid & 15;
    reg u32 out_col = (ctaid_x() << 4) + (tid >> 4);
    reg u32 r0 = ctaid_y() << 3;
    reg u32 cnt = (r0 < rows) ? ((rows - r0 < 8) ? (rows - r0) : 8) : 0;
    if (cnt == 0) { preexit(); return; }
    if (tid < (cnt << 4)) { sts128(s_sh, tid << 2, ldg128_persist(ptr_add(ptr_add(shared_inter, r0, 256), tid, 16))); }
    if (tid < (cnt << 3)) {
        reg u32 sl = (r0 << 3) + tid;
        sts32(s_pr, tid, ldg32_persist(ptr_add(route_packed_row, sl, 4)));
        sts32(s_wt, tid, u32_as_f32(ldg32_persist(ptr_add(route_weight, sl, 4))));
    }
    barrier();
    reg u32x4 sw = ldg128_stream(ptr_add(ptr_add(shared_w2, out_col, 256), lane, 16));
    unroll (r = 0..8) {
        if (r < cnt) {
            reg f32 sdot = 0.0f;
            bf16_dot8_acc(sdot, sw, lds128(s_sh, (r << 6) + (lane << 2)));
            lanes_reduce_sum(16, sdot);
            if (lane == 0) {
                reg f32 acc = 0.0f;
                unroll (k = 0..8) { acc = fma(bf16_lo(ldg16_stream(ptr_add(ptr_add(expert_out, lds32(s_pr, (r << 3) + k), 8192), out_col, 2))), lds32(s_wt, (r << 3) + k), acc); }
                stg16(ptr_add(ptr_add(out_bf16, r0 + r, 8192), out_col, 2), f32_to_bf16(bf16_lo(f32_to_bf16(acc)) + bf16_lo(f32_to_bf16(sdot))));
            }
        }
    }
    preexit();
}
