macro moe_nvfp4_w1w3_dot_row(vw1, vw3, s10, s11, s30, s31, act_row, c, acc1, acc3) {
    reg u32x4 b0 = ldg128_persist(ptr_add(act_row, c << 2, 16)); reg u32x4 b1 = ldg128_persist(ptr_add(act_row, (c << 2) + 1, 16));
    reg f32 d10 = 0.0f; reg f32 d30 = 0.0f;
    nvfp4_e2m1_dot16(vw1[0], vw1[1], b0, b1, d10); nvfp4_e2m1_dot16(vw3[0], vw3[1], b0, b1, d30);
    acc1 = fma(s10, d10, acc1); acc3 = fma(s30, d30, acc3);
    reg u32x4 b2 = ldg128_persist(ptr_add(act_row, (c << 2) + 2, 16)); reg u32x4 b3 = ldg128_persist(ptr_add(act_row, (c << 2) + 3, 16));
    reg f32 d11 = 0.0f; reg f32 d31 = 0.0f;
    nvfp4_e2m1_dot16(vw1[2], vw1[3], b2, b3, d11); nvfp4_e2m1_dot16(vw3[2], vw3[3], b2, b3, d31);
    acc1 = fma(s11, d11, acc1); acc3 = fma(s31, d31, acc3);
}

macro moe_nvfp4_w1w3_load_ws(w1_ptr, s1_ptr, g1, w3_ptr, s3_ptr, g3, c, vw1, vw3, s10, s11, s30, s31) {
    vw1 = ldg128_stream(ptr_add(w1_ptr, c, 16)); vw3 = ldg128_stream(ptr_add(w3_ptr, c, 16));
    reg u32 sc1 = ldg16_persist(ptr_add(s1_ptr, c, 2)); reg u32 sc3 = ldg16_persist(ptr_add(s3_ptr, c, 2));
    nvfp4_ue4m3_decode(sc1, g1, s10); nvfp4_ue4m3_decode(sc1 >> 8, g1, s11);
    nvfp4_ue4m3_decode(sc3, g3, s30); nvfp4_ue4m3_decode(sc3 >> 8, g3, s31);
}

@pdl
@concept(moe)
template kernel[MMOE_BLK256, REGS] moe_nvfp4_skinny_w1w3_tpl<IS_BATCHED, LANES, REGS>(
    global u32* w1, global u8* w1_scale_blob, global u32* w3, global u8* w3_scale_blob,
    global u32* act, global f32* packed_weight, global u32* group_row_offset,
    global u32* row_map, global u32* output, u32 k_dim, u32 n_dim, u32 groups
) {
    acqbulk();
    reg u32 m[6]; reg u32 chunks = k_dim >> 5;
    moe_skinny_grid_setup(IS_BATCHED, MMOE_BLK256, LANES, 0, group_row_offset, row_map, groups, n_dim, m);
    if (m[5] == 0) { preexit(); return; }
    reg u32 roff = (m[2] * n_dim + m[0]) * chunks;
    reg u64 w1p = ptr_add(w1, roff, 16); reg u64 w3p = ptr_add(w3, roff, 16);
    reg u64 s1p = ptr_add(ptr_add(w1_scale_blob, groups, 4), roff, 2); reg u64 s3p = ptr_add(ptr_add(w3_scale_blob, groups, 4), roff, 2);
    reg f32 g1 = u32_as_f32(ldg32_persist(ptr_add(w1_scale_blob, m[2], 4))); reg f32 g3 = u32_as_f32(ldg32_persist(ptr_add(w3_scale_blob, m[2], 4)));
    if constexpr (IS_BATCHED == 0) {
        reg f32 acc1 = 0.0f; reg f32 acc3 = 0.0f;
        for (reg u32 c = m[1]; c < chunks; c += LANES) {
            reg u32x4 vw1; reg u32x4 vw3; reg f32 s10 = 0.0f; reg f32 s11 = 0.0f; reg f32 s30 = 0.0f; reg f32 s31 = 0.0f;
            moe_nvfp4_w1w3_load_ws(w1p, s1p, g1, w3p, s3p, g3, c, vw1, vw3, s10, s11, s30, s31);
            moe_nvfp4_w1w3_dot_row(vw1, vw3, s10, s11, s30, s31, act, c, acc1, acc3);
        }
        lanes_reduce_sum(LANES, acc1); lanes_reduce_sum(LANES, acc3);
        if (m[1] == 0) { moe_skinny_store_elem(1, output, ctaid_y(), n_dim, m[0], acc1, acc3, packed_weight); }
    } else {
        for (reg u32 first = m[3]; first < m[4]; first += 4) {
            reg u32 cnt = (m[4] - first < 4) ? (m[4] - first) : 4;
            reg u64 pa[4]; reg f32 a1[4]; reg f32 a3[4];
            unroll (r = 0..4) { pa[r] = ptr_add(act, ldg32_persist(ptr_add(row_map, first + ((r < cnt) ? r : 0), 4)) * (chunks << 2), 16); a1[r] = 0.0f; a3[r] = 0.0f; }
            for (reg u32 c = m[1]; c < chunks; c += LANES) {
                reg u32x4 vw1; reg u32x4 vw3; reg f32 s10 = 0.0f; reg f32 s11 = 0.0f; reg f32 s30 = 0.0f; reg f32 s31 = 0.0f;
                moe_nvfp4_w1w3_load_ws(w1p, s1p, g1, w3p, s3p, g3, c, vw1, vw3, s10, s11, s30, s31);
                unroll (r = 0..4) { moe_nvfp4_w1w3_dot_row(vw1, vw3, s10, s11, s30, s31, pa[r], c, a1[r], a3[r]); }
            }
            unroll (r = 0..4) {
                lanes_reduce_sum(LANES, a1[r]); lanes_reduce_sum(LANES, a3[r]);
                if (m[1] == 0 && r < cnt) { moe_skinny_store_elem(1, output, first + r, n_dim, m[0], a1[r], a3[r], packed_weight); }
            }
        }
    }
    preexit();
}

