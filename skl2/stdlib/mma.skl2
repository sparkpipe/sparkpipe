@export
macro qmma_issue_k(A_PER_T, B_PER_T, a_sm, b_sm, a_src, b_src, a_mask, b_mask, st_off, kp) {
    unroll (q = 0..A_PER_T) { ldgsts128_z(st_off + a_sm[q], ptr_add(a_src[q], kp, 128), (a_mask >> q) & 1); }
    unroll (q = 0..B_PER_T) { ldgsts128_z(st_off + b_sm[q], ptr_add(b_src[q], kp, 128), (b_mask >> q) & 1); }
}

@export
macro qmma_load_frag(FUSED, MF, NF_H, stage_s, ks, a_off, bg_off, bu_off, a_reg, bg_reg, bu_reg) {
    unroll (ii = 0..MF) { a_reg[ii] = ldsm_x4(stage_s + (a_off[ii] ^ (ks << 5))); }
    unroll (jh = 0..NF_H) {
        bg_reg[jh] = ldsm_x4(stage_s + (bg_off[jh] ^ (ks << 5)));
        if constexpr (FUSED == 1) { bu_reg[jh] = ldsm_x4(stage_s + (bu_off[jh] ^ (ks << 5))); }
    }
}

@export
macro qmma_mma_step(FUSED, MF, NF_H, a_reg, bg_reg, bu_reg, acc_g, acc_u) {
    unroll (i = 0..MF) {
        unroll (jh = 0..NF_H) {
            acc_g[(i * NF_H + jh) * 2] = hmma16816_bf16(a_reg[i], lo_u32x2(bg_reg[jh]), acc_g[(i * NF_H + jh) * 2]);
            acc_g[(i * NF_H + jh) * 2 + 1] = hmma16816_bf16(a_reg[i], hi_u32x2(bg_reg[jh]), acc_g[(i * NF_H + jh) * 2 + 1]);
            if constexpr (FUSED == 1) {
                acc_u[(i * NF_H + jh) * 2] = hmma16816_bf16(a_reg[i], lo_u32x2(bu_reg[jh]), acc_u[(i * NF_H + jh) * 2]);
                acc_u[(i * NF_H + jh) * 2 + 1] = hmma16816_bf16(a_reg[i], hi_u32x2(bu_reg[jh]), acc_u[(i * NF_H + jh) * 2 + 1]);
            }
        }
    }
}

@export
macro qmma_adv_stage(STAGES, STAGE_BYTES, off) {
    if constexpr (STAGES == 2) { off = off ^ STAGE_BYTES; }
    else { off = (off + STAGE_BYTES == STAGES * STAGE_BYTES) ? 0 : (off + STAGE_BYTES); }
}

@export
macro qmma_init_foffs(FUSED, MF, NF_H, TILE_M, TILE_N, wm_r0, wn_n0, lane, a_off, bg_off, bu_off) {
    reg u32 ac0 = (lane >> 4) & 1;
    unroll (ii = 0..MF) {
        reg u32 ar = wm_r0 + (ii << 4) + (lane & 15);
        a_off[ii] = (ar << 7) | ((ac0 ^ (((ar & 1) << 2) | ((ar >> 1) & 3))) << 4);
    }
    reg u32 bc0 = (lane >> 3) & 1;
    unroll (jh = 0..NF_H) {
        reg u32 br = wn_n0 + (jh << 4) + (lane & 7) + (((lane >> 4) & 1) << 3);
        reg u32 swz = bc0 ^ (((br & 1) << 2) | ((br >> 1) & 3));
        bg_off[jh] = (TILE_M << 7) + ((br << 7) | (swz << 4));
        if constexpr (FUSED == 1) { bu_off[jh] = ((TILE_M + TILE_N) << 7) + ((br << 7) | (swz << 4)); }
    }
}

@export
macro qmma_ksteps_body(FUSED, MF, NF_H, STAGES, STAGE_BYTES, DO_PREFETCH_NEXT, sc_off, a_off, bg_off, bu_off, a0, a1, bg0, bg1, bu0, bu1, acc_g, acc_u) {
    if constexpr (STAGES == 2) { qmma_load_frag(FUSED, MF, NF_H, sc_off, 0, a_off, bg_off, bu_off, a0, bg0, bu0); }
    qmma_load_frag(FUSED, MF, NF_H, sc_off, 1, a_off, bg_off, bu_off, a1, bg1, bu1);
    qmma_mma_step(FUSED, MF, NF_H, a0, bg0, bu0, acc_g, acc_u);
    qmma_load_frag(FUSED, MF, NF_H, sc_off, 2, a_off, bg_off, bu_off, a0, bg0, bu0);
    qmma_mma_step(FUSED, MF, NF_H, a1, bg1, bu1, acc_g, acc_u);
    qmma_load_frag(FUSED, MF, NF_H, sc_off, 3, a_off, bg_off, bu_off, a1, bg1, bu1);
    qmma_mma_step(FUSED, MF, NF_H, a0, bg0, bu0, acc_g, acc_u);
    if constexpr (STAGES == 3 && DO_PREFETCH_NEXT == 1) {
        depbar_le(1); barrier();
        qmma_adv_stage(3, STAGE_BYTES, sc_off);
        qmma_load_frag(FUSED, MF, NF_H, sc_off, 0, a_off, bg_off, bu_off, a0, bg0, bu0);
    }
    qmma_mma_step(FUSED, MF, NF_H, a1, bg1, bu1, acc_g, acc_u);
    if constexpr (STAGES == 2) { qmma_adv_stage(2, STAGE_BYTES, sc_off); }
}

@export
macro qmma_run_pipeline(STAGES, FUSED, MF, NF_H, A_PER_T, B_PER_T, STAGE_BYTES, k_tiles, sbase, a_sm, b_sm, a_src, b_src, a_mask, b_mask, a_off, bg_off, bu_off, a0, a1, bg0, bg1, bu0, bu1, acc_g, acc_u) {
    reg u32 sp_off = sbase; reg u32 sc_off = sbase;
    unroll (ps = 0..(STAGES - 1)) {
        if (ps < k_tiles) { qmma_issue_k(A_PER_T, B_PER_T, a_sm, b_sm, a_src, b_src, a_mask, b_mask, sp_off, ps); }
        ldgdepbar();
        qmma_adv_stage(STAGES, STAGE_BYTES, sp_off);
    }
    if constexpr (STAGES == 3) {
        depbar_le(1); barrier();
        qmma_load_frag(FUSED, MF, NF_H, sc_off, 0, a_off, bg_off, bu_off, a0, bg0, bu0);
        for (reg u32 kt = 0; kt + 2 < k_tiles; kt += 1) {
            qmma_issue_k(A_PER_T, B_PER_T, a_sm, b_sm, a_src, b_src, a_mask, b_mask, sp_off, kt + 2);
            qmma_adv_stage(3, STAGE_BYTES, sp_off);
            ldgdepbar();
            qmma_ksteps_body(FUSED, MF, NF_H, 3, STAGE_BYTES, 1, sc_off, a_off, bg_off, bu_off, a0, a1, bg0, bg1, bu0, bu1, acc_g, acc_u);
        }
        if (k_tiles >= 2) {
            ldgdepbar();
            qmma_ksteps_body(FUSED, MF, NF_H, 3, STAGE_BYTES, 1, sc_off, a_off, bg_off, bu_off, a0, a1, bg0, bg1, bu0, bu1, acc_g, acc_u);
        }
        if (k_tiles >= 1) {
            qmma_ksteps_body(FUSED, MF, NF_H, 3, STAGE_BYTES, 0, sc_off, a_off, bg_off, bu_off, a0, a1, bg0, bg1, bu0, bu1, acc_g, acc_u);
        }
    } else {
        for (reg u32 kt = 0; kt + 1 < k_tiles; kt += 1) {
            depbar_le(0); barrier();
            qmma_issue_k(A_PER_T, B_PER_T, a_sm, b_sm, a_src, b_src, a_mask, b_mask, sp_off, kt + 1);
            qmma_adv_stage(2, STAGE_BYTES, sp_off);
            ldgdepbar();
            qmma_ksteps_body(FUSED, MF, NF_H, 2, STAGE_BYTES, 0, sc_off, a_off, bg_off, bu_off, a0, a1, bg0, bg1, bu0, bu1, acc_g, acc_u);
        }
        if (k_tiles >= 1) {
            depbar_le(0); barrier();
            qmma_ksteps_body(FUSED, MF, NF_H, 2, STAGE_BYTES, 0, sc_off, a_off, bg_off, bu_off, a0, a1, bg0, bg1, bu0, bu1, acc_g, acc_u);
        }
    }
    depbar_le(0);
}

@export
macro qmma_init_ptrs(FUSED, TILE_M, TILE_N, THREADS, A_PER_T, B_PER_T, act, wgt, row0, col0, rows, k_dim, n_dim, tid, a_sm, b_sm, a_src, b_src, a_mask, b_mask) {
    reg u32 r0 = tid >> 3;
    reg u32 c0 = tid & 7;
    unroll (q = 0..A_PER_T) {
        reg u32 r = r0 + q * (THREADS >> 3);
        reg u32 va = (row0 + r < rows) ? 1 : 0;
        a_sm[q] = (r << 7) | ((c0 ^ (((r & 1) << 2) | ((r >> 1) & 3))) << 4);
        a_src[q] = ptr_add(act, ((va != 0) ? ((row0 + r) * k_dim + (c0 << 3)) : 0), 2);
        a_mask = a_mask | (va << q);
    }
    unroll (q = 0..B_PER_T) {
        reg u32 br = r0 + q * (THREADS >> 3);
        reg u32 is_u = 0;
        if constexpr (FUSED == 1) { is_u = (br >= TILE_N) ? 1 : 0; }
        reg u32 gn = col0 + ((is_u != 0) ? (br - TILE_N) : br);
        reg u32 vb = (gn < n_dim) ? 1 : 0;
        reg u32 wrow = (is_u != 0) ? (n_dim + gn) : gn;
        b_sm[q] = (TILE_M << 7) + ((br << 7) | ((c0 ^ (((br & 1) << 2) | ((br >> 1) & 3))) << 4));
        b_src[q] = ptr_add(wgt, ((vb != 0) ? (wrow * k_dim + (c0 << 3)) : 0), 2);
        b_mask = b_mask | (vb << q);
    }
}

@export
macro qmma_store_pair(FUSED, out_ptr, r, col, N, g0, g1, u0, u1) {
    reg f32 v0 = g0;
    reg f32 v1 = g1;
    if constexpr (FUSED == 1) {
        reg f32 s0 = 0.0f; reg f32 s1 = 0.0f;
        silu_exact_f32(bf16_lo(f32_to_bf16(g0)), s0);
        silu_exact_f32(bf16_lo(f32_to_bf16(g1)), s1);
        v0 = s0 * bf16_lo(f32_to_bf16(u0));
        v1 = s1 * bf16_lo(f32_to_bf16(u1));
    }
    if (col + 1 < N) {
        stg32(ptr_add(ptr_add(out_ptr, r, N << 1), col, 2), pack_bf16x2(v0, v1));
    } else if (col < N) {
        stg16(ptr_add(ptr_add(out_ptr, r, N << 1), col, 2), f32_to_bf16(v0));
    }
}

@export
macro qmma_store_ij(FUSED, output, r0, r1, c0, rows, n_dim, g_v, u_v) {
    if (r0 < rows) { qmma_store_pair(FUSED, output, r0, c0, n_dim, g_v[0], g_v[1], u_v[0], u_v[1]); }
    if (r1 < rows) { qmma_store_pair(FUSED, output, r1, c0, n_dim, g_v[2], g_v[3], u_v[2], u_v[3]); }
}

@export
macro qmma_setup_and_run(STAGES, FUSED, TILE_M, TILE_N, THREADS, WARPS_M, DYN_SMEM, smem, act, wgt, row0, col0, rows, k_dim, n_dim, tid, wm_r0, wn_n0, lane, acc_g, acc_u) {
    reg u32 a_sm[(TILE_M * 8) / THREADS]; reg u32 b_sm[((1 + FUSED) * TILE_N * 8) / THREADS];
    reg u64 a_src[(TILE_M * 8) / THREADS]; reg u64 b_src[((1 + FUSED) * TILE_N * 8) / THREADS];
    reg u32 a_mask = 0; reg u32 b_mask = 0;
    qmma_init_ptrs(FUSED, TILE_M, TILE_N, THREADS, (TILE_M * 8) / THREADS, ((1 + FUSED) * TILE_N * 8) / THREADS, act, wgt, row0, col0, rows, k_dim, n_dim, tid, a_sm, b_sm, a_src, b_src, a_mask, b_mask);
    reg u32 a_off[(TILE_M / WARPS_M) / 16]; reg u32 bg_off[(TILE_N / ((THREADS / 32) / WARPS_M)) / 16];
    reg u32 bu_off[FUSED == 1 ? ((TILE_N / ((THREADS / 32) / WARPS_M)) / 16) : 1];
    qmma_init_foffs(FUSED, (TILE_M / WARPS_M) / 16, (TILE_N / ((THREADS / 32) / WARPS_M)) / 16, TILE_M, TILE_N, wm_r0, wn_n0, lane, a_off, bg_off, bu_off);
    reg u32x4 a0[(TILE_M / WARPS_M) / 16]; reg u32x4 a1[(TILE_M / WARPS_M) / 16];
    reg u32x4 bg0[(TILE_N / ((THREADS / 32) / WARPS_M)) / 16]; reg u32x4 bg1[(TILE_N / ((THREADS / 32) / WARPS_M)) / 16];
    reg u32x4 bu0[FUSED == 1 ? ((TILE_N / ((THREADS / 32) / WARPS_M)) / 16) : 1];
    reg u32x4 bu1[FUSED == 1 ? ((TILE_N / ((THREADS / 32) / WARPS_M)) / 16) : 1];
    reg u32 sbase = 0;
    if constexpr (DYN_SMEM == 0) { sbase = smem_base(smem); }
    qmma_run_pipeline(STAGES, FUSED, (TILE_M / WARPS_M) / 16, (TILE_N / ((THREADS / 32) / WARPS_M)) / 16, (TILE_M * 8) / THREADS, ((1 + FUSED) * TILE_N * 8) / THREADS, (TILE_M + (1 + FUSED) * TILE_N) * 128, k_dim >> 6, sbase, a_sm, b_sm, a_src, b_src, a_mask, b_mask, a_off, bg_off, bu_off, a0, a1, bg0, bg1, bu0, bu1, acc_g, acc_u);
}
