RELEASE_PROFILE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
RELEASE_NODES="spark0 spark1 spark2 spark3 spark4 spark5 spark6 spark7 spark8 spark9 sparka sparkb sparkc sparkd sparke sparkf"
RELEASE_HUB=rtx5090
RELEASE_ROOT_NAME=glm53flash.fp8.tp16
RELEASE_RANK_PACK=packs/glm53flash.fp8.tp16.rank@hex@.sp
RELEASE_DRIVER=stages/stage_000/model_driver.so
RELEASE_LAYOUT=legacy
RELEASE_WEIGHTD_STAGE=weightd-bundle-stage
RELEASE_PROBE_EXTRA=$RELEASE_PROFILE_DIR/probe_extra.sh
RELEASE_CHECKS=$RELEASE_PROFILE_DIR/checks.json
RELEASE_PERF_EXPECT=$RELEASE_PROFILE_DIR/perf_expect.json
RELEASE_STAGE_DRIFT=$RELEASE_PROFILE_DIR/stage_drift.json
RELEASE_STAGE_WORLD=16
RELEASE_ARTIFACT=glm53_release
RELEASE_BUILD_SCRIPT=tools/glm5_next_build_release.sh
RELEASE_GPU_HOLDER_BLOCK="lead- glm-"
RELEASE_BUILD_FILES="bin/sparkpipe_model_residentd bin/sparkpipe_model_api bin/sparkpipe_model_batch lib/hidden_transport.so lib/model_serving_adapter.so stages/stage_000/model_driver.so stages/stage_000/spark_model_driver_generated.c stages/stage_000/link_units/*.a"
RELEASE_API_CHANNEL=g53-api-channel
RELEASE_API_UNIT=g53-api
RELEASE_API_PORT=8433
RELEASE_ADAPTER_BUILD=build/modules/glm5_next_resident_decode_stage/fp8/libglm5_next_serving_adapter_fp8.so
RELEASE_API_MAKE='make -j8 build/sparkpipe_model_api && make -C modules/glm5_next_resident_decode_stage adapter EXPERT_CODEC=fp8 MODEL_REVISION=84c6a6aa9497188e15a635ba793b0f95a79b1033 CONTRACT_SHA256=$(sha256sum model_contracts/glm53_flash_authoritative.json | cut -d" " -f1) MODEL_DESCRIPTION=$(pwd)/examples/model_descriptions/glm5_next_resident_decode_stage_fp8_firmware.json && make build/sparkpipe_tokenize_prompt'
RELEASE_API_REQUIRED_STRING=chat_template_missing
RELEASE_API_REQUIRED_LOG="tokenizer sidecar ready|chat_template declared stop_markers=3"
RELEASE_ROTATION_PAUSE_FILE=fleet-rotation/ROTATION_PAUSE
RELEASE_ROTATION_UNIT=fleet-rotation.service
RELEASE_MEM_UNHOLD_GIB=36
RELEASE_MEM_FLOOR_GIB=20
RELEASE_CONVERGE_MIN=15
RELEASE_CONVERGE_EXPECT="l2=on kvref=0 kvs=1of16 gmode=graph"
