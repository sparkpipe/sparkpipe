[Unit]
Description=SparkPipe bookings sandbox: the payment and booking service in sandbox mode, with Toss Payments in test mode
After=network-online.target
Wants=network-online.target

[Service]
User=sparkpipe-pay-sandbox
Group=sparkpipe-pay-sandbox
EnvironmentFile=/etc/sparkpipe-pay/sandbox.env
ExecStart=/usr/bin/python3 /opt/sparkpipe-pay/sparkpipe_pay.py serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sparkpipe-pay-sandbox
ReadOnlyPaths=/var/www/html /opt/sparkpipe-pay
InaccessiblePaths=-/var/lib/sparkpipe-pay -/etc/sparkpipe-pay/env -/etc/sparkpipe-pay/client_secret -/etc/sparkpipe-pay/pool_key

[Install]
WantedBy=multi-user.target
