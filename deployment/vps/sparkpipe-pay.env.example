SPARKPIPE_PAY_PORT=18090
SPARKPIPE_PAY_DATA=/var/lib/sparkpipe-pay
SPARKPIPE_PAY_SITE=/var/www/html
SPARKPIPE_PAY_PUBLIC=https://sparkpipe.ai
COINPAYMENTS_API=https://a-api.coinpayments.net/api/v2
COINPAYMENTS_CLIENT_ID=
COINPAYMENTS_CLIENT_SECRET_FILE=/etc/sparkpipe-pay/client_secret
TOSS_API=https://api.tosspayments.com
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_VARIANT_KEY=
SPARKPIPE_PAY_SMTP=127.0.0.1:25
SPARKPIPE_PAY_MAIL_FROM="SparkPipe <noreply@sparkpipe.ai>"
SPARKPIPE_PAY_NOTIFY=hyor@sparkpipe.ai
SPARKPIPE_PAY_SWIFT_BENEFICIARY=""
SPARKPIPE_PAY_SWIFT_BANK=""
SPARKPIPE_PAY_SWIFT_BANK_ADDRESS=""
SPARKPIPE_PAY_SWIFT_ACCOUNT=""
SPARKPIPE_PAY_SWIFT_BIC=""
SPARKPIPE_POOL_UPSTREAM=http://127.0.0.1:18081/v1
SPARKPIPE_POOL_KEY_FILE=/etc/sparkpipe-pay/pool_key
