 "prompts": [
  {
   "command": "context",
   "name": "Context: what the prompt holds",
   "content": "/context"
  },
  {
   "command": "compact",
   "name": "Compact: keep the most relevant half (memory off)",
   "content": "/compact 50%"
  },
  {
   "command": "compact-full",
   "name": "Compact fully: keep only a summary (memory off)",
   "content": "/compact full"
  },
  {
   "command": "compact-undo",
   "name": "Undo the compaction",
   "content": "/compact undo"
  },
  {
   "command": "memory-off",
   "name": "Memory off: send the full chat",
   "content": "/memory off"
  },
  {
   "command": "memory-on",
   "name": "Memory on",
   "content": "/memory on"
  },
  {
   "command": "target",
   "name": "Context target for memory",
   "content": "/target 64K"
  },
  {
   "command": "timer",
   "name": "Timer: run a prompt on a schedule",
   "content": "/timer every 10m "
  }
 ]
