{
 "header": "model-families/dsv41_flash/source/dsv41_flash_fused.cuh",
 "test": "tests/cuda/dsv41_flash_fused_exact.cu",
 "manifest": "model-families/dsv41_flash/fusion/decode.manifest.json",
 "includes": ["inference/kernels/fused/arrival.cuh", "inference/kernels/fused/collapse_norm.cuh", "inference/kernels/hc.cuh", "inference/kernels/topk_warp.cuh",
  "runtime/launch.h"],
 "test_includes": ["sparkpipe/spark_dsv41_flash_stage_model.h", "dsv41_flash_stage.cuh"],
 "ops": {
  "d41_output_head": {
   "body": "D41OutputHead",
   "source": "model-families/dsv41_flash/source/dsv41_flash_stage_kernels.cuh",
   "replaces": "D41MergeSinkKernel, D41RopeRowsKernel (inverse), and for each output group D41ColumnsKernel and SparkDsv41FlashFp8QdqKernel",
   "parameters": ["partials", "source_stride", "heads", "sink", "positions", "frequency", "group_input", "group_heads"],
   "call": "D41OutputHead<{threads}>({partials}, {source_stride}, {heads}, {sink}, {positions}, {frequency}, {group_input}, {group_heads}, rows, row, item, {shared});",
   "lanes": 0
  },
  "d41_route_tail": {
   "body": "D41RouteTail",
   "source": "model-families/dsv41_flash/source/dsv41_flash_stage_kernels.cuh",
   "replaces": "D41RouteLocalKernel, LmRouteBuildKernel and LmPackedRouteWeightKernel",
   "parameters": ["experts_held", "route_expert", "route_weight", "route_global", "routes", "group", "local_experts", "experts", "top_k",
    "group_row_offset", "route_packed_row", "route_source_token", "tile_m", "neuron_tiles_up", "tile_prefix_up", "neuron_tiles_down",
    "tile_prefix_down", "packed_weight"],
   "call": "D41RouteTail<{threads}, {experts_held}>({route_expert}, {route_weight}, {route_global}, {routes}, {group}, {local_experts}, {experts}, {top_k}, {group_row_offset}, {route_packed_row}, {route_source_token}, {tile_m}, {neuron_tiles_up}, {tile_prefix_up}, {neuron_tiles_down}, {tile_prefix_down}, {packed_weight});",
   "lanes": 0
  },
  "d41_ring_store": {
   "body": "D41WindowRingStoreRow",
   "source": "model-families/dsv41_flash/source/dsv41_flash_stage_kernels.cuh",
   "replaces": "D41WindowRingStoreKernel",
   "parameters": ["wave_kv", "ring", "positions", "row_lane", "row_ordinal", "sequence_row_begin", "recurrent_slot", "ring_slot_stride", "ring_rows",
    "window", "degree", "rank", "commit", "lane_count"],
   "call": "D41WindowRingStoreRow({wave_kv}, {ring}, {positions}, {row_lane}, {row_ordinal}, {sequence_row_begin}, {recurrent_slot}, {ring_slot_stride}, {ring_rows}, {window}, {degree}, {rank}, rows, {commit}, {lane_count}, row);",
   "lanes": 0
  }
 },
 "kernels": [
  {
   "name": "D41FusedMixNormKernel",
   "launcher": "D41FusedMixNormLaunch",
   "arguments_type": "D41FusedMixNormArguments",
   "rows_constant": "D41FusedMixNormRows",
   "threads": 256,
   "rows_max": 16,
   "shared_bytes": "(D41_HIDDEN + 8u) * sizeof(float)",
   "dependent_launch": true,
   "replaces": ["LmHcSinkhornPartialKernel<4u>", "LmHcSinkhornKernel<4u>", "D41RmsNormQdqKernel<256u>"],
   "arguments": [
    {"name": "streams", "type": "const uint16_t *", "elements": "rows * D41K_HC * D41_HIDDEN", "fill": "bf16"},
    {"name": "fn", "type": "const float *", "elements": "LmHcSinkhornShape<D41K_HC>::kMix * D41K_HC * D41_HIDDEN", "fill": "f32"},
    {"name": "scale", "type": "const float *", "elements": "4u", "fill": "f32"},
    {"name": "base", "type": "const float *", "elements": "LmHcSinkhornShape<D41K_HC>::kMix", "fill": "f32"},
    {"name": "partials", "type": "float *", "elements": "rows * LmHcSinkhornShape<D41K_HC>::kPartials", "fill": "zero"},
    {"name": "pre", "type": "float *", "elements": "rows * D41K_HC", "fill": "zero"},
    {"name": "post", "type": "float *", "elements": "rows * D41K_HC", "fill": "zero"},
    {"name": "comb", "type": "float *", "elements": "rows * D41K_HC * D41K_HC", "fill": "zero"},
    {"name": "counters", "type": "uint32_t *", "elements": "rows", "fill": "zero"},
    {"name": "collapse_pre", "type": "const float *", "elements": "rows * D41K_HC", "fill": "f32"},
    {"name": "norm", "type": "const uint16_t *", "elements": "D41_HIDDEN", "fill": "bf16"},
    {"name": "x", "type": "uint16_t *", "elements": "rows * D41_HIDDEN", "fill": "zero"},
    {"name": "xq", "type": "uint16_t *", "elements": "rows * D41_HIDDEN", "fill": "zero"}
   ],
   "roles": [
    {
     "op": "hc_sinkhorn_partials",
     "blocks_per_row": "LmHcSinkhornShape<D41K_HC>::kTasks",
     "bind": {"streams_count": "D41K_HC", "streams": "arguments.streams", "fn": "arguments.fn", "partials": "arguments.partials", "width": "D41_HIDDEN"},
     "tail": {
      "op": "hc_sinkhorn_row",
      "scope": "row",
      "bind": {"streams_count": "D41K_HC", "partials": "arguments.partials", "scale": "arguments.scale", "base": "arguments.base", "pre": "arguments.pre",
       "post": "arguments.post", "comb": "arguments.comb", "width": "D41_HIDDEN", "rms_epsilon": "D41_EPS", "iterations": "D41_HC_ITERATIONS",
       "epsilon": "D41_HC_EPS"}
     }
    },
    {
     "op": "hc_collapse_norm",
     "blocks_per_row": "D41_HIDDEN / D41_THREADS",
     "bind": {"streams_count": "D41K_HC", "lane": "SparkDsv41FlashFp8QdqLaneOp", "streams": "arguments.streams",
      "pre": "arguments.collapse_pre", "weight": "arguments.norm", "output": "arguments.x", "quantized": "arguments.xq", "width": "D41_HIDDEN",
      "epsilon": "D41_EPS"}
    }
   ],
   "reference": [
    "FUSED_REQUIRE(LmHcSinkhornMixes<D41K_HC>(streams, fn, scale, base, partials, pre, post, comb, rows, D41_HIDDEN, D41_EPS, D41_HC_ITERATIONS, D41_HC_EPS, stream) == LM_LAUNCH_OK);",
    "D41CollapseNormQdq(streams, collapse_pre, norm, x, xq, rows, stream);"
   ],
   "outputs": ["partials", "pre", "post", "comb", "x", "xq"],
   "perturb": "streams"
  },
  {
   "name": "D41FusedOutputKernel",
   "launcher": "D41FusedOutputLaunch",
   "arguments_type": "D41FusedOutputArguments",
   "rows_constant": "D41FusedOutputRows",
   "threads": 256,
   "rows_max": 16,
   "shared_bytes": "32u * sizeof(float) + D41K_LATENT * sizeof(uint16_t)",
   "dependent_launch": true,
   "replaces": ["D41WindowRingStoreKernel", "D41MergeSinkKernel", "D41RopeRowsKernel", "D41ColumnsKernel", "SparkDsv41FlashFp8QdqKernel"],
   "arguments": [
    {"name": "records", "type": "const float *", "elements": "rows * D41_LOCAL_HEADS * D41K_RECORD", "fill": "index",
     "expression": "index % D41K_RECORD == 1u ? 1.0f + (float)(FusedMix(index) % 1024u) / 256.0f : ((float)(FusedMix(index) % 4096u) - 2048.0f) / 512.0f"},
    {"name": "source_stride", "type": "uint64_t", "value": "D41DestinationStride(rows, D41_LOCAL_HEADS)"},
    {"name": "sink", "type": "const float *", "elements": "D41_LOCAL_HEADS", "fill": "f32"},
    {"name": "positions", "type": "const uint32_t *", "elements": "rows", "fill": "index", "expression": "160u + 37u * index"},
    {"name": "frequency", "type": "const float *", "elements": "D41K_ROPE_PAIRS", "fill": "f32"},
    {"name": "group_input", "type": "uint16_t *", "elements": "rows * D41_LOCAL_HEADS * D41_HEAD_DIM", "fill": "zero",
     "row_zero": [["0u", "D41_GROUP_WIDTH"], ["rows * D41_GROUP_WIDTH", "D41_GROUP_WIDTH"]]},
    {"name": "window_kv", "type": "const uint16_t *", "elements": "rows * D41_HEAD_DIM", "fill": "bf16"},
    {"name": "ring", "type": "uint16_t *", "elements": "rows * D41_RING_ROWS * D41_HEAD_DIM", "fill": "zero", "partial": true},
    {"name": "row_lane", "type": "const uint32_t *", "elements": "rows", "fill": "index", "expression": "index"},
    {"name": "row_ordinal", "type": "const uint32_t *", "elements": "rows", "fill": "index", "expression": "0u"},
    {"name": "sequence_row_begin", "type": "const uint32_t *", "elements": "rows + 1u", "fill": "index", "expression": "index"},
    {"name": "recurrent_index", "type": "const uint32_t *", "elements": "rows", "fill": "index", "expression": "index"},
    {"name": "ring_slot_stride", "type": "uint64_t", "value": "(uint64_t)D41_RING_ROWS * D41_HEAD_DIM"},
    {"name": "commit", "type": "uint32_t", "value": "1u"}
   ],
   "scratch": [
    {"name": "merged", "type": "uint16_t *", "elements": "rows * D41_LOCAL_HEADS * D41_HEAD_DIM"}
   ],
   "roles": [
    {
     "op": "d41_output_head",
     "blocks_per_row": "D41_LOCAL_HEADS",
     "bind": {"partials": "arguments.records", "source_stride": "arguments.source_stride", "heads": "D41_LOCAL_HEADS", "sink": "arguments.sink",
      "positions": "arguments.positions", "frequency": "arguments.frequency", "group_input": "arguments.group_input",
      "group_heads": "D41_GROUP_WIDTH / D41_HEAD_DIM"}
    },
    {
     "op": "d41_ring_store",
     "blocks_per_row": "1u",
     "bind": {"wave_kv": "arguments.window_kv", "ring": "arguments.ring", "positions": "arguments.positions", "row_lane": "arguments.row_lane",
      "row_ordinal": "arguments.row_ordinal", "sequence_row_begin": "arguments.sequence_row_begin", "recurrent_slot": "arguments.recurrent_index",
      "ring_slot_stride": "arguments.ring_slot_stride", "ring_rows": "D41_RING_ROWS", "window": "D41_WINDOW", "degree": "1u", "rank": "0u",
      "commit": "arguments.commit", "lane_count": "(const uint32_t *)0"}
    }
   ],
   "reference": [
    "LM_LAUNCH((D41WindowRingStoreKernel), rows, D41_THREADS, 0, stream, window_kv, ring, positions, row_lane, row_ordinal, sequence_row_begin, recurrent_index, ring_slot_stride, D41_RING_ROWS, D41_WINDOW, 1u, 0u, rows, commit, (const uint32_t *)0);",
    "LM_LAUNCH((D41MergeSinkKernel), dim3(rows, D41_LOCAL_HEADS), D41_THREADS, 0, stream, records, source_stride, 1u, D41_LOCAL_HEADS, sink, merged);",
    "D41Rope(merged, rows, D41_LOCAL_HEADS, D41_HEAD_DIM, D41_HEAD_DIM - D41_ROPE, positions, 0, frequency, 1u, 0, stream);",
    "for ( uint32_t group = 0u; group < D41_LOCAL_GROUPS; ++group )",
    "{",
    "\tLM_LAUNCH((D41ColumnsKernel), dim3(D41Blocks(D41_GROUP_WIDTH), rows), D41_THREADS, 0, stream, merged + (uint64_t)group * D41_GROUP_WIDTH, D41_LOCAL_HEADS * D41_HEAD_DIM, group_input + (uint64_t)group * rows * D41_GROUP_WIDTH, D41_GROUP_WIDTH, D41_GROUP_WIDTH);",
    "\tD41Fp8Qdq(group_input + (uint64_t)group * rows * D41_GROUP_WIDTH, (uint64_t)rows * D41_GROUP_WIDTH, stream);",
    "}"
   ],
   "outputs": ["group_input", "ring"],
   "perturb": "records"
  },
  {
   "name": "D41FusedRouteKernel",
   "launcher": "D41FusedRouteLaunch",
   "arguments_type": "D41FusedRouteArguments",
   "rows_constant": "D41FusedRouteRows",
   "threads": 256,
   "rows_max": 16,
   "shared_bytes": "0u",
   "dependent_launch": true,
   "replaces": ["LmTopkWarpKernel", "D41RouteLocalKernel", "LmRouteBuildKernel", "LmPackedRouteWeightKernel"],
   "arguments": [
    {"name": "scores", "type": "const float *", "elements": "rows * D41_EXPERTS", "fill": "f32"},
    {"name": "bias", "type": "const float *", "elements": "D41_EXPERTS", "fill": "f32"},
    {"name": "group", "type": "const uint8_t *", "elements": "D41_EXPERTS", "fill": "index", "expression": "index % 4u == 0u ? index / 4u : 0xffu"},
    {"name": "route_expert", "type": "uint32_t *", "elements": "rows * D41_TOPK", "fill": "zero"},
    {"name": "route_weight", "type": "float *", "elements": "rows * D41_TOPK", "fill": "zero"},
    {"name": "route_global", "type": "uint32_t *", "elements": "rows * D41_TOPK", "fill": "zero"},
    {"name": "group_row_offset", "type": "uint32_t *", "elements": "D41_LOCAL_EXPERTS + 2u", "fill": "zero", "row_zero": "none"},
    {"name": "route_packed_row", "type": "uint32_t *", "elements": "rows * D41_TOPK", "fill": "zero", "row_zero": "none"},
    {"name": "route_source_token", "type": "uint32_t *", "elements": "rows * D41_TOPK", "fill": "zero", "row_zero": "none"},
    {"name": "tile_prefix_up", "type": "uint32_t *", "elements": "D41_LOCAL_EXPERTS + 2u", "fill": "zero", "row_zero": "none"},
    {"name": "tile_prefix_down", "type": "uint32_t *", "elements": "D41_LOCAL_EXPERTS + 2u", "fill": "zero", "row_zero": "none"},
    {"name": "packed_weight", "type": "float *", "elements": "rows * D41_TOPK", "fill": "zero", "row_zero": "none"},
    {"name": "fault", "type": "uint32_t *", "elements": "1u", "fill": "zero", "partial": true, "row_zero": "none"},
    {"name": "counters", "type": "uint32_t *", "elements": "1u", "fill": "zero"},
    {"name": "tile_m", "type": "uint32_t", "derived": "LmLaunchGroupedTileM(rows, D41_TOPK, D41_LOCAL_EXPERTS + 1u)"},
    {"name": "neuron_tiles_up", "type": "uint32_t", "value": "(2u * D41_MOE_INTER + D41_GEMM_TILE_N - 1u) / D41_GEMM_TILE_N"},
    {"name": "neuron_tiles_down", "type": "uint32_t", "value": "(D41_HIDDEN + D41_GEMM_TILE_N - 1u) / D41_GEMM_TILE_N"}
   ],
   "roles": [
    {
     "op": "topk_route_row",
     "blocks_per_row": "1u",
     "bind": {"k": "D41_TOPK", "renormalise": "true", "transform": "LM_TOPK_SCORE_SQRT_SOFTPLUS", "scores": "arguments.scores", "n": "D41_EXPERTS",
      "indices": "arguments.route_expert", "values": "arguments.route_weight", "bias": "arguments.bias", "logits": "(const uint16_t *)0",
      "scale": "D41_ROUTE_SCALE", "fault": "arguments.fault"},
     "tail": {
      "op": "d41_route_tail",
      "scope": "launch",
      "bind": {"experts_held": "D41_LOCAL_EXPERTS + 1u", "route_expert": "arguments.route_expert", "route_weight": "arguments.route_weight",
       "route_global": "arguments.route_global", "routes": "rows * D41_TOPK", "group": "arguments.group", "local_experts": "D41_LOCAL_EXPERTS",
       "experts": "D41_EXPERTS", "top_k": "D41_TOPK", "group_row_offset": "arguments.group_row_offset", "route_packed_row": "arguments.route_packed_row",
       "route_source_token": "arguments.route_source_token", "tile_m": "arguments.tile_m", "neuron_tiles_up": "arguments.neuron_tiles_up",
       "tile_prefix_up": "arguments.tile_prefix_up", "neuron_tiles_down": "arguments.neuron_tiles_down", "tile_prefix_down": "arguments.tile_prefix_down",
       "packed_weight": "arguments.packed_weight"}
     }
    }
   ],
   "reference": [
    "FUSED_REQUIRE((LmTopkRouteLaunch<D41_THREADS, D41_TOPK, true, LM_TOPK_SCORE_SQRT_SOFTPLUS>(rows, scores, D41_EXPERTS, route_expert, route_weight, bias, 0, D41_ROUTE_SCALE, fault, stream)) == SPARK_GPU_SUCCESS);",
    "LM_LAUNCH((D41RouteLocalKernel), (rows * D41_TOPK + 255u) / 256u, 256u, 0, stream, route_expert, route_weight, route_global, rows * D41_TOPK, group, D41_LOCAL_EXPERTS, D41_LOCAL_EXPERTS, D41_EXPERTS);",
    "FUSED_REQUIRE((LmRouteBuild<D41_THREADS, D41_LOCAL_EXPERTS + 1u>(route_expert, rows, rows * D41_TOPK, D41_TOPK, group_row_offset, route_packed_row, route_source_token, 2u * D41_MOE_INTER, D41_HIDDEN, D41_GEMM_TILE_N, tile_prefix_up, tile_prefix_down, stream)) == LM_LAUNCH_OK);",
    "LM_LAUNCH((LmPackedRouteWeightKernel), (rows * D41_TOPK + 255u) / 256u, 256u, 0, stream, route_packed_row, route_weight, packed_weight, rows * D41_TOPK);"
   ],
   "outputs": ["route_expert", "route_weight", "route_global", "group_row_offset", "route_packed_row", "route_source_token", "tile_prefix_up",
    "tile_prefix_down", "packed_weight", "fault"],
   "perturb": "scores",
   "bump": "64.0f"
  }
 ]
}
