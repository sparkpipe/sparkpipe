{
  "schema_version": 1,
  "description": "Primary-source registry for the daily SOTA scanner. Every supported exact model must keep at least one target-eligible primary source here. Targets are selected independently in each exact benchmark cell. Quarantined entries are monitored deliberately so their claims can be recorded and visibly excluded from targets.",
  "refresh_command": "python3 tools/update_sota_ledger.py --mode fetch --cache-dir cache/sota_envelopes",
  "offline_rebuild_command": "python3 tools/update_sota_ledger.py --mode offline --envelope-dir examples/sota_observations",
  "policy": {
    "higher_is_better_target_factor": 1.1,
    "lower_is_better_target_factor": 0.9,
    "target_selection": "best_metric_value_per_exact_cell",
    "equal_value_tiebreaker": "lexicographically_smallest_observation_id",
    "target_eligible_evidence_classes": [
      "MEASURED_BENCHMARK_ARTIFACT",
      "MEASURED_ISSUE_RECEIPT",
      "MEASURED_OFFICIAL_DOCS",
      "PAPER_MEASURED"
    ],
    "quarantined_evidence_classes": [
      "VENDOR_MARKETING",
      "ANONYMOUS_SCREENSHOT",
      "AGGREGATOR_SECONDARY",
      "UNVERIFIED"
    ]
  },
  "models": [
    {
      "model_id": "dsv4-flash",
      "display_name": "DeepSeek V4 Flash",
      "sources": [
        {
          "source_id": "dsv4-flash-release-benchmark",
          "url": "https://raw.githubusercontent.com/deepseek-ai/DeepSeek-V4/main/benchmarks/v4_flash_decode_throughput_20260601.json",
          "document_kind": "github_repository_artifact",
          "publisher": "DeepSeek",
          "evidence_class": "MEASURED_BENCHMARK_ARTIFACT",
          "expected_checkpoint_name": "deepseek-ai/DeepSeek-V4-Flash",
          "extraction": {
            "format": "sparkpipe_flat_v1"
          }
        },
        {
          "source_id": "dsv4-flash-hf-model-card-bench",
          "url": "https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash/raw/main/benchmarks/decode_throughput_20260701.json",
          "document_kind": "huggingface_model_card",
          "publisher": "DeepSeek",
          "evidence_class": "MEASURED_BENCHMARK_ARTIFACT",
          "expected_checkpoint_name": "deepseek-ai/DeepSeek-V4-Flash",
          "extraction": {
            "format": "sparkpipe_flat_v1"
          }
        },
        {
          "source_id": "dsv4-flash-aggregator-transcription",
          "url": "https://inference-aggregator.example/transcriptions/deepseek-v4-flash",
          "document_kind": "aggregator_page",
          "publisher": "Inference Leaderboard Aggregator",
          "evidence_class": "AGGREGATOR_SECONDARY",
          "expected_checkpoint_name": "deepseek-ai/DeepSeek-V4-Flash",
          "extraction": {
            "format": "sparkpipe_flat_v1"
          }
        }
      ]
    },
    {
      "model_id": "dsv4-pro",
      "display_name": "DeepSeek V4 Pro",
