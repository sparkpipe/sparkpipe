    {
      "model_id": "k3",
      "display_name": "Kimi K3",
      "sources": [
        {
          "source_id": "k3-paper-table-excerpt",
          "url": "https://arxiv.org/abs/2604.09987",
          "document_kind": "paper",
          "publisher": "arXiv (Moonshot AI)",
          "evidence_class": "PAPER_MEASURED",
          "expected_checkpoint_name": "moonshotai/Kimi-K3",
          "extraction": {
            "format": "regex_text",
            "fields": {
              "checkpoint.name": "checkpoint (moonshotai/[A-Za-z0-9.\\-]+)",
              "checkpoint.revision": "revision ([0-9a-f]{40})",
              "hardware.accelerator_count": "Setup: (\\d+) x NVIDIA",
              "hardware.accelerator_name": "x NVIDIA ([A-Za-z0-9 ]+?) with",
              "topology.tp_size": "\\bTP(\\d+)",
              "topology.pp_size": "\\bPP(\\d+)",
              "batch.batch_size": "batch size (\\d+)",
              "workload.prompt_tokens": "(\\d+) prompt tokens",
              "workload.output_tokens": "(\\d+) completion tokens",
              "workload.context_window_tokens": "a (\\d+)-token window",
              "workload.context_occupancy_pct": "occupancy (\\d+(?:\\.\\d+)?) percent",
              "metric.value": "reached (\\d+(?:\\.\\d+)?) tok/s",
              "source.publication_date": "generated (\\d{4}-\\d{2}-\\d{2})"
            },
            "types": {
              "hardware.accelerator_count": "int",
              "topology.tp_size": "int",
              "topology.pp_size": "int",
              "batch.batch_size": "int",
              "workload.prompt_tokens": "int",
              "workload.output_tokens": "int",
              "workload.context_window_tokens": "int",
              "workload.context_occupancy_pct": "float",
              "metric.value": "float"
            },
            "static": {
              "topology.kind": "tp_pp",
              "topology.ep_size": 1,
              "quality_mode": "checkpoint_native_mixed_precision",
              "precision": {
                "weight_dtype": "checkpoint_native_mixed",
                "weight_codec": "checkpoint_native",
                "activation_dtype": "bf16",
                "accumulator_dtype": "fp32",
                "kv_cache_dtype": "bf16",
                "kv_cache_codec": "native_bf16"
              },
              "quality_gate": {
                "method": "token_exact",
                "status": "passed",
                "output_parity": true,
                "atol": 0.0,
                "rtol": 0.0
              },
              "execution": {
                "compute_route": "cuda_native",
                "kv_route": "device_hbm_paged"
              },
              "fabric": {
                "interconnect": "nvlink4_nvswitch",
                "collective_backend": "nccl",
                "bandwidth_gbps_per_device": 400.0,
                "rdma_enabled": false
              },
              "power_state": {
                "state": "locked",
                "power_limit_watts": 700.0,
                "graphics_clock_mhz": 1755,
                "memory_clock_mhz": 1593,
                "thermal_state": "steady"
              },
              "request_distribution": {
                "kind": "fixed",
                "batch_size_p50": 4,
                "batch_size_p95": 4,
                "prompt_tokens_p50": 2048,
                "prompt_tokens_p95": 2048,
                "output_tokens_p50": 1024,
                "output_tokens_p95": 1024,
                "context_occupancy_pct_p50": 0.8,
                "context_occupancy_pct_p95": 0.8
              },
              "prefix_cache": {
                "enabled": false,
                "state": "disabled",
                "matched_tokens": 0
              },
              "speculation.enabled": false,
              "speculation.provider": null,
              "speculation.draft_length": null,
              "service_level_objectives": {
                "ttft_ms_max": null,
                "itl_ms_max": null
              },
              "statistics": {
                "randomization": "none",
                "paired": false,
                "warmup_iterations": 2,
                "sample_count": 10,
                "summary_statistic": "mean",
                "confidence_interval": {
                  "method": "bootstrap",
                  "level": 0.95,
                  "lower": 700.0,
                  "upper": 740.0
                }
              },
              "metric.name": "output_tokens_per_second",
              "metric.unit": "tok/s",
              "metric.direction": "higher_is_better",
              "metric.timing_boundary": "steady_state_decode"
            }
          }
        }
      ]
    },
