+static float round_bf16(float v)
+{
+	uint32_t w;
+	memcpy(&w, &v, 4);
+	w = (w + 0x7fffu + ((w >> 16) & 1u)) & 0xffff0000u;
+	memcpy(&v, &w, 4);
+	return v;
+}
