@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Source contract for transport-owned reusable mixed-reduction programs."""
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+HEADER = (ROOT / "include/sparkpipe/spark_tp_device_collective.h").read_text()
