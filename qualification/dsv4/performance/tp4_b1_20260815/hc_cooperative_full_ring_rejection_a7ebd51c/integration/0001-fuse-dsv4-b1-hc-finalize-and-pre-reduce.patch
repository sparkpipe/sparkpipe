-	if ( streams_bf16 == 0 || fn_f32 == 0 || scale3_f32 == 0 || base_f32 == 0 || partials_f32 == 0 || mixes_f32 == 0 || pre_f32 == 0 || post_f32 == 0 || comb_f32 == 0 || row_count == 0u || flat_dimension != SPARK_DSV4_MODEL_BOUNDARY_STREAM_ELEMENTS || mix_rows != SPARK_DSV4_MODEL_HC_MIX_ROWS || hc != SPARK_DSV4_MODEL_HC_STREAM_COUNT || iterations == 0u || rms_epsilon <= 0.0f || hc_epsilon <= 0.0f )
-		return(cudaErrorInvalidValue);
-	SparkDsv4HcMixSplitKKernel<<<row_count * SPARK_DSV4_HC_SPLIT_K_COUNT,SPARK_LM_CTA_THREADS,0,stream>>>(streams_bf16,fn_f32,partials_f32,row_count,flat_dimension);
-	error = cudaGetLastError();
+	error = SparkDsv4RequireHcMixShape(streams_bf16,fn_f32,scale3_f32,
+		base_f32,partials_f32,mixes_f32,row_count,flat_dimension,mix_rows,hc,
+		iterations,rms_epsilon,hc_epsilon,pre_f32,post_f32,comb_f32);
 	if ( error == cudaSuccess )
-	{
-		SparkDsv4HcMixSplitKFinalizeKernel<<<row_count,64u,0,stream>>>(partials_f32,scale3_f32,base_f32,row_count,iterations,rms_epsilon,hc_epsilon,mixes_f32,pre_f32,post_f32,comb_f32);
-		error = cudaGetLastError();
-	}
+		error = SparkDsv4LaunchHcMixSplitKPartials(stream,streams_bf16,fn_f32,
+			partials_f32,row_count,flat_dimension);
+	if ( error == cudaSuccess )
+		error = SparkDsv4LaunchHcFinalize(stream,partials_f32,scale3_f32,
+			base_f32,row_count,iterations,rms_epsilon,hc_epsilon,mixes_f32,
+			pre_f32,post_f32,comb_f32);
 	return(error);
 }
 
@@ -3316,6 +3399,55 @@ extern "C" cudaError_t SparkDsv4LaunchHcPreReduce(
 	return(cudaGetLastError());
 }
 
+static cudaError_t SparkDsv4LaunchHcFinalizePreReduceB1(
+	cudaStream_t stream,const float *partials_f32,const float *scale3_f32,
+	const float *base_f32,const void *streams_bf16,uint32_t iterations,
+	float rms_epsilon,float hc_epsilon,float *mixes_f32,float *pre_f32,
+	float *post_f32,float *comb_f32,void *reduced_bf16,void *residual_bf16)
+{
+	void *arguments[] = {(void *)&partials_f32,(void *)&scale3_f32,
+		(void *)&base_f32,(void *)&streams_bf16,(void *)&iterations,
+		(void *)&rms_epsilon,(void *)&hc_epsilon,(void *)&mixes_f32,
+		(void *)&pre_f32,(void *)&post_f32,(void *)&comb_f32,
+		(void *)&reduced_bf16,(void *)&residual_bf16};
+	return(cudaLaunchCooperativeKernel(
+		(void *)SparkDsv4HcFinalizePreReduceCooperativeKernel,
+		dim3(SPARK_DSV4_HC_MINIMUM_BLOCKS),dim3(SPARK_DSV4_HC_ELEMENT_TILE),
+		arguments,0u,stream));
+}
+
+extern "C" cudaError_t SparkDsv4LaunchHcEnter(
+	cudaStream_t stream,const void *streams_bf16,const float *fn_f32,
+	const float *scale3_f32,const float *base_f32,float *partials_f32,
+	float *mixes_f32,uint32_t row_count,uint32_t flat_dimension,
+	uint32_t mix_rows,uint32_t hc,uint32_t iterations,float rms_epsilon,
+	float hc_epsilon,float *pre_f32,float *post_f32,float *comb_f32,
+	void *reduced_bf16,void *residual_bf16,uint32_t dimension)
+{
+	cudaError_t error = SparkDsv4RequireHcMixShape(streams_bf16,fn_f32,
+		scale3_f32,base_f32,partials_f32,mixes_f32,row_count,flat_dimension,
+		mix_rows,hc,iterations,rms_epsilon,hc_epsilon,pre_f32,post_f32,
+		comb_f32);
+	if ( error == cudaSuccess && (reduced_bf16 == 0 || residual_bf16 == 0 ||
+		dimension != SPARK_DSV4_MODEL_HIDDEN_DIMENSION) )
+		error = cudaErrorInvalidValue;
+	if ( error == cudaSuccess )
+		error = SparkDsv4LaunchHcMixSplitKPartials(stream,streams_bf16,fn_f32,
+			partials_f32,row_count,flat_dimension);
+	if ( error == cudaSuccess && row_count == 1u )
+		return(SparkDsv4LaunchHcFinalizePreReduceB1(stream,partials_f32,
+			scale3_f32,base_f32,streams_bf16,iterations,rms_epsilon,hc_epsilon,
+			mixes_f32,pre_f32,post_f32,comb_f32,reduced_bf16,residual_bf16));
+	if ( error == cudaSuccess )
+		error = SparkDsv4LaunchHcFinalize(stream,partials_f32,scale3_f32,
+			base_f32,row_count,iterations,rms_epsilon,hc_epsilon,mixes_f32,
+			pre_f32,post_f32,comb_f32);
+	if ( error == cudaSuccess )
+		error = SparkDsv4LaunchHcPreReduce(stream,streams_bf16,pre_f32,
+			reduced_bf16,residual_bf16,row_count,hc,dimension);
+	return(error);
+}
+
