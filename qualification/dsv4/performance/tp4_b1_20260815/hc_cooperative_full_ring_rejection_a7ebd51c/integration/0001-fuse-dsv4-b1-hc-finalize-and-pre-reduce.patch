+		cudaSuccess;
+	int result;
+	if ( error == cudaSuccess ) error = cudaMemcpy(a,first,bytes,
+		cudaMemcpyDeviceToHost);
+	if ( error == cudaSuccess ) error = cudaMemcpy(b,second,bytes,
+		cudaMemcpyDeviceToHost);
+	result = SparkDsv4ValidationRequireCuda(error,message);
+	if ( result == 0 ) result = SparkDsv4ValidationRequire(
+		memcmp(a,b,bytes) == 0,message);
+	free(b);
+	free(a);
+	return(result);
