+static int SparkDsv4ValidationHcAllocate(
+	SparkDsv4ValidationHcBuffers *buffers)
+{
+	static const uint16_t values[] = {0x3f00u,0xbf00u,0x3e80u,0xbe80u,
+		0x3f40u,0xbf40u,0x3e00u,0xbe00u};
+	uint64_t rows = SPARK_DSV4_VALIDATION_ROW_COUNT;
+	uint64_t flat = SPARK_DSV4_MODEL_BOUNDARY_STREAM_ELEMENTS;
+	uint64_t stream_count = rows * flat;
+	uint64_t fn_count = flat * SPARK_DSV4_MODEL_HC_MIX_ROWS,index;
+	uint16_t *streams = (uint16_t *)malloc(stream_count * sizeof(uint16_t));
+	float *fn = (float *)malloc(fn_count * sizeof(float));
+	float scale3[3] = {0.375f,0.625f,0.875f};
+	float base[SPARK_DSV4_MODEL_HC_MIX_ROWS];
+	cudaError_t error = cudaErrorMemoryAllocation;
+	memset(buffers,0,sizeof(*buffers));
+	if ( streams != 0 && fn != 0 ) error = SparkDsv4ValidationHcDeviceAllocate(buffers);
+	for (index=0u; streams != 0 && index<stream_count; index++)
+		streams[index] = values[(index * 5u + (index / flat) * 3u) % 8u];
+	for (index=0u; fn != 0 && index<fn_count; index++)
+		fn[index] = (float)((int32_t)((index * 29u + 7u) % 257u) - 128) /
+			1024.0f;
+	for (index=0u; index<SPARK_DSV4_MODEL_HC_MIX_ROWS; index++)
+		base[index] = (float)((int32_t)((index * 19u + 3u) % 53u) - 26) /
+			128.0f;
+	if ( error == cudaSuccess ) error = cudaMemcpy(buffers->streams_bf16,
+		streams,stream_count * sizeof(uint16_t),cudaMemcpyHostToDevice);
+	if ( error == cudaSuccess ) error = cudaMemcpy(buffers->fn_f32,fn,
+		fn_count * sizeof(float),cudaMemcpyHostToDevice);
+	if ( error == cudaSuccess ) error = cudaMemcpy(buffers->scale3_f32,scale3,
+		sizeof(scale3),cudaMemcpyHostToDevice);
+	if ( error == cudaSuccess ) error = cudaMemcpy(buffers->base_f32,base,
+		sizeof(base),cudaMemcpyHostToDevice);
+	free(fn);
+	free(streams);
+	return(SparkDsv4ValidationRequireCuda(error,"hc_enter_allocate"));
