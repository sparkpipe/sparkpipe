        {"source": "include/sparkpipe/spark_hardware_transport_probe.h", "role": "provider_abi"},
        {"source": "tools/hardware/spark_transport_characterize.c", "role": "probe"}
      ]
    },
    {
      "id": "pmtu_characterize",
      "executable": "build/spark_pmtu_characterize",
      "components": [
        {"source": "tools/hardware/spark_pmtu_characterize.c", "role": "probe"}
