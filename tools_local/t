#!/usr/bin/env bash
# t — measure: one canary (4 tok) then one N-token run (default 32).
# usage: ./t [tokens]
set -euo pipefail
N=${1:-32}
ssh spark0 "timeout $((N*12+60)) python3 -c \"
import http.client, json, time
def req(ids, n):
    body = json.dumps({'prompt_token_ids': ids, 'max_tokens': n, 'temperature': 0})
    conn = http.client.HTTPConnection('127.0.0.1', 8433, timeout=$((N*10+50)))
    t0 = time.monotonic()
    conn.request('POST', '/v1/completions', body=body)
    r = conn.getresponse()
    d = json.loads(r.read())
    dt = time.monotonic() - t0
    conn.close()
    return dt, len(d.get('tokens', [])), d.get('tokens', [])[:2]
dt, ntok, first = req([1,2,3,4,5,6,7,8], 4)
print(f'canary: t={dt:.1f}s ntok={ntok} first={first}', flush=True)
dt, ntok, first = req([1,2,3,4,5,6,7,8], $N)
rate = (ntok/dt) if dt > 0 else 0
print(f'${N}tok: t={dt:.1f}s ntok={ntok} rate={rate:.2f} tok/s', flush=True)
\""
ssh spark0 'L=~/sparkdata/glm53flash.fp8.tp16/residentd.log; echo "graph=$(grep -c "GRAPH-" $L 2>/dev/null) spins=$(grep -c MESH-SPIN-TIMEOUT $L 2>/dev/null) fails=$(grep -c chainfail $L 2>/dev/null)"'
