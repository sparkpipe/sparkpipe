#!/usr/bin/env bash
# b — simultaneous full-stack bounce only (no sync, no build): kill engines
# + weightds on all nodes at once, poll listeners, report health.
set -euo pipefail
cd "$(dirname "$0")/.."
NODES="spark0 spark1 spark2 spark3 spark4 spark5 spark6 spark7 spark8 spark9 sparka sparkb sparkc sparkd sparke sparkf"
for n in $NODES; do
  ssh -o ConnectTimeout=8 "$n" 'rr=$HOME/sparkdata/glm53flash.fp8.tp16; for p in $(ls -l /proc/[0-9]*/exe 2>/dev/null | grep -E "sparkpipe_model|sparkpipe_weightd" | sed "s|.*/proc/\([0-9]*\)/exe.*|\1|"); do c=$(readlink /proc/$p/cwd 2>/dev/null); e=$(readlink /proc/$p/exe 2>/dev/null); if [ "$c" = "$rr" ] || [[ "$e" == *sparkdata/weightd* ]]; then kill -9 $p 2>/dev/null; fi; done; true' 2>/dev/null &
done
wait
for i in $(seq 1 40); do
  ok=$(ssh spark0 'python3 -c "
import socket
fails = 0
for i in range(16):
    s = socket.socket(); s.settimeout(1)
    try: s.connect((\"10.10.100.%d\" % (10+i), 19560+i))
    except Exception: fails += 1
    s.close()
print(16-fails)
"' 2>/dev/null || echo 0)
  [ "$ok" = "16" ] && break
  sleep 8
done
sleep 15
H=$(ssh spark0 'curl -s -m 3 -o /dev/null -w "%{http_code}" http://127.0.0.1:8433/health || true')
if [ "$H" != "200" ]; then sleep 30; H=$(ssh spark0 'curl -s -m 3 -o /dev/null -w "%{http_code}" http://127.0.0.1:8433/health || true'); fi
echo "BOUNCE-DONE listeners=$ok health=$H"
