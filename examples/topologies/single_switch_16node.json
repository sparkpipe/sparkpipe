{
  "schema_version": 1,
  "topology": {
    "name": "single_switch_16node",
    "mode": "single_switch",
    "description": "Intermediate deployment on the way to dual switch: the same 16 spark nodes with only port 0 cabled to one 100 Gbps all-to-all switch. Every node has one direct 100 Gbit/s path to every peer through that switch.",
    "runtime_projection": {
      "path": "examples/runtime_configs/single_switch_100g.json",
      "mode": "single_switch_single_rail",
      "link_speed_key": "link_speed_gbps",
      "include_mtu": true,
      "extra": {
        "switch_family": "MikroTik 804"
      },
      "description": "Initial switched deployment. Every Spark has one direct 100 Gbit/s path to every peer through one switch."
    }
  },
  "node_types": [
    {
      "name": "spark",
      "memory_bandwidth_gb_s": 273,
      "bf16_tflops": 125,
      "fp8_tflops": 250,
      "fp4_tflops": 500,
      "unified_memory_bytes": 137438953472,
      "nvme_read_gb_s": 6,
      "network_port_count": 2,
      "provenance": "Bandwidth/compute per docs/archive/GB10_CUDA_COST_MODEL_CALIBRATION.md: 273 GB/s LPDDR5x unified; 250 TFLOP/s FP8 dense (1 PFLOP FP4 sparse, halved for dense, halved again FP4 to FP8); BF16 halved once more on the same public-spec chain. 128 GB unified per README. NVMe 6 GB/s is the midpoint of the unpinned 5-7 GB/s assumption in docs/archive/PERF_ROADMAP_2026-08-01.md."
    }
  ],
  "fabrics": [
    {
      "name": "switch_a",
      "kind": "switch",
      "speed_gbps": 100,
      "latency_ns": 3000,
      "mtu_bytes": 9000,
      "provenance": "Speed/MTU per the qualified single-switch runtime config; latency is assumed, unpinned - no in-repo switch latency measurement exists yet."
    }
  ],
