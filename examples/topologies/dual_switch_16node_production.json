{
  "schema_version": 1,
  "topology": {
    "name": "dual_switch_16node_production",
    "mode": "dual_switch",
    "description": "Production end state: 16 GB10 spark nodes, each with port 0 on switch A and port 1 on switch B, two independent 100 Gbps all-to-all rails. The runtime still fails closed on this mode (see the projected runtime config) until dual-rail ownership and failover are qualified.",
    "runtime_projection": {
      "path": "examples/runtime_configs/dual_switch_dual_rail_future.json",
      "mode": "dual_switch_dual_rail_future",
      "link_speed_key": "link_speed_gbps_per_rail",
      "include_mtu": false,
      "extra": {
        "enabled": false
      },
      "description": "Future topology. Current code recognizes it only to fail closed until dual-rail ownership and failover are qualified."
    }
  },
  "node_types": [
    {
      "name": "spark",
      "memory_bandwidth_gb_s": 273,
      "bf16_tflops": 125,
      "fp8_tflops": 250,
      "fp4_tflops": 500,
      "unified_memory_bytes": 137438953472,
      "nvme_read_gb_s": 6,
      "network_port_count": 2,
      "provenance": "Bandwidth/compute per docs/archive/GB10_CUDA_COST_MODEL_CALIBRATION.md: 273 GB/s LPDDR5x unified; 250 TFLOP/s FP8 dense (1 PFLOP FP4 sparse, halved for dense, halved again FP4 to FP8); BF16 halved once more on the same public-spec chain. 128 GB unified per README. NVMe 6 GB/s is the midpoint of the unpinned 5-7 GB/s assumption in docs/archive/PERF_ROADMAP_2026-08-01.md."
    }
  ],
  "fabrics": [
    {
      "name": "switch_a",
      "kind": "switch",
      "speed_gbps": 100,
      "latency_ns": 3000,
      "mtu_bytes": 9000,
      "provenance": "Speed/MTU match the qualified single-switch rail; latency is assumed, unpinned - no in-repo switch latency measurement exists yet."
    },
    {
      "name": "switch_b",
      "kind": "switch",
      "speed_gbps": 100,
      "latency_ns": 3000,
      "mtu_bytes": 9000,
      "provenance": "Second rail, same assumed characteristics as switch_a; kept as a separate fabric so port-to-fabric assignment is explicit."
    }
  ],
