@export
macro u32_divmod(num, den, out_q, out_r) {
    reg u32 qv = 0;
    reg u32 rv = 0;
    for (reg u32 bit = 0; bit < 32; bit += 1) {
        reg u32 sh = 31 - bit;
        rv = (rv << 1) | ((num >> sh) & 1);
        if (rv >= den) {
            rv = rv - den;
            qv = qv | (1 << sh);
        }
    }
    out_q = qv;
    out_r = rv;
}
