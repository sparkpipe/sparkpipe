@export
macro u32_divmod(num, den, out_q, out_r) {
    reg u32 qv = 0;
    reg u32 rv = 0;
    reg u32 nv = num;
    for (reg u32 bit = 0; bit < 32; bit += 1) {
        rv = (rv << 1) | (nv >> 31);
        nv = nv << 1;
        qv = qv << 1;
        if (rv >= den) {
            rv = rv - den;
            qv = qv | 1;
        }
    }
    out_q = qv;
    out_r = rv;
}

@export
macro warp_sum_down(val) {
    val = val + shfl_down(val, 16);
    val = val + shfl_down(val, 8);
    val = val + shfl_down(val, 4);
    val = val + shfl_down(val, 2);
    val = val + shfl_down(val, 1);
}

@export
macro block_reduce_sum_exact(total, reduction, wid, lane, out_sum) {
    warp_sum_down(total);
    if (lane == 0) { sts32(reduction, wid, total); }
    barrier();
    reg f32 b = 0.0f;
    if (lane < 8) { b = lds32(reduction, lane); }
    b = b + shfl_down(b, 4);
    b = b + shfl_down(b, 2);
    b = b + shfl_down(b, 1);
    out_sum = shfl_idx(b, 0);
}

@export
macro block_reduce_max_exact(val, reduction, wid, lane, out_max) {
    val = maxf(val, shfl_down(val, 16));
    val = maxf(val, shfl_down(val, 8));
    val = maxf(val, shfl_down(val, 4));
    val = maxf(val, shfl_down(val, 2));
    val = maxf(val, shfl_down(val, 1));
    if (lane == 0) { sts32(reduction, wid, val); }
    barrier();
    reg f32 b = u32_as_f32(0xFF800000);
    if (lane < 8) { b = lds32(reduction, lane); }
    b = maxf(b, shfl_down(b, 4));
    b = maxf(b, shfl_down(b, 2));
    b = maxf(b, shfl_down(b, 1));
    out_max = shfl_idx(b, 0);
}

@export
macro rcp_nr1_f32(denom, out_inv) {
    reg f32 r = rcp(denom);
    out_inv = fma(r, fma(-denom, r, 1.0f), r);
}

@export
macro rcp_nr2_f32(denom, out_inv) {
    reg f32 r = rcp(denom);
    r = fma(r, fma(-denom, r, 1.0f), r);
    out_inv = fma(r, fma(-denom, r, 1.0f), r);
}

@export
macro div_nr1_f32(num, denom, inv_d, out_q) {
    reg f32 q = num * inv_d;
    out_q = fma(inv_d, fma(-denom, q, num), q);
}

@export
macro rsqrt_exact_div(sum_sq, dim_f, eps, out_scale) {
    reg f32 r = 0.0f;
    rcp_nr1_f32(dim_f, r);
    reg f32 q = 0.0f;
    div_nr1_f32(sum_sq, dim_f, r, q);
    out_scale = rsqrt(q + eps);
}

@export
macro silu_exact_f32(g, out_q) {
    reg f32 d = exp2_ftz(maxf(g, -88.0f) * -1.4426950408889634f) + 1.0f;
    reg f32 r = 0.0f;
    rcp_nr1_f32(d, r);
    div_nr1_f32(g, d, r, out_q);
    out_q = (g < -88.0f) ? 0.0f : out_q;
}

@export
macro sigmoid_exact_f32(g, out_s) {
    reg f32 d = exp2_ftz(maxf(g, -88.0f) * -1.4426950408889634f) + 1.0f;
    rcp_nr2_f32(d, out_s);
    out_s = (g < -88.0f) ? 0.0f : out_s;
}

@export
macro argmax_tiebreak_step(cand_s, cand_i, best_s, best_i) {
    if (cand_s > best_s) {
        best_s = cand_s;
        best_i = cand_i;
    } else if (cand_s == best_s) {
        if (cand_i < best_i) {
            best_s = cand_s;
            best_i = cand_i;
        }
    }
}

@export
macro warp_argmax_tiebreak(best_s, best_i) {
    reg f32 os16 = shfl_down(best_s, 16);
    reg u32 oi16 = shfl_down(best_i, 16);
    argmax_tiebreak_step(os16, oi16, best_s, best_i);
    reg f32 os8 = shfl_down(best_s, 8);
    reg u32 oi8 = shfl_down(best_i, 8);
    argmax_tiebreak_step(os8, oi8, best_s, best_i);
    reg f32 os4 = shfl_down(best_s, 4);
    reg u32 oi4 = shfl_down(best_i, 4);
    argmax_tiebreak_step(os4, oi4, best_s, best_i);
    reg f32 os2 = shfl_down(best_s, 2);
    reg u32 oi2 = shfl_down(best_i, 2);
    argmax_tiebreak_step(os2, oi2, best_s, best_i);
    reg f32 os1 = shfl_down(best_s, 1);
    reg u32 oi1 = shfl_down(best_i, 1);
    argmax_tiebreak_step(os1, oi1, best_s, best_i);
}

@export
macro block_argmax_tiebreak_to_smem(best_s, best_i, sh_s, sh_i, wid, lane) {
    warp_argmax_tiebreak(best_s, best_i);
    if (lane == 0) {
        sts32(sh_s, wid, best_s);
        sts32(sh_i, wid, best_i);
    }
    barrier();
}

@export
macro block_argmax_tiebreak_finish(sh_s, sh_i, out_s, out_i) {
    out_s = lds32(sh_s, 0);
    out_i = lds32(sh_i, 0);
    unroll (w = 1..8) {
        reg f32 ws = lds32(sh_s, w);
        reg u32 wi = lds32(sh_i, w);
        argmax_tiebreak_step(ws, wi, out_s, out_i);
    }
}

@export
macro softplus_exact_f32(x, out_sp) {
    if (x > 20.0f) {
        out_sp = x;
    } else if (x < -12.0f) {
        out_sp = exp2_ftz(x * 1.4426950408889634f);
    } else {
        reg f32 y = exp2_ftz(x * 1.4426950408889634f) + 1.0f;
        reg u32 yb = f32_as_u32(y);
        reg u32 e = ((yb >> 23) & 0xFF) - 127;
        reg f32 m = u32_as_f32((yb & 0x007FFFFF) | 0x3F800000);
        if (m > 1.4142135623730951f) {
            m = m * 0.5f;
            e = e + 1;
        }
        reg f32 inv_mp = 0.0f;
        rcp_nr1_f32(m + 1.0f, inv_mp);
        reg f32 z = (m - 1.0f) * inv_mp;
        reg f32 z2 = z * z;
        reg f32 p = fma(0.1428571492433548f, z2, 0.20000000298023224f);
        p = fma(p, z2, 0.3333333432674408f);
        p = fma(p, z2, 1.0f);
        out_sp = fma(u32_to_f32(e), 0.6931471805599453f, (z + z) * p);
    }
}

@export
macro gdn_decay_f32(a_log, shifted, out_decay) {
    reg f32 sp = 0.0f;
    softplus_exact_f32(shifted, sp);
    reg f32 a_exp = exp2_ftz(a_log * 1.4426950408889634f);
    out_decay = exp2_ftz((-a_exp * sp) * 1.4426950408889634f);
}

@export
macro sincos_pos_f32(angle, out_sin, out_cos) {
    reg f32 turns = fmul_rz(angle, 0.15915493667125702f);
    out_sin = sin_ftz(turns);
    out_cos = cos_ftz(turns);
}

@export
macro kv_shard_slot_index_page(kv_view, seq, pos, page, slot_in_page, page_slots, out_idx, out_ok) {
    out_ok = 0;
    out_idx = 0xFFFFFFFF;
    reg u32 pt_stride = param_u32(kv_view, 16);
    reg u32 seq_cnt = param_u32(kv_view, 20);
    reg u32 pool_pages = param_u32(kv_view, 24);
    reg u32 degree = param_u32(kv_view, 40);
    if (seq < seq_cnt && page < pt_stride) {
        reg u32 owns = 1;
        reg u32 sip = slot_in_page;
        reg u32 sh_page_slots = page_slots;
        if (degree > 1) {
            reg u32 rank = param_u32(kv_view, 44);
            reg u32 grain = param_u32(kv_view, 48);
            reg u32 qg = 0; reg u32 rg = 0;
            u32_divmod(pos, grain, qg, rg);
            reg u32 qd = 0; reg u32 owner = 0;
            u32_divmod(qg, degree, qd, owner);
            if (owner != rank) {
                owns = 0;
            } else {
                reg u32 span = grain * degree;
                reg u32 sq = 0; reg u32 sr = 0;
                u32_divmod(sip, span, sq, sr);
                reg u32 gq = 0; reg u32 gr = 0;
                u32_divmod(sip, grain, gq, gr);
                sip = sq * grain + gr;
                reg u32 psr = 0;
                u32_divmod(page_slots, degree, sh_page_slots, psr);
            }
        }
        if (owns != 0) {
            reg u64 pt_ptr = param_u64(kv_view, 8);
            reg u32 phys = ldg32_persist(ptr_add(pt_ptr, seq * pt_stride + page, 4));
            if (phys < pool_pages) {
                out_idx = phys * sh_page_slots + sip;
                out_ok = 1;
            }
        }
    }
}

@export
macro kv_shard_slot_addr_page(kv_view, seq, pos, page, slot_in_page, page_slots, slot_bytes, out_addr, out_ok) {
    out_addr = param_u64(kv_view, 0);
    reg u32 sidx = 0xFFFFFFFF;
    kv_shard_slot_index_page(kv_view, seq, pos, page, slot_in_page, page_slots, sidx, out_ok);
    if (out_ok != 0) { out_addr = ptr_add(out_addr, sidx, slot_bytes); }
}

@export
macro kv_shard_slot_addr(kv_view, seq, pos, slot_bytes, out_addr, out_ok) {
    kv_shard_slot_addr_page(kv_view, seq, pos, pos >> 6, pos & 63, 64, slot_bytes, out_addr, out_ok);
}

@export
macro bf16_dot8_acc(acc, wv, av) {
    reg f32 p0 = fma(bf16_lo(wv[0]), bf16_lo(av[0]), 0.0f);
    reg f32 p1 = bf16_hi(wv[0]) * bf16_hi(av[0]);
    unroll (k = 1..4) {
        p0 = fma(bf16_lo(wv[k]), bf16_lo(av[k]), p0);
        p1 = fma(bf16_hi(wv[k]), bf16_hi(av[k]), p1);
    }
    acc = fma(1.0f, p0 + p1, acc);
}

@export
macro lanes_reduce_sum(LANES, val) {
    if constexpr (LANES == 32) { val = warp_sum(val); }
    else if constexpr (LANES == 16) {
        val = val + shfl_xor(val, 8);
        val = val + shfl_xor(val, 4);
        val = val + shfl_xor(val, 2);
        val = val + shfl_xor(val, 1);
    } else {
        val = oct_sum(val);
    }
}

@export
macro nvfp4_ue4m3_decode(byte_val, gscale, out_sc) {
    reg u32 m = byte_val & 0x7F;
    m = m - (((m + 1) >> 7) & 1);
    out_sc = ue4m3_to_f32(m) * gscale;
}

@export
macro nvfp4_e2m1_dot16(w_lo, w_hi, a_lo, a_hi, out_dot) {
    reg f32x4 d0 = cvt_e2m1x4_f32x4(w_lo, 0);
    reg f32 a0 = d0.x * bf16_lo(a_lo[0]);
    reg f32 a1 = d0.y * bf16_hi(a_lo[0]);
    reg f32 a2 = d0.z * bf16_lo(a_lo[1]);
    reg f32 a3 = d0.w * bf16_hi(a_lo[1]);
    reg f32x4 d1 = cvt_e2m1x4_f32x4(w_lo, 16);
    a0 = fma(d1.x, bf16_lo(a_lo[2]), a0);
    a1 = fma(d1.y, bf16_hi(a_lo[2]), a1);
    a2 = fma(d1.z, bf16_lo(a_lo[3]), a2);
    a3 = fma(d1.w, bf16_hi(a_lo[3]), a3);
    reg f32x4 d2 = cvt_e2m1x4_f32x4(w_hi, 0);
    a0 = fma(d2.x, bf16_lo(a_hi[0]), a0);
    a1 = fma(d2.y, bf16_hi(a_hi[0]), a1);
    a2 = fma(d2.z, bf16_lo(a_hi[1]), a2);
    a3 = fma(d2.w, bf16_hi(a_hi[1]), a3);
    reg f32x4 d3 = cvt_e2m1x4_f32x4(w_hi, 16);
    a0 = fma(d3.x, bf16_lo(a_hi[2]), a0);
    a1 = fma(d3.y, bf16_hi(a_hi[2]), a1);
    a2 = fma(d3.z, bf16_lo(a_hi[3]), a2);
    a3 = fma(d3.w, bf16_hi(a_hi[3]), a3);
    out_dot = (a0 + a1) + (a2 + a3);
}

@export
macro hyper_gate_f32(v0, s_f, inv_s, out_v) {
    reg f32 sc = 0.0f;
    div_nr1_f32(v0, s_f, inv_s, sc);
    sc = bf16_lo(f32_to_bf16(sc));
    reg f32 sg = 0.0f;
    sigmoid_exact_f32(sc, sg);
    out_v = sc * sg;
}

@export
macro hyper_inject_weight_f32(v0, s_f, inv_s, out_v) {
    reg f32 sc = 0.0f;
    div_nr1_f32(v0, s_f, inv_s, sc);
    sc = bf16_lo(f32_to_bf16(sc));
    reg f32 sg = 0.0f;
    sigmoid_exact_f32(sc, sg);
    out_v = bf16_lo(f32_to_bf16(2.0f * bf16_lo(f32_to_bf16(sg))));
}

@export
macro hyper_mix_term_f32(u_val, n_val, out_v) {
    reg f32 sg = 0.0f;
    sigmoid_exact_f32(u_val, sg);
    out_v = bf16_lo(f32_to_bf16(bf16_lo(f32_to_bf16(sg)) * n_val));
}

@export
macro hyper_key_gate_f32(total, width_f, out_gate) {
    reg f32 inv_sw = rsqrt(width_f);
    inv_sw = inv_sw * fma(-0.5f * width_f, inv_sw * inv_sw, 1.5f);
    reg f32 sw = width_f * inv_sw;
    reg f32 sc0 = 0.0f;
    div_nr1_f32(bf16_lo(f32_to_bf16(total)), sw, inv_sw, sc0);
    reg f32 score = bf16_lo(f32_to_bf16(sc0));
    reg f32 mag_in = maxf(fabsf(score), 1.0e-6f);
    reg f32 inv_m = rsqrt(mag_in);
    inv_m = inv_m * fma(-0.5f * mag_in, inv_m * inv_m, 1.5f);
    reg f32 mag = bf16_lo(f32_to_bf16(mag_in * inv_m));
    reg f32 signed_m = (score < 0.0f) ? (0.0f - mag) : ((score > 0.0f) ? mag : 0.0f);
    reg f32 sg = 0.0f;
    sigmoid_exact_f32(signed_m, sg);
    out_gate = bf16_lo(f32_to_bf16(sg));
}

@export
macro f32_topk_key(val_f, out_key) {
    reg u32 b = f32_as_u32(val_f);
    out_key = b ^ (((b >> 31) != 0) ? 0xFFFFFFFF : 0x80000000);
}

@export
macro kv_shard_local_keys(degree, rank, grain, keys, out_local) {
    if (degree <= 1) {
        out_local = keys;
    } else {
        reg u32 span = grain * degree;
        reg u32 qk = 0; reg u32 rest = 0;
        u32_divmod(keys, span, qk, rest);
        reg u32 first = rank * grain;
        reg u32 extra = 0;
        if (rest > first) {
            extra = (rest - first < grain) ? (rest - first) : grain;
        }
        out_local = qk * grain + extra;
    }
}

@export
macro kv_shard_local_pos(degree, rank, grain, local, out_pos) {
    if (degree <= 1) {
        out_pos = local;
    } else {
        reg u32 q = 0; reg u32 r = 0;
        u32_divmod(local, grain, q, r);
        out_pos = (q * degree + rank) * grain + r;
    }
}

@export
macro warp_prefix_u32(val, lane) {
    reg u32 a1 = shfl_up(val, 1); if (lane >= 1) { val = val + a1; }
    reg u32 a2 = shfl_up(val, 2); if (lane >= 2) { val = val + a2; }
    reg u32 a4 = shfl_up(val, 4); if (lane >= 4) { val = val + a4; }
    reg u32 a8 = shfl_up(val, 8); if (lane >= 8) { val = val + a8; }
    reg u32 a16 = shfl_up(val, 16); if (lane >= 16) { val = val + a16; }
}

@export
macro kv_shard_slot_addr_gen(kv_view, seq, pos, page_slots, slot_bytes, out_addr, out_ok) {
    reg u32 page = 0; reg u32 slot_in_page = 0;
    u32_divmod(pos, page_slots, page, slot_in_page);
    kv_shard_slot_addr_page(kv_view, seq, pos, page, slot_in_page, page_slots, slot_bytes, out_addr, out_ok);
}

@export
macro tanh_exact_f32(x, out_t) {
    reg f32 ax = fabsf(x);
    reg f32 t = 1.0f;
    if (ax < 0.01f) {
        t = ax * fma(ax * ax, -0.3333333432674408f, 1.0f);
    } else if (ax < 9.0f) {
        reg f32 e = exp2_ftz((-2.0f * ax) * 1.4426950408889634f);
        reg f32 d = 1.0f + e;
        reg f32 inv_d = 0.0f;
        rcp_nr1_f32(d, inv_d);
        div_nr1_f32(1.0f - e, d, inv_d, t);
    }
    out_t = (x < 0.0f) ? (0.0f - t) : t;
}

@export
macro situ_exact_f32(g, u, beta, lin_beta, out_v) {
    reg f32 inv_b = 0.0f; rcp_nr1_f32(beta, inv_b);
    reg f32 gb = 0.0f; div_nr1_f32(g, beta, inv_b, gb);
    reg f32 tg = 0.0f; tanh_exact_f32(gb, tg);
    reg f32 sg = 0.0f; sigmoid_exact_f32(g, sg);
    reg f32 act = (beta * tg) * sg;
    reg f32 ue = u;
    if (lin_beta > 0.0f) {
        reg f32 inv_lb = 0.0f; rcp_nr1_f32(lin_beta, inv_lb);
        reg f32 ulb = 0.0f; div_nr1_f32(u, lin_beta, inv_lb, ulb);
        reg f32 tu = 0.0f; tanh_exact_f32(ulb, tu);
        ue = lin_beta * tu;
    }
    out_v = act * ue;
}

@export
macro warp_norm_sum_f32(val, lane, out_weight) {
    reg f32 tree = val;
    reg f32 o16 = shfl_down(tree, 16); if (lane < 16) { tree = tree + o16; }
    reg f32 o8 = shfl_down(tree, 8); if (lane < 8) { tree = tree + o8; }
    reg f32 o4 = shfl_down(tree, 4); if (lane < 4) { tree = tree + o4; }
    reg f32 o2 = shfl_down(tree, 2); if (lane < 2) { tree = tree + o2; }
    reg f32 o1 = shfl_down(tree, 1); if (lane < 1) { tree = tree + o1; }
    reg f32 tot = shfl_idx(tree, 0) + 1.0e-20f;
    reg f32 inv_t = 0.0f;
    rcp_nr1_f32(tot, inv_t);
    div_nr1_f32(val, tot, inv_t, out_weight);
}

@export
macro bf16_exact_2col_rows8(act_cnt, s_rows, activation, w0, w1, chunks, lane, a0, a1) {
    reg u64 a_ptr[8];
    unroll (r = 0..8) {
        reg u32 sr = lds32(s_rows, 0);
        if (r < act_cnt) { sr = lds32(s_rows, r); }
        a_ptr[r] = ptr_add(activation, sr * chunks, 16);
        a0[r] = 0.0f; a1[r] = 0.0f;
    }
    for (reg u32 c = lane; c < chunks; c += 32) {
        reg u32x4 vw0 = ldg128_stream(ptr_add(w0, c, 16));
        reg u32x4 vw1 = ldg128_stream(ptr_add(w1, c, 16));
        unroll (r = 0..8) {
            if (r < act_cnt) {
                reg u32x4 va = ldg128_persist(ptr_add(a_ptr[r], c, 16));
                bf16_dot8_acc(a0[r], vw0, va);
                bf16_dot8_acc(a1[r], vw1, va);
            }
        }
    }
}

@export
macro route_warp_hist_count(route_expert, routes, num_groups, wid, lane, w_hist, w_beg, w_end) {
    reg u32 slice = (routes + 7) >> 3;
    w_beg = wid * slice;
    w_end = (w_beg + slice < routes) ? (w_beg + slice) : routes;
    if (lane == 0) {
        for (reg u32 i = w_beg; i < w_end; i += 1) {
            reg u32 e = ldg32_persist(ptr_add(route_expert, i, 4));
            if (e < num_groups) {
                reg u32 idx = wid * num_groups + e;
                sts32(w_hist, idx, lds32(w_hist, idx) + 1);
            }
        }
    }
    barrier();
}

@export
macro route_warp_scatter(WRITE_EW, route_expert, route_weight, num_groups, top_k, wid, lane, w_beg, w_end, w_hist, route_packed_row, route_source_token, packed_expert, packed_weight) {
    if (lane == 0) {
        for (reg u32 i = w_beg; i < w_end; i += 1) {
            reg u32 e = ldg32_persist(ptr_add(route_expert, i, 4));
            if (e < num_groups) {
                reg u32 idx = wid * num_groups + e;
                reg u32 packed = lds32(w_hist, idx);
                sts32(w_hist, idx, packed + 1);
                stg32(ptr_add(route_packed_row, i, 4), packed);
                reg u32 src_tok = 0; reg u32 sr = 0;
                u32_divmod(i, top_k, src_tok, sr);
                stg32(ptr_add(route_source_token, packed, 4), src_tok);
                if constexpr (WRITE_EW == 1) {
                    stg32(ptr_add(packed_weight, packed, 4), ldg32_persist(ptr_add(route_weight, i, 4)));
                    stg32(ptr_add(packed_expert, packed, 4), e);
                }
            }
        }
    }
}

@export
macro route_f32_sort_key(val_f, out_key) {
    reg u32 b = f32_as_u32(val_f);
    if ((b & 0x7F800000) == 0x7F800000) {
        out_key = 0;
    } else {
        out_key = b ^ (((b >> 31) != 0) ? 0xFFFFFFFF : 0x80000000);
    }
}

@export
macro u32_argmax_step(ck, ci, bk, bi) {
    if (ck > bk) {
        bk = ck; bi = ci;
    } else if (ck == bk) {
        if (ci > bi) { bk = ck; bi = ci; }
    }
}

@export
macro warp_argmax_u32(bk, bi) {
    reg u32 ok16 = shfl_xor(bk, 16); reg u32 oi16 = shfl_xor(bi, 16);
    u32_argmax_step(ok16, oi16, bk, bi);
    reg u32 ok8 = shfl_xor(bk, 8); reg u32 oi8 = shfl_xor(bi, 8);
    u32_argmax_step(ok8, oi8, bk, bi);
    reg u32 ok4 = shfl_xor(bk, 4); reg u32 oi4 = shfl_xor(bi, 4);
    u32_argmax_step(ok4, oi4, bk, bi);
    reg u32 ok2 = shfl_xor(bk, 2); reg u32 oi2 = shfl_xor(bi, 2);
    u32_argmax_step(ok2, oi2, bk, bi);
    reg u32 ok1 = shfl_xor(bk, 1); reg u32 oi1 = shfl_xor(bi, 1);
    u32_argmax_step(ok1, oi1, bk, bi);
}

@export
macro fp8_e4m3_qdq_lane_bf16(val_f, out_bf16) {
    reg f32 am = fabsf(val_f);
    am = maxf(am, shfl_xor(am, 16));
    am = maxf(am, shfl_xor(am, 8));
    am = maxf(am, shfl_xor(am, 4));
    am = maxf(am, shfl_xor(am, 2));
    am = maxf(am, shfl_xor(am, 1));
    reg u32 sbits = pow2_ceil_e8m0_bits(maxf(am, 1.0e-4f)) << 23;
    reg f32 sc = u32_as_f32(sbits);
    reg f32 inv = u32_as_f32(0x7F000000 - sbits);
    reg u32 q = cvt_f32x2_e4m3x2(minf(maxf(val_f * inv, -448.0f), 448.0f), 0.0f);
    out_bf16 = f32_to_bf16(e4m3_to_f32(q & 0xFF) * sc);
}

@export
macro bounded_decay_f32(logit, bias, log_scale, min_log_decay, out_decay) {
    reg f32 scaled = exp2_ftz(log_scale * 1.4426950408889634f) * (logit + bias);
    reg f32 sg = 0.0f;
    sigmoid_exact_f32(scaled, sg);
    out_decay = exp2_ftz((min_log_decay * sg) * 1.4426950408889634f);
}

@export
macro sincos_exact_f32(angle, out_sin, out_cos) {
    reg f32 tmp = fma(angle, 0.6366197723675814f, 12582912.0f);
    reg u32 q = f32_as_u32(tmp) & 3;
    reg f32 kf = tmp - 12582912.0f;
    reg f32 r = fma(-kf, 1.5707962512969971f, angle);
    r = fma(-kf, 7.549789415861596e-8f, r);
    r = fma(-kf, -5.3903025299577647e-15f, r);
    reg f32 r2 = r * r;
    reg f32 s = fma(r2, -1.9515295891e-4f, 8.3321608736e-3f);
    s = fma(r2, s, -1.6666654611e-1f);
    s = fma(r2 * r, s, r);
    reg f32 c = fma(r2, 2.443315711809948e-5f, -1.388731625493765e-3f);
    c = fma(r2, c, 4.166664568298827e-2f);
    c = fma(r2 * r2, c, fma(-0.5f, r2, 1.0f));
    if (q == 0) {
        out_sin = s;
        out_cos = c;
    } else if (q == 1) {
        out_sin = c;
        out_cos = -s;
    } else if (q == 2) {
        out_sin = -s;
        out_cos = -c;
    } else {
        out_sin = -c;
        out_cos = s;
    }
}

@export
macro exp_exact_f32(x, out_e) {
    reg f32 xc = minf(maxf(x, -88.0f), 88.0f);
    reg f32 xl = xc * 1.4426950216293334961f;
    reg f32 kf = fma(xc, 1.4426950216293334961f, 12582912.0f) - 12582912.0f;
    if (kf > xl) { kf = kf - 1.0f; }
    reg f32 frac = fma(xc, 1.925963033500011079e-8f, fma(xc, 1.4426950216293334961f, -kf));
    reg f32 e = exp2_ftz(frac) * exp2_ftz(kf);
    out_e = (x < -88.0f) ? 0.0f : e;
}

@export
macro sqrt_softplus_f32(val_f, out_v) {
    reg f32 sp = val_f;
    if (val_f <= 20.0f) {
        reg f32 ex = 0.0f;
        exp_exact_f32(val_f, ex);
        reg u32 eb = (f32_as_u32(ex + 1.0f) - 0x3F400000) & 0xFF800000;
        reg f32 ef = u32_to_f32(eb >> 23);
        reg f32 m = u32_as_f32(f32_as_u32(ex) - eb) + (u32_as_f32(0x3F800000 - eb) - 1.0f);
        reg f32 p = fma(m, -0.04534861445426941f, 0.10546888411045074463f);
        p = fma(m, p, -0.13229703903198242188f);
        p = fma(m, p, 0.14491446316242218018f);
        p = fma(m, p, -0.16641564667224884033f);
        p = fma(m, p, 0.19988867640495300293f);
        p = fma(m, p, -0.25000196695327758789f);
        p = fma(m, p, 0.33333510160446166992f);
        p = fma(m, p, -0.5f);
        p = fma(m, m * p, m);
        sp = fma(ef, 0.69314718246459960938f, p);
    }
    if (sp > 0.0f) {
        reg f32 r = rsqrt(sp);
        reg f32 s = sp * r;
        out_v = fma(fma(-s, s, sp), r * 0.5f, s);
    } else {
        out_v = 0.0f;
    }
}

@export
macro fused_last_arrival(counter_ptr, arrivals, tid, s_last, out_last) {
    membar_gpu();
    barrier();
    if (tid == 0) {
        reg u32 prev = atomg_add_u32(counter_ptr, 1);
        reg u32 is_last = (prev + 1 == arrivals) ? 1 : 0;
        if (is_last != 0) {
            reg u32 dummy = atomg_exch_u32(counter_ptr, 0);
            is_last = (dummy == dummy) ? 1 : 1;
        }
        sts32(s_last, 0, is_last);
    }
    barrier();
    out_last = lds32(s_last, 0);
    if (out_last != 0) {
        membar_gpu();
    }
}

@export
macro bf16x8_sumsq(v, sq) {
    unroll (bk_ = 0..4) {
        reg f32 x0 = bf16_lo(v[bk_]);
        reg f32 x1 = bf16_hi(v[bk_]);
        sq = fma(x0, x0, sq);
        sq = fma(x1, x1, sq);
    }
}

@export
macro bf16x8_add(a, b) {
    unroll (bk_ = 0..4) {
        a[bk_] = pack_bf16x2(bf16_lo(a[bk_]) + bf16_lo(b[bk_]), bf16_hi(a[bk_]) + bf16_hi(b[bk_]));
    }
}

@export
macro bf16x8_fma_scalar(acc, v, wt) {
    reg u32x4 bv_ = v;
    unroll (bk_ = 0..4) {
        acc[bk_ * 2] = fma(bf16_lo(bv_[bk_]), wt, acc[bk_ * 2]);
        acc[bk_ * 2 + 1] = fma(bf16_hi(bv_[bk_]), wt, acc[bk_ * 2 + 1]);
    }
}

@export
macro bf16x8_scale_weight(W_F32, ROUND_MID, CENTERED, sv, w_ptr, v_idx, scale) {
    if constexpr (W_F32 == 1) {
        reg u32x8 wv = ldg256_persist(ptr_add(w_ptr, v_idx, 32));
        unroll (k = 0..4) {
            reg f32 a = bf16_lo(sv[k]) * scale;
            reg f32 b = bf16_hi(sv[k]) * scale;
            if constexpr (ROUND_MID == 1) { a = bf16_lo(f32_to_bf16(a)); b = bf16_lo(f32_to_bf16(b)); }
            sv[k] = pack_bf16x2(a * u32_as_f32(wv[k * 2]), b * u32_as_f32(wv[k * 2 + 1]));
        }
    } else {
        reg u32x4 wv = ldg128_persist(ptr_add(w_ptr, v_idx, 16));
        unroll (k = 0..4) {
            reg f32 a = bf16_lo(sv[k]) * scale;
            reg f32 b = bf16_hi(sv[k]) * scale;
            if constexpr (ROUND_MID == 1) { a = bf16_lo(f32_to_bf16(a)); b = bf16_lo(f32_to_bf16(b)); }
            reg f32 w0 = bf16_lo(wv[k]);
            reg f32 w1 = bf16_hi(wv[k]);
            if constexpr (CENTERED == 1) { w0 = 1.0f + w0; w1 = 1.0f + w1; }
            sv[k] = pack_bf16x2(a * w0, b * w1);
        }
    }
}

@export
macro copy_bf16_1d(src, dst, width, tid, stride) {
    if (((width & 7) | (src[0] & 15) | (dst[0] & 15)) == 0) {
        reg u32 vecs = width >> 3;
        for (reg u32 v = tid; v < vecs; v += stride) {
            stg128(ptr_add(dst, v, 16), ldg128_stream(ptr_add(src, v, 16)));
        }
    } else {
        for (reg u32 idx = tid; idx < width; idx += stride) {
            stg16(ptr_add(dst, idx, 2), ldg16_stream(ptr_add(src, idx, 2)));
        }
    }
}

@export
macro rope_pair_bf16_u32(bits, sn, cs, out_bits) {
    reg f32 re = bf16_lo(bits);
    reg f32 im = bf16_hi(bits);
    out_bits = pack_bf16x2(fma(re, cs, 0.0f - im * sn), fma(re, sn, im * cs));
}

@export
macro row_active_keys(row, seq, len, bound, out_active) {
    reg u32 s = ldg32_persist(ptr_add(seq, row, 4));
    out_active = ldg32_persist(ptr_add(len, s, 4));
    if ((bound[0] | bound[1]) != 0) {
        reg u32 b = ldg32_persist(ptr_add(bound, row, 4));
        if (b == 0xFFFFFFFF) {
            out_active = 0;
        } else if (b + 1 < out_active) {
            out_active = b + 1;
        }
    }
}

@export
macro warp_sq_bcast(val, out_sq) {
    reg f32 sq = val * val;
    warp_sum_down(sq);
    out_sq = shfl_idx(sq, 0);
}

@export
macro relu4_weighted_reduce(c0, c1, w0, w1, w2, w3, out_lo, out_hi) {
    out_lo = fma(w3, maxf(c1[2], 0.0f), fma(w2, maxf(c1[0], 0.0f), fma(w1, maxf(c0[2], 0.0f), w0 * maxf(c0[0], 0.0f))));
    out_hi = fma(w3, maxf(c1[3], 0.0f), fma(w2, maxf(c1[1], 0.0f), fma(w1, maxf(c0[3], 0.0f), w0 * maxf(c0[1], 0.0f))));
    out_lo = out_lo + shfl_xor(out_lo, 4); out_hi = out_hi + shfl_xor(out_hi, 4);
    out_lo = out_lo + shfl_xor(out_lo, 8); out_hi = out_hi + shfl_xor(out_hi, 8);
    out_lo = out_lo + shfl_xor(out_lo, 16); out_hi = out_hi + shfl_xor(out_hi, 16);
}

@export
macro bf16x8_acc_add(sum, raw) {
    reg u32x4 br_ = raw;
    unroll (bk_ = 0..4) {
        sum[bk_ * 2] = sum[bk_ * 2] + bf16_lo(br_[bk_]);
        sum[bk_ * 2 + 1] = sum[bk_ * 2 + 1] + bf16_hi(br_[bk_]);
    }
}

@export
macro bf16x8_pack_f32(sum, out_v) {
    unroll (bk_ = 0..4) { out_v[bk_] = pack_bf16x2(sum[bk_ * 2], sum[bk_ * 2 + 1]); }
}

@export
macro fp8_e4m3_quant8_pow2(v, out_c0, out_c1, out_sbits) {
    reg f32 am = maxf(maxf(fabsf(v[0]), fabsf(v[1])), maxf(fabsf(v[2]), fabsf(v[3])));
    am = maxf(am, maxf(maxf(fabsf(v[4]), fabsf(v[5])), maxf(fabsf(v[6]), fabsf(v[7]))));
    am = maxf(am, shfl_xor(am, 1)); am = maxf(am, shfl_xor(am, 2));
    out_sbits = pow2_ceil_e8m0_bits(maxf(am, 1.0e-4f)) << 23;
    reg f32 inv = u32_as_f32(0x7F000000 - out_sbits);
    reg u32 p0 = cvt_f32x2_e4m3x2(minf(maxf(v[0] * inv, -448.0f), 448.0f), minf(maxf(v[1] * inv, -448.0f), 448.0f));
    reg u32 p1 = cvt_f32x2_e4m3x2(minf(maxf(v[2] * inv, -448.0f), 448.0f), minf(maxf(v[3] * inv, -448.0f), 448.0f));
    reg u32 p2 = cvt_f32x2_e4m3x2(minf(maxf(v[4] * inv, -448.0f), 448.0f), minf(maxf(v[5] * inv, -448.0f), 448.0f));
    reg u32 p3 = cvt_f32x2_e4m3x2(minf(maxf(v[6] * inv, -448.0f), 448.0f), minf(maxf(v[7] * inv, -448.0f), 448.0f));
    out_c0 = p0 | (p1 << 16); out_c1 = p2 | (p3 << 16);
}

@export
macro fp8_e4m3_dequant8_bf16(c0, c1, sbits, out_u4) {
    reg f32 sc = u32_as_f32(sbits);
    reg f32x4 d0 = cvt_e4m3x4_f32x4(c0); reg f32x4 d1 = cvt_e4m3x4_f32x4(c1);
    out_u4 = pack_u32x4(pack_bf16x2(d0[0] * sc, d0[1] * sc), pack_bf16x2(d0[2] * sc, d0[3] * sc), pack_bf16x2(d1[0] * sc, d1[1] * sc), pack_bf16x2(d1[2] * sc, d1[3] * sc));
}

@export
macro sqrt_nr1_f32(x, out_s) {
    if (x <= 0.0f) { out_s = 0.0f; }
    else { reg f32 r_ = rsqrt(x); r_ = r_ * fma(-0.5f * x, r_ * r_, 1.5f); out_s = x * r_; }
}

@export
macro engram_source_rank(id_val, part_val, table_rows, out_src) {
    out_src = 0xFFFFFFFF;
    if ((id_val[1] >> 31) == 0) {
        reg u32 lt_ = 0;
        if (id_val[1] < table_rows[1]) { lt_ = 1; }
        else { if (id_val[1] == table_rows[1] && id_val[0] < table_rows[0]) { lt_ = 1; } }
        if (lt_ != 0) { reg u32 q_ = 0; reg u32 r_ = 0; u32_divmod(id_val[0], part_val[0], q_, r_); out_src = q_; }
    }
}

@export
macro block_reduce_max_f32(val, s_red, wid, lane, out_max) {
    reg f32 wm_ = warp_max(val);
    if (lane == 0) { sts32(s_red, wid, wm_); }
    barrier();
    reg f32 bm_ = u32_as_f32(0xFF800000); if (lane < 8) { bm_ = lds32(s_red, lane); }
    out_max = shfl_idx(warp_max(bm_), 0);
}

@export
macro pdl_row_prologue(rows, out_row, out_tid, out_wid, out_lane) {
    acqbulk();
    out_row = ctaid_x();
    if (out_row >= rows) { preexit(); return; }
    out_tid = tid_x(); out_wid = warp_id(); out_lane = lane_id();
}

@export
macro kv_emit_slot_addr(view, emit_row, seq_of_row, page_slots, slot_bytes, out_row, out_slot) {
    acqbulk();
    out_row = ctaid_x();
    reg u32 pos_ = ldg32_persist(ptr_add(emit_row, out_row, 4));
    if (pos_ == 0xFFFFFFFF) { preexit(); return; }
    reg u32 ok_ = 0;
    kv_shard_slot_addr_gen(view, ldg32_persist(ptr_add(seq_of_row, out_row, 4)), pos_, page_slots, slot_bytes, out_slot, ok_);
    if (ok_ == 0) { preexit(); return; }
}
