@export
macro u32_divmod(num, den, out_q, out_r) {
    reg u32 qv = 0;
    reg u32 rv = 0;
    reg u32 nv = num;
    for (reg u32 bit = 0; bit < 32; bit += 1) {
        rv = (rv << 1) | (nv >> 31);
        nv = nv << 1;
        qv = qv << 1;
        if (rv >= den) {
            rv = rv - den;
            qv = qv | 1;
        }
    }
    out_q = qv;
    out_r = rv;
}

@export
macro warp_sum_down(val) {
    val = val + shfl_down(val, 16);
    val = val + shfl_down(val, 8);
    val = val + shfl_down(val, 4);
    val = val + shfl_down(val, 2);
    val = val + shfl_down(val, 1);
}

@export
macro block_reduce_sum_exact(total, reduction, wid, lane, out_sum) {
    warp_sum_down(total);
    if (lane == 0) { sts32(reduction, wid, total); }
    barrier();
    reg f32 b = 0.0f;
    if (lane < 8) { b = lds32(reduction, lane); }
    b = b + shfl_down(b, 4);
    b = b + shfl_down(b, 2);
    b = b + shfl_down(b, 1);
    out_sum = shfl_idx(b, 0);
}

@export
macro block_reduce_max_exact(val, reduction, wid, lane, out_max) {
    val = maxf(val, shfl_down(val, 16));
    val = maxf(val, shfl_down(val, 8));
    val = maxf(val, shfl_down(val, 4));
    val = maxf(val, shfl_down(val, 2));
    val = maxf(val, shfl_down(val, 1));
    if (lane == 0) { sts32(reduction, wid, val); }
    barrier();
    reg f32 b = u32_as_f32(0xFF800000);
    if (lane < 8) { b = lds32(reduction, lane); }
    b = maxf(b, shfl_down(b, 4));
    b = maxf(b, shfl_down(b, 2));
    b = maxf(b, shfl_down(b, 1));
    out_max = shfl_idx(b, 0);
}

@export
macro rcp_nr1_f32(denom, out_inv) {
    reg f32 r = rcp(denom);
    out_inv = fma(r, fma(-denom, r, 1.0f), r);
}

@export
macro rcp_nr2_f32(denom, out_inv) {
    reg f32 r = rcp(denom);
    r = fma(r, fma(-denom, r, 1.0f), r);
    out_inv = fma(r, fma(-denom, r, 1.0f), r);
}

@export
macro div_nr1_f32(num, denom, inv_d, out_q) {
    reg f32 q = num * inv_d;
    out_q = fma(inv_d, fma(-denom, q, num), q);
}

@export
macro rsqrt_exact_div(sum_sq, dim_f, eps, out_scale) {
    reg f32 r = 0.0f;
    rcp_nr1_f32(dim_f, r);
    reg f32 q = 0.0f;
    div_nr1_f32(sum_sq, dim_f, r, q);
    out_scale = rsqrt(q + eps);
}

@export
macro silu_exact_f32(g, out_q) {
    reg f32 d = exp2_ftz(g * -1.4426950408889634f) + 1.0f;
    reg f32 r = 0.0f;
    rcp_nr1_f32(d, r);
    div_nr1_f32(g, d, r, out_q);
}

@export
macro sigmoid_exact_f32(g, out_s) {
    reg f32 d = exp2_ftz(g * -1.4426950408889634f) + 1.0f;
    rcp_nr2_f32(d, out_s);
}

@export
macro argmax_tiebreak_step(cand_s, cand_i, best_s, best_i) {
    if (cand_s > best_s) {
        best_s = cand_s;
        best_i = cand_i;
    } else if (cand_s == best_s) {
        if (cand_i < best_i) {
            best_s = cand_s;
            best_i = cand_i;
        }
    }
}

@export
macro warp_argmax_tiebreak(best_s, best_i) {
    reg f32 os16 = shfl_down(best_s, 16);
    reg u32 oi16 = shfl_down(best_i, 16);
    argmax_tiebreak_step(os16, oi16, best_s, best_i);
    reg f32 os8 = shfl_down(best_s, 8);
    reg u32 oi8 = shfl_down(best_i, 8);
    argmax_tiebreak_step(os8, oi8, best_s, best_i);
    reg f32 os4 = shfl_down(best_s, 4);
    reg u32 oi4 = shfl_down(best_i, 4);
    argmax_tiebreak_step(os4, oi4, best_s, best_i);
    reg f32 os2 = shfl_down(best_s, 2);
    reg u32 oi2 = shfl_down(best_i, 2);
    argmax_tiebreak_step(os2, oi2, best_s, best_i);
    reg f32 os1 = shfl_down(best_s, 1);
    reg u32 oi1 = shfl_down(best_i, 1);
    argmax_tiebreak_step(os1, oi1, best_s, best_i);
}

@export
macro block_argmax_tiebreak_to_smem(best_s, best_i, sh_s, sh_i, wid, lane) {
    warp_argmax_tiebreak(best_s, best_i);
    if (lane == 0) {
        sts32(sh_s, wid, best_s);
        sts32(sh_i, wid, best_i);
    }
    barrier();
}

@export
macro block_argmax_tiebreak_finish(sh_s, sh_i, out_s, out_i) {
    out_s = lds32(sh_s, 0);
    out_i = lds32(sh_i, 0);
    unroll (w = 1..8) {
        reg f32 ws = lds32(sh_s, w);
        reg u32 wi = lds32(sh_i, w);
        argmax_tiebreak_step(ws, wi, out_s, out_i);
    }
}

@export
macro softplus_exact_f32(x, out_sp) {
    if (x > 20.0f) {
        out_sp = x;
    } else if (x < -12.0f) {
        out_sp = exp2_ftz(x * 1.4426950408889634f);
    } else {
        reg f32 y = exp2_ftz(x * 1.4426950408889634f) + 1.0f;
        reg u32 yb = f32_as_u32(y);
        reg u32 e = ((yb >> 23) & 0xFF) - 127;
        reg f32 m = u32_as_f32((yb & 0x007FFFFF) | 0x3F800000);
        if (m > 1.4142135623730951f) {
            m = m * 0.5f;
            e = e + 1;
        }
        reg f32 inv_mp = 0.0f;
        rcp_nr1_f32(m + 1.0f, inv_mp);
        reg f32 z = (m - 1.0f) * inv_mp;
        reg f32 z2 = z * z;
        reg f32 p = fma(0.1428571492433548f, z2, 0.20000000298023224f);
        p = fma(p, z2, 0.3333333432674408f);
        p = fma(p, z2, 1.0f);
        out_sp = fma(u32_to_f32(e), 0.6931471805599453f, (z + z) * p);
    }
}

@export
macro gdn_decay_f32(a_log, shifted, out_decay) {
    reg f32 sp = 0.0f;
    softplus_exact_f32(shifted, sp);
    reg f32 a_exp = exp2_ftz(a_log * 1.4426950408889634f);
    out_decay = exp2_ftz((-a_exp * sp) * 1.4426950408889634f);
}

@export
macro sincos_pos_f32(angle, out_sin, out_cos) {
    reg f32 turns = fmul_rz(angle, 0.15915493667125702f);
    out_sin = sin_ftz(turns);
    out_cos = cos_ftz(turns);
}

@export
macro kv_shard_slot_addr_page(kv_view, seq, pos, page, slot_in_page, page_slots, slot_bytes, out_addr, out_ok) {
    out_ok = 0;
    out_addr = param_u64(kv_view, 0);
    reg u32 pt_stride = param_u32(kv_view, 16);
    reg u32 seq_cnt = param_u32(kv_view, 20);
    reg u32 pool_pages = param_u32(kv_view, 24);
    reg u32 degree = param_u32(kv_view, 40);
    if (seq < seq_cnt && page < pt_stride) {
        reg u32 owns = 1;
        reg u32 sip = slot_in_page;
        reg u32 sh_page_slots = page_slots;
        if (degree > 1) {
            reg u32 rank = param_u32(kv_view, 44);
            reg u32 grain = param_u32(kv_view, 48);
            reg u32 qg = 0; reg u32 rg = 0;
            u32_divmod(pos, grain, qg, rg);
            reg u32 qd = 0; reg u32 owner = 0;
            u32_divmod(qg, degree, qd, owner);
            if (owner != rank) {
                owns = 0;
            } else {
                reg u32 span = grain * degree;
                reg u32 sq = 0; reg u32 sr = 0;
                u32_divmod(sip, span, sq, sr);
                reg u32 gq = 0; reg u32 gr = 0;
                u32_divmod(sip, grain, gq, gr);
                sip = sq * grain + gr;
                reg u32 psr = 0;
                u32_divmod(page_slots, degree, sh_page_slots, psr);
            }
        }
        if (owns != 0) {
            reg u64 pt_ptr = param_u64(kv_view, 8);
            reg u32 phys = ldg32_persist(ptr_add(pt_ptr, seq * pt_stride + page, 4));
            if (phys < pool_pages) {
                out_addr = ptr_add(out_addr, phys * sh_page_slots + sip, slot_bytes);
                out_ok = 1;
            }
        }
    }
}

@export
macro kv_shard_slot_addr(kv_view, seq, pos, slot_bytes, out_addr, out_ok) {
    kv_shard_slot_addr_page(kv_view, seq, pos, pos >> 6, pos & 63, 64, slot_bytes, out_addr, out_ok);
}

@export
macro bf16_dot8_acc(acc, wv, av) {
    reg f32 p0 = fma(bf16_lo(wv[0]), bf16_lo(av[0]), 0.0f);
    reg f32 p1 = bf16_hi(wv[0]) * bf16_hi(av[0]);
    unroll (k = 1..4) {
        p0 = fma(bf16_lo(wv[k]), bf16_lo(av[k]), p0);
        p1 = fma(bf16_hi(wv[k]), bf16_hi(av[k]), p1);
    }
    acc = fma(1.0f, p0 + p1, acc);
}

@export
macro lanes_reduce_sum(LANES, val) {
    if constexpr (LANES == 32) { val = warp_sum(val); }
    else if constexpr (LANES == 16) {
        val = val + shfl_xor(val, 8);
        val = val + shfl_xor(val, 4);
        val = val + shfl_xor(val, 2);
        val = val + shfl_xor(val, 1);
    } else {
        val = oct_sum(val);
    }
}

@export
macro nvfp4_ue4m3_decode(byte_val, gscale, out_sc) {
    reg u32 m = byte_val & 0x7F;
    m = m - (((m + 1) >> 7) & 1);
    out_sc = ue4m3_to_f32(m) * gscale;
}

@export
macro nvfp4_e2m1_dot16(w_lo, w_hi, a_lo, a_hi, out_dot) {
    reg f32x4 d0 = cvt_e2m1x4_f32x4(w_lo, 0);
    reg f32 a0 = d0.x * bf16_lo(a_lo[0]);
    reg f32 a1 = d0.y * bf16_hi(a_lo[0]);
    reg f32 a2 = d0.z * bf16_lo(a_lo[1]);
    reg f32 a3 = d0.w * bf16_hi(a_lo[1]);
    reg f32x4 d1 = cvt_e2m1x4_f32x4(w_lo, 16);
    a0 = fma(d1.x, bf16_lo(a_lo[2]), a0);
    a1 = fma(d1.y, bf16_hi(a_lo[2]), a1);
    a2 = fma(d1.z, bf16_lo(a_lo[3]), a2);
    a3 = fma(d1.w, bf16_hi(a_lo[3]), a3);
    reg f32x4 d2 = cvt_e2m1x4_f32x4(w_hi, 0);
    a0 = fma(d2.x, bf16_lo(a_hi[0]), a0);
    a1 = fma(d2.y, bf16_hi(a_hi[0]), a1);
    a2 = fma(d2.z, bf16_lo(a_hi[1]), a2);
    a3 = fma(d2.w, bf16_hi(a_hi[1]), a3);
    reg f32x4 d3 = cvt_e2m1x4_f32x4(w_hi, 16);
    a0 = fma(d3.x, bf16_lo(a_hi[2]), a0);
    a1 = fma(d3.y, bf16_hi(a_hi[2]), a1);
    a2 = fma(d3.z, bf16_lo(a_hi[3]), a2);
    a3 = fma(d3.w, bf16_hi(a_hi[3]), a3);
    out_dot = (a0 + a1) + (a2 + a3);
}

@export
macro hyper_gate_f32(v0, s_f, inv_s, out_v) {
    reg f32 sc = 0.0f;
    div_nr1_f32(v0, s_f, inv_s, sc);
    sc = bf16_lo(f32_to_bf16(sc));
    reg f32 sg = 0.0f;
    sigmoid_exact_f32(sc, sg);
    out_v = sc * sg;
}

@export
macro hyper_inject_weight_f32(v0, s_f, inv_s, out_v) {
    reg f32 sc = 0.0f;
    div_nr1_f32(v0, s_f, inv_s, sc);
    sc = bf16_lo(f32_to_bf16(sc));
    reg f32 sg = 0.0f;
    sigmoid_exact_f32(sc, sg);
    out_v = bf16_lo(f32_to_bf16(2.0f * bf16_lo(f32_to_bf16(sg))));
}

@export
macro hyper_mix_term_f32(u_val, n_val, out_v) {
    reg f32 sg = 0.0f;
    sigmoid_exact_f32(u_val, sg);
    out_v = bf16_lo(f32_to_bf16(bf16_lo(f32_to_bf16(sg)) * n_val));
}

@export
macro hyper_key_gate_f32(total, width_f, out_gate) {
    reg f32 inv_sw = rsqrt(width_f);
    inv_sw = inv_sw * fma(-0.5f * width_f, inv_sw * inv_sw, 1.5f);
    reg f32 sw = width_f * inv_sw;
    reg f32 sc0 = 0.0f;
    div_nr1_f32(bf16_lo(f32_to_bf16(total)), sw, inv_sw, sc0);
    reg f32 score = bf16_lo(f32_to_bf16(sc0));
    reg f32 mag_in = maxf(fabsf(score), 1.0e-6f);
    reg f32 inv_m = rsqrt(mag_in);
    inv_m = inv_m * fma(-0.5f * mag_in, inv_m * inv_m, 1.5f);
    reg f32 mag = bf16_lo(f32_to_bf16(mag_in * inv_m));
    reg f32 signed_m = (score < 0.0f) ? (0.0f - mag) : ((score > 0.0f) ? mag : 0.0f);
    reg f32 sg = 0.0f;
    sigmoid_exact_f32(signed_m, sg);
    out_gate = bf16_lo(f32_to_bf16(sg));
}

@export
macro f32_topk_key(val_f, out_key) {
    reg u32 b = f32_as_u32(val_f);
    out_key = b ^ (((b >> 31) != 0) ? 0xFFFFFFFF : 0x80000000);
}

@export
macro kv_shard_local_keys(degree, rank, grain, keys, out_local) {
    if (degree <= 1) {
        out_local = keys;
    } else {
        reg u32 span = grain * degree;
        reg u32 qk = 0; reg u32 rest = 0;
        u32_divmod(keys, span, qk, rest);
        reg u32 first = rank * grain;
        reg u32 extra = 0;
        if (rest > first) {
            extra = (rest - first < grain) ? (rest - first) : grain;
        }
        out_local = qk * grain + extra;
    }
}

@export
macro kv_shard_local_pos(degree, rank, grain, local, out_pos) {
    if (degree <= 1) {
        out_pos = local;
    } else {
        reg u32 q = 0; reg u32 r = 0;
        u32_divmod(local, grain, q, r);
        out_pos = (q * degree + rank) * grain + r;
    }
}

@export
macro kv_shard_slot_addr_gen(kv_view, seq, pos, page_slots, slot_bytes, out_addr, out_ok) {
    reg u32 page = 0; reg u32 slot_in_page = 0;
    u32_divmod(pos, page_slots, page, slot_in_page);
    kv_shard_slot_addr_page(kv_view, seq, pos, page, slot_in_page, page_slots, slot_bytes, out_addr, out_ok);
}
