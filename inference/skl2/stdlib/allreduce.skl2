import "stdlib/epilogues.skl2";

primitive std.allreduce @v1 {
    concept = allreduce;
    arch = sm_121a;
    variant hybrid_inline_128 {
        kernel = allreduce_wqe_stg128;
        transport = rdma_inline_wqe;
        store_isa = stg128_sys;
        fence = membar_sys;
        max_inline_bytes = 16384;
    }
    variant hybrid_dma_ring {
        kernel = allreduce_combine_rmsnorm_bf16;
        transport = rdma_write_ring;
        load_isa = ldg256_stream;
        epilogue = rmsnorm;
    }
    variant two_d_4x4 {
        kernel = allreduce_combine_rmsnorm_bf16;
        transport = two_d_mesh_rs_ag;
        row_ranks = 4;
        col_ranks = 4;
    }
    policy {
        when msg_bytes <= 16384 && ranks <= 16 => hybrid_inline_128;
        when msg_bytes > 16384 && topology == "2d_4x4" => two_d_4x4;
        default => hybrid_dma_ring;
    }
    fuse {
        gemv + allreduce -> linear_ar;
        allreduce + norm -> ar_rmsnorm;
    }
}

primitive std.allreduce @v2 {
    concept = allreduce;
    arch = sm_121a;
    variant hybrid_single_acquire_128 {
        kernel = allreduce_wqe_stg128;
        transport = rdma_single_acquire_rs_ag;
        store_isa = stg128_sys;
        fence = membar_sys;
        isolated_cpu_seq_cacheline = true;
        single_thread_doorbell = true;
        max_inline_bytes = 16384;
    }
    variant hybrid_dma_ring {
        kernel = allreduce_combine_rmsnorm_bf16;
        transport = rdma_write_ring;
        load_isa = ldg256_stream;
        epilogue = rmsnorm;
    }
    variant two_d_4x4 {
        kernel = allreduce_combine_rmsnorm_bf16;
        transport = two_d_mesh_rs_ag;
        row_ranks = 4;
        col_ranks = 4;
    }
    policy {
        when msg_bytes <= 16384 && ranks <= 16 => hybrid_single_acquire_128;
        when msg_bytes > 16384 && topology == "2d_4x4" => two_d_4x4;
        default => hybrid_dma_ring;
    }
    fuse {
        gemv + allreduce -> linear_ar;
        allreduce + norm -> ar_rmsnorm;
    }
}

primitive std.allreduce @v3 {
    concept = allreduce;
    arch = sm_121a;
    variant hybrid_fused_1cta_128 {
        kernel = allreduce_wqe_stg128;
        transport = rdma_fused_1cta_rs_ag;
        store_isa = stg128_sys;
        load_isa = ldg256_stream;
        fence = membar_sys;
        gpu_devcache_align16 = true;
        isolated_cpu_seq_cacheline = true;
        single_thread_doorbell = true;
        idle_warp_revalidate_overlap = true;
        hidden_self_copy = true;
        fused_one_phase_ops = "pair_gather,all_gather,all_to_all,max_u64";
        max_fused_bytes = 131072;
        max_inline_bytes = 828;
    }
    variant hybrid_dma_ring {
        kernel = allreduce_combine_rmsnorm_bf16;
        transport = rdma_write_ring;
        load_isa = ldg256_stream;
        epilogue = rmsnorm;
    }
    variant two_d_4x4 {
        kernel = allreduce_combine_rmsnorm_bf16;
        transport = two_d_mesh_rs_ag;
        row_ranks = 4;
        col_ranks = 4;
    }
    policy {
        when msg_bytes <= 131072 && ranks <= 16 && topology == "hybrid_mode0" => hybrid_fused_1cta_128;
        when msg_bytes <= 16384 && ranks <= 16 => hybrid_fused_1cta_128;
        when msg_bytes > 16384 && topology == "2d_4x4" => two_d_4x4;
        default => hybrid_dma_ring;
    }
    fuse {
        gemv + allreduce -> linear_ar;
        allreduce + norm -> ar_rmsnorm;
    }
}

@concept(allreduce)
@pdl
kernel[128, 32] allreduce_wqe_stg128(
    global u32* wqe_ring,
    global u32* doorbell_reg,
    global u32* payload_src,
    u32 wqe_words4,
    u32 doorbell_val
) {
    acqbulk();
    reg u32 tid = ctaid_x() * 128 + tid_x();
    if (tid < wqe_words4) {
        reg u32x4 seg = ldg128_stream(ptr_add(payload_src, tid, 16));
        stg128_sys(ptr_add(wqe_ring, tid, 16), seg);
    }
    barrier();
    if (tid == 0) {
        membar_sys();
        stg32_sys(doorbell_reg, doorbell_val);
    }
    preexit();
}

@concept(allreduce)
@pdl
kernel[256, 64] allreduce_combine_rmsnorm_bf16(
    global u32* rank0_bf16,
    global u32* rank1_bf16,
    global u32* weight_bf16,
    global u32* out_bf16,
    u32 rows,
    u32 chunks16,
    f32 eps,
    f32 inv_dim
) {
    shared f32 smem[8];
    acqbulk();
    reg u32 row = ctaid_x();
    if (row >= rows) {
        preexit();
        return;
    }
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    ureg u64 p0 = ptr_add(rank0_bf16, row * chunks16, 32);
    ureg u64 p1 = ptr_add(rank1_bf16, row * chunks16, 32);
    ureg u64 po = ptr_add(out_bf16, row * chunks16, 32);
    reg f32 s0 = 0.0f;
    reg f32 s1 = 0.0f;
    for (reg u32 c = tid; c < chunks16; c += 256) {
        reg u32x8 a = ldg256_stream(ptr_add(p0, c, 32));
        reg u32x8 b = ldg256_stream(ptr_add(p1, c, 32));
        unroll (k = 0..8) {
            reg f32 lo = bf16_lo(a[k]) + bf16_lo(b[k]);
            reg f32 hi = bf16_hi(a[k]) + bf16_hi(b[k]);
            s0 = fma(lo, lo, s0);
            s1 = fma(hi, hi, s1);
            a[k] = pack_bf16x2(lo, hi);
        }
        stg256(ptr_add(p0, c, 32), a);
    }
    reg f32 wsum = warp_sum(s0 + s1);
    if (lane == 0) {
        sts32(smem, wid, wsum);
    }
    barrier();
    reg f32 bsum = 0.0f;
    unroll (w = 0..8) {
        bsum = bsum + lds32(smem, w);
    }
    reg f32 inv_rms = rsqrt(fma(bsum, inv_dim, eps));
    for (reg u32 c = tid; c < chunks16; c += 256) {
        reg u32x8 hv = ldg256_persist(ptr_add(p0, c, 32));
        reg u32x8 wv = ldg256_persist(ptr_add(weight_bf16, c, 32));
        unroll (k = 0..8) {
            hv[k] = pack_bf16x2(bf16_lo(hv[k]) * inv_rms * bf16_lo(wv[k]), bf16_hi(hv[k]) * inv_rms * bf16_hi(wv[k]));
        }
        stg256(ptr_add(po, c, 32), hv);
    }
    preexit();
}
