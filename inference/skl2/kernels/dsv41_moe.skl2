import "stdlib/math.skl2";

const D41M_BLK256 = 256;
const D41M_BLK128 = 128;
const D41M_HC = 4;

macro d41_gate_limited_glu(g, u, limit, out_v) {
    reg f32 lim = minf(g, limit);
    reg f32 clp = minf(maxf(u, 0.0f - limit), limit);
    reg f32 sv = 0.0f;
    silu_exact_f32(lim, sv);
    out_v = sv * clp;
}

macro d41_swiglu8_vec(g_raw, u_raw, weight, limit, out_bf, out_f) {
    unroll (k = 0..4) {
        reg f32 v0 = 0.0f; reg f32 v1 = 0.0f;
        d41_gate_limited_glu(bf16_lo(g_raw[k]), bf16_lo(u_raw[k]), limit, v0);
        d41_gate_limited_glu(bf16_hi(g_raw[k]), bf16_hi(u_raw[k]), limit, v1);
        out_bf[k] = pack_bf16x2(v0 * weight, v1 * weight);
        out_f[k * 2] = bf16_lo(out_bf[k]);
        out_f[k * 2 + 1] = bf16_hi(out_bf[k]);
    }
}

macro d41_fp8_quant8(f, out_codes, out_exp) {
    reg f32 m0 = maxf(maxf(fabsf(f[0]), fabsf(f[1])), maxf(fabsf(f[2]), fabsf(f[3])));
    reg f32 m1 = maxf(maxf(fabsf(f[4]), fabsf(f[5])), maxf(fabsf(f[6]), fabsf(f[7])));
    reg f32 amax = quad_max(maxf(m0, m1));
    out_exp = pow2_ceil_e8m0_bits(maxf(amax, 1.0e-4f));
    reg f32 inv = u32_as_f32((254 - out_exp) << 23);
    reg u32 p0 = cvt_f32x2_e4m3x2(minf(maxf(f[0] * inv, -448.0f), 448.0f), minf(maxf(f[1] * inv, -448.0f), 448.0f));
    reg u32 p1 = cvt_f32x2_e4m3x2(minf(maxf(f[2] * inv, -448.0f), 448.0f), minf(maxf(f[3] * inv, -448.0f), 448.0f));
    reg u32 p2 = cvt_f32x2_e4m3x2(minf(maxf(f[4] * inv, -448.0f), 448.0f), minf(maxf(f[5] * inv, -448.0f), 448.0f));
    reg u32 p3 = cvt_f32x2_e4m3x2(minf(maxf(f[6] * inv, -448.0f), 448.0f), minf(maxf(f[7] * inv, -448.0f), 448.0f));
    out_codes = pack_u32x2(pack_u16x2(p0, p1), pack_u16x2(p2, p3));
}

macro d41_dequant_e4m3x8(codes, scale, out_bf) {
    reg f32x4 lo4 = cvt_e4m3x4_f32x4(codes[0]);
    reg f32x4 hi4 = cvt_e4m3x4_f32x4(codes[1]);
    out_bf[0] = pack_bf16x2(lo4[0] * scale, lo4[1] * scale);
    out_bf[1] = pack_bf16x2(lo4[2] * scale, lo4[3] * scale);
    out_bf[2] = pack_bf16x2(hi4[0] * scale, hi4[1] * scale);
    out_bf[3] = pack_bf16x2(hi4[2] * scale, hi4[3] * scale);
}

macro d41_fp8_qdq8(f, out_bf) {
    reg u32x2 codes; reg u32 e8m0 = 0;
    d41_fp8_quant8(f, codes, e8m0);
    d41_dequant_e4m3x8(codes, u32_as_f32(e8m0 << 23), out_bf);
}

macro d41_fp8_quant_lane(val_f, out_code, out_exp) {
    reg f32 amax = warp_max(fabsf(val_f));
    out_exp = pow2_ceil_e8m0_bits(maxf(amax, 1.0e-4f));
    reg f32 inv = u32_as_f32((254 - out_exp) << 23);
    reg f32 clamped = minf(maxf(val_f * inv, -448.0f), 448.0f);
    out_code = cvt_f32x2_e4m3x2(clamped, 0.0f) & 0xFF;
}

macro d41_dequant_row_e4m3(src, scales, dst, width) {
    reg u32 tid = ctaid_x() * ntid_x() + tid_x();
    reg u32 step = grid_x() * ntid_x();
    reg u32 aligned = ((width & 7) | (src[0] & 7) | (dst[0] & 15)) == 0 ? 1 : 0;
    if (aligned != 0) {
        reg u32 quads = width >> 3;
        for (reg u32 q = tid; q < quads; q += step) {
            reg u32x2 c = ldg64_stream(ptr_add(src, q, 8));
            reg u32 e8m0 = ldg8_stream(ptr_add(scales, q >> 2, 1));
            reg u32x4 ov;
            d41_dequant_e4m3x8(c, u32_as_f32(e8m0 << 23), ov);
            stg128(ptr_add(dst, q, 16), ov);
        }
    } else {
        for (reg u32 i = tid; i < width; i += step) {
            reg f32 v = e4m3_to_f32(ldg8_stream(ptr_add(src, i, 1)));
            reg f32 sc = u32_as_f32(ldg8_stream(ptr_add(scales, i >> 5, 1)) << 23);
            stg16(ptr_add(dst, i, 2), f32_to_bf16(v * sc));
        }
    }
}

macro d41_copy_slice_bf16(src, dst, count) {
    reg u32 tid = tid_x();
    reg u32 step = ntid_x();
    if (((count & 7) | (src[0] & 15) | (dst[0] & 15)) == 0) {
        reg u32 vecs = count >> 3;
        for (reg u32 q = tid; q < vecs; q += step) {
            stg128(ptr_add(dst, q, 16), ldg128_stream(ptr_add(src, q, 16)));
        }
    } else {
        for (reg u32 i = tid; i < count; i += step) {
            stg16(ptr_add(dst, i, 2), ldg16_stream(ptr_add(src, i, 2)));
        }
    }
}

macro d41_moe_add_bf16x8(acc, raw) {
    acc[0] = acc[0] + bf16_lo(raw[0]);
    acc[1] = acc[1] + bf16_hi(raw[0]);
    acc[2] = acc[2] + bf16_lo(raw[1]);
    acc[3] = acc[3] + bf16_hi(raw[1]);
    acc[4] = acc[4] + bf16_lo(raw[2]);
    acc[5] = acc[5] + bf16_hi(raw[2]);
    acc[6] = acc[6] + bf16_lo(raw[3]);
    acc[7] = acc[7] + bf16_hi(raw[3]);
}

macro d41_moe_pack_bf16x8(acc, out_v) {
    out_v[0] = pack_bf16x2(acc[0], acc[1]);
    out_v[1] = pack_bf16x2(acc[2], acc[3]);
    out_v[2] = pack_bf16x2(acc[4], acc[5]);
    out_v[3] = pack_bf16x2(acc[6], acc[7]);
}

macro d41_load_f32x8_add(base_ptr, off_f, acc) {
    reg u32x4 v0 = ldg128_stream(ptr_add(base_ptr, off_f, 4));
    reg u32x4 v1 = ldg128_stream(ptr_add(base_ptr, off_f + 4, 4));
    acc[0] = acc[0] + u32_as_f32(v0[0]);
    acc[1] = acc[1] + u32_as_f32(v0[1]);
    acc[2] = acc[2] + u32_as_f32(v0[2]);
    acc[3] = acc[3] + u32_as_f32(v0[3]);
    acc[4] = acc[4] + u32_as_f32(v1[0]);
    acc[5] = acc[5] + u32_as_f32(v1[1]);
    acc[6] = acc[6] + u32_as_f32(v1[2]);
    acc[7] = acc[7] + u32_as_f32(v1[3]);
}

macro d41_store_f32x8(base_ptr, off_f, acc) {
    stg128(ptr_add(base_ptr, off_f, 4), pack_u32x4(f32_as_u32(acc[0]), f32_as_u32(acc[1]), f32_as_u32(acc[2]), f32_as_u32(acc[3])));
    stg128(ptr_add(base_ptr, off_f + 4, 4), pack_u32x4(f32_as_u32(acc[4]), f32_as_u32(acc[5]), f32_as_u32(acc[6]), f32_as_u32(acc[7])));
}

macro d41_load_bf16x8_f32(ptr, f) {
    reg u32x4 raw = ldg128_stream(ptr);
    f[0] = bf16_lo(raw[0]);
    f[1] = bf16_hi(raw[0]);
    f[2] = bf16_lo(raw[1]);
    f[3] = bf16_hi(raw[1]);
    f[4] = bf16_lo(raw[2]);
    f[5] = bf16_hi(raw[2]);
    f[6] = bf16_lo(raw[3]);
    f[7] = bf16_hi(raw[3]);
}

macro d41_store_fp8_or_qdq(IS_MX, f, out_a, scales, dst, q) {
    if constexpr (IS_MX == 1) {
        reg u32x2 packed; reg u32 sc = 0;
        d41_fp8_quant8(f, packed, sc);
        stg64(ptr_add(out_a, dst, 8), packed);
        if ((q & 3) == 0) { stg8(ptr_add(scales, dst >> 2, 1), sc); }
    } else {
        reg u32x4 qv;
        d41_fp8_qdq8(f, qv);
        stg128(ptr_add(out_a, dst, 16), qv);
    }
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 48] d41_swiglu_rows_256(
    global u32* gate, global u32* up, global u32* output, u32 width, f32 limit
) {
    acqbulk();
    reg u32 row = ctaid_y();
    reg u32 row_bytes = width << 1;
    reg u64 g_row = ptr_add(gate, row, row_bytes);
    reg u64 u_row = ptr_add(up, row, row_bytes);
    reg u64 o_row = ptr_add(output, row, row_bytes);
    reg u32 tid = ctaid_x() * ntid_x() + tid_x();
    reg u32 step = grid_x() * ntid_x();
    if (((width & 7) | (g_row[0] & 15) | (u_row[0] & 15) | (o_row[0] & 15)) == 0) {
        reg u32 vecs = width >> 3;
        for (reg u32 q = tid; q < vecs; q += step) {
            reg u32x4 gv = ldg128_stream(ptr_add(g_row, q, 16));
            reg u32x4 uv = ldg128_stream(ptr_add(u_row, q, 16));
            reg u32x4 ov;
            unroll (k = 0..4) {
                reg f32 r0 = 0.0f; reg f32 r1 = 0.0f;
                d41_gate_limited_glu(bf16_lo(gv[k]), bf16_lo(uv[k]), limit, r0);
                d41_gate_limited_glu(bf16_hi(gv[k]), bf16_hi(uv[k]), limit, r1);
                ov[k] = pack_bf16x2(r0, r1);
            }
            stg128(ptr_add(o_row, q, 16), ov);
        }
        preexit();
        return;
    }
    for (reg u32 i = tid; i < width; i += step) {
        reg f32 r = 0.0f;
        d41_gate_limited_glu(bf16_lo(ldg16_stream(ptr_add(g_row, i, 2))), bf16_lo(ldg16_stream(ptr_add(u_row, i, 2))), limit, r);
        stg16(ptr_add(o_row, i, 2), f32_to_bf16(r));
    }
    preexit();
}

@pdl
@concept(moe)
template kernel[D41M_BLK256, 80] d41_swiglu_fp8_tpl<IS_MX>(
    global u32* gate, global u32* up,
    global u32* out_a,
    if (IS_MX == 1) global u8* scales,
    u32 width, f32 limit
) {
    acqbulk();
    reg u32 octets = width >> 3;
    reg u32 q = ctaid_x() * ntid_x() + tid_x();
    if (q < octets) {
        reg u32 row = ctaid_y();
        reg u32 base = row * octets + q;
        reg u32x4 gv = ldg128_stream(ptr_add(gate, base, 16));
        reg u32x4 uv = ldg128_stream(ptr_add(up, base, 16));
        reg u32x4 bf; reg f32 f[8];
        d41_swiglu8_vec(gv, uv, 1.0f, limit, bf, f);
        d41_store_fp8_or_qdq(IS_MX, f, out_a, scales, base, q);
    }
    preexit();
}

instantiate d41_swiglu_fp8_tpl<0> as d41_swiglu_qdq_rows_256;
instantiate d41_swiglu_fp8_tpl<1> as d41_swiglu_mx_256;

@pdl
@concept(moe)
template kernel[D41M_BLK256, 80] d41_rank_major_fp8_tpl<IS_MX>(
    global u32* gathered, global u32* out_a,
    if (IS_MX == 1) global u8* scales,
    u32 rows, u32 width, u32 ranks, u32 first_rank
) {
    acqbulk();
    reg u32 total_oct = (ranks * width) >> 3;
    reg u32 q = ctaid_x() * ntid_x() + tid_x();
    if (q < total_oct) {
        reg u32 w_oct = width >> 3;
        reg u32 rk = 0; reg u32 within = 0;
        u32_divmod(q, w_oct, rk, within);
        reg u32 row = ctaid_y();
        reg u64 src = ptr_add(gathered, ((first_rank + rk) * rows + row) * w_oct + within, 16);
        reg f32 f[8];
        d41_load_bf16x8_f32(src, f);
        reg u32 dst = row * total_oct + q;
        d41_store_fp8_or_qdq(IS_MX, f, out_a, scales, dst, q);
    }
    preexit();
}

instantiate d41_rank_major_fp8_tpl<0> as d41_rank_major_qdq_256;
instantiate d41_rank_major_fp8_tpl<1> as d41_rank_major_mx_256;

macro d41_hc_post4_apply(s_post, s_comb, sub, streams, row, width, offset) {
    reg u32x4 sraw[4];
    unroll (cp = 0..4) {
        sraw[cp] = ldg128_stream(ptr_add(ptr_add(streams, row * 4 + cp, width << 1), offset, 2));
    }
    unroll (cp = 0..4) {
        reg f32 pc = lds32(s_post, cp);
        reg f32 c0 = lds32(s_comb, cp);
        reg f32 c1 = lds32(s_comb, 4 + cp);
        reg f32 c2 = lds32(s_comb, 8 + cp);
        reg f32 c3 = lds32(s_comb, 12 + cp);
        reg u32x4 ov;
        unroll (w = 0..4) {
            reg f32 t0 = c0 * bf16_lo(sraw[0][w]) + c1 * bf16_lo(sraw[1][w]) + c2 * bf16_lo(sraw[2][w]) + c3 * bf16_lo(sraw[3][w]);
            reg f32 t1 = c0 * bf16_hi(sraw[0][w]) + c1 * bf16_hi(sraw[1][w]) + c2 * bf16_hi(sraw[2][w]) + c3 * bf16_hi(sraw[3][w]);
            ov[w] = pack_bf16x2(pc * bf16_lo(sub[w]) + t0, pc * bf16_hi(sub[w]) + t1);
        }
        stg128(ptr_add(ptr_add(streams, row * 4 + cp, width << 1), offset, 2), ov);
    }
}

@pdl
@concept(norm_rope)
template kernel[D41M_BLK256, 96] d41_hc_post_fused_tpl<MODE>(
    global u32* gathered, global f32* post, global f32* comb,
    global u32* streams, u32 rows, u32 width, u32 degree, u32 slice_width
) {
    shared f32 sp[4];
    shared f32 sc[16];
    acqbulk();
    reg u32 row = ctaid_y();
    reg u32 tid = tid_x();
    if (tid < 4) { sts32(sp, tid, u32_as_f32(ldg32_persist(ptr_add(post, row * 4 + tid, 4)))); }
    if (tid < 16) { sts32(sc, tid, u32_as_f32(ldg32_persist(ptr_add(comb, row * 16 + tid, 4)))); }
    barrier();
    reg u32 octets = width >> 3;
    reg u32 step = grid_x() * ntid_x();
    for (reg u32 q = ctaid_x() * ntid_x() + tid; q < octets; q += step) {
        reg u32x4 sub;
        if constexpr (MODE == 1) {
            reg u32 sw_oct = slice_width >> 3;
            reg u32 rk = 0; reg u32 within = 0;
            u32_divmod(q, sw_oct, rk, within);
            sub = ldg128_persist(ptr_add(gathered, (rk * rows + row) * sw_oct + within, 16));
        } else if constexpr (MODE == 2) {
            reg u32 elems = rows * width;
            reg u32 base = row * width + (q << 3);
            reg f32 s[8];
            unroll (k = 0..8) { s[k] = 0.0f; }
            for (reg u32 src = 0; src < degree; src += 1) {
                d41_load_f32x8_add(ptr_add(gathered, src, elems << 2), base, s);
            }
            d41_moe_pack_bf16x8(s, sub);
        } else {
            reg u32 row_oct = rows * octets;
            reg u32 base = row * octets + q;
            reg f32 s[8];
            unroll (k = 0..8) { s[k] = 0.0f; }
            for (reg u32 src = 0; src < degree; src += 1) {
                reg u32x4 gv = ldg128_stream(ptr_add(gathered, src * row_oct + base, 16));
                d41_moe_add_bf16x8(s, gv);
            }
            d41_moe_pack_bf16x8(s, sub);
        }
        d41_hc_post4_apply(sp, sc, sub, streams, row, width, q << 3);
    }
    preexit();
}

instantiate d41_hc_post_fused_tpl<1> as d41_hc_post_fused_m1_256;
instantiate d41_hc_post_fused_tpl<2> as d41_hc_post_fused_m2_256;
instantiate d41_hc_post_fused_tpl<3> as d41_hc_post_fused_m3_256;

@pdl
@concept(attention)
kernel[D41M_BLK256, 32] d41_index_pack_256(
    global u32* query, global u32* weight, global u32* packed,
    u32 query_width, u32 weight_width, u32 pack_width
) {
    acqbulk();
    reg u32 row = ctaid_x();
    reg u64 prow = ptr_add(packed, row, pack_width << 1);
    d41_copy_slice_bf16(ptr_add(query, row, query_width << 1), prow, query_width);
    reg u32 tail = pack_width - query_width;
    reg u64 wrow = ptr_add(weight, row, weight_width << 1);
    reg u64 pdst = ptr_add(prow, query_width, 2);
    reg u32 step = ntid_x();
    for (reg u32 i = tid_x(); i < tail; i += step) {
        reg u32 v = 0;
        if (i < weight_width) { v = ldg16_stream(ptr_add(wrow, i, 2)); }
        stg16(ptr_add(pdst, i, 2), v);
    }
    preexit();
}

@pdl
@concept(attention)
kernel[D41M_BLK256, 32] d41_index_unpack_256(
    global u32* packed, u64 rank_stride,
    global u32* query, global u32* weight,
    u32 query_width, u32 weight_width, u32 pack_width
) {
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 rk = ctaid_y();
    reg u32 ranks = grid_y();
    reg u64 src = ptr_add(ptr_add(packed, rk, rank_stride[0] << 1), row, pack_width << 1);
    reg u32 out_idx = row * ranks + rk;
    d41_copy_slice_bf16(src, ptr_add(query, out_idx, query_width << 1), query_width);
    d41_copy_slice_bf16(ptr_add(src, query_width, 2), ptr_add(weight, out_idx, weight_width << 1), weight_width);
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 64] d41_moe_send_256(
    global u32* gate_up, global f32* packed_weight, global u32* shared_in,
    global u32* send, u32 routes, u32 rows, u32 slice, u32 hidden_slice,
    u32 degree, u64 destination_stride, f32 limit, u32 route_elements, u32 codes
) {
    acqbulk();
    reg u32 item = ctaid_z() * grid_y() + ctaid_y();
    reg u32 elem = ctaid_x() * ntid_x() + tid_x();
    reg u32 dst_bytes = destination_stride[0] << 1;
    if (item < routes) {
        if (elem >= slice) { preexit(); return; }
        reg u64 g_row = ptr_add(gate_up, item, slice << 2);
        reg f32 gv = bf16_lo(ldg16_stream(ptr_add(g_row, elem, 2)));
        reg f32 uv = bf16_lo(ldg16_stream(ptr_add(g_row, slice + elem, 2)));
        reg f32 wt = u32_as_f32(ldg32_persist(ptr_add(packed_weight, item, 4)));
        reg f32 res = 0.0f;
        d41_gate_limited_glu(gv, uv, limit, res);
        reg u32 bf = f32_to_bf16(res * wt);
        if (codes == 0) {
            for (reg u32 d = 0; d < degree; d += 1) {
                reg u64 dptr = ptr_add(ptr_add(send, d, dst_bytes), item, slice << 1);
                stg16(ptr_add(dptr, elem, 2), bf);
            }
            preexit();
            return;
        }
        reg u32 code = 0; reg u32 exp = 0;
        d41_fp8_quant_lane(bf16_lo(bf), code, exp);
        reg u32 s_blocks = slice >> 5;
        reg u32 sc_off = routes * slice + item * s_blocks + (elem >> 5);
        for (reg u32 d = 0; d < degree; d += 1) {
            reg u64 bptr = ptr_add(send, d, dst_bytes);
            stg8(ptr_add(ptr_add(bptr, item, slice), elem, 1), code);
            if ((elem & 31) == 0) { stg8(ptr_add(bptr, sc_off, 1), exp); }
        }
        preexit();
        return;
    }
    reg u32 row = item - routes;
    if (row >= rows || elem >= hidden_slice * degree) { preexit(); return; }
    reg u32 d_idx = 0; reg u32 within = 0;
    u32_divmod(elem, hidden_slice, d_idx, within);
    reg u32 sv = ldg16_stream(ptr_add(ptr_add(shared_in, row, (hidden_slice * degree) << 1), elem, 2));
    reg u64 drow = ptr_add(ptr_add(send, d_idx, dst_bytes), routes * route_elements + row * hidden_slice, 2);
    stg16(ptr_add(drow, within, 2), sv);
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 80] d41_moe_send_vec_256(
    global u32* gate_up, global f32* packed_weight, global u32* shared_in,
    global u32* send, u32 routes, u32 rows, u32 slice, u32 hidden_slice,
    u32 degree, u64 destination_stride, f32 limit, u32 route_elements, u32 codes
) {
    acqbulk();
    reg u32 item = ctaid_z() * grid_y() + ctaid_y();
    reg u32 q = ctaid_x() * ntid_x() + tid_x();
    reg u32 dst_bytes = destination_stride[0] << 1;
    if (item < routes) {
        reg u32 octets = slice >> 3;
        if (q >= octets) { preexit(); return; }
        reg u32 g_base = item * (octets << 1) + q;
        reg u32x4 gv = ldg128_stream(ptr_add(gate_up, g_base, 16));
        reg u32x4 uv = ldg128_stream(ptr_add(gate_up, g_base + octets, 16));
        reg f32 wt = u32_as_f32(ldg32_persist(ptr_add(packed_weight, item, 4)));
        reg u32x4 bf; reg f32 f[8];
        d41_swiglu8_vec(gv, uv, wt, limit, bf, f);
        if (codes == 0) {
            for (reg u32 d = 0; d < degree; d += 1) {
                reg u64 drow = ptr_add(ptr_add(send, d, dst_bytes), item, slice << 1);
                stg128(ptr_add(drow, q, 16), bf);
            }
            preexit();
            return;
        }
        reg u32x2 packed; reg u32 sc = 0;
        d41_fp8_quant8(f, packed, sc);
        reg u32 s_blocks = slice >> 5;
        reg u32 sc_off = routes * slice + item * s_blocks + (q >> 2);
        for (reg u32 d = 0; d < degree; d += 1) {
            reg u64 bptr = ptr_add(send, d, dst_bytes);
            stg64(ptr_add(ptr_add(bptr, item, slice), q, 8), packed);
            if ((q & 3) == 0) { stg8(ptr_add(bptr, sc_off, 1), sc); }
        }
        preexit();
        return;
    }
    reg u32 row = item - routes;
    reg u32 h_oct = hidden_slice >> 3;
    if (row >= rows || q >= h_oct * degree) { preexit(); return; }
    reg u32 d_idx = 0; reg u32 within = 0;
    u32_divmod(q, h_oct, d_idx, within);
    reg u32x4 sv = ldg128_stream(ptr_add(ptr_add(shared_in, row, (hidden_slice * degree) << 1), q, 16));
    reg u64 drow = ptr_add(ptr_add(send, d_idx, dst_bytes), routes * route_elements + row * hidden_slice, 2);
    stg128(ptr_add(drow, within, 16), sv);
    preexit();
}

@pdl
@concept(moe)
template kernel[D41M_BLK256, 80] d41_act_assemble_vec_tpl<IS_MX>(
    global u32* received, global u32* out_buf, u32 slice, u32 width,
    u64 source_stride, u32 routes,
    if (IS_MX == 0) u32 codes
) {
    acqbulk();
    reg u32 route = ctaid_z() * grid_y() + ctaid_y();
    reg u32 q = ctaid_x() * ntid_x() + tid_x();
    if (route >= routes || q >= (width >> 3)) { preexit(); return; }
    reg u32 elem = q << 3;
    reg u32 src = 0; reg u32 within = 0;
    u32_divmod(elem, slice, src, within);
    reg u64 sbase = ptr_add(received, src, source_stride[0] << 1);
    if constexpr (IS_MX == 0) {
        reg u64 dst = ptr_add(ptr_add(out_buf, route, width << 1), q, 16);
        if (codes != 0) {
            reg u32 s_blocks = slice >> 5;
            reg u32 exp = ldg8_stream(ptr_add(sbase, routes * slice + route * s_blocks + (within >> 5), 1));
            reg u32x2 c = ldg64_stream(ptr_add(ptr_add(sbase, route, slice), within, 1));
            reg u32x4 ov;
            d41_dequant_e4m3x8(c, u32_as_f32(exp << 23), ov);
            stg128(dst, ov);
            preexit();
            return;
        }
        reg f32 f[8];
        d41_load_bf16x8_f32(ptr_add(sbase, route * slice + within, 2), f);
        reg u32x4 qv;
        d41_fp8_qdq8(f, qv);
        stg128(dst, qv);
    } else {
        reg f32 f[8];
        d41_load_bf16x8_f32(ptr_add(sbase, route * slice + within, 2), f);
        reg u32x2 packed; reg u32 sc = 0;
        d41_fp8_quant8(f, packed, sc);
        stg64(ptr_add(ptr_add(out_buf, route, width), elem, 1), packed);
        if ((q & 3) == 0) {
            stg8(ptr_add(out_buf, routes * width + route * (width >> 5) + (q >> 2), 1), sc);
        }
    }
    preexit();
}

instantiate d41_act_assemble_vec_tpl<1> as d41_act_assemble_mx_256;
instantiate d41_act_assemble_vec_tpl<0> as d41_act_assemble_qdq_vec_256;

@pdl
@concept(moe)
kernel[D41M_BLK256, 48] d41_act_assemble_qdq_256(
    global u32* received, global u32* act, u32 slice, u32 width,
    u64 source_stride, u32 routes, u32 codes
) {
    acqbulk();
    reg u32 route = ctaid_z() * grid_y() + ctaid_y();
    reg u32 elem = ctaid_x() * ntid_x() + tid_x();
    if (route >= routes || elem >= width) { preexit(); return; }
    reg u32 src = 0; reg u32 within = 0;
    u32_divmod(elem, slice, src, within);
    reg u64 sbase = ptr_add(received, src, source_stride[0] << 1);
    reg u64 dst = ptr_add(ptr_add(act, route, width << 1), elem, 2);
    if (codes != 0) {
        reg u32 s_blocks = slice >> 5;
        reg u32 exp = ldg8_stream(ptr_add(sbase, routes * slice + route * s_blocks + (within >> 5), 1));
        reg f32 v = e4m3_to_f32(ldg8_stream(ptr_add(ptr_add(sbase, route, slice), within, 1)));
        stg16(dst, f32_to_bf16(v * u32_as_f32(exp << 23)));
        preexit();
        return;
    }
    reg f32 val = bf16_lo(ldg16_stream(ptr_add(sbase, route * slice + within, 2)));
    reg u32 c = 0; reg u32 exp = 0;
    d41_fp8_quant_lane(val, c, exp);
    stg16(dst, f32_to_bf16(e4m3_to_f32(c) * u32_as_f32(exp << 23)));
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 48] d41_act_assemble_codes_256(
    global u32* received, global u8* codes, u32 slice, u32 width,
    u64 source_stride, u32 routes
) {
    acqbulk();
    reg u32 route = ctaid_z() * grid_y() + ctaid_y();
    reg u32 vec = ctaid_x() * ntid_x() + tid_x();
    reg u32 c_vecs = width >> 4;
    reg u32 blocks = slice >> 5;
    if (route >= routes || vec >= c_vecs + (width >> 6)) { preexit(); return; }
    if (vec < c_vecs) {
        reg u32 elem = vec << 4;
        reg u32 src = 0; reg u32 within = 0;
        u32_divmod(elem, slice, src, within);
        reg u64 sbase = ptr_add(received, src, source_stride[0] << 1);
        stg128(ptr_add(ptr_add(codes, route, width), elem, 1), ldg128_stream(ptr_add(ptr_add(sbase, route, slice), within, 1)));
        preexit();
        return;
    }
    reg u32 blk = (vec - c_vecs) << 1;
    reg u32 src = 0; reg u32 within = 0;
    u32_divmod(blk, blocks, src, within);
    reg u64 sbase = ptr_add(received, src, source_stride[0] << 1);
    reg u64 sptr = ptr_add(sbase, routes * slice + route * blocks + within, 1);
    reg u64 dptr = ptr_add(codes, routes * width + route * (width >> 5) + blk, 1);
    stg16(dptr, ldg16_stream(sptr));
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 80] d41_shared_send_256(
    global u32* gate, global u32* up, global u32* send,
    u32 rows, u32 width, u32 degree, u64 destination_stride, f32 limit
) {
    acqbulk();
    reg u32 row = ctaid_y();
    reg u32 q = ctaid_x() * ntid_x() + tid_x();
    reg u32 octets = width >> 3;
    if (row >= rows || q >= octets) { preexit(); return; }
    reg u32 base = row * octets + q;
    reg u32x4 gv = ldg128_stream(ptr_add(gate, base, 16));
    reg u32x4 uv = ldg128_stream(ptr_add(up, base, 16));
    reg u32x4 bf; reg f32 f[8];
    d41_swiglu8_vec(gv, uv, 1.0f, limit, bf, f);
    reg u32x2 packed; reg u32 sc = 0;
    d41_fp8_quant8(f, packed, sc);
    reg u32 s_blocks = width >> 5;
    reg u32 sc_off = rows * width + row * s_blocks + (q >> 2);
    reg u32 dst_bytes = destination_stride[0] << 1;
    for (reg u32 d = 0; d < degree; d += 1) {
        reg u64 bptr = ptr_add(send, d, dst_bytes);
        stg64(ptr_add(ptr_add(bptr, row, width), q, 8), packed);
        if ((q & 3) == 0) { stg8(ptr_add(bptr, sc_off, 1), sc); }
    }
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 64] d41_shared_dequant_all_256(
    global u32* received, global u32* act, u32 rows, u64 stride,
    u32 degree, u32 total_granules, u32 granule
) {
    acqbulk();
    reg u32 row = ctaid_y();
    reg u32 src = ctaid_z();
    if (row >= rows || src >= degree) { preexit(); return; }
    reg u32 base = 0; reg u32 extra = 0;
    u32_divmod(total_granules, degree, base, extra);
    reg u32 first = (src * base + ((src < extra) ? src : extra)) * granule;
    reg u32 width = (base + ((src < extra) ? 1 : 0)) * granule;
    reg u64 bytes = ptr_add(received, src, stride[0] << 1);
    reg u64 s_src = ptr_add(bytes, row, width);
    reg u64 s_sc = ptr_add(bytes, rows * width + row * (width >> 5), 1);
    reg u64 d_row = ptr_add(act, first * rows + row * width, 2);
    d41_dequant_row_e4m3(s_src, s_sc, d_row, width);
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 64] d41_shared_dequant_256(
    global u8* bytes, global u32* act, u32 rows, u32 width
) {
    acqbulk();
    reg u32 row = ctaid_y();
    if (row < rows) {
        reg u64 s_src = ptr_add(bytes, row, width);
        reg u64 s_sc = ptr_add(bytes, rows * width + row * (width >> 5), 1);
        reg u64 d_row = ptr_add(act, row, width << 1);
        d41_dequant_row_e4m3(s_src, s_sc, d_row, width);
    }
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 32] d41_ffn_pack_256(
    global u32* route_expert, global f32* route_weight, global u8* block,
    u32 own, u32 routed, u32 hidden, u32 top_k
) {
    acqbulk();
    reg u32 item = ctaid_x() * ntid_x() + tid_x();
    if (item < routed * top_k) {
        reg u32 ids = own * (hidden + (hidden >> 5));
        reg u64 id_ptr = ptr_add(block, ids, 1);
        stg32(ptr_add(id_ptr, item, 4), ldg32_stream(ptr_add(route_expert, item, 4)));
        stg32(ptr_add(id_ptr, own * top_k + item, 4), ldg32_stream(ptr_add(route_weight, item, 4)));
    }
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 64] d41_ffn_unpack_256(
    global u8* received, global u32* xq, global u8* mx_codes, global u8* mx_scales,
    global u32* route_expert, global f32* route_weight,
    u32 own, u32 hidden, u32 top_k, u64 block_bytes
) {
    acqbulk();
    reg u32 row = ctaid_y();
    reg u32 src = 0; reg u32 idx = 0;
    u32_divmod(row, own, src, idx);
    reg u64 blk = ptr_add(received, src, block_bytes[0]);
    reg u32 scale_bytes = hidden >> 5;
    reg u64 id_ptr = ptr_add(blk, own * (hidden + scale_bytes), 1);
    reg u32 lane = ctaid_x() * ntid_x() + tid_x();
    reg u32 lanes = grid_x() * ntid_x();
    for (reg u32 k = lane; k < top_k; k += lanes) {
        stg32(ptr_add(route_expert, row * top_k + k, 4), ldg32_stream(ptr_add(id_ptr, idx * top_k + k, 4)));
        stg32(ptr_add(route_weight, row * top_k + k, 4), ldg32_stream(ptr_add(id_ptr, (own + idx) * top_k + k, 4)));
    }
    if ((mx_codes[0] | mx_codes[1]) != 0) {
        reg u64 csrc = ptr_add(blk, idx, hidden);
        reg u64 cdst = ptr_add(mx_codes, row, hidden);
        for (reg u32 i = lane; i < (hidden >> 4); i += lanes) {
            stg128(ptr_add(cdst, i, 16), ldg128_stream(ptr_add(csrc, i, 16)));
        }
        reg u64 ssrc = ptr_add(ptr_add(blk, own, hidden), idx, scale_bytes);
        reg u64 sdst = ptr_add(mx_scales, row, scale_bytes);
        for (reg u32 i = lane; i < (scale_bytes >> 2); i += lanes) {
            stg32(ptr_add(sdst, i, 4), ldg32_stream(ptr_add(ssrc, i, 4)));
        }
        preexit();
        return;
    }
    reg u64 bsrc = ptr_add(blk, idx, hidden);
    reg u64 bsc = ptr_add(ptr_add(blk, own, hidden), idx, scale_bytes);
    d41_dequant_row_e4m3(bsrc, bsc, ptr_add(xq, row, hidden << 1), hidden);
    preexit();
}

@pdl
@concept(attention)
kernel[D41M_BLK128, 32] d41_unpack_q_codes_128(
    global u8* received, global u8* codes, global u8* scales,
    u32 own, u64 segment, u32 qlora
) {
    acqbulk();
    reg u32 row = ctaid_y();
    reg u32 src = 0; reg u32 loc = 0;
    u32_divmod(row, own, src, loc);
    reg u64 seg = ptr_add(received, src, segment[0]);
    reg u32 code_vecs = qlora >> 4;
    reg u32 scale_words = qlora >> 7;
    reg u32 tid = tid_x();
    if (tid < code_vecs) {
        stg128(ptr_add(ptr_add(codes, row, qlora), tid, 16), ldg128_stream(ptr_add(ptr_add(seg, loc, qlora), tid, 16)));
    } else if (tid < code_vecs + scale_words) {
        reg u32 j = tid - code_vecs;
        reg u32 s_cols = qlora >> 5;
        reg u64 ssrc = ptr_add(ptr_add(seg, own, qlora), loc, s_cols);
        stg32(ptr_add(ptr_add(scales, row, s_cols), j, 4), ldg32_stream(ptr_add(ssrc, j, 4)));
    }
    preexit();
}

macro d41_finalize_slice_vec(s_src, s_pr, slice_out, received, shared_partial, route_expert, route_packed_row, output, row, top_k, local_experts, total_experts, degree, hidden_slice, source_stride, shared_offset) {
    reg u32 quads = hidden_slice >> 3;
    reg u32 hbytes = hidden_slice << 1;
    reg u32 has_sp = ((shared_partial[0] | shared_partial[1]) != 0) ? 1 : 0;
    reg u64 out_q = ptr_add(output, row, hbytes);
    reg u32 step = grid_x() * ntid_x();
    for (reg u32 q = ctaid_x() * ntid_x() + tid_x(); q < quads; q += step) {
        reg f32 sum[8];
        unroll (i = 0..8) { sum[i] = 0.0f; }
        for (reg u32 src = 0; src < degree; src += 1) {
            reg f32 total[8];
            unroll (i = 0..8) { total[i] = 0.0f; }
            for (reg u32 k = 0; k < top_k; k += 1) {
                reg u32 rsrc = lds32(s_src, k);
                if (rsrc == src) {
                    reg u32 pr = lds32(s_pr, k);
                    reg u32x4 rv = ldg128_stream(ptr_add(ptr_add(slice_out, pr, hbytes), q, 16));
                    d41_moe_add_bf16x8(total, rv);
                }
            }
            reg u64 sh_p = (has_sp != 0)
                ? ptr_add(shared_partial, src * grid_y() + row, hbytes)
                : ptr_add(ptr_add(received, src, source_stride[0] << 1), shared_offset[0] + row * hidden_slice, 2);
            reg u32x4 sh = ldg128_stream(ptr_add(sh_p, q, 16));
            d41_moe_add_bf16x8(total, sh);
            unroll (i = 0..8) { sum[i] = sum[i] + bf16_lo(f32_to_bf16(total[i])); }
        }
        reg u32x4 ov;
        d41_moe_pack_bf16x8(sum, ov);
        stg128(ptr_add(out_q, q, 16), ov);
    }
}

macro d41_finalize_slice_scalar_src(slice_out, received, shared_partial, route_expert, route_packed_row, row, elem, top_k, local_experts, total_experts, src, hidden_slice, hbytes, has_sp, source_stride, shared_offset, out_sum) {
    reg f32 total = 0.0f;
    for (reg u32 k = 0; k < top_k; k += 1) {
        reg u32 rt = row * top_k + k;
        reg u32 e = ldg32_stream(ptr_add(route_expert, rt, 4));
        reg u32 eq = total_experts;
        if (e < total_experts) {
            reg u32 er = 0;
            u32_divmod(e, local_experts, eq, er);
        }
        if (eq == src) {
            reg u32 pr = ldg32_stream(ptr_add(route_packed_row, rt, 4));
            total = total + bf16_lo(ldg16_stream(ptr_add(ptr_add(slice_out, pr, hbytes), elem, 2)));
        }
    }
    reg u64 sh_p = (has_sp != 0)
        ? ptr_add(shared_partial, src * grid_y() + row, hbytes)
        : ptr_add(ptr_add(received, src, source_stride[0] << 1), shared_offset[0] + row * hidden_slice, 2);
    total = total + bf16_lo(ldg16_stream(ptr_add(sh_p, elem, 2)));
    out_sum = out_sum + bf16_lo(f32_to_bf16(total));
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 80] d41_finalize_slice_256(
    global u32* slice_out, global u32* received,
    global u32* route_expert, global u32* route_packed_row, global u32* output,
    u32 top_k, u32 local_experts, u32 degree, u32 hidden_slice,
    u64 source_stride, u64 shared_offset, global u32* shared_partial
) {
    shared u32 s_src[16];
    shared u32 s_pr[16];
    acqbulk();
    reg u32 row = ctaid_y();
    reg u32 total_experts = local_experts * degree;
    if (top_k <= 16) {
        if (tid_x() < top_k) {
            reg u32 rt = row * top_k + tid_x();
            reg u32 e = ldg32_stream(ptr_add(route_expert, rt, 4));
            reg u32 src = degree;
            if (e < total_experts) {
                reg u32 rem = 0;
                u32_divmod(e, local_experts, src, rem);
            }
            sts32(s_src, tid_x(), src);
            sts32(s_pr, tid_x(), ldg32_stream(ptr_add(route_packed_row, rt, 4)));
        }
        barrier();
    }
    reg u32 has_sp = ((shared_partial[0] | shared_partial[1]) != 0) ? 1 : 0;
    reg u32 al_bad = (hidden_slice & 7) | (slice_out[0] & 15) | (output[0] & 15);
    if (has_sp != 0) {
        al_bad = al_bad | (shared_partial[0] & 15);
    } else {
        al_bad = al_bad | (received[0] & 15) | (source_stride[0] & 7) | (shared_offset[0] & 7);
    }
    if (al_bad == 0 && top_k <= 16) {
        d41_finalize_slice_vec(s_src, s_pr, slice_out, received, shared_partial, route_expert, route_packed_row, output, row, top_k, local_experts, total_experts, degree, hidden_slice, source_stride, shared_offset);
        preexit();
        return;
    }
    reg u32 hbytes = hidden_slice << 1;
    reg u32 step = grid_x() * ntid_x();
    for (reg u32 elem = ctaid_x() * ntid_x() + tid_x(); elem < hidden_slice; elem += step) {
        reg f32 sum = 0.0f;
        for (reg u32 src = 0; src < degree; src += 1) {
            d41_finalize_slice_scalar_src(slice_out, received, shared_partial, route_expert, route_packed_row, row, elem, top_k, local_experts, total_experts, src, hidden_slice, hbytes, has_sp, source_stride, shared_offset, sum);
        }
        stg16(ptr_add(ptr_add(output, row, hbytes), elem, 2), f32_to_bf16(sum));
    }
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 32] d41_slice_gather_256(
    global u32* gathered, global u32* output, u32 rows, u32 hidden_slice, u32 degree
) {
    acqbulk();
    reg u32 row = ctaid_y();
    reg u32 elem = ctaid_x() * ntid_x() + tid_x();
    reg u32 total = hidden_slice * degree;
    if (elem >= total) { preexit(); return; }
    reg u32 rk = 0; reg u32 within = 0;
    u32_divmod(elem, hidden_slice, rk, within);
    reg u32 v = ldg16_stream(ptr_add(gathered, (rk * rows + row) * hidden_slice + within, 2));
    stg16(ptr_add(output, row * total + elem, 2), v);
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 80] d41_expert_act_256(
    global u32* gate_up, global f32* packed_weight, global u32* group_row_offset,
    u32 local_experts, global u8* codes, global u32* act, u32 routes, u32 width, f32 limit
) {
    acqbulk();
    reg u32 q = ctaid_x() * ntid_x() + tid_x();
    reg u32 octets = width >> 3;
    reg u32 s_blocks = width >> 5;
    reg u32 loc = ldg32_persist(ptr_add(group_row_offset, local_experts, 4));
    reg u32 count = (loc < routes) ? loc : routes;
    reg u32 has_act = ((act[0] | act[1]) != 0) ? 1 : 0;
    if (q < octets) {
        reg u32 ystep = grid_y();
        for (reg u32 rt = ctaid_y(); rt < count; rt += ystep) {
            reg u32 g_base = rt * (octets << 1) + q;
            reg u32x4 gv = ldg128_stream(ptr_add(gate_up, g_base, 16));
            reg u32x4 uv = ldg128_stream(ptr_add(gate_up, g_base + octets, 16));
            reg f32 wt = u32_as_f32(ldg32_persist(ptr_add(packed_weight, rt, 4)));
            reg u32x4 bf; reg f32 f[8];
            d41_swiglu8_vec(gv, uv, wt, limit, bf, f);
            reg u32x2 packed; reg u32 sc = 0;
            d41_fp8_quant8(f, packed, sc);
            if (has_act != 0) {
                reg u32x4 ov;
                d41_dequant_e4m3x8(packed, u32_as_f32(sc << 23), ov);
                stg128(ptr_add(act, rt * octets + q, 16), ov);
            } else {
                stg64(ptr_add(codes, rt * octets + q, 8), packed);
                if ((q & 3) == 0) {
                    stg8(ptr_add(codes, routes * width + rt * s_blocks + (q >> 2), 1), sc);
                }
            }
        }
    }
    preexit();
}

@pdl
@concept(moe)
template kernel[D41M_BLK256, 80] d41_moe_finalize_f32_tpl<OUT_BF16>(
    global u32* packed, global u32* route_packed_row, global u32* route_expert,
    global f32* shared_in, global u32* output, u32 top_k, u32 local_experts, u32 width
) {
    shared u32 active_rows[16];
    shared u32 active_count[1];
    acqbulk();
    reg u32 row = ctaid_y();
    if (tid_x() == 0) {
        reg u32 n = 0;
        for (reg u32 k = 0; k < top_k; k += 1) {
            if (n < 16) {
                reg u32 rt = row * top_k + k;
                if (ldg32_persist(ptr_add(route_expert, rt, 4)) < local_experts) {
                    sts32(active_rows, n, ldg32_persist(ptr_add(route_packed_row, rt, 4)));
                    n = n + 1;
                }
            }
        }
        sts32(active_count, 0, n);
    }
    barrier();
    reg u32 count = lds32(active_count, 0);
    reg u32 tid = ctaid_x() * ntid_x() + tid_x();
    reg u32 step = grid_x() * ntid_x();
    reg u32 al_bad = (width & 7) | (packed[0] & 15) | (shared_in[0] & 15) | (output[0] & 15);
    if (top_k <= 16 && al_bad == 0) {
        reg u32 octets = width >> 3;
        reg u64 sh_row = ptr_add(shared_in, row, width << 2);
        reg u64 out_row = ptr_add(output, row, (OUT_BF16 == 1) ? (width << 1) : (width << 2));
        for (reg u32 q = tid; q < octets; q += step) {
            reg f32 total[8];
            unroll (j = 0..8) { total[j] = 0.0f; }
            for (reg u32 i = 0; i < count; i += 1) {
                reg u32 ar = lds32(active_rows, i);
                reg u32x4 rv = ldg128_persist(ptr_add(ptr_add(packed, ar, width << 1), q, 16));
                d41_moe_add_bf16x8(total, rv);
            }
            d41_load_f32x8_add(sh_row, q << 3, total);
            if constexpr (OUT_BF16 == 1) {
                reg u32x4 ov;
                d41_moe_pack_bf16x8(total, ov);
                stg128(ptr_add(out_row, q, 16), ov);
            } else {
                d41_store_f32x8(out_row, q << 3, total);
            }
        }
        preexit();
        return;
    }
    for (reg u32 elem = tid; elem < width; elem += step) {
        reg f32 total = 0.0f;
        for (reg u32 k = 0; k < top_k; k += 1) {
            reg u32 rt = row * top_k + k;
            if (ldg32_persist(ptr_add(route_expert, rt, 4)) < local_experts) {
                reg u32 pr = ldg32_persist(ptr_add(route_packed_row, rt, 4));
                total = total + bf16_lo(ldg16_stream(ptr_add(ptr_add(packed, pr, width << 1), elem, 2)));
            }
        }
        reg f32 s = total + u32_as_f32(ldg32_stream(ptr_add(ptr_add(shared_in, row, width << 2), elem, 4)));
        if constexpr (OUT_BF16 == 1) {
            stg16(ptr_add(ptr_add(output, row, width << 1), elem, 2), f32_to_bf16(s));
        } else {
            stg32(ptr_add(ptr_add(output, row, width << 2), elem, 4), f32_as_u32(s));
        }
    }
    preexit();
}

instantiate d41_moe_finalize_f32_tpl<0> as d41_moe_finalize_f32_256;
instantiate d41_moe_finalize_f32_tpl<1> as d41_moe_finalize_f32_bf16_256;

@pdl
@concept(moe)
kernel[D41M_BLK256, 64] d41_sum_sources_f32_256(
    global f32* gathered, global u32* output, u64 elements, u32 degree
) {
    acqbulk();
    reg u32 elems = elements[0];
    reg u32 tid = ctaid_x() * ntid_x() + tid_x();
    reg u32 step = grid_x() * ntid_x();
    if (((elems & 7) | (gathered[0] & 15) | (output[0] & 15)) == 0) {
        reg u32 quads = elems >> 3;
        for (reg u32 q = tid; q < quads; q += step) {
            reg f32 s[8];
            unroll (k = 0..8) { s[k] = 0.0f; }
            for (reg u32 src = 0; src < degree; src += 1) {
                d41_load_f32x8_add(ptr_add(gathered, src, elems << 2), q << 3, s);
            }
            reg u32x4 ov;
            d41_moe_pack_bf16x8(s, ov);
            stg128(ptr_add(output, q, 16), ov);
        }
        preexit();
        return;
    }
    for (reg u32 idx = tid; idx < elems; idx += step) {
        reg f32 sum = 0.0f;
        for (reg u32 src = 0; src < degree; src += 1) {
            sum = sum + u32_as_f32(ldg32_stream(ptr_add(ptr_add(gathered, src, elems << 2), idx, 4)));
        }
        stg16(ptr_add(output, idx, 2), f32_to_bf16(sum));
    }
    preexit();
}

@pdl
@concept(moe)
kernel[D41M_BLK256, 64] d41_sum_gathered_256(
    global u32* gathered, global u32* output, u64 elements, u32 degree
) {
    acqbulk();
    reg u32 elems = elements[0];
    reg u32 tid = ctaid_x() * ntid_x() + tid_x();
    reg u32 step = grid_x() * ntid_x();
    if (((elems & 7) | (gathered[0] & 15) | (output[0] & 15)) == 0) {
        reg u32 quads = elems >> 3;
        for (reg u32 q = tid; q < quads; q += step) {
            reg f32 s[8];
            unroll (k = 0..8) { s[k] = 0.0f; }
            for (reg u32 src = 0; src < degree; src += 1) {
                reg u32x4 gv = ldg128_stream(ptr_add(ptr_add(gathered, src, elems << 1), q, 16));
                d41_moe_add_bf16x8(s, gv);
            }
            reg u32x4 ov;
            d41_moe_pack_bf16x8(s, ov);
            stg128(ptr_add(output, q, 16), ov);
        }
        preexit();
        return;
    }
    for (reg u32 idx = tid; idx < elems; idx += step) {
        reg f32 sum = 0.0f;
        for (reg u32 src = 0; src < degree; src += 1) {
            sum = sum + bf16_lo(ldg16_stream(ptr_add(ptr_add(gathered, src, elems << 1), idx, 2)));
        }
        stg16(ptr_add(output, idx, 2), f32_to_bf16(sum));
    }
    preexit();
}
