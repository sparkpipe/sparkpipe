@pdl
@concept(stage_mem)
template kernel[BLOCK, 48] index_pool_pack_tpl<IS_PACK>(
    global u32* src0, global u32* src1_or_dst, if (IS_PACK == 1) global u32* packed_bf16, u32 dim_or_pools,
    if (IS_PACK == 0) u32 local_stride, if (IS_PACK == 0) u64 peer_stride_bytes, if (IS_PACK == 0) u32 degree,
    if (IS_PACK == 0) global u32* sequence_of_row, if (IS_PACK == 0) global u32* context_length, if (IS_PACK == 0) global u32* row_positions,
    if (IS_PACK == 0) u32 dense_limit, if (IS_PACK == 0) u32 has_seq_ctx, if (IS_PACK == 0) u32 has_row_pos
) {
    acqbulk();
