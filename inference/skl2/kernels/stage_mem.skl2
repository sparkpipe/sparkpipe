@pdl
@concept(stage_mem)
template kernel[BLOCK, 48] index_dense_expand_tpl<EXPAND_POOL>(
    if (EXPAND_POOL == 1) global u32* selected_pools,
    global u32* sequence_of_row, global u32* context_length, global u32* positions, global u32* selected,
    if (EXPAND_POOL == 0) u32 topk, if (EXPAND_POOL == 1) u32 rows, if (EXPAND_POOL == 1) u32 dense_limit, if (EXPAND_POOL == 1) u32 fill_dense
) {
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x();
    if constexpr (EXPAND_POOL == 1) { if (row >= rows) { preexit(); return; } }
    reg u32 ctx = 0; row_active_keys(row, sequence_of_row, context_length, positions, ctx);
    if constexpr (EXPAND_POOL == 0) {
        if (ctx <= topk) {
            reg u64 dst = ptr_add(selected, row, topk << 2);
            for (reg u32 i = tid; i < topk; i += BLOCK) { stg32(ptr_add(dst, i, 4), (i < ctx) ? i : STG_NO_ROW); }
        }
    } else {
        reg u64 dst = ptr_add(selected, row, 2051 << 2);
        if (dense_limit != 0 && ctx <= dense_limit) {
            if (fill_dense != 0) { for (reg u32 i = tid; i < 2051; i += BLOCK) { stg32(ptr_add(dst, i, 4), (i < ctx) ? i : STG_NO_ROW); } }
            preexit(); return;
        }
        reg u32 pooled = ctx & 0xFFFFFFFC; reg u64 srow = ptr_add(selected_pools, row, 2048);
        for (reg u32 i = tid; i < 2051; i += BLOCK) {
            reg u32 pos = STG_NO_ROW;
            if (i < 2048) { reg u32 cand = (ldg32_persist(ptr_add(srow, i >> 2, 4)) << 2) + (i & 3); if (cand < pooled) { pos = cand; } }
            else { reg u32 cand = pooled + i - 2048; if (cand < ctx) { pos = cand; } }
            stg32(ptr_add(dst, i, 4), pos);
        }
    }
    preexit();
}

