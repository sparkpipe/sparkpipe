@pdl
@concept(stage_mem)
template kernel[BLOCK, 32] stage_kv_ring_copy_tpl<IS_RING>(
    global u32* src_buf, global u32* idx_buf,
    if (IS_RING == 0) global u32* kv_all, if (IS_RING == 0) u32 rows, if (IS_RING == 0) u32 total_ctx,
    if (IS_RING == 1) u64 slot_stride, if (IS_RING == 1) u32 ring_elements, if (IS_RING == 1) global u32* send
) {
