@pdl
@concept(route_topk)
kernel[BLOCK, 48] d41_whole_block_max_256(
    global f32* scores, u64 score_stride, global u32* seq, global u32* len, global u32* bound,
    global f32* block_scores, u32 block_stride, u32 grain, u32 dense_rows
) {
    shared f32 s_vals[2048];
    acqbulk();
    reg u32 row = ctaid_y(); reg u32 act = 0;
    row_active_keys(row, seq, len, bound, act);
    if (dense_rows != 0 && act <= dense_rows) { preexit(); return; }
    reg u32 sstr = score_stride[0]; reg u64 src = ptr_add(scores, row, sstr << 2);
    reg u64 dst = ptr_add(block_scores, row, block_stride << 2);
    reg u32 b0 = ctaid_x() * ntid_x(); reg u32 tid = tid_x(); reg u32 b = b0 + tid;
    reg u32 fast8 = 0;
    if (grain == 8) { if (ntid_x() == 256) { if ((src[0] & 15) == 0) { fast8 = 1; } } }
    if (fast8 != 0) {
        reg u32 base_k = b0 << 3;
        if (base_k >= act) { if (b < block_stride) { stg32(ptr_add(dst, b, 4), STG_NEG_INF); } preexit(); return; }
        reg u32 lim = (act < sstr) ? act : sstr;
        unroll (pass = 0..2) {
            reg u32 off = (pass * 256 + tid) << 2; reg u32 gk = base_k + off;
            if (gk + 3 < lim) { sts128(s_vals, off, ldg128_stream(ptr_add(src, gk, 4))); }
            else { unroll (e = 0..4) { sts32(s_vals, off + e, u32_as_f32((gk + e < lim) ? ldg32_stream(ptr_add(src, gk + e, 4)) : STG_NEG_INF)); } }
        }
        barrier();
        if (b < block_stride) {
            reg u32 o = tid << 3;
            reg f32 m0 = maxf(maxf(lds32(s_vals, o), lds32(s_vals, o + 1)), maxf(lds32(s_vals, o + 2), lds32(s_vals, o + 3)));
            reg f32 m1 = maxf(maxf(lds32(s_vals, o + 4), lds32(s_vals, o + 5)), maxf(lds32(s_vals, o + 6), lds32(s_vals, o + 7)));
            stg32(ptr_add(dst, b, 4), f32_as_u32(maxf(m0, m1)));
        }
    } else if (b < block_stride) {
        reg u32 first = b * grain;
        reg f32 mx = u32_as_f32(STG_NEG_INF);
        reg u32 last = (first + grain < act) ? (first + grain) : act;
        for (reg u32 i = first; i < last; i += 1) { mx = maxf(mx, u32_as_f32(ldg32_stream(ptr_add(src, i, 4)))); }
        stg32(ptr_add(dst, b, 4), f32_as_u32(mx));
    }
    preexit();
}

@pdl
@concept(route_topk)
kernel[BLOCK, 32] d41_whole_block_apply_256(
    global f32* scores, u64 score_stride, u32 grain, global u8* mask, u32 block_stride,
    global u32* seq, global u32* len, global u32* bound, u32 dense_rows
) {
    acqbulk();
    reg u32 row = ctaid_y(); reg u32 act = 0; row_active_keys(row, seq, len, bound, act);
    if (act > dense_rows) {
        reg u32 sstr = score_stride[0]; reg u32 i = ctaid_x() * ntid_x() + tid_x();
        if (i < ((act < sstr) ? act : sstr)) {
            reg u32 b = 0; reg u32 rem = 0; u32_divmod(i, grain, b, rem);
            reg u32 keep_b = (b < block_stride) ? ldg8_stream(ptr_add(ptr_add(mask, row, block_stride), b, 1)) : 0;
            if (keep_b == 0) { stg32(ptr_add(ptr_add(scores, row, sstr << 2), i, 4), STG_NEG_INF); }
        }
    }
    preexit();
}

@pdl
@concept(route_topk)
kernel[BLOCK, 32] d41_whole_block_mask_256(
    global f32* block_scores, global u32* chosen, u32 keep, global u8* mask, u32 block_stride,
    global u32* seq, global u32* len, global u32* bound, u32 grain, u32 dense_rows
) {
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x(); reg u32 step = ntid_x();
    reg u64 line = ptr_add(mask, row, block_stride); reg u32 has_meta = 0;
    if (dense_rows != 0) { if ((seq[0] | seq[1]) != 0) { if ((len[0] | len[1]) != 0) { has_meta = 1; } } }
    if (has_meta != 0) {
        reg u32 act = 0; row_active_keys(row, seq, len, bound, act);
        if (act <= dense_rows) {
            reg u32 ab = 0; reg u32 rem = 0; u32_divmod(act + grain - 1, grain, ab, rem);
            for (reg u32 b = tid; b < block_stride; b += step) { stg8(ptr_add(line, b, 1), (b < ab) ? 1 : 0); }
            preexit(); return;
        }
    }
    reg u64 brow = ptr_add(block_scores, row, block_stride << 2);
    for (reg u32 b = tid; b < block_stride; b += step) { stg8(ptr_add(line, b, 1), 0); }
    barrier();
    reg u64 ch_row = ptr_add(chosen, row, keep << 2); reg f32 ninf = u32_as_f32(STG_NEG_INF);
    for (reg u32 e = tid; e < keep; e += step) {
        reg u32 b = ldg32_stream(ptr_add(ch_row, e, 4));
        if (b < block_stride) { if (u32_as_f32(ldg32_stream(ptr_add(brow, b, 4))) > ninf) { stg8(ptr_add(line, b, 1), 1); } }
    }
    preexit();
}

macro stg_compact_half(primary, idx, count, s_warp, wid, lane, out_flag, out_off, out_tot) {
    out_flag = 0;
    if (idx < count) { if (ldg32_persist(ptr_add(primary, idx + 1, 4)) > ldg32_persist(ptr_add(primary, idx, 4))) { out_flag = 1; } }
    reg u32 v = out_flag; warp_prefix_u32(v, lane);
    if (lane == 31) { sts32(s_warp, wid, v); }
    barrier();
    if (wid == 0) { reg u32 w = (lane < 8) ? lds32(s_warp, lane) : 0; warp_prefix_u32(w, lane); if (lane < 8) { sts32(s_warp, lane, w); } }
    barrier();
    out_tot = lds32(s_warp, 7);
    out_off = ((wid > 0) ? lds32(s_warp, wid - 1) : 0) + v - out_flag;
}

@pdl
@concept(route_topk)
template kernel[BLOCK, 32] route_compact_tpl<IS_LOCAL>(
    global u32* primary, if (IS_LOCAL == 1) global f32* route_weight, global u32* out_buf, u32 count0,
    if (IS_LOCAL == 1) global u8* group, if (IS_LOCAL == 1) u32 local_experts, if (IS_LOCAL == 1) u32 groups, u32 count1
) {
    if constexpr (IS_LOCAL == 0) { shared u32 s_warp[8]; }
    acqbulk();
    if constexpr (IS_LOCAL == 0) {
        reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
        reg u32 a0 = 0; reg u32 off0 = 0; reg u32 tot0 = 0; reg u32 a1 = 0; reg u32 off1 = 0; reg u32 tot1 = 0;
        stg_compact_half(primary, tid, count1, s_warp, wid, lane, a0, off0, tot0);
        if (a0 != 0) { stg32(ptr_add(out_buf, off0, 4), tid); }
        barrier();
        stg_compact_half(primary, tid + 256, count1, s_warp, wid, lane, a1, off1, tot1);
        if (a1 != 0) { stg32(ptr_add(out_buf, tot0 + off1, 4), tid + 256); }
        if (tid == 0) { stg32(ptr_add(out_buf, count0, 4), tot0 + tot1); }
    } else {
        reg u32 route = ctaid_x() * ntid_x() + tid_x();
        if (route < count0) {
            reg u32 val = ldg32_persist(ptr_add(primary, route, 4)); reg u32 ex = val & 0x7FFFFFFF;
            reg u32 loc = (ex < count1) ? ldg8_persist(ptr_add(group, ex, 1)) : groups;
            stg32(ptr_add(out_buf, route, 4), ex);
            reg u32 keep = ((val >> 31) != 0) ? ((loc >= local_experts) ? ((loc < groups) ? 1 : 0) : 0) : ((loc < local_experts) ? 1 : 0);
            if (keep != 0) { stg32(ptr_add(primary, route, 4), loc); }
            else { stg32(ptr_add(primary, route, 4), groups); stg32(ptr_add(route_weight, route, 4), 0); }
        }
    }
    preexit();
}

instantiate route_compact_tpl<0> as d41_compact_active_experts_256;
instantiate route_compact_tpl<1> as d41_route_local_256;

@pdl
@concept(recurrent)
template kernel[BLOCK, 32] conv_window_stream_tpl<MODE>(
    global u16* window, global u16* input_or_tail, if (MODE == 0) global u32* chunk_row_begin,
    if (MODE == 2) global u16* before, if (MODE != 0) u32 rows_or_end, u32 channels, if (MODE == 0) u32 chunks
) {
    acqbulk();
    reg u32 idx = ctaid_x() * BLOCK + tid_x();
    if constexpr (MODE == 0) {
        reg u32 q_ch = 0; reg u32 ch = 0; u32_divmod(idx, channels, q_ch, ch);
        reg u32 chunk = 1 + q_ch;
        if (chunk < chunks) {
            reg u32 rb = ldg32_persist(ptr_add(chunk_row_begin, chunk, 4));
            reg u64 wp = ptr_add(window, chunk * channels + ch, 8);
            unroll (tap = 0..4) { stg16(ptr_add(wp, tap, 2), ldg16_stream(ptr_add(ptr_add(input_or_tail, rb - 4 + tap, channels << 1), ch, 2))); }
        }
    } else if constexpr (MODE == 1) {
        if (idx < channels) {
            reg u64 wp = ptr_add(window, idx, 8);
            unroll (tap = 0..4) {
                reg u32 val = (rows_or_end + tap >= 4) ? ldg16_stream(ptr_add(ptr_add(input_or_tail, rows_or_end + tap - 4, channels << 1), idx, 2)) : 0;
                stg16(ptr_add(wp, tap, 2), val);
            }
        }
    } else {
        if (idx < channels) {
            reg u64 bp = ptr_add(before, idx, 8); reg u64 ep = ptr_add(input_or_tail, idx, 8); reg u32 taps[4];
            unroll (tap = 0..4) { taps[tap] = (tap + rows_or_end < 4) ? ldg16_stream(ptr_add(bp, tap + rows_or_end, 2)) : ldg16_stream(ptr_add(ep, tap, 2)); }
            reg u64 wp = ptr_add(window, idx, 8);
            unroll (tap = 0..4) { stg16(ptr_add(wp, tap, 2), taps[tap]); }
        }
    }
    preexit();
}

instantiate conv_window_stream_tpl<0> as k3_streamed_conv_seed_256;
instantiate conv_window_stream_tpl<1> as k3_streamed_conv_tail_256;
instantiate conv_window_stream_tpl<2> as k3_streamed_conv_end_256;

macro stg_kda_load_tap(in_p, seq_row_indices, has_seq_idx, idx, ch_b, ch, out_v) {
    reg u32 r = idx;
    if (has_seq_idx != 0) { r = ldg32_persist(ptr_add(seq_row_indices, idx, 4)); }
    out_v = ldg16_persist(ptr_add(ptr_add(in_p, r, ch_b), ch, 2));
}

macro stg_kda_conv_header(blk_idx, win_q, win_k, win_v, in_q, in_k, in_v, state_index, seq_row_begin, channels, rows, has_seq_begin, out_sid, out_ch, out_in_p, out_beg, out_cnt, out_slot) {
    reg u32 bi = 0; u32_divmod(blk_idx, channels >> 7, out_sid, bi);
    out_ch = (bi << 7) + tid_x();
    reg u64 win_b = (out_sid == 0) ? win_q : ((out_sid == 1) ? win_k : win_v);
    out_in_p = (out_sid == 0) ? in_q : ((out_sid == 1) ? in_k : in_v);
    out_beg = 0; reg u32 end = rows;
    if (has_seq_begin != 0) { out_beg = ldg32_persist(seq_row_begin); end = ldg32_persist(ptr_add(seq_row_begin, 1, 4)); }
    out_cnt = (end > out_beg) ? (end - out_beg) : 0;
    out_slot = ptr_add(ptr_add(win_b, ldg32_persist(state_index) * channels, 8), out_ch, 8);
}

@pdl
@concept(recurrent)
kernel[128, 48] g5n_kda_causal_conv_prefill_128(
    global u32* win_q, global u32* win_k, global u32* win_v,
    global u32* state_index, global u32* seq_row_begin, global u32* seq_row_indices,
    global u32* in_q, global u32* in_k, global u32* in_v,
    global u32* w_q, global u32* w_k, global u32* w_v,
    global u32* out_q, global u32* out_k, global u32* out_v,
    u32 channels, u32 rows, u32 has_seq_begin, u32 has_seq_idx
) {
    acqbulk();
    reg u32 sid = 0; reg u32 ch = 0; reg u64 in_p = 0; reg u32 beg = 0; reg u32 cnt = 0; reg u64 slot = 0;
    stg_kda_conv_header(ctaid_y(), win_q, win_k, win_v, in_q, in_k, in_v, state_index, seq_row_begin, channels, rows, has_seq_begin, sid, ch, in_p, beg, cnt, slot);
    reg u32 rb = ctaid_x() << 3;
    if (rb >= cnt) { preexit(); return; }
    reg u32 ch_b = channels << 1;
    reg u64 w_p = (sid == 0) ? w_q : ((sid == 1) ? w_k : w_v);
    reg u64 out_p = (sid == 0) ? out_q : ((sid == 1) ? out_k : out_v);
    reg u32x2 ww = ldg64_persist(ptr_add(w_p, ch, 8));
    reg f32 tw0 = bf16_lo(ww[0]); reg f32 tw1 = bf16_hi(ww[0]); reg f32 tw2 = bf16_lo(ww[1]); reg f32 tw3 = bf16_hi(ww[1]);
    reg u32 t0 = 0; reg u32 t1 = 0; reg u32 t2 = 0; reg u32 t3 = 0;
    if (rb < 3) {
        reg u32x2 w = ldg64_persist(slot);
        t0 = w[0] & 0xFFFF; t1 = w[0] >> 16; t2 = w[1] & 0xFFFF; t3 = w[1] >> 16;
        for (reg u32 p = 0; p < rb; p += 1) { t0 = t1; t1 = t2; t2 = t3; stg_kda_load_tap(in_p, seq_row_indices, has_seq_idx, beg + p, ch_b, ch, t3); }
    } else {
        stg_kda_load_tap(in_p, seq_row_indices, has_seq_idx, beg + rb - 3, ch_b, ch, t1);
        stg_kda_load_tap(in_p, seq_row_indices, has_seq_idx, beg + rb - 2, ch_b, ch, t2);
        stg_kda_load_tap(in_p, seq_row_indices, has_seq_idx, beg + rb - 1, ch_b, ch, t3);
    }
    reg u32 r_end = (rb + 8 < cnt) ? (rb + 8) : cnt;
    for (reg u32 o = rb; o < r_end; o += 1) {
        reg u32 row = beg + o;
        if (has_seq_idx != 0) { row = ldg32_persist(ptr_add(seq_row_indices, beg + o, 4)); }
        t0 = t1; t1 = t2; t2 = t3; t3 = ldg16_persist(ptr_add(ptr_add(in_p, row, ch_b), ch, 2));
        reg f32 tb = bf16_lo(f32_to_bf16(((bf16_lo(t0) * tw0 + bf16_lo(t1) * tw1) + bf16_lo(t2) * tw2) + bf16_lo(t3) * tw3));
        reg f32 sg = 0.0f; sigmoid_exact_f32(tb, sg);
        stg16(ptr_add(ptr_add(out_p, row, ch_b), ch, 2), f32_to_bf16(tb * sg));
    }
    preexit();
}

@pdl
@concept(recurrent)
kernel[128, 48] g5n_kda_conv_window_commit_128(
    global u32* win_q, global u32* win_k, global u32* win_v,
    global u32* state_index, global u32* seq_row_begin, global u32* seq_row_indices,
    global u32* in_q, global u32* in_k, global u32* in_v,
    u32 channels, u32 rows, u32 has_seq_begin, u32 has_seq_idx
) {
    acqbulk();
    reg u32 sid = 0; reg u32 ch = 0; reg u64 in_p = 0; reg u32 beg = 0; reg u32 cnt = 0; reg u64 slot = 0;
    stg_kda_conv_header(ctaid_x(), win_q, win_k, win_v, in_q, in_k, in_v, state_index, seq_row_begin, channels, rows, has_seq_begin, sid, ch, in_p, beg, cnt, slot);
    if (cnt == 0) { preexit(); return; }
    reg u32x2 ow = (cnt < 4) ? ldg64_persist(slot) : pack_u32x2(0, 0);
    reg u32 taps[4];
    unroll (t = 0..4) {
        if (cnt + t >= 4) { stg_kda_load_tap(in_p, seq_row_indices, has_seq_idx, beg + cnt + t - 4, channels << 1, ch, taps[t]); }
        else { reg u32 pi = cnt + t; taps[t] = (pi == 0) ? (ow[0] & 0xFFFF) : ((pi == 1) ? (ow[0] >> 16) : ((pi == 2) ? (ow[1] & 0xFFFF) : (ow[1] >> 16))); }
    }
    stg64(slot, pack_u32x2(pack_u16x2(taps[0], taps[1]), pack_u16x2(taps[2], taps[3])));
    preexit();
}

macro stg_lane_count(has_lc, lane_count, seq_row_begin, ln, out_cnt) {
    out_cnt = (has_lc != 0) ? ldg32_persist(ptr_add(lane_count, ln, 4)) : (ldg32_persist(ptr_add(seq_row_begin, ln + 1, 4)) - ldg32_persist(ptr_add(seq_row_begin, ln, 4)));
}

macro stg_ring_store_body(wave_kv, ring, positions, row_lane, row_ordinal, seq_row_begin, rec_slot, ring_slot_stride, ring_rows, window, degree, rank, rows, commit, lane_count, path_rows, row_in, tid) {
    if (commit != 0 && row_in < rows) {
        reg u32 has_pr = ((path_rows[0] | path_rows[1]) != 0) ? 1 : 0; reg u32 has_lc = ((lane_count[0] | lane_count[1]) != 0) ? 1 : 0;
        reg u32 ln = 0; reg u32 cnt = 0; reg u32 ord = row_in; reg u32 row = row_in;
        if (has_pr != 0) {
            if (has_lc != 0) { cnt = ldg32_persist(lane_count); }
            if (ord < cnt && ord + window >= cnt) { row = ldg32_persist(ptr_add(path_rows, ord, 4)); }
        } else {
            ln = ldg32_persist(ptr_add(row_lane, row, 4));
            stg_lane_count(has_lc, lane_count, seq_row_begin, ln, cnt);
            ord = ldg32_persist(ptr_add(row_ordinal, row, 4));
        }
        if (ord < cnt && ord + window >= cnt) {
            reg u32 pos = ldg32_persist(ptr_add(positions, row, 4)); reg u32 qd = pos; reg u32 rd = 0;
            if (degree > 1) { u32_divmod(pos, degree, qd, rd); }
            if (rd == rank) {
                reg u32 qr = 0; reg u32 rr = 0; u32_divmod(qd, ring_rows, qr, rr);
                copy_bf16_1d(ptr_add(wave_kv, row, 1024), ptr_add(ptr_add(ring, ldg32_persist(ptr_add(rec_slot, ln, 4)), ring_slot_stride[0] << 1), rr, 1024), 512, tid, BLOCK);
            }
        }
    }
}

macro stg_merge_sink_stats(partials, source_stride, sources, heads, sink, row, head, s_scales, s_denom, tid, out_denom, out_inv_d) {
    reg u32 base = (row * heads + head) * 514;
    if (tid < 32) {
        reg f32 max_l = u32_as_f32(0xF193E593); reg f32 den_l = 0.0f;
        if (tid < sources) {
            reg u64 p_s = ptr_add(ptr_add(partials, tid, source_stride[0] << 2), base, 4);
            max_l = u32_as_f32(ldg32_persist(p_s)); den_l = u32_as_f32(ldg32_persist(ptr_add(p_s, 1, 4)));
        }
        reg f32 top = warp_max(max_l); reg f32 sc_l = 0.0f;
        if (tid < sources) {
            if (f32_as_u32(max_l) != STG_NEG_INF) { sc_l = exp2_ftz((max_l - top) * 1.4426950408889634f); }
            sts32(s_scales, tid, sc_l);
        }
        reg f32 dsum = 0.0f;
        for (reg u32 s = 0; s < sources; s += 1) { dsum = fma(shfl_idx(den_l, s), shfl_idx(sc_l, s), dsum); }
        if (tid == 0) { sts32(s_denom, 0, dsum + exp2_ftz((u32_as_f32(ldg32_persist(ptr_add(sink, head, 4))) - top) * 1.4426950408889634f)); }
    }
    barrier();
    out_denom = lds32(s_denom, 0); rcp_nr1_f32(out_denom, out_inv_d);
}

@pdl
@concept(attention)
kernel[BLOCK, 48] d41_compressor_save_256(
    global f32* kv, global f32* score, global f32* state, global u32* positions, global u32* row_lane,
    global u32* row_ordinal, global u32* sequence_row_begin, global u32* recurrent_slot,
    u32 rows, u32 ratio, u32 state_stride_floats, u32 width, u32 commit, global u32* lane_count, global u32* path_rows
) {
    acqbulk();
    if (commit == 0) { preexit(); return; }
    reg u32 row = ctaid_x(); reg u32 lane = 0;
    reg u32 has_path = ((path_rows[0] | path_rows[1]) != 0) ? 1 : 0; reg u32 has_lc = ((lane_count[0] | lane_count[1]) != 0) ? 1 : 0;
    if (has_path != 0) {
        reg u32 cnt = (has_lc != 0) ? ldg32_stream(lane_count) : 0;
        if (ctaid_x() != 0 || cnt == 0) { preexit(); return; }
        row = ldg32_stream(ptr_add(path_rows, cnt - 1, 4));
    } else {
        if (row >= rows) { preexit(); return; }
        lane = ldg32_stream(ptr_add(row_lane, row, 4));
        reg u32 cnt = 0; stg_lane_count(has_lc, lane_count, sequence_row_begin, lane, cnt);
        if (ldg32_stream(ptr_add(row_ordinal, row, 4)) + 1 != cnt) { preexit(); return; }
    }
    reg u32 q0 = 0; reg u32 r0 = 0; u32_divmod(ldg32_stream(ptr_add(positions, row, 4)) + 1, ratio, q0, r0);
    if (r0 == 0) { preexit(); return; }
    reg u64 dst = ptr_add(state, ldg32_stream(ptr_add(recurrent_slot, lane, 4)), state_stride_floats << 2);
    reg u64 dst_s = ptr_add(dst, width, 4); reg u64 src_k = ptr_add(kv, row, width << 2); reg u64 src_s = ptr_add(score, row, width << 2);
    reg u32 step = ntid_x();
    for (reg u32 c = tid_x(); c < width; c += step) { stg32(ptr_add(dst, c, 4), ldg32_stream(ptr_add(src_k, c, 4))); stg32(ptr_add(dst_s, c, 4), ldg32_stream(ptr_add(src_s, c, 4))); }
    preexit();
}

@pdl
@concept(stage_mem)
kernel[BLOCK, 64] d41_window_ring_store_256(
    global u16* wave_kv, global u16* ring, global u32* positions, global u32* row_lane, global u32* row_ordinal,
    global u32* seq_row_begin, global u32* rec_slot, u64 ring_slot_stride, u32 ring_rows, u32 window, u32 degree, u32 rank,
    u32 rows, u32 commit, global u32* lane_count, global u32* path_rows
) {
    acqbulk();
    stg_ring_store_body(wave_kv, ring, positions, row_lane, row_ordinal, seq_row_begin, rec_slot, ring_slot_stride, ring_rows, window, degree, rank, rows, commit, lane_count, path_rows, ctaid_x(), tid_x());
    preexit();
}

@pdl
@concept(attention)
kernel[BLOCK, 48] d41_merge_sink_256(
    global f32* partials, u64 source_stride, u32 sources, u32 heads, global f32* sink, global u16* output
) {
    shared f32 s_scales[16]; shared f32 s_denom[1];
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 head = ctaid_y(); reg u32 tid = tid_x();
    reg f32 denom = 0.0f; reg f32 inv_d = 0.0f;
    stg_merge_sink_stats(partials, source_stride, sources, heads, sink, row, head, s_scales, s_denom, tid, denom, inv_d);
    reg u64 first_src = ptr_add(partials, (row * heads + head) * 514 + 2, 4); reg u64 out_p = ptr_add(output, row * heads + head, 1024);
    reg u32 s_ok = (sources == 1) ? 1 : (((source_stride[0] & 3) == 0) ? 1 : 0);
    reg u32 align16 = 0;
    if (((first_src[0] | out_p[0]) & 15) == 0) { if (s_ok != 0) { align16 = 1; } }
    if (align16 != 0) {
        if (tid < 128) {
            reg f32 m[4]; reg f32 q[4]; unroll (k = 0..4) { m[k] = 0.0f; q[k] = 0.0f; }
            for (reg u32 s = 0; s < sources; s += 1) {
                reg f32 sc = lds32(s_scales, s); reg u32x4 p = ldg128_stream(ptr_add(ptr_add(first_src, s, source_stride[0] << 2), tid, 16));
                unroll (k = 0..4) { m[k] = fma(u32_as_f32(p[k]), sc, m[k]); }
            }
            unroll (k = 0..4) { div_nr1_f32(m[k], denom, inv_d, q[k]); }
            stg64(ptr_add(out_p, tid, 8), pack_u32x2(pack_bf16x2(q[0], q[1]), pack_bf16x2(q[2], q[3])));
        }
    } else {
        for (reg u32 e = tid; e < 512; e += BLOCK) {
            reg f32 m = 0.0f; reg f32 q = 0.0f;
            for (reg u32 s = 0; s < sources; s += 1) { m = fma(u32_as_f32(ldg32_stream(ptr_add(ptr_add(first_src, s, source_stride[0] << 2), e, 4))), lds32(s_scales, s), m); }
            div_nr1_f32(m, denom, inv_d, q); stg16(ptr_add(out_p, e, 2), f32_to_bf16(q));
        }
    }
    preexit();
}

@pdl
@concept(attention)
template kernel[BLOCK, REGS] spread_output_tpl<WITH_RING, REGS>(
    global f32* partials, u64 source_stride, u32 heads, global f32* sink, global u32* positions, global f32* inv_freq, global u16* output, u32 qdq,
    if (WITH_RING == 1) global u16* wave_kv, if (WITH_RING == 1) global u16* ring, if (WITH_RING == 1) global u32* row_lane,
    if (WITH_RING == 1) global u32* row_ordinal, if (WITH_RING == 1) global u32* seq_row_begin, if (WITH_RING == 1) global u32* rec_slot,
    if (WITH_RING == 1) u64 ring_slot_stride, if (WITH_RING == 1) u32 ring_rows, if (WITH_RING == 1) u32 window,
    if (WITH_RING == 1) u32 rows, if (WITH_RING == 1) u32 commit
) {
    shared f32 s_scales[16]; shared f32 s_denom[1]; shared u32 s_merged[256];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 row = ctaid_x(); reg u32 head = ctaid_y();
    if constexpr (WITH_RING == 1) {
        reg u32 total_heads = rows * heads;
        if (ctaid_x() >= total_heads) {
            reg u64 null_ptr = 0;
            stg_ring_store_body(wave_kv, ring, positions, row_lane, row_ordinal, seq_row_begin, rec_slot, ring_slot_stride, ring_rows, window, 1, 0, rows, commit, null_ptr, null_ptr, ctaid_x() - total_heads, tid);
            preexit(); return;
        }
        u32_divmod(ctaid_x(), heads, row, head);
    }
    reg f32 denom = 0.0f; reg f32 inv_d = 0.0f;
    stg_merge_sink_stats(partials, source_stride, 1, heads, sink, row, head, s_scales, s_denom, tid, denom, inv_d);
    reg f32 sc0 = lds32(s_scales, 0);
    reg u64 fsrc = ptr_add(partials, (row * heads + head) * 514 + 2, 4);
    reg f32 q0 = 0.0f; reg f32 q1 = 0.0f;
    div_nr1_f32(u32_as_f32(ldg32_stream(ptr_add(fsrc, tid << 1, 4))) * sc0, denom, inv_d, q0);
    div_nr1_f32(u32_as_f32(ldg32_stream(ptr_add(fsrc, (tid << 1) + 1, 4))) * sc0, denom, inv_d, q1);
    sts32(s_merged, tid, pack_bf16x2(q0, q1));
    barrier();
    if (tid < 32) {
        reg f32 sn = 0.0f; reg f32 cs = 0.0f;
        sincos_exact_f32(u32_to_f32(ldg32_persist(ptr_add(positions, row, 4))) * u32_as_f32(ldg32_persist(ptr_add(inv_freq, tid, 4))), sn, cs);
        reg u32 rot = 0; rope_pair_bf16_u32(lds32(s_merged, 224 + tid), 0.0f - sn, cs, rot);
        sts32(s_merged, 224 + tid, rot);
    }
    barrier();
    reg u64 target = ptr_add(output, row * heads + head, 1024);
    for (reg u32 e = tid; e < 512; e += BLOCK) {
        reg u32 w = lds32(s_merged, e >> 1);
        reg u32 bf = ((e & 1) == 0) ? (w & 0xFFFF) : (w >> 16);
        if (qdq != 0) { fp8_e4m3_qdq_lane_bf16(bf16_lo(bf), bf); }
        stg16(ptr_add(target, e, 2), bf);
    }
    preexit();
}

instantiate spread_output_tpl<0, 56> as d41_spread_output_256;
instantiate spread_output_tpl<1, 80> as d41_spread_output_ring_256;

@pdl
@concept(attention)
kernel[BLOCK, 48] k3_streamed_fold_records_256(
    global f32* running, global f32* block_in, u32 heads, u32 rows, u32 first, u32 value_dim, u32 record_floats
) {
    shared f32 keep_s[256]; shared f32 take_s[256];
    acqbulk();
    reg u32 row = ctaid_x();
    if (row >= rows) { preexit(); return; }
    reg u32 tid = tid_x(); reg u32 width = heads * value_dim;
    reg u64 r_ptr = ptr_add(running, row, record_floats << 2); reg u64 b_ptr = ptr_add(block_in, row, record_floats << 2);
    reg u32 aligned4 = ((((r_ptr[0] | b_ptr[0]) & 15) | (value_dim & 3)) == 0) ? 1 : 0;
    for (reg u32 h0 = 0; h0 < heads; h0 += BLOCK) {
        reg u32 hcount = (heads - h0 < BLOCK) ? (heads - h0) : BLOCK;
        if (tid < hcount) {
            reg u32 mo = width + ((h0 + tid) << 1);
            reg f32 om = (first == 0) ? u32_as_f32(ldg32_stream(ptr_add(r_ptr, mo, 4))) : u32_as_f32(STG_NEG_INF);
            reg f32 nm = u32_as_f32(ldg32_stream(ptr_add(b_ptr, mo, 4)));
            reg f32 top = maxf(om, nm);
            reg f32 kp = (f32_as_u32(om) == STG_NEG_INF) ? 0.0f : exp2_ftz((om - top) * 1.4426950408889634f);
            reg f32 tk = (f32_as_u32(nm) == STG_NEG_INF) ? 0.0f : exp2_ftz((nm - top) * 1.4426950408889634f);
            sts32(keep_s, tid, kp); sts32(take_s, tid, tk);
            reg f32 ol = (first == 0) ? (u32_as_f32(ldg32_stream(ptr_add(r_ptr, mo + 1, 4))) * kp) : 0.0f;
            stg32(ptr_add(r_ptr, mo + 1, 4), f32_as_u32(ol + u32_as_f32(ldg32_stream(ptr_add(b_ptr, mo + 1, 4))) * tk));
            stg32(ptr_add(r_ptr, mo, 4), f32_as_u32(top));
        }
        barrier();
        reg u64 rh = ptr_add(r_ptr, h0 * value_dim, 4); reg u64 bh = ptr_add(b_ptr, h0 * value_dim, 4);
        if (aligned4 != 0) {
            reg u32 vdim = value_dim >> 2;
            for (reg u32 idx = tid; idx < hcount * vdim; idx += BLOCK) {
                reg u32 h = 0; reg u32 rem = 0; u32_divmod(idx, vdim, h, rem);
                reg f32 kp = lds32(keep_s, h); reg f32 tk = lds32(take_s, h);
                reg u32x4 bv = ldg128_stream(ptr_add(bh, idx, 16));
                reg f32 o0 = u32_as_f32(bv[0]) * tk; reg f32 o1 = u32_as_f32(bv[1]) * tk; reg f32 o2 = u32_as_f32(bv[2]) * tk; reg f32 o3 = u32_as_f32(bv[3]) * tk;
                if (first == 0) {
                    reg u32x4 rv = ldg128_stream(ptr_add(rh, idx, 16));
                    o0 = fma(u32_as_f32(rv[0]), kp, o0); o1 = fma(u32_as_f32(rv[1]), kp, o1); o2 = fma(u32_as_f32(rv[2]), kp, o2); o3 = fma(u32_as_f32(rv[3]), kp, o3);
                }
                stg128(ptr_add(rh, idx, 16), pack_u32x4(f32_as_u32(o0), f32_as_u32(o1), f32_as_u32(o2), f32_as_u32(o3)));
            }
        } else {
            for (reg u32 idx = tid; idx < hcount * value_dim; idx += BLOCK) {
                reg u32 h = 0; reg u32 rem = 0; u32_divmod(idx, value_dim, h, rem);
                reg f32 ov = u32_as_f32(ldg32_stream(ptr_add(bh, idx, 4))) * lds32(take_s, h);
                if (first == 0) { ov = fma(u32_as_f32(ldg32_stream(ptr_add(rh, idx, 4))), lds32(keep_s, h), ov); }
                stg32(ptr_add(rh, idx, 4), f32_as_u32(ov));
            }
        }
        barrier();
    }
    preexit();
}

macro stg_exact_linear_w(LANES, s_w, weight, n0, chunks, output_dim, k_base, st, tid) {
    if (tid < (LANES << 2)) {
        reg u32 wn = (LANES == 32) ? (tid >> 5) : (tid >> 4);
        reg u32 wc = tid & (LANES - 1);
        reg u32 ok = ((n0 + wn < output_dim) ? 1 : 0) & ((k_base + wc < chunks) ? 1 : 0);
        reg u64 src = (ok != 0) ? ptr_add(ptr_add(weight, n0 + wn, chunks << 4), k_base + wc, 16) : weight;
        ldgsts128_z(smem_base(s_w) + ((st << 2) + wn) * (LANES << 4) + (wc << 4), src, ok);
    }
    ldgdepbar();
}

macro stg_linear_store_elem(ob_ptr, of_ptr, row, col, out_str, use_f32, val) {
    if (use_f32 != 0) { stg32(ptr_add(ptr_add(of_ptr, row, out_str << 2), col, 4), f32_as_u32(val)); }
    else { stg16(ptr_add(ptr_add(ob_ptr, row, out_str << 1), col, 2), f32_to_bf16(val)); }
}

macro stg_exact_split_read_part(args, OFF, task, out_w, out_ob, out_of, out_f32, out_dim, out_str, out_coff, out_n) {
    out_w = param_u64(args, OFF); out_ob = param_u64(args, OFF + 8); out_of = param_u64(args, OFF + 16);
    out_f32 = ((param_u32(args, OFF + 16) | param_u32(args, OFF + 20)) != 0) ? 1 : 0;
    out_dim = param_u32(args, OFF + 24); out_str = param_u32(args, OFF + 28);
    out_coff = param_u32(args, OFF + 32); out_n = (task - param_u32(args, OFF + 36)) << 2;
}

@pdl
@concept(linear)
template kernel[BLOCK, REGS] exact_linear_staged_tpl<LANES, RPG, REGS>(
    global u32* weight, global u32* activation, global u32* output_bf16, global f32* output_f32,
    u32 rows, u32 input_dim, u32 output_dim, u32 use_f32
) {
    shared u32 s_w[2 * 4 * LANES * 4];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 n0 = ctaid_x() << 2;
    reg u32 grp = (LANES == 32) ? (tid >> 5) : (tid >> 4); reg u32 sub = tid & (LANES - 1);
    reg u32 wf_row = ctaid_y() * ((BLOCK / LANES) * RPG) + grp * RPG;
    reg u32 row_cnt = (wf_row < rows) ? ((rows - wf_row < RPG) ? (rows - wf_row) : RPG) : 0;
    reg u32 chunks = input_dim >> 3; reg u32 in_b = input_dim << 1;
    stg_exact_linear_w(LANES, s_w, weight, n0, chunks, output_dim, 0, 0, tid);
    reg f32 acc[4 * RPG]; unroll (z = 0..(4 * RPG)) { acc[z] = 0.0f; }
    reg u32 cur = 0;
    for (reg u32 kb = 0; kb < chunks; kb += LANES) {
        reg u32 has_nxt = (kb + LANES < chunks) ? 1 : 0;
        if (has_nxt != 0) { stg_exact_linear_w(LANES, s_w, weight, n0, chunks, output_dim, kb + LANES, cur ^ 1, tid); depbar_le(1); }
        else { depbar_le(0); }
        barrier();
        reg u32 c = kb + sub;
        if (row_cnt != 0 && c < chunks) {
            reg u32x4 wv[4]; unroll (n = 0..4) { wv[n] = lds128(s_w, (((cur << 2) + n) * LANES + sub) << 2); }
            unroll (r = 0..RPG) {
                reg u32x4 va = ldg128_persist(ptr_add(ptr_add(activation, (r < row_cnt) ? (wf_row + r) : 0, in_b), c, 16));
                unroll (n = 0..4) { bf16_dot8_acc(acc[n * RPG + r], wv[n], va); }
            }
        }
        cur = cur ^ 1;
        if (has_nxt != 0) { barrier(); }
    }
    if (row_cnt == 0) { preexit(); return; }
    unroll (z = 0..(4 * RPG)) { lanes_reduce_sum(LANES, acc[z]); }
    if (sub == 0) {
        unroll (r = 0..RPG) {
            unroll (n = 0..4) {
                if (r < row_cnt && n0 + n < output_dim) {
                    stg_linear_store_elem(output_bf16, output_f32, wf_row + r, n0 + n, output_dim, use_f32, acc[n * RPG + r]);
                }
            }
        }
    }
    preexit();
}

