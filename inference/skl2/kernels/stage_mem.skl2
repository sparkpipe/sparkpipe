            reg u32 ctx = ldg32_persist(ptr_add(context_length, ldg32_persist(ptr_add(sequence_of_row, row, 4)), 4));
            if (has_row_pos != 0) { reg u32 rp = ldg32_persist(ptr_add(row_positions, row, 4)) + 1; if (rp < ctx) { ctx = rp; } }
            if (ctx <= dense_limit) { preexit(); return; }
            if ((ctx >> 2) < limit) { limit = ctx >> 2; }
        }
        reg u64 drow = ptr_add(src1_or_dst, row, dim_or_pools << 2); reg u32 rlb = (row * local_stride) << 2;
        for (reg u32 pool = tid; pool < limit; pool += BLOCK) {
            reg u32 owner = 0; reg u32 loc = pool;
            if (degree > 1) { u32_divmod(pool, degree, loc, owner); }
            stg32(ptr_add(drow, pool, 4), ldg32_persist(ptr_add(ptr_add(src0, owner, peer_stride_bytes[0]), rlb + (loc << 2), 1)));
        }
    }
    preexit();
}

