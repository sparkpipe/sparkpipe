            reg u32 pos = ldg32_persist(ptr_add(idx_buf, row, 4));
            if (pos < total_ctx && tid < 64) { stg128(ptr_add(ptr_add(kv_all, pos, 1024), tid, 16), ldg128_persist(ptr_add(ptr_add(src_buf, row, 1024), tid, 16))); }
        }
    } else {
        reg u32 rslot = ldg32_persist(idx_buf);
        reg u64 src = ptr_add(ptr_add(src_buf, row, ring_elements << 1), rslot, slot_stride[0] << 1);
        reg u64 dst = ptr_add(send, row, ring_elements << 1);
        reg u32 step = ntid_x();
        for (reg u32 i = tid; i < ring_elements; i += step) { stg16(ptr_add(dst, i, 2), ldg16_stream(ptr_add(src, i, 2))); }
    }
    preexit();
}

