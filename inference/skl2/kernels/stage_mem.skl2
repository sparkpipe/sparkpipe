instantiate kv_unpack_prior_tpl<64, 1024, 1> as g5n_unpack_prior_kv_64;

@pdl
@concept(stage_mem)
template kernel[32, 32] stage_gather_meta_tpl<PACKED>(
    if (PACKED == 1) global u32* plan, if (PACKED == 1) u32 capacity, global u32* sequence_of_row,
    if (PACKED == 1) global u32* length, if (PACKED == 0) u32 old_ctx,
    if (PACKED == 0) global u32* gather_seq, if (PACKED == 0) global u32* gather_offset, if (PACKED == 0) global u32* gather_prior_ctx
) {
    acqbulk();
    if (tid_x() == 0) {
        reg u32 seq = ldg32_stream(sequence_of_row);
        if constexpr (PACKED == 1) {
            stg32(plan, seq); stg32(ptr_add(plan, capacity + seq, 4), 0);
            stg32(ptr_add(plan, (capacity << 1) + seq, 4), ldg32_stream(ptr_add(length, seq, 4)));
        } else {
            stg32(gather_seq, seq); stg32(ptr_add(gather_offset, seq, 4), 0); stg32(ptr_add(gather_prior_ctx, seq, 4), old_ctx);
        }
    }
    preexit();
}

