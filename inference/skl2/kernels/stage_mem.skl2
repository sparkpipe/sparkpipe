instantiate stage_state_init_tpl<1, 128> as k3_streamed_pad_rows_128;

@pdl
@concept(stage_mem)
template kernel[BLOCK, 32] stage_div_map_tpl<MODE>(
    global u32* in0, if (MODE == 0) global u32* in1, global u32* out0, if (MODE == 0) global u32* out1, u32 count, u32 ratio
) {
    acqbulk();
    reg u32 idx = ctaid_x() * ntid_x() + tid_x();
    if (idx < count) {
        reg u32 v = ldg32_stream(ptr_add(in0, idx, 4));
        if constexpr (MODE == 0) {
            reg u32 cf = STG_NO_ROW; reg u32 co = 0; reg u32 r1 = 0;
            if (v != STG_NO_ROW) { reg u32 r0 = 0; u32_divmod(v, ratio, cf, r0); }
            stg32(ptr_add(out0, idx, 4), cf);
            u32_divmod(ldg32_stream(ptr_add(in1, idx, 4)), ratio, co, r1); stg32(ptr_add(out1, idx, 4), co);
        } else if constexpr (MODE == 1) {
            reg u32 vis = 0; reg u32 rem = 0; u32_divmod(v + 1, ratio, vis, rem);
            stg32(ptr_add(out0, idx, 4), (vis == 0) ? STG_NO_ROW : (vis - 1));
        } else {
            reg u32 cl = 0; reg u32 rem = 0; u32_divmod(v, ratio, cl, rem); stg32(ptr_add(out0, idx, 4), cl);
        }
    }
    preexit();
}

