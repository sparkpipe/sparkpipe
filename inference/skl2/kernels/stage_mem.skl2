instantiate stage_gather_meta_tpl<0> as g5n_gather_meta_32;

@pdl
@concept(stage_mem)
template kernel[BLOCK, 32] stage_pad_fill_tpl<MODE>(
    global u32* dst, if (MODE == 3) u64 dest_stride, if (MODE == 3) u32 span, if (MODE == 3) u32 destinations,
    if (MODE != 3) u32 count_or_rows, if (MODE == 1) u32 padded1, if (MODE == 1) u32 stride1,
    if (MODE == 2) u32 padded2, if (MODE == 2) u32 keep2
) {
    acqbulk();
    reg u32 gidx = ctaid_x() * ntid_x() + tid_x(); reg u32 step = grid_x() * ntid_x();
    if constexpr (MODE == 0) {
        if (gidx < count_or_rows) { stg32(ptr_add(dst, gidx, 4), gidx); }
    } else if constexpr (MODE == 1) {
        for (reg u32 i = count_or_rows * stride1 + gidx; i < padded1 * stride1; i += step) { stg32(ptr_add(dst, i, 4), STG_NEG_INF); }
    } else if constexpr (MODE == 2) {
        reg u32x2 empty = pack_u32x2(0, STG_NO_ROW);
        for (reg u32 i = count_or_rows * keep2 + gidx; i < padded2 * keep2; i += step) { stg64(ptr_add(dst, i, 8), empty); }
    } else {
        for (reg u32 d = 0; d < destinations; d += 1) {
            reg u64 dptr = ptr_add(dst, d, dest_stride[0] << 2);
            for (reg u32 off = gidx; off < span; off += step) {
                reg u32 q = 0; reg u32 rem = 0; u32_divmod(off, 514, q, rem);
                stg32(ptr_add(dptr, off, 4), (rem == 0) ? STG_NEG_INF : 0);
            }
        }
    }
    preexit();
}

