import "stdlib/math.skl2";

const BLOCK = 256;
const STG_NO_ROW = 0xFFFFFFFF;
const STG_NEG_INF = 0xFF800000;

@pdl
@concept(head)
template kernel[BLOCK, 32] stage_embedding_pdl_t<MODE>(
    global u32* embed_weight, global u32* token_ids, global u32* hidden_bf16, u32 hidden,
    if (MODE != 2) u32 vocab_slice_offset, u32 vocab_slice_rows,
    if (MODE != 0) u32 alias_first, if (MODE != 0) u32 alias_count, if (MODE != 0) u32 alias_row
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_y();
    reg u32 tok = ldg32_stream(ptr_add(token_ids, row, 4));
    if constexpr (MODE != 0) { if (tok - alias_first < alias_count) { tok = alias_row; } }
    reg u32 local = (MODE != 2) ? (tok - vocab_slice_offset) : tok;
    reg u32 row_bytes = hidden << 1;
    ureg u64 target = ptr_add(hidden_bf16, row, row_bytes);
    reg u32 tid = ctaid_x() * BLOCK + tid_x(); reg u32 stride = grid_x() * BLOCK;
    reg u32 align_bad = (hidden & 7) | (target[0] & 15);
    if (local >= vocab_slice_rows) {
        if (align_bad == 0) {
            reg u32 vecs = hidden >> 3; reg u32x4 zero = pack_u32x4(0, 0, 0, 0);
            for (reg u32 v = tid; v < vecs; v += stride) { stg128(ptr_add(target, v, 16), zero); }
            return;
        }
        for (reg u32 k = tid; k < hidden; k += stride) { stg16(ptr_add(target, k, 2), 0); }
        return;
    }
    ureg u64 source = ptr_add(embed_weight, local, row_bytes);
    if constexpr (MODE != 2) {
        copy_bf16_1d(source, target, hidden, tid, stride);
    } else if ((align_bad | (source[0] & 15)) == 0) {
        reg u32 vecs = hidden >> 3;
        for (reg u32 v = tid; v < vecs; v += stride) {
            reg u32x4 val = ldg128_persist(ptr_add(source, v, 16));
            unroll (k = 0..4) {
                reg u32 lo = val[k] & 0xFFFF; reg u32 hi = val[k] & 0xFFFF0000;
                val[k] = ((lo == 0x8000) ? 0 : lo) | ((hi == 0x80000000) ? 0 : hi);
            }
            stg128(ptr_add(target, v, 16), val);
        }
    } else {
        for (reg u32 k = tid; k < hidden; k += stride) {
            reg u32 val = ldg16_persist(ptr_add(source, k, 2));
            stg16(ptr_add(target, k, 2), (val == 0x8000) ? 0 : val);
        }
    }
}

instantiate stage_embedding_pdl_t<0> as stage_embedding_lookup_pdl_bf16x8;
instantiate stage_embedding_pdl_t<1> as stage_embedding_alias_pdl_bf16x8;
instantiate stage_embedding_pdl_t<2> as stage_embedding_whole_pdl_bf16x8;

@concept(head)
kernel[BLOCK, 24] stage_store_outputs_u32_f32(
    global u32* token_ids_out, global u32* scores_out,
    global u32* tokens, global u32* scores, global u32* chain_step, u32 rows
) {
    reg u32 row = ctaid_x() * ntid_x() + tid_x();
    if (row >= rows) { return; }
    reg u32 base = ldg32_stream(chain_step) * rows + row;
    if ((token_ids_out[0] | token_ids_out[1]) != 0) { stg32(ptr_add(token_ids_out, base, 4), ldg32_stream(ptr_add(tokens, row, 4))); }
    if ((scores_out[0] | scores_out[1]) != 0) { stg32(ptr_add(scores_out, base, 4), ldg32_stream(ptr_add(scores, row, 4))); }
}

@concept(head)
kernel[BLOCK, 24] stage_chain_advance_u32(
    global u32* token_ids, global u32* tokens, global u32* positions,
    global u32* context_length, global u32* sequence_of_row, u32 rows,
    global u32* chain_step, global u32* distribution_positions, u32 distribution_count
) {
    reg u32 row = ctaid_x() * ntid_x() + tid_x();
    if (row == 0) { stg32(chain_step, ldg32_stream(chain_step) + 1); }
    if (row < distribution_count) { stg32(ptr_add(distribution_positions, row, 4), ldg32_stream(ptr_add(distribution_positions, row, 4)) + 1); }
    if (row >= rows) { return; }
    stg32(ptr_add(token_ids, row, 4), ldg32_stream(ptr_add(tokens, row, 4)));
    reg u32 p = ldg32_stream(ptr_add(positions, row, 4)) + 1;
    stg32(ptr_add(positions, row, 4), p);
    stg32(ptr_add(context_length, ldg32_stream(ptr_add(sequence_of_row, row, 4)), 4), p + 1);
}

@pdl
@concept(head)
template kernel[BLOCK, 32] stage_gather_rows_tpl<LAST_ROW>(
    if (LAST_ROW == 1) global u32* row_begin,
    global u32* row_indices, global u32* hidden_bf16, global u32* out_bf16, u32 hidden
) {
    acqbulk();
    preexit();
    reg u32 dst_row = ctaid_x();
    reg u32 idx = (LAST_ROW == 1) ? (ldg32_stream(ptr_add(row_begin, dst_row + 1, 4)) - 1) : dst_row;
    reg u32 src_row = ldg32_stream(ptr_add(row_indices, idx, 4));
    reg u32 row_bytes = hidden << 1;
    copy_bf16_1d(ptr_add(hidden_bf16, src_row, row_bytes), ptr_add(out_bf16, dst_row, row_bytes), hidden, tid_x(), ntid_x());
}

instantiate stage_gather_rows_tpl<1> as stage_last_rows_gather_pdl_bf16x8;
instantiate stage_gather_rows_tpl<0> as stage_rows_gather_pdl_bf16x8;

@pdl
@concept(head)
kernel[BLOCK, 24] stage_last_rows_scatter_pdl_u32_f32(
    global u32* row_begin, global u32* row_indices,
    global u32* token, global u32* score, global u32* out_token, global u32* out_score, u32 sequences
) {
    acqbulk();
    preexit();
    reg u32 seq = ctaid_x() * ntid_x() + tid_x();
    if (seq >= sequences) { return; }
    reg u32 row = ldg32_stream(ptr_add(row_indices, ldg32_stream(ptr_add(row_begin, seq + 1, 4)) - 1, 4));
    stg32(ptr_add(out_token, row, 4), ldg32_stream(ptr_add(token, seq, 4)));
    stg32(ptr_add(out_score, row, 4), ldg32_stream(ptr_add(score, seq, 4)));
}

@pdl
@concept(head)
template kernel[BLOCK, 24] stage_maxloc_tpl<MODE>(
    if (MODE == 1) global u32* scores_in, if (MODE == 2) global u32* maxloc_in, global u32* tokens,
    if (MODE == 2) global u32* scores_out, if (MODE == 1) global u32* maxloc_out, u32 rows, if (MODE == 0) u32 rank_offset
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_y();
    if (row >= rows || tid_x() != 0) { return; }
    if constexpr (MODE == 0) {
        reg u32 tok = ldg32_stream(ptr_add(tokens, row, 4));
        if (tok != STG_NO_ROW) { stg32(ptr_add(tokens, row, 4), tok + rank_offset); }
    } else if constexpr (MODE == 1) {
        reg u32 sb = ldg32_stream(ptr_add(scores_in, row, 4));
        reg u32 tok = ldg32_stream(ptr_add(tokens, row, 4));
        reg u32 ord = 0;
        if ((sb & 0x7FFFFFFF) <= 0x7F800000) {
            if (sb == 0x80000000) { sb = 0; }
            ord = ((sb & 0x80000000) != 0) ? (sb ^ STG_NO_ROW) : (sb ^ 0x80000000);
        }
        stg64(ptr_add(maxloc_out, row, 8), pack_u32x2(STG_NO_ROW - tok, ord));
    } else {
        reg u32x2 ml = ldg64_stream(ptr_add(maxloc_in, row, 8));
        reg u32 sb = ((ml[1] & 0x80000000) != 0) ? (ml[1] ^ 0x80000000) : (ml[1] ^ STG_NO_ROW);
        stg32(ptr_add(tokens, row, 4), STG_NO_ROW - ml[0]);
        stg32(ptr_add(scores_out, row, 4), sb);
    }
}

instantiate stage_maxloc_tpl<0> as stage_head_rank_token_pdl_u32;
instantiate stage_maxloc_tpl<1> as stage_maxloc_pack_pdl_f32_u32;
instantiate stage_maxloc_tpl<2> as stage_maxloc_unpack_pdl_u64;

@concept(allreduce)
template kernel[BLOCK, 24] stage_combine_tpl<IS_U64_MAX>(
    global u32* source, global u32* destination, u32 elements
) {
    reg u32 i = ctaid_x() * ntid_x() + tid_x();
    if (i >= elements) { return; }
    if constexpr (IS_U64_MAX == 1) {
        reg u32x2 sv = ldg64_stream(ptr_add(source, i, 8));
        reg u32x2 dv = ldg64_stream(ptr_add(destination, i, 8));
        reg u32 take = (sv[1] > dv[1]) ? 1 : 0;
        if (sv[1] == dv[1] && sv[0] > dv[0]) { take = 1; }
        if (take != 0) { stg64(ptr_add(destination, i, 8), sv); }
    } else {
        reg f32 a = bf16_lo(ldg16_stream(ptr_add(destination, i, 2)));
        reg f32 b = bf16_lo(ldg16_stream(ptr_add(source, i, 2)));
        stg16(ptr_add(destination, i, 2), f32_to_bf16(a + b));
    }
}

instantiate stage_combine_tpl<0> as stage_combine_pair_bf16;
instantiate stage_combine_tpl<1> as stage_combine_u64_max;

@concept(allreduce)
kernel[BLOCK, 24] stage_tap_copy_bf16(
    global u32* source, global u32* destination, u32 rows, u32 dimension, u64 destination_stride
) {
    reg u32 row = ctaid_y(); reg u32 elem = ctaid_x() * ntid_x() + tid_x();
    if (row < rows && elem < dimension) {
        stg16(ptr_add(ptr_add(destination, row, destination_stride[0] << 1), elem, 2), ldg16_stream(ptr_add(ptr_add(source, row, dimension << 1), elem, 2)));
    }
}

@concept(head)
kernel[BLOCK, 24] stage_row_lanes_u32(
    global u32* sequence_row_begin, global u32* sequence_row_indices,
    global u32* row_lane, global u32* row_ordinal
) {
    reg u32 lane = ctaid_x();
    reg u32 begin = ldg32_stream(ptr_add(sequence_row_begin, lane, 4));
    reg u32 end = ldg32_stream(ptr_add(sequence_row_begin, lane + 1, 4));
    reg u32 step = ntid_x();
    for (reg u32 k = begin + tid_x(); k < end; k += step) {
        reg u32 idx = ldg32_stream(ptr_add(sequence_row_indices, k, 4));
        stg32(ptr_add(row_lane, idx, 4), lane);
        stg32(ptr_add(row_ordinal, idx, 4), k - begin);
    }
}

@pdl
@concept(head)
kernel[BLOCK, 48] stage_row_dot_pdl_bf16x8(
    global u32* rows_bf16, global u32* weight_bf16, global u32* output_bf16, u32 width
) {
    shared f32 reduce[8];
    acqbulk();
    preexit();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x();
    ureg u64 row_ptr = ptr_add(rows_bf16, row, width << 1);
    reg f32 sum = 0.0f;
    if (((width & 7) | (row_ptr[0] & 15) | (weight_bf16[0] & 15)) == 0) {
        reg u32 chunks = width >> 3;
        for (reg u32 c = tid; c < chunks; c += BLOCK) {
            reg u32x4 av = ldg128_stream(ptr_add(row_ptr, c, 16));
            reg u32x4 bv = ldg128_persist(ptr_add(weight_bf16, c, 16));
            unroll (k = 0..4) {
                sum = fma(bf16_lo(av[k]), bf16_lo(bv[k]), sum);
                sum = fma(bf16_hi(av[k]), bf16_hi(bv[k]), sum);
            }
        }
    } else {
        for (reg u32 idx = tid; idx < width; idx += BLOCK) {
            sum = fma(bf16_lo(ldg16_stream(ptr_add(row_ptr, idx, 2))), bf16_lo(ldg16_persist(ptr_add(weight_bf16, idx, 2))), sum);
        }
    }
    reg f32 total = 0.0f;
    block_reduce_sum_exact(sum, reduce, warp_id(), lane_id(), total);
    if (tid == 0) { stg16(ptr_add(output_bf16, row, 2), f32_to_bf16(total)); }
}

@concept(allreduce)
template kernel[BLOCK, 96] vec256_cast_copy_tpl<MODE>(global u32* p0, global u32* p1, u32 chunks) {
    if constexpr (MODE == 0) {
        reg u32 chunks8 = chunks << 1; reg u32 i0 = (ctaid_x() << 9) + tid_x();
        unroll (p = 0..2) {
            reg u32 idx = i0 + (p << 8);
            if (idx < chunks8) {
                reg u32x8 a = ldg256_stream(ptr_add(p0, idx, 32)); reg u32x4 o;
                unroll (k = 0..4) { o[k] = pack_bf16x2(u32_as_f32(a[k * 2]), u32_as_f32(a[k * 2 + 1])); }
                stg128(ptr_add(p1, idx, 16), o);
            }
        }
    } else {
        reg u32 idx = ctaid_x() * BLOCK + tid_x();
        if (idx >= chunks) { return; }
        if constexpr (MODE == 1) {
            reg u32x8 v = ldg256_stream(ptr_add(p0, idx, 32)); reg u32x8 o0; reg u32x8 o1;
            unroll (k = 0..4) {
                o0[k * 2] = f32_as_u32(bf16_lo(v[k])); o0[k * 2 + 1] = f32_as_u32(bf16_hi(v[k]));
                o1[k * 2] = f32_as_u32(bf16_lo(v[4 + k])); o1[k * 2 + 1] = f32_as_u32(bf16_hi(v[4 + k]));
            }
            stg256(ptr_add(p1, idx * 2, 32), o0); stg256(ptr_add(p1, idx * 2 + 1, 32), o1);
        } else {
            stg256(ptr_add(p0, idx, 32), ldg256_stream(ptr_add(p1, idx, 32)));
        }
    }
}

instantiate vec256_cast_copy_tpl<0> as tp_f32_to_bf16_vec16;
instantiate vec256_cast_copy_tpl<1> as tp_bf16_to_f32_vec16;
instantiate vec256_cast_copy_tpl<2> as device_program_copy_vec256;

@concept(allreduce)
template kernel[BLOCK, 32] device_program_mem_tpl<IS_FILL>(
    global u32* destination, if (IS_FILL == 0) global u32* source, if (IS_FILL == 1) u32 value, u64 bytes
) {
    reg u32 tid = ctaid_x() * ntid_x() + tid_x(); reg u32 stride = grid_x() * ntid_x();
    reg u32 n = bytes[0];
    reg u32 mis = (16 - (destination[0] & 15)) & 15;
    reg u32 lead = (n < mis) ? n : mis;
    reg u32 body = (n - lead) >> 4;
    reg u32 tail_base = lead + (body << 4);
    if constexpr (IS_FILL == 1) {
        reg u32 bv = value & 0xFF; reg u32 wd = bv * 0x01010101; reg u32x4 pat = pack_u32x4(wd, wd, wd, wd);
        for (reg u32 i = tid; i < lead; i += stride) { stg8(ptr_add(destination, i, 1), bv); }
        ureg u64 dv = ptr_add(destination, lead, 1);
        for (reg u32 v = tid; v < body; v += stride) { stg128(ptr_add(dv, v, 16), pat); }
        for (reg u32 i = tail_base + tid; i < n; i += stride) { stg8(ptr_add(destination, i, 1), bv); }
    } else if (((destination[0] ^ source[0]) & 15) == 0) {
        for (reg u32 i = tid; i < lead; i += stride) { stg8(ptr_add(destination, i, 1), ldg8_stream(ptr_add(source, i, 1))); }
        ureg u64 dv = ptr_add(destination, lead, 1); ureg u64 sv = ptr_add(source, lead, 1);
        for (reg u32 v = tid; v < body; v += stride) { stg128(ptr_add(dv, v, 16), ldg128_stream(ptr_add(sv, v, 16))); }
        for (reg u32 i = tail_base + tid; i < n; i += stride) { stg8(ptr_add(destination, i, 1), ldg8_stream(ptr_add(source, i, 1))); }
    } else {
        for (reg u32 i = tid; i < n; i += stride) { stg8(ptr_add(destination, i, 1), ldg8_stream(ptr_add(source, i, 1))); }
    }
}

instantiate device_program_mem_tpl<0> as device_program_copy_exact;
instantiate device_program_mem_tpl<1> as device_program_fill_exact;

@pdl
@concept(stage_mem)
template kernel[BLK, 32] kv_unpack_prior_tpl<BLK, ROW_BYTES, STRIDE_U64>(
    u32 degree, u32 grain, global u8* gathered_bytes,
    if (STRIDE_U64 == 0) u32 rank_stride32, if (STRIDE_U64 == 1) u64 rank_stride64,
    u32 prior_local_keys, u32 old_ctx, global u16* kv_all
) {
    acqbulk();
    reg u32 loc = ctaid_x(); reg u32 srank = ctaid_y(); reg u32 tid = tid_x();
    if (loc < prior_local_keys && srank < degree && tid < (ROW_BYTES >> 4)) {
        reg u32 pos = 0; kv_shard_local_pos(degree, srank, grain, loc, pos);
        if (pos < old_ctx) {
            reg u32 rstr = (STRIDE_U64 == 1) ? rank_stride64[0] : rank_stride32;
            stg128(ptr_add(ptr_add(kv_all, pos, ROW_BYTES), tid, 16), ldg128_persist(ptr_add(ptr_add(ptr_add(gathered_bytes, srank, rstr), loc, ROW_BYTES), tid, 16)));
        }
    }
    preexit();
}

