    if constexpr (IS_PACK == 1) {
        reg u32 two_d = dim_or_pools << 1;
        reg u64 krow = ptr_add(src0, row, two_d); reg u64 grow = ptr_add(src1_or_dst, row, two_d); reg u64 prow = ptr_add(packed_bf16, row, (two_d + 1) << 1);
        for (reg u32 i = tid; i < two_d; i += BLOCK) { stg16(ptr_add(prow, i, 2), (i < dim_or_pools) ? ldg16_persist(ptr_add(krow, i, 2)) : ldg16_persist(ptr_add(grow, i - dim_or_pools, 2))); }
        if (tid == 0) { stg16(ptr_add(prow, two_d, 2), 0x3F80); }
    } else {
        reg u32 limit = dim_or_pools;
