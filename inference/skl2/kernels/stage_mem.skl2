@pdl
@concept(stage_mem)
kernel[BLOCK, 48] k3_runner_fused_pack_256(
    global u16* attention, global u16* hidden, global u16* shared_buf,
    global u16* gate_up, global u16* fused,
    u32 rows, u32 phase, u32 segments, u32 gate_up_elements, u32 k3_hidden
) {
    acqbulk();
    reg u32 idx = ctaid_x() * BLOCK + tid_x();
    reg u32 count = (phase == 2) ? gate_up_elements : (rows * k3_hidden);
    reg u64 primary = (phase == 2) ? gate_up : ((phase == 0) ? attention : hidden);
    reg u32 add_sh = (phase == 1) ? ((segments == 2) ? 1 : 0) : 0;
    reg u32 bad = (count & 7) | ((primary[0] | fused[0]) & 15) | ((add_sh != 0) ? (shared_buf[0] & 15) : 0);
    if (bad == 0) {
        if (idx < (count >> 3)) {
            reg u32x4 pv = ldg128_stream(ptr_add(primary, idx, 16));
            if (add_sh != 0) { reg u32x4 sv = ldg128_stream(ptr_add(shared_buf, idx, 16)); bf16x8_add(pv, sv); }
            stg128(ptr_add(fused, idx, 16), pv);
        }
    } else if (idx < count) {
        reg u32 pv = ldg16_stream(ptr_add(primary, idx, 2));
        if (add_sh != 0) { pv = f32_to_bf16(bf16_lo(pv) + bf16_lo(ldg16_stream(ptr_add(shared_buf, idx, 2)))); }
        stg16(ptr_add(fused, idx, 2), pv);
    }
    preexit();
}

macro stg_copy_dual_bf16(VEC_MODE, src, dst, dst2, has_d2, elems, tid) {
    if constexpr (VEC_MODE == 1) {
        reg u32 vecs = elems >> 3;
        for (reg u32 i = tid; i < vecs; i += BLOCK) {
            reg u32 b = i << 2;
            reg u32x4 pk = pack_u32x4(ldg32_stream(ptr_add(src, b, 4)), ldg32_stream(ptr_add(src, b + 1, 4)), ldg32_stream(ptr_add(src, b + 2, 4)), ldg32_stream(ptr_add(src, b + 3, 4)));
            stg128(ptr_add(dst, i, 16), pk);
            if (has_d2 != 0) { stg128(ptr_add(dst2, i, 16), pk); }
        }
    } else {
        for (reg u32 i = tid; i < elems; i += BLOCK) {
            reg u32 v = ldg16_stream(ptr_add(src, i, 2));
            stg16(ptr_add(dst, i, 2), v);
            if (has_d2 != 0) { stg16(ptr_add(dst2, i, 2), v); }
        }
    }
}

@pdl
@concept(stage_mem)
kernel[BLOCK, 64] k3_split_fused_proj_256(
    global u16* qkvb_bf16, global u16* query_bf16, global u16* key_bf16,
    global u16* value_bf16, global u16* beta_bf16,
    global u16* replay_q, global u16* replay_k, global u16* replay_v,
    u32 rows, u32 qk_dim, u32 v_dim, u32 heads, u32 fused_rows
) {
    acqbulk();
    reg u32 row = ctaid_x();
    if (row >= rows) { preexit(); return; }
    reg u32 tid = tid_x();
    reg u64 src = ptr_add(qkvb_bf16, row, fused_rows << 1);
    reg u64 q_dst = ptr_add(query_bf16, row, qk_dim << 1); reg u64 k_dst = ptr_add(key_bf16, row, qk_dim << 1); reg u64 v_dst = ptr_add(value_bf16, row, v_dim << 1);
    reg u32 has_rq = ((replay_q[0] | replay_q[1]) != 0) ? 1 : 0; reg u32 has_rk = ((replay_k[0] | replay_k[1]) != 0) ? 1 : 0; reg u32 has_rv = ((replay_v[0] | replay_v[1]) != 0) ? 1 : 0;
    reg u64 rq_dst = ptr_add(replay_q, row, qk_dim << 1); reg u64 rk_dst = ptr_add(replay_k, row, qk_dim << 1); reg u64 rv_dst = ptr_add(replay_v, row, v_dim << 1);
    reg u32 bad = (qk_dim & 7) | (v_dim & 7) | (fused_rows & 1) | (src[0] & 3) | ((q_dst[0] | k_dst[0] | v_dst[0]) & 15)
        | ((has_rq != 0) ? (rq_dst[0] & 15) : 0) | ((has_rk != 0) ? (rk_dst[0] & 15) : 0) | ((has_rv != 0) ? (rv_dst[0] & 15) : 0);
    if (bad == 0) {
        stg_copy_dual_bf16(1, src, q_dst, rq_dst, has_rq, qk_dim, tid);
        stg_copy_dual_bf16(1, ptr_add(src, qk_dim, 2), k_dst, rk_dst, has_rk, qk_dim, tid);
        stg_copy_dual_bf16(1, ptr_add(src, qk_dim << 1, 2), v_dst, rv_dst, has_rv, v_dim, tid);
    } else {
        stg_copy_dual_bf16(0, src, q_dst, rq_dst, has_rq, qk_dim, tid);
        stg_copy_dual_bf16(0, ptr_add(src, qk_dim, 2), k_dst, rk_dst, has_rk, qk_dim, tid);
        stg_copy_dual_bf16(0, ptr_add(src, qk_dim << 1, 2), v_dst, rv_dst, has_rv, v_dim, tid);
    }
    reg u64 b_src = ptr_add(src, (qk_dim << 1) + v_dim, 2); reg u64 b_dst = ptr_add(beta_bf16, row, heads << 1);
    for (reg u32 i = tid; i < heads; i += BLOCK) { stg16(ptr_add(b_dst, i, 2), ldg16_stream(ptr_add(b_src, i, 2))); }
    preexit();
}

@pdl
@concept(stage_mem)
kernel[BLOCK, 48] d41_fp8_slice_256(
    global u8* payload, global u8* block_scale,
    global u8* weight, global u8* row_scale, global u32* wide,
    u32 columns, u32 row_first, u32 column_first, u32 output_columns
) {
    acqbulk();
    reg u32 bx = ctaid_x(); reg u32 row = row_first + bx;
    reg u32 out_groups = output_columns >> 5; reg u32 tid = tid_x(); reg u32 ntid = ntid_x();
    reg u64 bs_row = ptr_add(block_scale, (row >> 5) * (columns >> 5) + (column_first >> 5), 1);
    reg u64 rs_row = ptr_add(row_scale, bx, out_groups);
    for (reg u32 g = tid; g < out_groups; g += ntid) { stg8(ptr_add(rs_row, g, 1), ldg8_stream(ptr_add(bs_row, g, 1))); }
    reg u64 p_row = ptr_add(ptr_add(payload, row, columns), column_first, 1);
    if ((weight[0] | weight[1]) != 0) {
        reg u64 w_row = ptr_add(weight, bx, output_columns);
        for (reg u32 i = tid; i < output_columns; i += ntid) { stg8(ptr_add(w_row, i, 1), ldg8_stream(ptr_add(p_row, i, 1))); }
    }
    if ((wide[0] | wide[1]) != 0) {
        reg u64 wd_row = ptr_add(wide, bx, output_columns << 1);
        for (reg u32 i = tid; i < output_columns; i += ntid) {
            stg16(ptr_add(wd_row, i, 2), f32_to_bf16(e4m3_to_f32(ldg8_stream(ptr_add(p_row, i, 1))) * ue8m0_to_f32(ldg8_stream(ptr_add(bs_row, i >> 5, 1)))));
        }
    }
    preexit();
}

@pdl
@concept(stage_mem)
template kernel[BLOCK, 48] rank_major_split2_tpl<IS_LATENT>(
    global u16* gathered, global u16* out0, if (IS_LATENT == 0) global u16* out1_bf16, if (IS_LATENT == 1) global f32* out1_f32,
    u32 rows, u32 slice0, u32 slice1, if (IS_LATENT == 0) u32 total0, if (IS_LATENT == 0) u32 total1, if (IS_LATENT == 1) u32 ranks
) {
    acqbulk();
    reg u32 row = ctaid_y(); reg u32 col = ctaid_x() * BLOCK + tid_x();
    if constexpr (IS_LATENT == 0) {
        reg u32 stride = slice0 + slice1;
        if (((slice0 & 7) | (slice1 & 3) | (stride & 3) | (out0[0] & 15) | ((gathered[0] | out1_bf16[0]) & 7)) == 0) {
            reg u32 qv = total0 >> 3; reg u32 kv = total1 >> 2;
            if (col < qv) {
                reg u32 rk = 0; reg u32 rem = 0; u32_divmod(col, slice0 >> 3, rk, rem);
                reg u64 src = ptr_add(ptr_add(gathered, rk * rows + row, stride << 1), rem << 3, 2);
                reg u32x2 lo = ldg64_stream(src); reg u32x2 hi = ldg64_stream(ptr_add(src, 1, 8));
                stg128(ptr_add(ptr_add(out0, row, total0 << 1), col, 16), pack_u32x4(lo[0], lo[1], hi[0], hi[1]));
            } else if (col < qv + kv) {
                reg u32 c = col - qv; reg u32 rk = 0; reg u32 rem = 0; u32_divmod(c, slice1 >> 2, rk, rem);
                stg64(ptr_add(ptr_add(out1_bf16, row, total1 << 1), c, 8), ldg64_stream(ptr_add(ptr_add(gathered, rk * rows + row, stride << 1), slice0 + (rem << 2), 2)));
            }
        } else if (col < total0) {
            reg u32 rk = 0; reg u32 rem = 0; u32_divmod(col, slice0, rk, rem);
            stg16(ptr_add(ptr_add(out0, row, total0 << 1), col, 2), ldg16_stream(ptr_add(ptr_add(gathered, rk * rows + row, stride << 1), rem, 2)));
        } else if (col < total0 + total1) {
            reg u32 c = col - total0; reg u32 rk = 0; reg u32 rem = 0; u32_divmod(c, slice1, rk, rem);
            stg16(ptr_add(ptr_add(out1_bf16, row, total1 << 1), c, 2), ldg16_stream(ptr_add(ptr_add(gathered, rk * rows + row, stride << 1), slice0 + rem, 2)));
        }
    } else {
        reg u32 rsb = (slice0 + (slice1 << 1)) << 1;
        if (((slice0 & 7) | (slice1 & 3) | ((gathered[0] | out0[0] | out1_f32[0]) & 15)) == 0) {
            reg u32 vs = slice0 >> 3; reg u32 ve = slice1 >> 2; reg u32 lv = vs * ranks;
            if (col < lv) {
                reg u32 r = 0; reg u32 c = 0; u32_divmod(col, vs, r, c);
                stg128(ptr_add(ptr_add(out0, row, (slice0 * ranks) << 1), col, 16), ldg128_stream(ptr_add(ptr_add(ptr_add(gathered, r * rows, rsb), row, slice0 << 1), c, 16)));
            } else if (col - lv < ve * ranks) {
                reg u32 ei = col - lv; reg u32 r = 0; reg u32 c = 0; u32_divmod(ei, ve, r, c);
                stg128(ptr_add(ptr_add(out1_f32, row, (slice1 * ranks) << 2), ei, 16), ldg128_stream(ptr_add(ptr_add(ptr_add(ptr_add(gathered, r * rows, rsb), rows, slice0 << 1), row, slice1 << 2), c, 16)));
            }
        } else if (col < slice0 * ranks) {
            reg u32 r = 0; reg u32 c = 0; u32_divmod(col, slice0, r, c);
            stg16(ptr_add(ptr_add(out0, row, (slice0 * ranks) << 1), col, 2), ldg16_stream(ptr_add(ptr_add(ptr_add(gathered, r * rows, rsb), row, slice0 << 1), c, 2)));
        } else if (col - slice0 * ranks < slice1 * ranks) {
            reg u32 ex = col - slice0 * ranks; reg u32 r = 0; reg u32 c = 0; u32_divmod(ex, slice1, r, c);
            stg32(ptr_add(ptr_add(out1_f32, row, (slice1 * ranks) << 2), ex, 4), ldg32_stream(ptr_add(ptr_add(ptr_add(ptr_add(gathered, r * rows, rsb), rows, slice0 << 1), row, slice1 << 2), c, 4)));
        }
    }
    preexit();
}

