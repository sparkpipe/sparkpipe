@pdl
@concept(linear)
template kernel[BLOCK, REGS] exact_split_bf16_8x4_tpl<PACKED_ARGS, REGS>(
    if (PACKED_ARGS == 1) blob[128, 8] args,
    if (PACKED_ARGS == 0) global u32* weight_in, if (PACKED_ARGS == 0) global u32* act_in,
    if (PACKED_ARGS == 0) global u32* ob_in, if (PACKED_ARGS == 0) global f32* of_in,
    if (PACKED_ARGS == 0) u32 rows_in, if (PACKED_ARGS == 0) u32 in_dim_in,
    if (PACKED_ARGS == 0) u32 out_dim_in, if (PACKED_ARGS == 0) u32 use_f32_in
) {
    shared f32 partial[256];
    acqbulk();
    reg u32 rows = 0; reg u32 in_dim = 0; reg u64 act_ptr = 0;
    reg u64 w_base = 0; reg u64 ob_ptr = 0; reg u64 of_ptr = 0;
    reg u32 has_f32 = 0; reg u32 out_dim = 0; reg u32 out_str = 0; reg u32 col_off = 0; reg u32 neuron = 0;
    if constexpr (PACKED_ARGS == 1) {
        rows = param_u32(args, 88); in_dim = param_u32(args, 92); act_ptr = param_u64(args, 80);
        reg u32 task = ctaid_x(); reg u32 use1 = 0;
        if (param_u32(args, 96) > 1) { if (task >= param_u32(args, 76)) { use1 = 1; } }
        if (use1 != 0) {
            stg_exact_split_read_part(args, 40, task, w_base, ob_ptr, of_ptr, has_f32, out_dim, out_str, col_off, neuron);
        } else {
            stg_exact_split_read_part(args, 0, task, w_base, ob_ptr, of_ptr, has_f32, out_dim, out_str, col_off, neuron);
        }
    } else {
        rows = rows_in; in_dim = in_dim_in; act_ptr = act_in;
        w_base = weight_in; ob_ptr = ob_in; of_ptr = of_in; has_f32 = use_f32_in;
        out_dim = out_dim_in; out_str = out_dim_in; neuron = ctaid_x() << 2;
    }
    reg u32 base_row = ctaid_y() << 3;
    if (base_row >= rows) { preexit(); return; }
    reg u32 count = (rows - base_row < 8) ? (rows - base_row) : 8;
    reg u32 chunks = in_dim >> 3; reg u32 in_b = in_dim << 1;
    reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u32 first_c = (chunks * wid) >> 3; reg u32 last_c = (chunks * (wid + 1)) >> 3;
    reg u64 wp[4];
    unroll (n = 0..4) { wp[n] = ptr_add(w_base, ((neuron + n < out_dim) ? (neuron + n) : neuron) * chunks, 16); }
    reg f32 acc[32]; unroll (i = 0..32) { acc[i] = 0.0f; }
    reg u64 act_base0 = ptr_add(act_ptr, base_row, in_b);
    for (reg u32 c = first_c + lane; c < last_c; c += 32) {
        reg u32x4 wv[4]; unroll (n = 0..4) { wv[n] = ldg128_persist(ptr_add(wp[n], c, 16)); }
        reg u64 ab = ptr_add(act_base0, c, 16);
        unroll (r = 0..8) {
            reg u32x4 av = ldg128_persist(ptr_add(ab, (r < count) ? r : 0, in_b));
            unroll (n = 0..4) { bf16_dot8_acc(acc[(n << 3) + r], wv[n], av); }
        }
    }
    unroll (i = 0..32) { acc[i] = warp_sum(acc[i]); if (lane == 0) { sts32(partial, (wid << 5) + i, acc[i]); } }
    barrier();
    if (wid == 0) {
        reg u32 n = lane >> 3; reg u32 r = lane & 7;
        if (r < count && neuron + n < out_dim) {
            reg f32 tot = 0.0f; unroll (w = 0..8) { tot = tot + lds32(partial, (w << 5) + lane); }
            stg_linear_store_elem(ob_ptr, of_ptr, base_row + r, col_off + neuron + n, out_str, has_f32, tot);
        }
    }
    preexit();
}

