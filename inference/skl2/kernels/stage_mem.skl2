@pdl
@concept(stage_mem)
template kernel[BLK, 32] stage_state_init_tpl<IS_PAD, BLK>(
    global f32* primary, if (IS_PAD == 1) global f32* write_gate, if (IS_PAD == 1) u32 first_pad,
    u32 count_or_rows, if (IS_PAD == 1) u32 heads
) {
    acqbulk();
    if constexpr (IS_PAD == 0) {
        reg u32 idx = ctaid_x() * BLK + tid_x();
        if (idx < (count_or_rows << 14)) {
            reg u32 within = idx & 16383;
            stg32(ptr_add(primary, idx, 4), f32_as_u32(((within >> 7) == (within & 127)) ? 1.0f : 0.0f));
        }
    } else {
        reg u32 row = first_pad + ctaid_x(); reg u32 head = ctaid_y();
        if (row < count_or_rows && head < heads) {
            reg u32 tid = tid_x(); reg u32 slot = row * heads + head;
            stg32(ptr_add(ptr_add(primary, slot, 512), tid, 4), f32_as_u32(1.0f));
            if (tid == 0) { stg32(ptr_add(write_gate, slot, 4), 0); }
        }
    }
    preexit();
}

