@pdl
@concept(norm_rope)
template kernel[BLK, REGS] qk_l2norm_decay_tpl<MODE, BLK, REGS>(
    if (MODE != 2) global u16* query_bf16, if (MODE != 2) global u16* key_bf16,
    if (MODE != 0) global u16* decay_logit_bf16, if (MODE != 0) global f32* channel_bias, if (MODE != 0) global f32* head_log_scale,
    if (MODE != 0) global u16* beta_logit_bf16, if (MODE != 0) global f32* retention, if (MODE != 0) global f32* write_gate,
    u32 heads, if (MODE == 0) u32 rows0, if (MODE == 1) f32 min_log_decay, if (MODE != 2) f32 epsilon, if (MODE != 0) u32 rows1
) {
    if constexpr (MODE == 0) { shared f32 red[8]; }
    acqbulk();
    if constexpr (MODE == 0) {
        reg u32 row = ctaid_x(); reg u32 head = ctaid_y();
        if (row < rows0 && head < heads) {
            reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
            reg u32 slot = row * heads + head;
            reg u64 qp = ptr_add(query_bf16, slot, 256); reg u64 kp = ptr_add(key_bf16, slot, 256);
            reg f32 q0 = bf16_lo(ldg16_stream(ptr_add(qp, tid, 2))); reg f32 k0 = bf16_lo(ldg16_stream(ptr_add(kp, tid, 2)));
            reg f32 qs = q0 * q0; reg f32 ks = k0 * k0;
            warp_sum_down(qs); warp_sum_down(ks);
            if (lane == 0) { sts32(red, wid, qs); sts32(red, 4 + wid, ks); }
            barrier();
            reg f32 q_inv = rsqrt(((lds32(red, 0) + lds32(red, 1)) + lds32(red, 2)) + lds32(red, 3) + epsilon);
            reg f32 k_inv = rsqrt(((lds32(red, 4) + lds32(red, 5)) + lds32(red, 6)) + lds32(red, 7) + epsilon);
            stg16(ptr_add(qp, tid, 2), f32_to_bf16(q0 * q_inv));
            stg16(ptr_add(kp, tid, 2), f32_to_bf16(k0 * k_inv));
        }
    } else if constexpr (MODE == 1) {
        reg u32 lane = lane_id();
        reg u32 task = (ctaid_x() << 2) + warp_id();
        if (task < rows1 * heads) {
            reg u32 q_row = 0; reg u32 head = 0;
            u32_divmod(task, heads, q_row, head);
            reg u64 qp = ptr_add(query_bf16, task, 256); reg u64 kp = ptr_add(key_bf16, task, 256);
            reg u64 dp = ptr_add(decay_logit_bf16, task, 256); reg u64 cbp = ptr_add(channel_bias, head, 512);
            reg u64 rp = ptr_add(retention, task, 512);
            reg f32 qv[4]; reg f32 kv[4]; reg f32 qs[4]; reg f32 ks[4];
            unroll (i = 0..4) {
                reg u32 off = (i << 5) + lane;
                qv[i] = bf16_lo(ldg16_stream(ptr_add(qp, off, 2))); kv[i] = bf16_lo(ldg16_stream(ptr_add(kp, off, 2)));
                warp_sq_bcast(qv[i], qs[i]); warp_sq_bcast(kv[i], ks[i]);
            }
            reg f32 q_inv = rsqrt((qs[0] + qs[2]) + (qs[1] + qs[3]) + epsilon);
            reg f32 k_inv = rsqrt((ks[0] + ks[2]) + (ks[1] + ks[3]) + epsilon);
            reg f32 hls = u32_as_f32(ldg32_persist(ptr_add(head_log_scale, head, 4)));
            unroll (i = 0..4) {
                reg u32 off = (i << 5) + lane;
                stg16(ptr_add(qp, off, 2), f32_to_bf16(qv[i] * q_inv)); stg16(ptr_add(kp, off, 2), f32_to_bf16(kv[i] * k_inv));
                reg f32 dec = 0.0f;
                bounded_decay_f32(bf16_lo(ldg16_persist(ptr_add(dp, off, 2))), u32_as_f32(ldg32_persist(ptr_add(cbp, off, 4))), hls, min_log_decay, dec);
                stg32(ptr_add(rp, off, 4), f32_as_u32(dec));
            }
            if (lane == 0) {
                reg f32 wg = 0.0f;
                sigmoid_exact_f32(bf16_lo(ldg16_persist(ptr_add(beta_logit_bf16, task, 2))), wg);
                stg32(ptr_add(write_gate, task, 4), f32_as_u32(wg));
            }
        }
    } else {
        reg u32 tid = tid_x(); reg u32 row = ctaid_x();
        if (row < rows1) {
            reg u32 rqk = heads << 7;
            reg u64 lr = ptr_add(decay_logit_bf16, row, rqk << 1); reg u64 rr = ptr_add(retention, row, rqk << 2);
            for (reg u32 i = tid; i < rqk; i += 256) {
                reg f32 dec = 0.0f;
                bounded_decay_f32(bf16_lo(ldg16_persist(ptr_add(lr, i, 2))), u32_as_f32(ldg32_persist(ptr_add(channel_bias, i, 4))), u32_as_f32(ldg32_persist(ptr_add(head_log_scale, i >> 7, 4))), -5.0f, dec);
                stg32(ptr_add(rr, i, 4), f32_as_u32(dec));
            }
            for (reg u32 h = tid; h < heads; h += 256) {
                reg f32 sg = 0.0f;
                sigmoid_exact_f32(bf16_lo(ldg16_persist(ptr_add(beta_logit_bf16, row * heads + h, 2))), sg);
                stg32(ptr_add(write_gate, row * heads + h, 4), f32_as_u32(bf16_lo(f32_to_bf16(sg))));
            }
        }
    }
    preexit();
}

