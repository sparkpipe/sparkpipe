@concept(norm_rope)
@pdl
template kernel[BLOCK, 48] row_sigmoid_pdl<IS_OUT_GATE>(
    global u32* primary_bf16, global u32* secondary_ptr, u32 width
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x();
    ureg u64 p_row = ptr_add(primary_bf16, row, width << 1);
    ureg u64 s_row = ptr_add(secondary_ptr, row, IS_OUT_GATE == 1 ? (width << 1) : (width << 2));
    if (((width & 7) | (p_row[0] & 15) | (s_row[0] & 15)) == 0) {
        reg u32 vecs = width >> 3;
        for (reg u32 v = tid; v < vecs; v += BLOCK) {
            reg u32x4 pv = ldg128_stream(ptr_add(p_row, v, 16));
            if constexpr (IS_OUT_GATE == 1) {
                reg u32x4 gv = ldg128_stream(ptr_add(s_row, v, 16));
                unroll (k = 0..4) {
                    reg f32 s0 = 0.0f; reg f32 s1 = 0.0f;
                    sigmoid_exact_f32(bf16_lo(gv[k]), s0); sigmoid_exact_f32(bf16_hi(gv[k]), s1);
                    pv[k] = pack_bf16x2(bf16_lo(pv[k]) * s0, bf16_hi(pv[k]) * s1);
                }
                stg128(ptr_add(p_row, v, 16), pv);
            } else {
                unroll (h = 0..2) {
                    reg f32 s0 = 0.0f; reg f32 s1 = 0.0f; reg f32 s2 = 0.0f; reg f32 s3 = 0.0f;
                    sigmoid_exact_f32(bf16_lo(pv[h * 2]), s0); sigmoid_exact_f32(bf16_hi(pv[h * 2]), s1);
                    sigmoid_exact_f32(bf16_lo(pv[h * 2 + 1]), s2); sigmoid_exact_f32(bf16_hi(pv[h * 2 + 1]), s3);
                    stg128(ptr_add(s_row, (v << 1) + h, 16), pack_u32x4(f32_as_u32(s0), f32_as_u32(s1), f32_as_u32(s2), f32_as_u32(s3)));
                }
            }
        }
        return;
    }
    for (reg u32 i = tid; i < width; i += BLOCK) {
        reg f32 s = 0.0f;
        if constexpr (IS_OUT_GATE == 1) {
            sigmoid_exact_f32(bf16_lo(ldg16_stream(ptr_add(s_row, i, 2))), s);
            stg16(ptr_add(p_row, i, 2), f32_to_bf16(bf16_lo(ldg16_stream(ptr_add(p_row, i, 2))) * s));
        } else {
            sigmoid_exact_f32(bf16_lo(ldg16_stream(ptr_add(p_row, i, 2))), s);
            stg32(ptr_add(s_row, i, 4), f32_as_u32(s));
        }
    }
}

