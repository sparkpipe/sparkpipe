@concept(norm_rope)
@pdl
kernel[BLOCK, 40] lm_concat_rows_pdl_bf16x8(
    global u32* left_bf16, global u32* right_bf16, global u32* output_bf16,
    u32 left_width, u32 right_width, u32 right_stride, u32 right_offset
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_y(); reg u32 total = left_width + right_width;
    reg u32 r_stride = (right_stride != 0) ? right_stride : right_width;
    ureg u64 left_row = ptr_add(left_bf16, row, left_width << 1);
    ureg u64 right_row = ptr_add(ptr_add(right_bf16, row, r_stride << 1), right_offset, 2);
    ureg u64 out_row = ptr_add(output_bf16, row, total << 1);
    reg u32 tid = ctaid_x() * ntid_x() + tid_x(); reg u32 stride = grid_x() * ntid_x();
    if (((left_width & 7) | (right_width & 7) | (left_row[0] & 15) | (right_row[0] & 15) | (out_row[0] & 15)) == 0) {
        reg u32 left_v = left_width >> 3; reg u32 total_v = total >> 3;
        for (reg u32 v = tid; v < total_v; v += stride) {
            if (v < left_v) { stg128(ptr_add(out_row, v, 16), ldg128_stream(ptr_add(left_row, v, 16))); } else { stg128(ptr_add(out_row, v, 16), ldg128_stream(ptr_add(right_row, v - left_v, 16))); }
        }
        return;
    }
    for (reg u32 idx = tid; idx < total; idx += stride) {
        if (idx < left_width) { stg16(ptr_add(out_row, idx, 2), ldg16_stream(ptr_add(left_row, idx, 2))); } else { stg16(ptr_add(out_row, idx, 2), ldg16_stream(ptr_add(right_row, idx - left_width, 2))); }
    }
}

@concept(norm_rope)
@pdl
kernel[BLOCK, 48] lm_rank_major_rows_pdl_bf16x8(
    global u32* gathered_bf16, global u32* rows_bf16, u32 rows, u32 width, u32 ranks, u32 first_rank
) {
    acqbulk();
    preexit();
    reg u32 total = width * ranks; reg u32 tid = ctaid_x() * BLOCK + tid_x(); reg u32 stride = grid_x() * BLOCK; reg u32 gy = grid_y();
    if (((width & 7) | (gathered_bf16[0] & 15) | (rows_bf16[0] & 15)) == 0) {
        reg u32 width_v = width >> 3; reg u32 total_v = width_v * ranks;
        for (reg u32 row = ctaid_y(); row < rows; row += gy) {
            ureg u64 dst_row = ptr_add(rows_bf16, row, total_v << 4);
            for (reg u32 v = tid; v < total_v; v += stride) {
                reg u32 rk = 0; reg u32 col = 0; u32_divmod(v, width_v, rk, col);
                stg128(ptr_add(dst_row, v, 16), ldg128_stream(ptr_add(ptr_add(gathered_bf16, (first_rank + rk) * rows + row, width_v << 4), col, 16)));
            }
        }
        return;
    }
    for (reg u32 row = ctaid_y(); row < rows; row += gy) {
        ureg u64 dst_row = ptr_add(rows_bf16, row, total << 1);
        for (reg u32 idx = tid; idx < total; idx += stride) {
            reg u32 q = 0; reg u32 rem = 0; u32_divmod(idx, width, q, rem);
            stg16(ptr_add(dst_row, idx, 2), ldg16_stream(ptr_add(ptr_add(gathered_bf16, (first_rank + q) * rows + row, width << 1), rem, 2)));
        }
    }
}

macro dyn_rms_load_bf16x8(src_ptr, off) {
    reg u32x4 b = ldg128_stream(ptr_add(src_ptr, off, 2));
    dyn_sts128(off, pack_u32x4(f32_as_u32(bf16_lo(b[0])), f32_as_u32(bf16_hi(b[0])), f32_as_u32(bf16_lo(b[1])), f32_as_u32(bf16_hi(b[1]))));
    dyn_sts128(off + 4, pack_u32x4(f32_as_u32(bf16_lo(b[2])), f32_as_u32(bf16_hi(b[2])), f32_as_u32(bf16_lo(b[3])), f32_as_u32(bf16_hi(b[3]))));
}

macro dyn_rms_scale(dim, eps, s_red, tid, wid, lane, out_sc) {
    barrier();
    reg f32 total = 0.0f;
    for (reg u32 i = tid; i < dim; i += BLOCK) { reg f32 v = dyn_lds32_f32(i); total = fma(v, v, total); }
    reg f32 sum = 0.0f;
    block_reduce_sum_exact(total, s_red, wid, lane, sum);
    rsqrt_exact_div(sum, u32_to_f32(dim), eps, out_sc);
}

macro dyn_rms_scale_load8(off, scale, weight, out_nm, out_r) {
    reg u32x4 lv0 = dyn_lds128(off); reg u32x4 lv1 = dyn_lds128(off + 4);
    reg u32x4 wb = ldg128_persist(ptr_add(weight, off, 2));
    unroll (k = 0..2) {
        out_nm[k] = pack_bf16x2(u32_as_f32(lv0[k * 2]) * scale * bf16_lo(wb[k]), u32_as_f32(lv0[k * 2 + 1]) * scale * bf16_hi(wb[k]));
        out_nm[k + 2] = pack_bf16x2(u32_as_f32(lv1[k * 2]) * scale * bf16_lo(wb[k + 2]), u32_as_f32(lv1[k * 2 + 1]) * scale * bf16_hi(wb[k + 2]));
    }
    unroll (k = 0..4) { out_r[k * 2] = bf16_lo(out_nm[k]); out_r[k * 2 + 1] = bf16_hi(out_nm[k]); }
}

macro dyn_rms_norm_qdq8(off, base_off, scale, weight, output, quantized, mx_codes, mx_scales, has_out, has_mx, tid) {
    reg u32x4 nm; reg f32 rv[8];
    dyn_rms_scale_load8(off, scale, weight, nm, rv);
    if (has_out != 0) { stg128(ptr_add(output, base_off + off, 2), nm); }
    reg u32 c0 = 0; reg u32 c1 = 0; reg u32 sbits = 0;
    fp8_e4m3_quant8_pow2(rv, c0, c1, sbits);
    if (has_mx != 0) {
        stg64(ptr_add(mx_codes, base_off + off, 1), pack_u32x2(c0, c1));
        if ((tid & 3) == 0) { stg8(ptr_add(mx_scales, (base_off + off) >> 5, 1), (sbits >> 23) & 0xFF); }
    } else {
        reg u32x4 qv = pack_u32x4(0, 0, 0, 0);
        fp8_e4m3_dequant8_bf16(c0, c1, sbits, qv);
        stg128(ptr_add(quantized, base_off + off, 2), qv);
    }
}

@pdl
@concept(norm)
kernel[BLOCK, 64] d41_rms_norm_qdq_256(
    global u32* input, global u32* streams, global f32* pre, global u32* weight,
    global u32* output, global u32* quantized, u32 dimension, f32 epsilon, global u8* mx_codes, global u8* mx_scales
) {
    shared f32 s_red[8];
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u32 span = 0; reg u32 srem = 0; u32_divmod(dimension, grid_y(), span, srem);
    reg u32 begin = ctaid_y() * span;
    reg u32 has_str = ((streams[0] | streams[1]) != 0) ? 1 : 0;
    reg u32 has_out = ((output[0] | output[1]) != 0) ? 1 : 0;
    reg u32 has_mx = ((mx_codes[0] | mx_codes[1]) != 0) ? 1 : 0;
    reg u32 base_off = row * dimension; reg u64 in_row = ptr_add(input, row, dimension << 1);
    for (reg u32 off = tid << 3; off < dimension; off += 2048) {
        if (has_str != 0) {
            reg f32 a[8]; unroll (k = 0..8) { a[k] = 0.0f; }
            unroll (copy = 0..4) {
                reg f32 pw = u32_as_f32(ldg32_persist(ptr_add(pre, row * 4 + copy, 4)));
                bf16x8_fma_scalar(a, ldg128_stream(ptr_add(ptr_add(streams, row * 4 + copy, dimension << 1), off, 2)), pw);
            }
            reg u32x4 pk; bf16x8_pack_f32(a, pk);
            dyn_sts128(off, pack_u32x4(f32_as_u32(bf16_lo(pk[0])), f32_as_u32(bf16_hi(pk[0])), f32_as_u32(bf16_lo(pk[1])), f32_as_u32(bf16_hi(pk[1]))));
            dyn_sts128(off + 4, pack_u32x4(f32_as_u32(bf16_lo(pk[2])), f32_as_u32(bf16_hi(pk[2])), f32_as_u32(bf16_lo(pk[3])), f32_as_u32(bf16_hi(pk[3]))));
        } else {
            dyn_rms_load_bf16x8(in_row, off);
        }
    }
    reg f32 sc = 0.0f; dyn_rms_scale(dimension, epsilon, s_red, tid, wid, lane, sc);
    for (reg u32 off = begin + (tid << 3); off < begin + span; off += 2048) {
        dyn_rms_norm_qdq8(off, base_off, sc, weight, output, quantized, mx_codes, mx_scales, has_out, has_mx, tid);
    }
    preexit();
}

@pdl
@concept(norm)
kernel[BLOCK, 80] d41_qkv_norm_rope_qdq_256(
    global u32* q_in, global u32* q_w, global u32* q_qdq, global u8* mx_codes, global u8* mx_scales, u32 q_dim, u32 q_parts,
    global u32* kv_in, global u32* kv_w, global u32* positions, global f32* inv_freq, global u32* kv_out,
    u32 kv_dim, u32 rope_offset, f32 epsilon, global f32* rope_sc
) {
    shared f32 s_red[8];
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 by = ctaid_y(); reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    if (by < q_parts) {
        reg u32 span = 0; reg u32 srem = 0; u32_divmod(q_dim, q_parts, span, srem);
        reg u32 begin = by * span; reg u32 base_off = row * q_dim; reg u64 q_row = ptr_add(q_in, row, q_dim << 1);
        for (reg u32 off = tid << 3; off < q_dim; off += 2048) { dyn_rms_load_bf16x8(q_row, off); }
        reg f32 sc = 0.0f; dyn_rms_scale(q_dim, epsilon, s_red, tid, wid, lane, sc);
        reg u32 has_mx = ((mx_codes[0] | mx_codes[1]) != 0) ? 1 : 0;
        for (reg u32 off = begin + (tid << 3); off < begin + span; off += 2048) {
            dyn_rms_norm_qdq8(off, base_off, sc, q_w, q_qdq, q_qdq, mx_codes, mx_scales, 0, has_mx, tid);
        }
        preexit(); return;
    }
    reg u64 kv_row = ptr_add(kv_in, row, kv_dim << 1);
    for (reg u32 off = tid << 3; off < kv_dim; off += 2048) { dyn_rms_load_bf16x8(kv_row, off); }
    reg f32 sc = 0.0f; dyn_rms_scale(kv_dim, epsilon, s_red, tid, wid, lane, sc);
    reg u32 has_rsc = rope_sc[0] | rope_sc[1];
    reg u32 pos = 0; if (has_rsc == 0) { pos = ldg32_persist(ptr_add(positions, row, 4)); }
    reg u64 kvo_row = ptr_add(kv_out, row, kv_dim << 1);
    for (reg u32 off = tid << 3; off < kv_dim; off += 2048) {
        reg u32x4 nm; reg f32 v[8];
        dyn_rms_scale_load8(off, sc, kv_w, nm, v);
        if (off >= rope_offset) {
            reg u32 pbase = (off - rope_offset) >> 1;
            unroll (p = 0..4) {
                reg f32 sn = 0.0f; reg f32 cs = 0.0f;
                if (has_rsc != 0) {
                    reg u64 rp = ptr_add(rope_sc, (row << 5) + pbase + p, 8);
                    sn = u32_as_f32(ldg32_persist(rp)); cs = u32_as_f32(ldg32_persist(ptr_add(rp, 1, 4)));
                } else {
                    sincos_pos_f32(u32_to_f32(pos) * u32_as_f32(ldg32_persist(ptr_add(inv_freq, pbase + p, 4))), sn, cs);
                }
                reg u32 rot = 0; rope_pair_bf16_u32(nm[p], sn, cs, rot);
                v[p * 2] = bf16_lo(rot); v[p * 2 + 1] = bf16_hi(rot);
            }
        }
        reg u32 c0 = 0; reg u32 c1 = 0; reg u32 sbits = 0; reg u32x4 qv = pack_u32x4(0, 0, 0, 0);
        fp8_e4m3_quant8_pow2(v, c0, c1, sbits);
        fp8_e4m3_dequant8_bf16(c0, c1, sbits, qv);
        stg128(ptr_add(kvo_row, off, 2), qv);
    }
    preexit();
}

@pdl
@concept(norm)
kernel[256, 48] d41_engram_gate_256(
    global u32* streams_bf16, global u32* kv_bf16, global u32* q_weight_bf16, global u32* k_weight_bf16,
    u32 hc, u32 dimension, f32 epsilon
) {
    shared f32 s_red[8];
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 copy = ctaid_y(); reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u64 s_ptr = ptr_add(streams_bf16, row * hc + copy, dimension << 1);
    reg u64 kv_row = ptr_add(kv_bf16, row * (hc + 1), dimension << 1);
    reg u64 k_ptr = ptr_add(kv_row, copy, dimension << 1); reg u64 v_ptr = ptr_add(kv_row, hc, dimension << 1);
    reg u64 qw_ptr = ptr_add(q_weight_bf16, copy, dimension << 1); reg u64 kw_ptr = ptr_add(k_weight_bf16, copy, dimension << 1);
    reg f32 h_sq = 0.0f; reg f32 k_sq = 0.0f; reg f32 dot = 0.0f;
    for (reg u32 e = tid; e < dimension; e += 256) {
        reg f32 hv = bf16_lo(ldg16_stream(ptr_add(s_ptr, e, 2))); reg f32 kv = bf16_lo(ldg16_stream(ptr_add(k_ptr, e, 2)));
        h_sq = fma(hv, hv, h_sq); k_sq = fma(kv, kv, k_sq);
        dot = fma(hv * (bf16_lo(ldg16_persist(ptr_add(qw_ptr, e, 2))) * bf16_lo(ldg16_persist(ptr_add(kw_ptr, e, 2)))), kv, dot);
    }
    reg f32 h_tot = 0.0f; reg f32 k_tot = 0.0f; reg f32 d_tot = 0.0f;
    block_reduce_sum_exact(h_sq, s_red, wid, lane, h_tot); barrier();
    block_reduce_sum_exact(k_sq, s_red, wid, lane, k_tot); barrier();
    block_reduce_sum_exact(dot, s_red, wid, lane, d_tot);
    reg f32 dim_f = u32_to_f32(dimension); reg f32 rh = 0.0f; reg f32 rk = 0.0f;
    rsqrt_exact_div(h_tot, dim_f, epsilon, rh); rsqrt_exact_div(k_tot, dim_f, epsilon, rk);
    reg f32 inv_sd = rsqrt(dim_f); inv_sd = inv_sd * fma(-0.5f * dim_f, inv_sd * inv_sd, 1.5f);
    reg f32 scaled = d_tot * (rh * rk) * inv_sd; reg f32 mag = 0.0f; reg f32 gate = 0.0f;
    sqrt_nr1_f32(maxf(fabsf(scaled), 1.0e-6f), mag);
    sigmoid_exact_f32(u32_as_f32((f32_as_u32(scaled) & 0x80000000) | f32_as_u32(mag)), gate);
    for (reg u32 e = tid; e < dimension; e += 256) {
        stg16(ptr_add(s_ptr, e, 2), f32_to_bf16(fma(gate, bf16_lo(ldg16_stream(ptr_add(v_ptr, e, 2))), bf16_lo(ldg16_stream(ptr_add(s_ptr, e, 2))))));
    }
    preexit();
}

@pdl
@concept(norm)
kernel[256, 32] d41_rms_norm_256(
    global u32* input_bf16, global u32* weight_bf16, global u32* output_bf16, u32 dimension, f32 epsilon
) {
    shared f32 s_red[8];
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x();
    reg u64 in_p = ptr_add(input_bf16, row, dimension << 1); reg u64 out_p = ptr_add(output_bf16, row, dimension << 1);
    reg f32 sq = 0.0f;
    for (reg u32 e = tid; e < dimension; e += 256) { reg f32 v = bf16_lo(ldg16_stream(ptr_add(in_p, e, 2))); sq = fma(v, v, sq); }
    reg f32 tot = 0.0f; reg f32 inv = 0.0f;
    block_reduce_sum_exact(sq, s_red, warp_id(), lane_id(), tot); rsqrt_exact_div(tot, u32_to_f32(dimension), epsilon, inv);
    for (reg u32 e = tid; e < dimension; e += 256) {
        stg16(ptr_add(out_p, e, 2), f32_to_bf16(bf16_lo(ldg16_persist(ptr_add(weight_bf16, e, 2))) * (bf16_lo(ldg16_stream(ptr_add(in_p, e, 2))) * inv)));
    }
    preexit();
}

@pdl
@concept(elementwise)
kernel[256, 32] d41_rope_op_256(
    global u32* data_bf16, global f32* cos_sin_f32, u32 head_count, u32 head_dimension, u32 rope_dimension, u32 inverse
) {
    acqbulk();
    reg u32 head = ctaid_x();
    if (head >= head_count) { preexit(); return; }
    reg u32 pairs = rope_dimension >> 1;
    for (reg u32 pair = tid_x(); pair < pairs; pair += 256) {
        reg u64 p = ptr_add(ptr_add(data_bf16, head, head_dimension << 1), head_dimension - rope_dimension + (pair << 1), 2);
        reg f32 cs = u32_as_f32(ldg32_persist(ptr_add(cos_sin_f32, pair << 1, 4)));
        reg f32 sn = u32_as_f32(ldg32_persist(ptr_add(cos_sin_f32, (pair << 1) + 1, 4)));
        if (inverse != 0) { sn = 0.0f - sn; }
        reg f32 rl = bf16_lo(ldg16_stream(p)); reg f32 im = bf16_lo(ldg16_stream(ptr_add(p, 1, 2)));
        stg16(p, f32_to_bf16(fma(rl, cs, 0.0f - im * sn))); stg16(ptr_add(p, 1, 2), f32_to_bf16(fma(rl, sn, im * cs)));
    }
    preexit();
}

@pdl
@concept(elementwise)
template kernel[256, REGS] elem_1d_op_tpl<OP, REGS>(
    if (OP == 0) global u32* a_ptr, if (OP == 1) global f32* a_ptr, if (OP == 2) global f32* a_ptr,
    global u32* b_ptr, if (OP == 0) global u32* out_ptr, u32 width,
    if (OP == 0) f32 limit, if (OP == 0) f32 weight
) {
    acqbulk();
    reg u32 e = ctaid_x() * ntid_x() + tid_x();
    if (e < width) {
        if constexpr (OP == 0) {
            reg f32 sv = 0.0f; silu_exact_f32(minf(bf16_lo(ldg16_stream(ptr_add(a_ptr, e, 2))), limit), sv);
            reg f32 u = minf(maxf(bf16_lo(ldg16_stream(ptr_add(b_ptr, e, 2))), 0.0f - limit), limit);
            stg16(ptr_add(out_ptr, e, 2), f32_to_bf16(weight * (sv * u)));
        } else if constexpr (OP == 1) {
            reg u64 dst = ptr_add(a_ptr, e, 4);
            stg32(dst, f32_as_u32(u32_as_f32(ldg32_stream(dst)) + bf16_lo(ldg16_stream(ptr_add(b_ptr, e, 2)))));
        } else {
            stg16(ptr_add(b_ptr, e, 2), f32_to_bf16(u32_as_f32(ldg32_stream(ptr_add(a_ptr, e, 4)))));
        }
    }
    preexit();
}

instantiate elem_1d_op_tpl<0, 32> as d41_swiglu_256;
instantiate elem_1d_op_tpl<1, 24> as d41_accumulate_256;
instantiate elem_1d_op_tpl<2, 24> as d41_narrow_256;
