@pdl
@concept(norm_rope)
template kernel[32, 40] rope_pair_tpl<MODE>(
    if (MODE == 1) global u16* data, if (MODE == 1) u32 heads, if (MODE == 1) u32 head_stride, if (MODE == 1) u32 rope_offset,
    global u32* positions, if (MODE == 1) i32 shift, global f32* inv_freq,
    if (MODE == 0) global u32* full_sc, if (MODE == 0) global u32* comp_sc, if (MODE == 0) u32 rows,
    if (MODE == 1) u32 inverse, if (MODE == 1) global u32* row_valid, if (MODE == 1) global u32* rope_sc
) {
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 pair = tid_x();
    if constexpr (MODE == 0) {
        if (row < rows && pair < 32) {
            reg f32 pf = u32_to_f32(ldg32_persist(ptr_add(positions, row, 4)));
            reg f32 s0 = 0.0f; reg f32 c0 = 0.0f; reg f32 s1 = 0.0f; reg f32 c1 = 0.0f;
            sincos_exact_f32(pf * u32_as_f32(ldg32_persist(ptr_add(inv_freq, pair, 4))), s0, c0);
            sincos_exact_f32(pf * u32_as_f32(ldg32_persist(ptr_add(inv_freq, 32 + pair, 4))), s1, c1);
            reg u32 idx = (row << 5) + pair;
            stg64(ptr_add(full_sc, idx, 8), pack_u32x2(f32_as_u32(s0), f32_as_u32(c0)));
            stg64(ptr_add(comp_sc, idx, 8), pack_u32x2(f32_as_u32(s1), f32_as_u32(c1)));
        }
    } else {
        reg u32 head = ctaid_y();
        if (pair >= 32 || head >= heads) { preexit(); return; }
        if ((row_valid[0] | row_valid[1]) != 0) {
            if (ldg32_persist(ptr_add(row_valid, row, 4)) == 0xFFFFFFFF) { preexit(); return; }
        }
        reg u64 target = ptr_add(data, (row * heads + head) * head_stride + rope_offset + (pair << 1), 2);
        reg f32 sn = 0.0f; reg f32 cs = 0.0f;
        reg u32 use_sc = 0;
        if ((rope_sc[0] | rope_sc[1]) != 0) { if (shift == 0) { use_sc = 1; } }
        if (use_sc != 0) {
            reg u32x2 sc = ldg64_persist(ptr_add(rope_sc, (row << 5) + pair, 8));
            sn = u32_as_f32(sc[0]); cs = u32_as_f32(sc[1]);
        } else {
            reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
            reg f32 pf = 0.0f;
            if (shift < 0) {
                reg u32 ns = 0 - shift;
                pf = (pos >= ns) ? u32_to_f32(pos - ns) : (0.0f - u32_to_f32(ns - pos));
            } else {
                pf = u32_to_f32(pos + shift);
            }
            sincos_exact_f32(pf * u32_as_f32(ldg32_persist(ptr_add(inv_freq, pair, 4))), sn, cs);
        }
        if (inverse != 0) { sn = 0.0f - sn; }
        reg u32 rot = 0;
        rope_pair_bf16_u32(ldg32_stream(target), sn, cs, rot);
        stg32(target, rot);
    }
    preexit();
}

instantiate rope_pair_tpl<0> as d41_rope_table_32;
instantiate rope_pair_tpl<1> as d41_rope_rows_32;

macro attnres_score_load(src_ptr, add_ptr, do_add, do_set, cache_smem, do_cache, score_w, hidden, eps, reduction, tid, wid, lane, out_dot) {
    reg u32x4 staged[4]; reg f32 sq = 0.0f;
    unroll (ch = 0..4) {
        reg u32 idx = ((ch << 8) + tid) << 3;
        staged[ch] = pack_u32x4(0, 0, 0, 0);
        if (idx < hidden) {
            if constexpr (do_set == 1) { staged[ch] = ldg128_stream(ptr_add(add_ptr, idx, 2)); stg128(ptr_add(src_ptr, idx, 2), staged[ch]); }
            else if constexpr (do_add == 1) { staged[ch] = ldg128_stream(ptr_add(src_ptr, idx, 2)); reg u32x4 av = ldg128_stream(ptr_add(add_ptr, idx, 2)); bf16x8_add(staged[ch], av); stg128(ptr_add(src_ptr, idx, 2), staged[ch]); }
            else { staged[ch] = ldg128_stream(ptr_add(src_ptr, idx, 2)); }
            if constexpr (do_cache == 1) { sts128(cache_smem, idx >> 1, staged[ch]); }
            bf16x8_sumsq(staged[ch], sq);
        }
    }
    reg f32 sum_sq = 0.0f; reg f32 inv = 0.0f; reg f32 dot = 0.0f;
    block_reduce_sum_exact(sq, reduction, wid, lane, sum_sq); barrier();
    rsqrt_exact_div(sum_sq, u32_to_f32(hidden), eps, inv);
    unroll (ch = 0..4) {
        reg u32 idx = ((ch << 8) + tid) << 3;
        if (idx < hidden) {
            reg u32x4 wv = ldg128_persist(ptr_add(score_w, idx, 2));
            unroll (k = 0..4) { dot = fma(bf16_lo(staged[ch][k]) * inv, bf16_lo(wv[k]), dot); dot = fma(bf16_hi(staged[ch][k]) * inv, bf16_hi(wv[k]), dot); }
        }
    }
    block_reduce_sum_exact(dot, reduction, wid, lane, out_dot); barrier();
}

macro attnres_softmax(IS_SMEM, score_buf, weight_smem, sources, tid) {
    if (tid == 0) {
        reg f32 mx = u32_as_f32(0xFF800000); reg f32 sm = 0.0f; reg f32 inv = 0.0f;
        for (reg u32 s = 0; s < sources; s += 1) { mx = maxf(mx, (IS_SMEM == 1) ? lds32(score_buf, s) : u32_as_f32(ldg32_stream(ptr_add(score_buf, s, 4)))); }
        for (reg u32 s = 0; s < sources; s += 1) {
            reg f32 v = (IS_SMEM == 1) ? lds32(score_buf, s) : u32_as_f32(ldg32_stream(ptr_add(score_buf, s, 4)));
            reg f32 e = exp2_ftz((v - mx) * 1.4426950408889634f); sts32(weight_smem, s, e); sm = sm + e;
        }
        rcp_nr1_f32(sm, inv);
        for (reg u32 s = 0; s < sources; s += 1) { reg f32 q = 0.0f; div_nr1_f32(lds32(weight_smem, s), sm, inv, q); sts32(weight_smem, s, q); }
    }
    barrier();
}

macro attnres_mix_chunk(USE_SROW, bank, partial, s_row, weight, sources, rows, row, hidden, idx, out_v) {
    reg f32 tot[8]; unroll (k = 0..8) { tot[k] = 0.0f; }
    reg u32 lim = (USE_SROW == 1) ? (sources - 1) : sources;
    for (reg u32 s = 0; s < lim; s += 1) {
        reg u64 sp = (s + 1 == sources) ? ptr_add(partial, row * hidden, 2) : ptr_add(bank, (s * rows + row) * hidden, 2);
        bf16x8_fma_scalar(tot, ldg128_stream(ptr_add(sp, idx, 2)), lds32(weight, s));
    }
    if constexpr (USE_SROW == 1) { bf16x8_fma_scalar(tot, lds128(s_row, idx >> 1), lds32(weight, sources - 1)); }
    unroll (k = 0..4) { out_v[k] = pack_bf16x2(tot[k * 2], tot[k * 2 + 1]); }
}

macro attnres_mix_and_out(USE_SROW, bank, partial, s_row, weight, norm_w, hidden_out, normed_out, sources, rows, row, hidden, eps, reduction, tid, wid, lane) {
    if ((norm_w[0] | norm_w[1]) != 0) {
        reg u32x4 staged[4]; reg f32 sq = 0.0f; reg f32 sum_sq = 0.0f; reg f32 sc = 0.0f;
        unroll (ch = 0..4) {
            reg u32 idx = ((ch << 8) + tid) << 3; staged[ch] = pack_u32x4(0, 0, 0, 0);
            if (idx < hidden) { attnres_mix_chunk(USE_SROW, bank, partial, s_row, weight, sources, rows, row, hidden, idx, staged[ch]); bf16x8_sumsq(staged[ch], sq); }
        }
        block_reduce_sum_exact(sq, reduction, wid, lane, sum_sq); rsqrt_exact_div(sum_sq, u32_to_f32(hidden), eps, sc);
        reg u64 n_row = ptr_add(normed_out, row * hidden, 2);
        unroll (ch = 0..4) {
            reg u32 idx = ((ch << 8) + tid) << 3;
            if (idx < hidden) { bf16x8_scale_weight(0, 1, 0, staged[ch], norm_w, idx >> 3, sc); stg128(ptr_add(n_row, idx, 2), staged[ch]); }
        }
    } else {
        reg u64 h_row = ptr_add(hidden_out, row * hidden, 2);
        unroll (ch = 0..4) {
            reg u32 idx = ((ch << 8) + tid) << 3;
            if (idx < hidden) { reg u32x4 mv; attnres_mix_chunk(USE_SROW, bank, partial, s_row, weight, sources, rows, row, hidden, idx, mv); stg128(ptr_add(h_row, idx, 2), mv); }
        }
    }
}

@pdl
@concept(norm_rope)
template kernel[BLOCK, 80] attnres_stage_tpl<IS_MIX>(
    global u32* bank_bf16, global u32* partial_bf16,
    if (IS_MIX == 0) global u32* addend_bf16, if (IS_MIX == 0) global u32* score_w, global f32* score_f32,
    if (IS_MIX == 1) global u32* norm_w, if (IS_MIX == 1) global u32* hidden_bf16, if (IS_MIX == 1) global u32* normed_bf16,
    u32 sources, u32 rows, u32 hidden, u32 max_sources, f32 eps
) {
    shared f32 reduction[8];
    if constexpr (IS_MIX == 1) { shared f32 weight[16]; }
    acqbulk();
    reg u32 row = ctaid_x(); reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    if constexpr (IS_MIX == 0) {
        reg u32 source = ctaid_y(); reg f32 dot = 0.0f;
        reg u32 is_add = 0;
        if (source + 1 == sources) { if ((addend_bf16[0] | addend_bf16[1]) != 0) { is_add = 1; } }
        if (is_add != 0) {
            attnres_score_load(ptr_add(partial_bf16, row * hidden, 2), ptr_add(addend_bf16, row * hidden, 2), 1, 0, reduction, 0, score_w, hidden, eps, reduction, tid, wid, lane, dot);
        } else {
            reg u64 sp = (source + 1 == sources) ? ptr_add(partial_bf16, row * hidden, 2) : ptr_add(bank_bf16, (source * rows + row) * hidden, 2);
            attnres_score_load(sp, sp, 0, 0, reduction, 0, score_w, hidden, eps, reduction, tid, wid, lane, dot);
        }
        if (tid == 0) { stg32(ptr_add(score_f32, row * max_sources + source, 4), f32_as_u32(dot)); }
    } else {
        attnres_softmax(0, ptr_add(score_f32, row * max_sources, 4), weight, sources, tid);
        attnres_mix_and_out(0, bank_bf16, partial_bf16, weight, weight, norm_w, hidden_bf16, normed_bf16, sources, rows, row, hidden, eps, reduction, tid, wid, lane);
    }
    preexit();
}

instantiate attnres_stage_tpl<0> as k3_attnres_score_add_256;
instantiate attnres_stage_tpl<1> as k3_attnres_mix_norm_256;

@pdl
@concept(norm_rope)
template kernel[BLOCK, 80] attnres_fused_tpl<IS_SLICE>(
    global u32* bank_bf16, global u32* partial_bf16, global u32* io_add_bf16, global u32* score_w,
    if (IS_SLICE == 0) global u32* norm_w, if (IS_SLICE == 0) global u32* hidden_bf16, if (IS_SLICE == 0) global u32* normed_bf16,
    u32 sources, u32 total_rows, if (IS_SLICE == 1) u32 first, if (IS_SLICE == 1) u32 count, if (IS_SLICE == 1) u32 set_partial,
    u32 hidden, f32 eps
) {
    shared f32 reduction[8]; shared f32 score[16]; shared f32 weight[16]; shared u32 s_row[3584];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u32 gstep = grid_x(); reg u32 end_r = total_rows; reg u32 has_add = 1; reg u32 base_first = 0;
    if constexpr (IS_SLICE == 1) {
        gstep = total_rows; end_r = count; base_first = first;
    } else {
        has_add = ((io_add_bf16[0] | io_add_bf16[1]) != 0) ? 1 : 0;
    }
    for (reg u32 local = ctaid_x(); local < end_r; local += gstep) {
        reg u32 row = base_first + local;
        reg u64 p_row = ptr_add(partial_bf16, row * hidden, 2);
        reg u64 io_row = ptr_add(io_add_bf16, local * hidden, 2);
        for (reg u32 s = 0; s < sources; s += 1) {
            reg f32 dot = 0.0f;
            reg u32 is_last = (s + 1 == sources) ? 1 : 0;
            if (is_last == 0) {
                reg u64 sp = ptr_add(bank_bf16, (s * total_rows + row) * hidden, 2);
                attnres_score_load(sp, sp, 0, 0, s_row, 0, score_w, hidden, eps, reduction, tid, wid, lane, dot);
            } else if constexpr (IS_SLICE == 1) {
                if (set_partial != 0) { attnres_score_load(p_row, io_row, 0, 1, s_row, 1, score_w, hidden, eps, reduction, tid, wid, lane, dot); }
                else { attnres_score_load(p_row, io_row, 1, 0, s_row, 1, score_w, hidden, eps, reduction, tid, wid, lane, dot); }
            } else {
                if (has_add != 0) { attnres_score_load(p_row, io_row, 1, 0, s_row, 1, score_w, hidden, eps, reduction, tid, wid, lane, dot); }
                else { attnres_score_load(p_row, partial_bf16, 0, 0, s_row, 1, score_w, hidden, eps, reduction, tid, wid, lane, dot); }
            }
            if (tid == 0) { sts32(score, s, dot); }
            barrier();
        }
        attnres_softmax(1, score, weight, sources, tid);
        if constexpr (IS_SLICE == 1) {
            unroll (ch = 0..4) {
                reg u32 idx = ((ch << 8) + tid) << 3;
                if (idx < hidden) { reg u32x4 mv; attnres_mix_chunk(1, bank_bf16, partial_bf16, s_row, weight, sources, total_rows, row, hidden, idx, mv); stg128(ptr_add(io_row, idx, 2), mv); }
            }
        } else {
            attnres_mix_and_out(1, bank_bf16, partial_bf16, s_row, weight, norm_w, hidden_bf16, normed_bf16, sources, total_rows, row, hidden, eps, reduction, tid, wid, lane);
            if (local + gstep < end_r) { barrier(); }
        }
    }
    preexit();
}

instantiate attnres_fused_tpl<0> as k3_partial_add_attnres_norm_256;
instantiate attnres_fused_tpl<1> as k3_partial_add_attnres_slice_256;

@concept(norm_rope)
@pdl
template kernel[BLOCK, 88] attn_tp1_merge_gate_tpl<IS_GEN>(
    global u32* received_f32, global u32* attn_local_bf16, global u32* output_bf16, u32 rows,
    if (IS_GEN == 1) u32 heads_in, if (IS_GEN == 1) u32 qkv_width_in
) {
    acqbulk();
    reg u32 heads = (IS_GEN == 1) ? heads_in : 24; reg u32 qkv_w = (IS_GEN == 1) ? qkv_width_in : 14336;
    reg u32 head = ctaid_x() * 8 + warp_id(); reg u32 row = ctaid_y();
    if (row < rows && head < heads) {
        reg u32 lane = lane_id(); reg u32 width = heads << 8;
        reg u32 row_base = row * (width + ((heads + 1) << 1));
        reg f32 denom = maxf(u32_as_f32(ldg32_stream(ptr_add(received_f32, row_base + width + head * 2 + 1, 4))), 1.0e-20f);
        reg f32 inv_d = 0.0f; rcp_nr1_f32(denom, inv_d);
        reg u32 h_base_p = (row_base + (head << 8)) >> 1;
        reg u32 g_base_p = (row * qkv_w + ((head * 2 + 1) << 8)) >> 1;
        reg u32 o_base_p = ((row * heads + head) << 8) >> 1;
        unroll (k = 0..4) {
            reg u32 v = lane + (k << 5);
            reg u32x2 a = ldg64_stream(ptr_add(received_f32, h_base_p + v, 8));
            reg u32 g = ldg32_stream(ptr_add(attn_local_bf16, g_base_p + v, 4));
            reg f32 qx = 0.0f; reg f32 qy = 0.0f; reg f32 s0 = 0.0f; reg f32 s1 = 0.0f;
            div_nr1_f32(u32_as_f32(a[0]), denom, inv_d, qx); div_nr1_f32(u32_as_f32(a[1]), denom, inv_d, qy);
            sigmoid_exact_f32(bf16_lo(g), s0); sigmoid_exact_f32(bf16_hi(g), s1);
            stg32(ptr_add(output_bf16, o_base_p + v, 4), pack_bf16x2(bf16_lo(f32_to_bf16(qx)) * s0, bf16_lo(f32_to_bf16(qy)) * s1));
        }
    }
    preexit();
}

