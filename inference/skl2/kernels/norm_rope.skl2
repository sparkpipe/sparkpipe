@concept(norm_rope)
@pdl
template kernel[BLOCK, REGS] row_op_pdl<IS_ADD, STRIDED, REGS>(
    global u32* src_bf16, if (IS_ADD == 1) global u32* add_bf16, global u32* dst_bf16,
    u32 rows, u32 dimension, if (STRIDED == 1) u64 destination_stride
) {
    acqbulk();
    preexit();
    reg u32 tid = tid_x(); reg u32 bx = ctaid_x(); reg u32 gy = grid_y();
    reg u32 dst_stride = (STRIDED == 1) ? destination_stride[0] : dimension;
    reg u32 align_bad = (dimension & 7) | (dst_stride & 7) | (src_bf16[0] & 15) | (dst_bf16[0] & 15);
    if constexpr (IS_ADD == 1) { align_bad = align_bad | (add_bf16[0] & 15); }
    reg u32 src_bytes = dimension << 1; reg u32 dst_bytes = dst_stride << 1;
    if (align_bad == 0) {
        reg u32 elem = 0;
        if (grid_x() * BLOCK >= dimension) { if (tid >= 32) { return; } elem = bx * BLOCK + (tid << 3); }
        else { elem = (bx * BLOCK + tid) << 3; }
        if (elem >= dimension) { return; }
        reg u32 vec_idx = elem >> 3;
        for (reg u32 row = ctaid_y(); row < rows; row += gy) {
            reg u32x4 sv = ldg128_stream(ptr_add(ptr_add(src_bf16, row, src_bytes), vec_idx, 16));
            if constexpr (IS_ADD == 1) { reg u32x4 av = ldg128_stream(ptr_add(ptr_add(add_bf16, row, src_bytes), vec_idx, 16)); bf16x8_add(sv, av); }
            stg128(ptr_add(ptr_add(dst_bf16, row, dst_bytes), vec_idx, 16), sv);
        }
        return;
    }
    reg u32 elem = bx * BLOCK + tid;
    if (elem >= dimension) { return; }
    for (reg u32 row = ctaid_y(); row < rows; row += gy) {
        reg u32 v = ldg16_stream(ptr_add(ptr_add(src_bf16, row, src_bytes), elem, 2));
        if constexpr (IS_ADD == 1) { v = f32_to_bf16(bf16_lo(v) + bf16_lo(ldg16_stream(ptr_add(ptr_add(add_bf16, row, src_bytes), elem, 2)))); }
        stg16(ptr_add(ptr_add(dst_bf16, row, dst_bytes), elem, 2), v);
    }
}

