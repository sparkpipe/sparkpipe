@concept(norm_rope)
@pdl
kernel[BLOCK, 48] lm_widen_bf16_to_f32_pdl(
    global u32* source_bf16, global u32* target_f32, u64 elements
) {
    acqbulk();
    preexit();
    reg u32 tid = ctaid_x() * ntid_x() + tid_x();
    reg u32 stride = grid_x() * ntid_x();
    reg u32 elems32 = elements[0];
    if (((source_bf16[0] & 15) | (target_f32[0] & 15)) == 0) {
        reg u32 vecs = elems32 >> 3;
        for (reg u32 v = tid; v < vecs; v += stride) {
            reg u32x4 sv = ldg128_stream(ptr_add(source_bf16, v, 16));
            stg128(ptr_add(target_f32, v << 1, 16), pack_u32x4(f32_as_u32(bf16_lo(sv[0])), f32_as_u32(bf16_hi(sv[0])), f32_as_u32(bf16_lo(sv[1])), f32_as_u32(bf16_hi(sv[1]))));
            stg128(ptr_add(target_f32, (v << 1) + 1, 16), pack_u32x4(f32_as_u32(bf16_lo(sv[2])), f32_as_u32(bf16_hi(sv[2])), f32_as_u32(bf16_lo(sv[3])), f32_as_u32(bf16_hi(sv[3]))));
        }
        for (reg u32 i = (vecs << 3) + tid; i < elems32; i += stride) {
            stg32(ptr_add(target_f32, i, 4), f32_as_u32(bf16_lo(ldg16_stream(ptr_add(source_bf16, i, 2)))));
        }
        return;
    }
    for (reg u32 i = tid; i < elems32; i += stride) {
        stg32(ptr_add(target_f32, i, 4), f32_as_u32(bf16_lo(ldg16_stream(ptr_add(source_bf16, i, 2)))));
    }
}

macro copy_1d_aligned(src, dst, width, tid, stride) {
    if (((width & 7) | (src[0] & 15) | (dst[0] & 15)) == 0) {
        reg u32 vecs = width >> 3;
        for (reg u32 v = tid; v < vecs; v += stride) {
            stg128(ptr_add(dst, v, 16), ldg128_stream(ptr_add(src, v, 16)));
        }
        return;
    }
    for (reg u32 idx = tid; idx < width; idx += stride) {
        stg16(ptr_add(dst, idx, 2), ldg16_stream(ptr_add(src, idx, 2)));
    }
}

@concept(norm_rope)
@pdl
template kernel[BLOCK, 32] row_map_copy_pdl<IS_SCATTER>(
    global u32* source_bf16, global u32* row_map, global u32* destination_bf16,
    u32 rows, u32 dimension
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_y();
    if (row >= rows) { return; }
    reg u32 mapped = row; if ((row_map[0] | row_map[1]) != 0) { mapped = ldg32_persist(ptr_add(row_map, row, 4)); }
    reg u32 row_bytes = dimension << 1;
    ureg u64 src = ptr_add(source_bf16, IS_SCATTER == 1 ? row : mapped, row_bytes);
    ureg u64 dst = ptr_add(destination_bf16, IS_SCATTER == 1 ? mapped : row, row_bytes);
    copy_1d_aligned(src, dst, dimension, ctaid_x() * BLOCK + tid_x(), grid_x() * BLOCK);
}

