@concept(norm_rope)
@pdl
kernel[BLOCK, 32] lm_slice_columns_pdl_bf16x8(
    global u32* source_bf16, global u32* target_bf16,
    u32 source_width, u32 offset, u32 width, u32 target_stride
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_y();
    reg u32 dst_stride = (target_stride != 0) ? target_stride : width;
    ureg u64 src = ptr_add(ptr_add(source_bf16, row, source_width << 1), offset, 2);
    ureg u64 dst = ptr_add(target_bf16, row, dst_stride << 1);
    copy_1d_aligned(src, dst, width, ctaid_x() * BLOCK + tid_x(), grid_x() * BLOCK);
}

@concept(norm_rope)
@pdl
kernel[BLOCK, 40] lm_concat_rows_pdl_bf16x8(
    global u32* left_bf16, global u32* right_bf16, global u32* output_bf16,
    u32 left_width, u32 right_width, u32 right_stride, u32 right_offset
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_y();
    reg u32 total = left_width + right_width;
    reg u32 r_stride = (right_stride != 0) ? right_stride : right_width;
    ureg u64 left_row = ptr_add(left_bf16, row, left_width << 1);
    ureg u64 right_row = ptr_add(ptr_add(right_bf16, row, r_stride << 1), right_offset, 2);
    ureg u64 out_row = ptr_add(output_bf16, row, total << 1);
    reg u32 ntx = ntid_x();
    reg u32 tid = ctaid_x() * ntx + tid_x();
    reg u32 stride = grid_x() * ntx;
    if (((left_width & 7) | (right_width & 7) | (left_row[0] & 15) | (right_row[0] & 15) | (out_row[0] & 15)) == 0) {
        reg u32 left_v = left_width >> 3;
        reg u32 total_v = total >> 3;
        for (reg u32 v = tid; v < total_v; v += stride) {
            reg u32x4 val = pack_u32x4(0, 0, 0, 0); if (v < left_v) { val = ldg128_stream(ptr_add(left_row, v, 16)); } else { val = ldg128_stream(ptr_add(right_row, v - left_v, 16)); }
            stg128(ptr_add(out_row, v, 16), val);
        }
        return;
    }
    for (reg u32 idx = tid; idx < total; idx += stride) {
        reg u32 val = 0; if (idx < left_width) { val = ldg16_stream(ptr_add(left_row, idx, 2)); } else { val = ldg16_stream(ptr_add(right_row, idx - left_width, 2)); }
        stg16(ptr_add(out_row, idx, 2), val);
    }
}

@concept(norm_rope)
@pdl
kernel[BLOCK, 48] lm_rank_major_rows_pdl_bf16x8(
    global u32* gathered_bf16, global u32* rows_bf16,
    u32 rows, u32 width, u32 ranks, u32 first_rank
) {
    acqbulk();
    preexit();
    reg u32 total = width * ranks;
    reg u32 tid = ctaid_x() * BLOCK + tid_x();
    reg u32 stride = grid_x() * BLOCK;
    reg u32 gy = grid_y();
    if (((width & 7) | (gathered_bf16[0] & 15) | (rows_bf16[0] & 15)) == 0) {
        reg u32 width_v = width >> 3;
        reg u32 total_v = width_v * ranks;
        for (reg u32 row = ctaid_y(); row < rows; row += gy) {
            ureg u64 dst_row = ptr_add(rows_bf16, row, total_v << 4);
            for (reg u32 v = tid; v < total_v; v += stride) {
                reg u32 rk = 0; reg u32 col = 0;
                u32_divmod(v, width_v, rk, col);
                ureg u64 src_row = ptr_add(gathered_bf16, (first_rank + rk) * rows + row, width_v << 4);
                stg128(ptr_add(dst_row, v, 16), ldg128_stream(ptr_add(src_row, col, 16)));
            }
        }
        return;
    }
    for (reg u32 row = ctaid_y(); row < rows; row += gy) {
        ureg u64 dst_row = ptr_add(rows_bf16, row, total << 1);
        for (reg u32 idx = tid; idx < total; idx += stride) {
            reg u32 q = 0; reg u32 rem = 0;
            u32_divmod(idx, width, q, rem);
            ureg u64 src_row = ptr_add(gathered_bf16, (first_rank + q) * rows + row, width << 1);
            stg16(ptr_add(dst_row, idx, 2), ldg16_stream(ptr_add(src_row, rem, 2)));
        }
    }
}

@concept(norm_rope)
@pdl
template kernel[BLOCK, 32] scale_elements_pdl<IS_F32>(
    global u32* values, u64 elements, f32 scale
) {
    acqbulk();
    preexit();
    reg u32 ntx = ntid_x();
    reg u32 tid = ctaid_x() * ntx + tid_x();
    reg u32 stride = grid_x() * ntx;
    reg u32 elems32 = elements[0];
    if ((values[0] & 15) == 0) {
        reg u32 shift = IS_F32 == 1 ? 2 : 3;
        reg u32 chunks = elems32 >> shift;
        for (reg u32 c = tid; c < chunks; c += stride) {
            reg u32x4 v = ldg128_stream(ptr_add(values, c, 16));
            if constexpr (IS_F32 == 1) {
                unroll (k = 0..4) { v[k] = f32_as_u32(u32_as_f32(v[k]) * scale); }
            } else {
                unroll (k = 0..4) { v[k] = pack_bf16x2(bf16_lo(v[k]) * scale, bf16_hi(v[k]) * scale); }
            }
            stg128(ptr_add(values, c, 16), v);
        }
        for (reg u32 idx = (chunks << shift) + tid; idx < elems32; idx += stride) {
            if constexpr (IS_F32 == 1) {
                stg32(ptr_add(values, idx, 4), f32_as_u32(u32_as_f32(ldg32_stream(ptr_add(values, idx, 4))) * scale));
            } else {
                stg16(ptr_add(values, idx, 2), f32_to_bf16(bf16_lo(ldg16_stream(ptr_add(values, idx, 2))) * scale));
            }
        }
        return;
    }
    for (reg u32 idx = tid; idx < elems32; idx += stride) {
        if constexpr (IS_F32 == 1) {
            stg32(ptr_add(values, idx, 4), f32_as_u32(u32_as_f32(ldg32_stream(ptr_add(values, idx, 4))) * scale));
        } else {
            stg16(ptr_add(values, idx, 2), f32_to_bf16(bf16_lo(ldg16_stream(ptr_add(values, idx, 2))) * scale));
        }
    }
}

instantiate scale_elements_pdl<0> as lm_scale_elements_bf16_pdl;
instantiate scale_elements_pdl<1> as lm_scale_elements_f32_pdl;
