instantiate attn_tp1_merge_gate_tpl<1> as qwen_hybrid_tp1_merge_gate_gen;

@concept(norm_rope)
@pdl
template kernel[BLOCK, REGS] elem_1d_vec_pdl<MODE, REGS>(
    global u32* p0, if (MODE < 2) global u32* p1, u64 elements, if (MODE >= 2) f32 scale
) {
    acqbulk();
    preexit();
    reg u32 tid = ctaid_x() * ntid_x() + tid_x(); reg u32 stride = grid_x() * ntid_x();
    reg u32 elems32 = elements[0]; reg u32 tail_start = 0;
    reg u32 mis = p0[0] & 15;
    if constexpr (MODE < 2) { mis = mis | (p1[0] & 15); }
    if (mis == 0) {
        reg u32 shift = (MODE == 3) ? 2 : 3;
        reg u32 chunks = elems32 >> shift;
        for (reg u32 c = tid; c < chunks; c += stride) {
            reg u32x4 v = ldg128_stream(ptr_add(p0, c, 16));
            if constexpr (MODE == 0) { reg u32x4 b = ldg128_stream(ptr_add(p1, c, 16)); bf16x8_add(v, b); stg128(ptr_add(p0, c, 16), v); }
            else if constexpr (MODE == 1) {
                stg128(ptr_add(p1, c << 1, 16), pack_u32x4(f32_as_u32(bf16_lo(v[0])), f32_as_u32(bf16_hi(v[0])), f32_as_u32(bf16_lo(v[1])), f32_as_u32(bf16_hi(v[1]))));
                stg128(ptr_add(p1, (c << 1) + 1, 16), pack_u32x4(f32_as_u32(bf16_lo(v[2])), f32_as_u32(bf16_hi(v[2])), f32_as_u32(bf16_lo(v[3])), f32_as_u32(bf16_hi(v[3]))));
            } else if constexpr (MODE == 2) {
                unroll (k = 0..4) { v[k] = pack_bf16x2(bf16_lo(v[k]) * scale, bf16_hi(v[k]) * scale); }
                stg128(ptr_add(p0, c, 16), v);
            } else {
                unroll (k = 0..4) { v[k] = f32_as_u32(u32_as_f32(v[k]) * scale); }
                stg128(ptr_add(p0, c, 16), v);
            }
        }
        tail_start = chunks << shift;
    }
    for (reg u32 i = tail_start + tid; i < elems32; i += stride) {
        if constexpr (MODE == 0) { stg16(ptr_add(p0, i, 2), f32_to_bf16(bf16_lo(ldg16_stream(ptr_add(p0, i, 2))) + bf16_lo(ldg16_stream(ptr_add(p1, i, 2))))); }
        else if constexpr (MODE == 1) { stg32(ptr_add(p1, i, 4), f32_as_u32(bf16_lo(ldg16_stream(ptr_add(p0, i, 2))))); }
        else if constexpr (MODE == 2) { stg16(ptr_add(p0, i, 2), f32_to_bf16(bf16_lo(ldg16_stream(ptr_add(p0, i, 2))) * scale)); }
        else { stg32(ptr_add(p0, i, 4), f32_as_u32(u32_as_f32(ldg32_stream(ptr_add(p0, i, 4))) * scale)); }
    }
}

