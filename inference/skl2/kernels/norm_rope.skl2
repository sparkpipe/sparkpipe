@concept(norm_rope)
@pdl
template kernel[BLOCK, 88] attn_tp1_merge_gate_tpl<IS_GEN>(
    global u32* received_f32, global u32* attn_local_bf16, global u32* output_bf16, u32 rows,
    if (IS_GEN == 1) u32 heads_in,
    if (IS_GEN == 1) u32 qkv_width_in
) {
    acqbulk();
    reg u32 heads = 24;
    reg u32 qkv_w = 14336;
    if constexpr (IS_GEN == 1) { heads = heads_in; qkv_w = qkv_width_in; }
    reg u32 head = ctaid_x() * 8 + warp_id();
    reg u32 row = ctaid_y();
    if (row < rows && head < heads) {
        reg u32 lane = lane_id();
        reg u32 width = heads << 8;
        reg u32 record = width + ((heads + 1) << 1);
        reg u32 row_base = row * record;
        reg f32 denom = maxf(u32_as_f32(ldg32_stream(ptr_add(received_f32, row_base + width + head * 2 + 1, 4))), 1.0e-20f);
        reg f32 inv_d = rcp(denom);
        inv_d = fma(inv_d, fma(-denom, inv_d, 1.0f), inv_d);
        reg u32 h_base_p = (row_base + (head << 8)) >> 1;
        reg u32 g_base_p = (row * qkv_w + ((head * 2 + 1) << 8)) >> 1;
        reg u32 o_base_p = ((row * heads + head) << 8) >> 1;
        unroll (k = 0..4) {
            reg u32 v = lane + k * 32;
            reg u32x2 a = ldg64_stream(ptr_add(received_f32, h_base_p + v, 8));
            reg u32 g = ldg32_stream(ptr_add(attn_local_bf16, g_base_p + v, 4));
            reg f32 ax = u32_as_f32(a[0]); reg f32 ay = u32_as_f32(a[1]);
            reg f32 qx = ax * inv_d; qx = fma(inv_d, fma(-denom, qx, ax), qx);
            reg f32 qy = ay * inv_d; qy = fma(inv_d, fma(-denom, qy, ay), qy);
            reg f32 s0 = 0.0f; reg f32 s1 = 0.0f;
            sigmoid_exact_f32(bf16_lo(g), s0);
            sigmoid_exact_f32(bf16_hi(g), s1);
            stg32(ptr_add(output_bf16, o_base_p + v, 4), pack_bf16x2(bf16_lo(f32_to_bf16(qx)) * s0, bf16_lo(f32_to_bf16(qy)) * s1));
        }
    }
    preexit();
}

instantiate attn_tp1_merge_gate_tpl<0> as attn_tp1_merge_sigmoid_gate_pdl_exact_bf16;
instantiate attn_tp1_merge_gate_tpl<1> as qwen_hybrid_tp1_merge_gate_gen;

@concept(norm_rope)
@pdl
kernel[BLOCK, 48] add_elements_pdl_exact_bf16x8(
    global u32* dst_bf16, global u32* addend_bf16, u64 elements
) {
    acqbulk();
    preexit();
    reg u32 tid = ctaid_x() * BLOCK + tid_x();
    reg u32 stride = grid_x() * BLOCK;
    reg u32 elems32 = elements & 0xFFFFFFFF;
    reg u32 vecs = elems32 >> 3;
    for (reg u32 v = tid; v < vecs; v += stride) {
        reg u32x4 a = ldg128_stream(ptr_add(dst_bf16, v, 16));
        reg u32x4 b = ldg128_stream(ptr_add(addend_bf16, v, 16));
        unroll (k = 0..4) { a[k] = pack_bf16x2(bf16_lo(a[k]) + bf16_lo(b[k]), bf16_hi(a[k]) + bf16_hi(b[k])); }
        stg128(ptr_add(dst_bf16, v, 16), a);
    }
    for (reg u32 i = (vecs << 3) + tid; i < elems32; i += stride) {
        stg16(ptr_add(dst_bf16, i, 2), f32_to_bf16(bf16_lo(ldg16_stream(ptr_add(dst_bf16, i, 2))) + bf16_lo(ldg16_stream(ptr_add(addend_bf16, i, 2)))));
    }
}

@concept(norm_rope)
@pdl
kernel[BLOCK, 48] lm_output_gate_pdl_exact_bf16x8(
    global u32* output_bf16, global u32* gate_bf16, u32 dimension
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_x();
    reg u32 tid = tid_x();
    reg u32 row_bytes = dimension << 1;
    ureg u64 out_row = ptr_add(output_bf16, row, row_bytes);
    ureg u64 gate_row = ptr_add(gate_bf16, row, row_bytes);
    if (((dimension & 7) | (out_row[0] & 15) | (gate_row[0] & 15)) == 0) {
        reg u32 vecs = dimension >> 3;
        for (reg u32 v = tid; v < vecs; v += BLOCK) {
            reg u32x4 ov = ldg128_stream(ptr_add(out_row, v, 16));
            reg u32x4 gv = ldg128_stream(ptr_add(gate_row, v, 16));
            unroll (k = 0..4) {
                reg f32 s0 = 0.0f; reg f32 s1 = 0.0f;
                sigmoid_exact_f32(bf16_lo(gv[k]), s0);
                sigmoid_exact_f32(bf16_hi(gv[k]), s1);
                ov[k] = pack_bf16x2(bf16_lo(ov[k]) * s0, bf16_hi(ov[k]) * s1);
            }
            stg128(ptr_add(out_row, v, 16), ov);
        }
        return;
    }
    for (reg u32 i = tid; i < dimension; i += BLOCK) {
        reg f32 s = 0.0f;
        sigmoid_exact_f32(bf16_lo(ldg16_stream(ptr_add(gate_row, i, 2))), s);
        stg16(ptr_add(out_row, i, 2), f32_to_bf16(bf16_lo(ldg16_stream(ptr_add(out_row, i, 2))) * s));
    }
}

@concept(norm_rope)
@pdl
kernel[BLOCK, 48] lm_sigmoid_rows_pdl_bf16x8(
    global u32* logits_bf16, global u32* scores_f32, u32 width
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_x();
    reg u32 tid = tid_x();
    ureg u64 src = ptr_add(logits_bf16, row, width << 1);
    ureg u64 dst = ptr_add(scores_f32, row, width << 2);
    if (((width & 7) | (src[0] & 15) | (dst[0] & 15)) == 0) {
        reg u32 vecs = width >> 3;
        for (reg u32 v = tid; v < vecs; v += BLOCK) {
            reg u32x4 lv = ldg128_stream(ptr_add(src, v, 16));
            unroll (h = 0..2) {
                reg u32x4 ov = pack_u32x4(0, 0, 0, 0);
                unroll (k = 0..2) {
                    reg f32 s0 = 0.0f; reg f32 s1 = 0.0f;
                    sigmoid_exact_f32(bf16_lo(lv[h * 2 + k]), s0);
                    sigmoid_exact_f32(bf16_hi(lv[h * 2 + k]), s1);
                    ov[k * 2] = f32_as_u32(s0);
                    ov[k * 2 + 1] = f32_as_u32(s1);
                }
                stg128(ptr_add(dst, (v << 1) + h, 16), ov);
            }
        }
        return;
    }
    for (reg u32 i = tid; i < width; i += BLOCK) {
        reg f32 s = 0.0f;
        sigmoid_exact_f32(bf16_lo(ldg16_stream(ptr_add(src, i, 2))), s);
        stg32(ptr_add(dst, i, 4), f32_as_u32(s));
    }
}

@concept(norm_rope)
@pdl
template kernel[BLOCK, REGS] row_op_pdl<IS_ADD, STRIDED, REGS>(
    global u32* src_bf16,
    if (IS_ADD == 1) global u32* add_bf16,
    global u32* dst_bf16,
    u32 rows, u32 dimension,
    if (STRIDED == 1) u64 destination_stride
) {
    acqbulk();
    preexit();
    reg u32 tid = tid_x();
    reg u32 bx = ctaid_x();
    reg u32 gy = grid_y();
    reg u32 dst_stride = dimension;
    if constexpr (STRIDED == 1) { dst_stride = destination_stride[0]; }
    reg u32 align_bad = (dimension & 7) | (dst_stride & 7) | (src_bf16[0] & 15) | (dst_bf16[0] & 15);
    if constexpr (IS_ADD == 1) { align_bad = align_bad | (add_bf16[0] & 15); }
    reg u32 src_bytes = dimension << 1;
    reg u32 dst_bytes = dst_stride << 1;
    if (align_bad == 0) {
        reg u32 elem = 0;
        if (grid_x() * BLOCK >= dimension) {
            if (tid >= 32) { return; }
            elem = bx * BLOCK + (tid << 3);
        } else {
            elem = (bx * BLOCK + tid) << 3;
        }
        if (elem >= dimension) { return; }
        reg u32 vec_idx = elem >> 3;
        for (reg u32 row = ctaid_y(); row < rows; row += gy) {
            reg u32x4 sv = ldg128_stream(ptr_add(ptr_add(src_bf16, row, src_bytes), vec_idx, 16));
            if constexpr (IS_ADD == 1) {
                reg u32x4 av = ldg128_stream(ptr_add(ptr_add(add_bf16, row, src_bytes), vec_idx, 16));
                unroll (k = 0..4) { sv[k] = pack_bf16x2(bf16_lo(sv[k]) + bf16_lo(av[k]), bf16_hi(sv[k]) + bf16_hi(av[k])); }
            }
            stg128(ptr_add(ptr_add(dst_bf16, row, dst_bytes), vec_idx, 16), sv);
        }
        return;
    }
    reg u32 elem = bx * BLOCK + tid;
    if (elem >= dimension) { return; }
    for (reg u32 row = ctaid_y(); row < rows; row += gy) {
        reg u32 v = ldg16_stream(ptr_add(ptr_add(src_bf16, row, src_bytes), elem, 2));
        if constexpr (IS_ADD == 1) {
            v = f32_to_bf16(bf16_lo(v) + bf16_lo(ldg16_stream(ptr_add(ptr_add(add_bf16, row, src_bytes), elem, 2))));
        }
        stg16(ptr_add(ptr_add(dst_bf16, row, dst_bytes), elem, 2), v);
    }
}

