@concept(norm_rope)
@pdl
template kernel[BLOCK, 32] row_map_copy_pdl<IS_SCATTER>(
    global u32* source_bf16, global u32* row_map, global u32* destination_bf16, u32 rows, u32 dimension
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_y();
    if (row >= rows) { return; }
    reg u32 mapped = row;
    if ((row_map[0] | row_map[1]) != 0) { mapped = ldg32_persist(ptr_add(row_map, row, 4)); }
    reg u32 row_bytes = dimension << 1;
    ureg u64 src = ptr_add(source_bf16, IS_SCATTER == 1 ? row : mapped, row_bytes);
    ureg u64 dst = ptr_add(destination_bf16, IS_SCATTER == 1 ? mapped : row, row_bytes);
    copy_bf16_1d(src, dst, dimension, ctaid_x() * BLOCK + tid_x(), grid_x() * BLOCK);
}

