@concept(norm_rope)
@pdl
template kernel[BLOCK, 32] slice_columns_tpl<HAS_OFFSET>(
    global u32* source_bf16, if (HAS_OFFSET == 0) u32 source_stride0, global u32* target_bf16,
    if (HAS_OFFSET == 1) u32 source_width, if (HAS_OFFSET == 1) u32 offset,
    if (HAS_OFFSET == 0) u32 target_stride0, u32 width, if (HAS_OFFSET == 1) u32 target_stride1
) {
    acqbulk();
    preexit();
    reg u32 row = ctaid_y();
    reg u32 src_w = (HAS_OFFSET == 1) ? source_width : source_stride0;
    reg u32 dst_s = (HAS_OFFSET == 1) ? ((target_stride1 != 0) ? target_stride1 : width) : target_stride0;
    reg u32 off = (HAS_OFFSET == 1) ? offset : 0;
    ureg u64 src = ptr_add(ptr_add(source_bf16, row, src_w << 1), off, 2);
    ureg u64 dst = ptr_add(target_bf16, row, dst_s << 1);
    copy_bf16_1d(src, dst, width, ctaid_x() * ntid_x() + tid_x(), grid_x() * ntid_x());
}

