macro kv_dual_stg128(slot, dst_all, has_slot, has_all, off, val) {
    if (has_slot != 0) { stg128(ptr_add(slot, off, 16), val); }
    if (has_all != 0) { stg128(ptr_add(dst_all, off, 16), val); }
}

macro kv_dual_stg16(slot, dst_all, has_slot, has_all, off, val) {
    if (has_slot != 0) { stg16(ptr_add(slot, off, 2), val); }
    if (has_all != 0) { stg16(ptr_add(dst_all, off, 2), val); }
}

macro kv_rms_scale64(tot, epsilon, wid, lane, red, out_scale) {
    warp_sum_down(tot);
    if (lane == 0) { sts32(red, wid, tot); }
    barrier();
    rsqrt_exact_div(lds32(red, 0) + lds32(red, 1), 512.0f, epsilon, out_scale);
}

@pdl
@concept(norm_rope)
template kernel[BLK, 56] kv_shard_norm_store_tpl<IS_LN, BLK>(
    blob[56, 8] view, global u16* rows_bf16, global u16* weight, if (IS_LN == 1) global u16* bias,
    global u32* sequence_of_row, global u32* position_of_row, u32 row_count, f32 epsilon,
    if (IS_LN == 0) global u16* kv_all, if (IS_LN == 0) u32 total_ctx, u32 page_slots, u32 slot_bytes
) {
    if constexpr (IS_LN == 0) { shared f32 red[2]; }
    acqbulk();
    reg u32 row = ctaid_x();
    if (row >= row_count) { preexit(); return; }
    reg u32 tid = tid_x();
    reg u32 pos = ldg32_persist(ptr_add(position_of_row, row, 4));
    reg u32 seq = ldg32_persist(ptr_add(sequence_of_row, row, 4));
    reg u64 slot = 0; reg u32 has_slot = 0;
    kv_shard_slot_addr_gen(view, seq, pos, page_slots, slot_bytes, slot, has_slot);
    if constexpr (IS_LN == 1) {
        if (has_slot == 0) { preexit(); return; }
        reg u64 src = ptr_add(rows_bf16, row, 256);
        reg f32 v[8]; unroll (i = 0..8) { v[i] = 0.0f; }
        reg f32 tot = 0.0f; reg f32 tot_sq = 0.0f;
        if (tid < 16) {
            reg u32x4 raw = ldg128_persist(ptr_add(src, tid, 16));
            unroll (k = 0..4) {
                reg f32 lo = bf16_lo(raw[k]); reg f32 hi = bf16_hi(raw[k]);
                v[k * 2] = lo; v[k * 2 + 1] = hi;
                tot = tot + (lo + hi); tot_sq = fma(hi, hi, fma(lo, lo, tot_sq));
            }
        }
        reg f32 mean = warp_sum(tot) * 0.0078125f;
        reg f32 inv = rsqrt(maxf((warp_sum(tot_sq) * 0.0078125f) - (mean * mean), 0.0f) + epsilon);
        if (tid < 16) {
            reg u32x4 wv = ldg128_persist(ptr_add(weight, tid, 16));
            reg u32x4 bv = ldg128_persist(ptr_add(bias, tid, 16));
            reg u32 pk[4];
            unroll (k = 0..4) { pk[k] = pack_bf16x2(((v[k * 2] - mean) * inv * bf16_lo(wv[k])) + bf16_lo(bv[k]), ((v[k * 2 + 1] - mean) * inv * bf16_hi(wv[k])) + bf16_hi(bv[k])); }
            stg128(ptr_add(slot, tid, 16), pack_u32x4(pk[0], pk[1], pk[2], pk[3]));
        }
    } else {
        reg u32 has_all = ((kv_all[0] | kv_all[1]) != 0) ? ((pos < total_ctx) ? 1 : 0) : 0;
        if ((has_slot | has_all) == 0) { preexit(); return; }
        reg u64 dst_all = ptr_add(kv_all, pos, 1152); reg u64 src = ptr_add(rows_bf16, row, 1152);
        reg u32 mis = ((src[0] | weight[0]) & 15) | ((has_slot != 0) ? (slot[0] & 15) : 0) | ((has_all != 0) ? (dst_all[0] & 15) : 0);
        if (mis == 0) {
            reg u32x4 raw = ldg128_persist(ptr_add(src, tid, 16));
            reg f32 tot = 0.0f; bf16x8_sumsq(raw, tot);
            reg f32 scale = 0.0f; kv_rms_scale64(tot, epsilon, warp_id(), lane_id(), red, scale);
            bf16x8_scale_weight(0, 1, 0, raw, weight, tid, scale);
            kv_dual_stg128(slot, dst_all, has_slot, has_all, tid, raw);
            if (tid < 8) { kv_dual_stg128(slot, dst_all, has_slot, has_all, 64 + tid, ldg128_persist(ptr_add(src, 64 + tid, 16))); }
        } else {
            reg f32 tot = 0.0f;
            for (reg u32 i = tid; i < 512; i += 64) { reg f32 v = bf16_lo(ldg16_persist(ptr_add(src, i, 2))); tot = fma(v, v, tot); }
            reg f32 scale = 0.0f; kv_rms_scale64(tot, epsilon, warp_id(), lane_id(), red, scale);
            for (reg u32 i = tid; i < 512; i += 64) {
                reg u32 ov = 0; rms_bf16_apply_scalar(0, 1, 0, bf16_lo(ldg16_persist(ptr_add(src, i, 2))), weight, i, scale, ov);
                kv_dual_stg16(slot, dst_all, has_slot, has_all, i, ov);
            }
            kv_dual_stg16(slot, dst_all, has_slot, has_all, 512 + tid, ldg16_persist(ptr_add(src, 512 + tid, 2)));
        }
    }
    preexit();
}

