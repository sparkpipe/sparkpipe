import "stdlib/math.skl2";

const HC_BLK256 = 256;
const HC_BLK128 = 128;
const HC_D41_HIDDEN = 5120;
const HC_D41_FLAT = 20480;
const HC_D41_KMIX = 24;
const HC_D41_KTASKS = 25;
const HC_D41_OCTETS = 640;

macro hc_sq_wave_reduce(sq_wave, wave_base, tid, width, total) {
    barrier();
    unroll (s = 0..8) {
        if (wave_base + (s << 8) + tid < width) {
            total = total + lds32(sq_wave, (s << 8) + tid);
        }
    }
}

macro hc_wave_sq_step(MODE, row_a, row_b, scalar, sq_wave, wave_base, tid, width, out_staged, total) {
    reg u32 off = wave_base + (tid << 3);
    if (off < width) {
        reg u32x4 va = ldg128_stream(ptr_add(row_a, off, 2));
        reg u32x4 res = va;
        if constexpr (MODE == 1) {
            reg u32x4 vb = ldg128_stream(ptr_add(row_b, off, 2));
            unroll (k = 0..4) {
                reg f32 r0 = bf16_lo(va[k]) + bf16_lo(f32_to_bf16(bf16_lo(vb[k]) * scalar));
                reg f32 r1 = bf16_hi(va[k]) + bf16_lo(f32_to_bf16(bf16_hi(vb[k]) * scalar));
                res[k] = pack_bf16x2(r0, r1);
            }
            stg128(ptr_add(row_a, off, 2), res);
        } else if constexpr (MODE == 2) {
            unroll (k = 0..4) {
                res[k] = pack_bf16x2(scalar * bf16_lo(va[k]), scalar * bf16_hi(va[k]));
            }
            stg128(ptr_add(row_b, off, 2), res);
        }
        unroll (k = 0..4) {
            reg f32 q0 = bf16_lo(res[k]);
            reg f32 q1 = bf16_hi(res[k]);
            sts32(sq_wave, (tid << 3) + k * 2, q0 * q0);
            sts32(sq_wave, (tid << 3) + k * 2 + 1, q1 * q1);
        }
        out_staged = res;
    } else {
        out_staged = pack_u32x4(0, 0, 0, 0);
    }
    hc_sq_wave_reduce(sq_wave, wave_base, tid, width, total);
}

macro hc_norm_pack8(vec, group_weight, offset, scale, out_v) {
    reg u32x4 wlo = ldg128_persist(ptr_add(group_weight, offset, 4));
    reg u32x4 whi = ldg128_persist(ptr_add(group_weight, offset + 4, 4));
    out_v[0] = pack_bf16x2((bf16_lo(vec[0]) * scale) * u32_as_f32(wlo[0]), (bf16_hi(vec[0]) * scale) * u32_as_f32(wlo[1]));
    out_v[1] = pack_bf16x2((bf16_lo(vec[1]) * scale) * u32_as_f32(wlo[2]), (bf16_hi(vec[1]) * scale) * u32_as_f32(wlo[3]));
    out_v[2] = pack_bf16x2((bf16_lo(vec[2]) * scale) * u32_as_f32(whi[0]), (bf16_hi(vec[2]) * scale) * u32_as_f32(whi[1]));
    out_v[3] = pack_bf16x2((bf16_lo(vec[3]) * scale) * u32_as_f32(whi[2]), (bf16_hi(vec[3]) * scale) * u32_as_f32(whi[3]));
}

macro hc_norm_store_waves(SLOTS, staged, w_ptr, out_row, tot, reduction, wid, lane, tid, width, width_f, eps) {
    reg f32 sm = 0.0f; reg f32 scale = 0.0f;
    block_reduce_sum_exact(tot, reduction, wid, lane, sm);
    rsqrt_exact_div(sm, width_f, eps, scale);
    unroll (sl = 0..SLOTS) {
        reg u32 off = (sl << 11) + (tid << 3);
        if (off < width) {
            reg u32x4 ov;
            hc_norm_pack8(staged[sl], w_ptr, off, scale, ov);
            stg128(ptr_add(out_row, off, 2), ov);
        }
    }
}

@pdl
@concept(norm_rope)
template kernel[HC_BLK256, REGS] hc_inject_norm_tpl<SLOTS, REGS>(
    global u32* residual_bf16, global u32* partial_bf16, global f32* inject,
    global f32* norm_weight, global u32* hc_normed_bf16,
    u32 groups, u32 width, f32 eps
) {
    shared f32 reduction[8];
    shared f32 sq_wave[2048];
    acqbulk();
    reg u32 st = ctaid_x(); reg u32 row = ctaid_y();
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u64 res_row = ptr_add(residual_bf16, (row * groups + st) * width, 2);
    reg u64 part_row = ptr_add(partial_bf16, row * width, 2);
    reg u64 out_row = ptr_add(hc_normed_bf16, (row * groups + st) * width, 2);
    reg u64 g_weight = ptr_add(norm_weight, st * width, 4);
    reg f32 weight = u32_as_f32(ldg32_persist(ptr_add(inject, row * groups + st, 4)));
    reg u32x4 staged[SLOTS];
    reg f32 total = 0.0f;
    unroll (sl = 0..SLOTS) {
        hc_wave_sq_step(1, res_row, part_row, weight, sq_wave, sl << 11, tid, width, staged[sl], total);
        if constexpr (sl + 1 < SLOTS) { barrier(); }
    }
    hc_norm_store_waves(SLOTS, staged, g_weight, out_row, total, reduction, wid, lane, tid, width, u32_to_f32(width), eps);
    preexit();
}

instantiate hc_inject_norm_tpl<1, 64> as hc_inject_norm_256_w2048;
instantiate hc_inject_norm_tpl<2, 80> as hc_inject_norm_256_w4096;
instantiate hc_inject_norm_tpl<4, 96> as hc_inject_norm_256_w8192;

@pdl
@concept(linear)
template kernel[THREADS, REGS] hc_down_gate_inject_skinny_tpl<THREADS, RG, REGS>(
    global u32* down, global u32* inject_w, global u32* hc_normed,
    global u32* hc_low, global f32* hc_inject,
    u32 rows, u32 streams, u32 width, u32 low_rank
) {
    shared f32 partial[(THREADS / 32) * RG];
    acqbulk();
    reg u32 chunks = (streams * width) >> 3;
    reg u32 has_inj = ((inject_w[0] | inject_w[1]) != 0) ? 1 : 0;
    reg u32 total_n = low_rank + ((has_inj != 0) ? streams : 0);
    reg u32 row_groups = (rows + RG - 1) >> ((RG == 1) ? 0 : ((RG == 4) ? 2 : 3));
    reg u32 n0 = 0; reg u32 rg_i = 0;
    u32_divmod(ctaid_x(), row_groups, n0, rg_i);
    if (n0 >= total_n) { preexit(); return; }
    reg u32 first_row = rg_i * RG;
    reg u32 count = (rows - first_row < RG) ? (rows - first_row) : RG;
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u64 w0 = (n0 < low_rank) ? ptr_add(down, n0 * chunks, 16) : ptr_add(inject_w, (n0 - low_rank) * chunks, 16);
    reg u64 a_ptr[RG];
    reg f32 acc[RG];
    unroll (r = 0..RG) {
        a_ptr[r] = ptr_add(hc_normed, (first_row + ((r < count) ? r : 0)) * chunks, 16);
        acc[r] = 0.0f;
    }
    for (reg u32 c = tid; c < chunks; c += THREADS) {
        reg u32x4 vw = ldg128_stream(ptr_add(w0, c, 16));
        unroll (r = 0..RG) {
            bf16_dot8_acc(acc[r], vw, ldg128_persist(ptr_add(a_ptr[r], c, 16)));
        }
    }
    unroll (r = 0..RG) { acc[r] = warp_sum(acc[r]); }
    reg f32 s_f = u32_to_f32(streams); reg f32 inv_s = 0.0f;
    rcp_nr1_f32(s_f, inv_s);
    if constexpr (THREADS > 32) {
        if (lane == 0) {
            unroll (r = 0..RG) { sts32(partial, wid * RG + r, acc[r]); }
        }
        barrier();
    }
    if (tid == 0) {
        unroll (r = 0..RG) {
            reg f32 sum = acc[r];
            if constexpr (THREADS > 32) {
                sum = lds32(partial, r);
                unroll (w = 1..(THREADS / 32)) { sum = sum + lds32(partial, w * RG + r); }
            }
            if (r < count) {
                reg f32 v0 = bf16_lo(f32_to_bf16(sum));
                if (n0 < low_rank) {
                    reg f32 gv = 0.0f;
                    hyper_gate_f32(v0, s_f, inv_s, gv);
                    stg16(ptr_add(hc_low, (first_row + r) * low_rank + n0, 2), f32_to_bf16(gv));
                } else {
                    reg f32 iv = 0.0f;
                    hyper_inject_weight_f32(v0, s_f, inv_s, iv);
                    stg32(ptr_add(hc_inject, (first_row + r) * streams + (n0 - low_rank), 4), f32_as_u32(iv));
                }
            }
        }
    }
    preexit();
}

instantiate hc_down_gate_inject_skinny_tpl<256, 1, 64> as hc_down_gate_inject_skinny_t256_r1;
instantiate hc_down_gate_inject_skinny_tpl<256, 4, 80> as hc_down_gate_inject_skinny_t256_r4;
instantiate hc_down_gate_inject_skinny_tpl<256, 8, 96> as hc_down_gate_inject_skinny_t256_r8;
