instantiate hc_down_gate_inject_skinny_tpl<128, 4, 80> as hc_down_gate_inject_skinny_t128_r4;
instantiate hc_down_gate_inject_skinny_tpl<128, 8, 96> as hc_down_gate_inject_skinny_t128_r8;
