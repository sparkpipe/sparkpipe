@pdl
@concept(linear)
template kernel[BLOCK256, 80] d41_shared_partials_tpl<MAX_R>(
    blob[112, 8] desc, global u32* received, u64 stride, u32 rows, u32 out_dim
) {
    shared u32 s_act[MAX_R * 320];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 src = 0; reg u32 ob = 0; u32_divmod(ctaid_x(), out_dim >> 4, src, ob);
    reg u32 row_base = ctaid_y() * MAX_R;
    if (row_base >= rows) { preexit(); return; }
    reg u32 live = (rows - row_base < MAX_R) ? (rows - row_base) : MAX_R;
    reg u32 width = param_u32(desc, 96); reg u64 w_ptr = param_u64(desc, 0); reg u64 ws_ptr = param_u64(desc, 32); reg u64 out_ptr = param_u64(desc, 64);
    if (src == 1) { width = param_u32(desc, 100); w_ptr = param_u64(desc, 8); ws_ptr = param_u64(desc, 40); out_ptr = param_u64(desc, 72); }
    else if (src == 2) { width = param_u32(desc, 104); w_ptr = param_u64(desc, 16); ws_ptr = param_u64(desc, 48); out_ptr = param_u64(desc, 80); }
    else if (src == 3) { width = param_u32(desc, 108); w_ptr = param_u64(desc, 24); ws_ptr = param_u64(desc, 56); out_ptr = param_u64(desc, 88); }
    reg u32 s_blocks = width >> 5;
    reg u64 bytes_p = ptr_add(received, src, stride[0] << 1); reg u64 scales_p = ptr_add(bytes_p, rows, width);
    for (reg u32 idx = tid; idx < live * (width >> 3); idx += 256) {
        reg u32 rr = 0; reg u32 q = 0; u32_divmod(idx, width >> 3, rr, q); reg u32 gr = row_base + rr;
        reg u32 sbits = ldg8_stream(ptr_add(scales_p, gr * s_blocks + (q >> 2), 1)) << 23;
        reg u64 bp = ptr_add(ptr_add(bytes_p, gr, width), q, 8);
        reg u32x4 dq;
        fp8_e4m3_dequant8_bf16(pack_u16x2(ldg16_stream(bp), ldg16_stream(ptr_add(bp, 1, 2))), pack_u16x2(ldg16_stream(ptr_add(bp, 2, 2)), ldg16_stream(ptr_add(bp, 3, 2))), sbits, dq);
        sts128(s_act, rr * 320 + q * 4, dq);
    }
    barrier();
    reg u32 o = (ob << 4) + (tid >> 4); reg u32 hl = tid & 15;
    reg u64 w_row = ptr_add(w_ptr, o, width); reg u64 ws_row = ptr_add(ws_ptr, o, s_blocks);
    reg f32 acc[MAX_R]; unroll (r = 0..MAX_R) { acc[r] = 0.0f; }
    for (reg u32 k = hl << 4; k < width; k += 256) {
        reg u32x4 w16 = ldg128_stream(ptr_add(w_row, k, 1)); reg f32 wsc = ue8m0_to_f32(ldg8_persist(ptr_add(ws_row, k >> 5, 1)));
        reg f32x4 fw[4]; unroll (wi = 0..4) { fw[wi] = cvt_e4m3x4_f32x4(w16[wi]); }
        unroll (r = 0..MAX_R) {
            if (r < live) {
                reg u32x4 a0 = lds128(s_act, r * 320 + (k >> 1)); reg u32x4 a1 = lds128(s_act, r * 320 + (k >> 1) + 4);
                reg f32 s = acc[r];
                unroll (wi = 0..4) {
                    reg u32 p0 = (wi < 2) ? a0[wi * 2] : a1[(wi - 2) * 2]; reg u32 p1 = (wi < 2) ? a0[wi * 2 + 1] : a1[(wi - 2) * 2 + 1];
                    s = fma(fw[wi][0] * wsc, bf16_lo(p0), s); s = fma(fw[wi][1] * wsc, bf16_hi(p0), s);
                    s = fma(fw[wi][2] * wsc, bf16_lo(p1), s); s = fma(fw[wi][3] * wsc, bf16_hi(p1), s);
                }
                acc[r] = s;
            }
        }
    }
    unroll (r = 0..MAX_R) { unroll (sh = 0..4) { acc[r] = acc[r] + shfl_xor(acc[r], 8 >> sh); } }
    if (hl == 0) { unroll (r = 0..MAX_R) { if (r < live) { stg16(ptr_add(ptr_add(out_ptr, row_base + r, out_dim << 1), o, 2), f32_to_bf16(acc[r])); } } }
    preexit();
}

instantiate d41_shared_partials_tpl<1> as d41_shared_partials_r1_256;
