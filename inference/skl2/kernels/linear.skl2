@pdl
@concept(linear)
template kernel[BLOCK256, REGS] warp_ref_linear_tpl<FMT, REGS>(
    if (FMT != 3) global u8* weight, if (FMT == 3) global u32* weight,
    if (FMT != 3) global u8* scale,
    if (FMT == 0) global f32* act, if (FMT == 1) global u32* act, if (FMT == 2) global f32* act, if (FMT == 3) global u32* act,
    if (FMT == 3) global f32* out_f32, global u32* out_bf16,
    u32 input_dim, u32 output_dim, if (FMT == 1) u32 outputs_per_group
) {
    acqbulk();
    reg u32 lane = lane_id(); reg u32 out_i = ctaid_x() * 8 + warp_id();
    if (out_i >= output_dim) { preexit(); return; }
    reg f32 total = 0.0f;
    if constexpr (FMT == 0) {
        reg u32 row = ctaid_y(); reg u64 ap = ptr_add(act, row, input_dim << 2);
        reg u64 wt = ptr_add(weight, out_i, input_dim); reg u64 sc_r = ptr_add(scale, out_i >> 5, input_dim >> 5);
        for (reg u32 k = lane << 4; k < input_dim; k += 512) {
            reg u32x4 pk = ldg128_stream(ptr_add(wt, k, 1)); reg f32 sc = ue8m0_to_f32(ldg8_persist(ptr_add(sc_r, k >> 5, 1)));
            reg f32 part = 0.0f;
            unroll (w = 0..4) {
                reg f32x4 fw = cvt_e4m3x4_f32x4(pk[w]); reg u32x4 av = ldg128_persist(ptr_add(ap, k + w * 4, 4));
                part = fma(fw[3], u32_as_f32(av[3]), fma(fw[2], u32_as_f32(av[2]), fma(fw[1], u32_as_f32(av[1]), fma(fw[0], u32_as_f32(av[0]), part))));
            }
            total = fma(part, sc, total);
        }
        warp_sum_down(total);
        if (lane == 0) { stg16(ptr_add(ptr_add(out_bf16, row, output_dim << 1), out_i, 2), f32_to_bf16(total)); }
    } else if constexpr (FMT == 1) {
        reg u32 og = 0; reg u32 orem = 0; u32_divmod(out_i, outputs_per_group, og, orem);
        reg u64 ap = ptr_add(act, og, input_dim << 1); reg u64 wt = ptr_add(weight, out_i, input_dim); reg u64 sc_r = ptr_add(scale, out_i >> 5, input_dim >> 5);
        for (reg u32 k = lane << 4; k < input_dim; k += 512) {
            reg u32x4 pk = ldg128_stream(ptr_add(wt, k, 1)); reg f32 sc = ue8m0_to_f32(ldg8_persist(ptr_add(sc_r, k >> 5, 1)));
            reg u32x4 a0 = ldg128_persist(ptr_add(ap, k, 2)); reg u32x4 a1 = ldg128_persist(ptr_add(ap, k + 8, 2));
            reg f32 part = 0.0f;
            unroll (w = 0..2) {
                reg f32x4 fw0 = cvt_e4m3x4_f32x4(pk[w]); reg f32x4 fw1 = cvt_e4m3x4_f32x4(pk[w + 2]);
                part = fma(fw0[1] * sc, bf16_hi(a0[w * 2]), fma(fw0[0] * sc, bf16_lo(a0[w * 2]), part));
                part = fma(fw0[3] * sc, bf16_hi(a0[w * 2 + 1]), fma(fw0[2] * sc, bf16_lo(a0[w * 2 + 1]), part));
                part = fma(fw1[1] * sc, bf16_hi(a1[w * 2]), fma(fw1[0] * sc, bf16_lo(a1[w * 2]), part));
                part = fma(fw1[3] * sc, bf16_hi(a1[w * 2 + 1]), fma(fw1[2] * sc, bf16_lo(a1[w * 2 + 1]), part));
            }
            total = total + part;
        }
        warp_sum_down(total);
        if (lane == 0) { stg16(ptr_add(out_bf16, out_i, 2), f32_to_bf16(total)); }
    } else if constexpr (FMT == 2) {
        reg u64 wt = ptr_add(weight, out_i, input_dim >> 1); reg u64 sc_r = ptr_add(scale, out_i, input_dim >> 5);
        for (reg u32 k = lane << 5; k < input_dim; k += 1024) {
            reg u32x4 pk = ldg128_stream(ptr_add(wt, k >> 1, 1)); reg f32 part = 0.0f;
            unroll (w = 0..4) {
                reg f32x4 d0 = cvt_e2m1x4_f32x4(pk[w], 0); reg f32x4 d1 = cvt_e2m1x4_f32x4(pk[w], 16);
                reg u32x4 a0 = ldg128_persist(ptr_add(act, k + w * 8, 4)); reg u32x4 a1 = ldg128_persist(ptr_add(act, k + w * 8 + 4, 4));
                part = fma(d0[3], u32_as_f32(a0[3]), fma(d0[2], u32_as_f32(a0[2]), fma(d0[1], u32_as_f32(a0[1]), fma(d0[0], u32_as_f32(a0[0]), part))));
                part = fma(d1[3], u32_as_f32(a1[3]), fma(d1[2], u32_as_f32(a1[2]), fma(d1[1], u32_as_f32(a1[1]), fma(d1[0], u32_as_f32(a1[0]), part))));
            }
            total = fma(part, ue8m0_to_f32(ldg8_persist(ptr_add(sc_r, k >> 5, 1))), total);
        }
        warp_sum_down(total);
        if (lane == 0) { stg16(ptr_add(out_bf16, out_i, 2), f32_to_bf16(total)); }
    } else {
        reg u64 wt = ptr_add(weight, out_i, input_dim << 1);
        for (reg u32 k = lane; k < input_dim; k += 32) { total = fma(bf16_lo(ldg16_stream(ptr_add(wt, k, 2))), bf16_lo(ldg16_persist(ptr_add(act, k, 2))), total); }
        warp_sum_down(total);
        if (lane == 0) {
            if ((out_f32[0] | out_f32[1]) != 0) { stg32(ptr_add(out_f32, out_i, 4), f32_as_u32(total)); }
            if ((out_bf16[0] | out_bf16[1]) != 0) { stg16(ptr_add(out_bf16, out_i, 2), f32_to_bf16(total)); }
        }
    }
    preexit();
}

