macro cell_fp4_produce_w(CELLS_PER_BLK, s_w, st_u32, w_base, w_off0, w_off1, w_off2, tid, tile_stride) {
    reg u32 w_vecs = 4 * CELLS_PER_BLK * 17; reg u32 th = CELLS_PER_BLK * 32;
    ldgsts128(s_w, st_u32 + tid * 4, ptr_add(w_base, w_off0, 1));
    if (tid + th < w_vecs) { ldgsts128(s_w, st_u32 + (tid + th) * 4, ptr_add(w_base, w_off1, 1)); }
    if (tid + th * 2 < w_vecs) { ldgsts128(s_w, st_u32 + (tid + th * 2) * 4, ptr_add(w_base, w_off2, 1)); }
    w_base = ptr_add(w_base, 4, tile_stride);
}

macro cell_fp4_accum_tile(s_act, abuf, step_off, count, wv, sc, acc) {
    reg f32x4 lo_p[4]; reg f32x4 hi_p[4];
    unroll (wi = 0..4) { lo_p[wi] = cvt_e2m1x4_f32x4(wv[wi], 0); hi_p[wi] = cvt_e2m1x4_f32x4(wv[wi], 16); }
    unroll (r = 0..4) {
        if (r < count) {
            reg u32 ab = (abuf * 4 + r) * 64 + (step_off >> 1);
            reg f32 c0 = 0.0f; reg f32 c1 = 0.0f; reg f32 c2 = 0.0f; reg f32 c3 = 0.0f;
            unroll (wi = 0..4) {
                reg u32x4 av = lds128(s_act, ab + wi * 4);
                c0 = fma(hi_p[wi][0], bf16_lo(av[2]), fma(lo_p[wi][0], bf16_lo(av[0]), c0));
                c1 = fma(hi_p[wi][1], bf16_hi(av[2]), fma(lo_p[wi][1], bf16_hi(av[0]), c1));
                c2 = fma(hi_p[wi][2], bf16_lo(av[3]), fma(lo_p[wi][2], bf16_lo(av[1]), c2));
                c3 = fma(hi_p[wi][3], bf16_hi(av[3]), fma(lo_p[wi][3], bf16_hi(av[1]), c3));
            }
            acc[r] = fma(sc, (c0 + c1) + (c2 + c3), acc[r]);
        }
    }
}

macro cell_fp4_load_act(MODE_RECV, s_act, abuf, k_idx, count, tid, src_tok, act_bf16, in_dim, r0, r1, r2, r3, sc_off_base, slice_w, s_blocks) {
    if (tid < (count << 4)) {
        reg u32 r = tid >> 4; reg u32 q = tid & 15;
        reg u32 tok = (r == 0) ? src_tok[0] : ((r == 1) ? src_tok[1] : ((r == 2) ? src_tok[2] : src_tok[3]));
        if constexpr (MODE_RECV == 0) {
            sts128(s_act, (abuf * 4 + r) * 64 + q * 4, ldg128_persist(ptr_add(ptr_add(act_bf16, tok, in_dim << 1), (k_idx << 7) + (q << 3), 2)));
        } else {
            reg u32 sr = 0; reg u32 within = 0; u32_divmod((k_idx << 7) + (q << 3), slice_w, sr, within);
            reg u64 rb = r0;
            if (sr == 1) { rb = r1; } else if (sr == 2) { rb = r2; } else if (sr == 3) { rb = r3; }
            reg u32 sbits = ldg8_persist(ptr_add(ptr_add(rb, sc_off_base, 1), tok * s_blocks + (within >> 5), 1)) << 23;
            reg u64 bp = ptr_add(ptr_add(rb, tok, slice_w), within, 1);
            reg u32 c0 = pack_u16x2(ldg16_persist(bp), ldg16_persist(ptr_add(bp, 1, 2)));
            reg u32 c1 = pack_u16x2(ldg16_persist(ptr_add(bp, 2, 2)), ldg16_persist(ptr_add(bp, 3, 2)));
            reg u32x4 dq; fp8_e4m3_dequant8_bf16(c0, c1, sbits, dq); sts128(s_act, (abuf * 4 + r) * 64 + q * 4, dq);
        }
    }
}

macro cell_fp4_init_woff(CELLS, tid, tile_stride, w_off0, w_off1, w_off2) {
    reg u32 tvecs = CELLS * 17; reg u32 th = CELLS * 32; reg u32 w_vecs = 4 * tvecs;
    reg u32 kt = 0; reg u32 inn = 0; u32_divmod(tid, tvecs, kt, inn); w_off0 = kt * tile_stride + (inn << 4);
    w_off1 = 0; if (tid + th < w_vecs) { u32_divmod(tid + th, tvecs, kt, inn); w_off1 = kt * tile_stride + (inn << 4); }
    w_off2 = 0; if (tid + th * 2 < w_vecs) { u32_divmod(tid + th * 2, tvecs, kt, inn); w_off2 = kt * tile_stride + (inn << 4); }
}

macro cell_fp4_kloop(CELLS, MODE_RECV, s_w, s_act, group_cells, act_bf16, r0, r1, r2, r3, sc_off_base, slice_w, s_blocks, in_dim, k_iters, count, src_tok, tile_stride, w_off0, w_off1, w_off2, tid, wid, half, sub, acc) {
    reg u32 w_u32_stage = 4 * CELLS * 68; reg u64 w_base = group_cells; reg u32 kp = 0; reg u32 sp_u32 = 0; reg u32 sc_u32 = 0;
    unroll (s = 0..2) {
        if (kp < k_iters) { cell_fp4_produce_w(CELLS, s_w, sp_u32, w_base, w_off0, w_off1, w_off2, tid, tile_stride); }
        ldgdepbar(); kp = kp + 1; sp_u32 = sp_u32 + w_u32_stage;
    }
    unroll (r = 0..4) { acc[r] = 0.0f; }
    for (reg u32 ks = 0; ks < k_iters; ks += 1) {
        reg u32 abuf = ks & 1;
        cell_fp4_load_act(MODE_RECV, s_act, abuf, ks, count, tid, src_tok, act_bf16, in_dim, r0, r1, r2, r3, sc_off_base, slice_w, s_blocks);
        depbar_le(1); barrier();
        if (kp < k_iters) {
            cell_fp4_produce_w(CELLS, s_w, sp_u32, w_base, w_off0, w_off1, w_off2, tid, tile_stride);
            kp = kp + 1; sp_u32 = sp_u32 + w_u32_stage; if (sp_u32 == 3 * w_u32_stage) { sp_u32 = 0; }
        }
        ldgdepbar();
        reg u32 wst = sc_u32 + wid * 68;
        unroll (si = 0..2) {
            reg u32 step = half + si * 2; reg u32 cp = wst + step * CELLS * 68;
            reg f32 sc = ue8m0_to_f32((lds32(s_w, cp + 64 + (sub >> 2)) >> ((sub & 3) << 3)) & 0xFF);
            cell_fp4_accum_tile(s_act, abuf, step * 32, count, lds128(s_w, cp + sub * 4), sc, acc);
        }
        sc_u32 = sc_u32 + w_u32_stage; if (sc_u32 == 3 * w_u32_stage) { sc_u32 = 0; }
    }
    depbar_le(0);
}

@pdl
@concept(linear)
template kernel[CELLS * 32, 128] d41_cell_fp4_gemv_tpl<CELLS, MODE_RECV>(
    global u8* cells, global u32* act_bf16, global u32* recv_base, global u32* output_bf16,
    global u32* group_row_offset, global u32* route_source_token, global u32* active_experts,
    u32 routes, u64 recv_stride, u32 experts, u32 in_dim, u32 out_dim, u32 slice_w
) {
    shared u32 s_w[3 * 4 * CELLS * 68]; shared u32 s_act[512];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id(); reg u32 sub = lane & 15; reg u32 half = lane >> 4;
    reg u32 total_cells = out_dim >> 4; reg u32 n_blocks = 0; reg u32 rem = 0; u32_divmod(total_cells, CELLS, n_blocks, rem);
    reg u32 active_idx = 0; reg u32 n_block = 0; u32_divmod(ctaid_x(), n_blocks, active_idx, n_block);
    if (active_idx >= ldg32_persist(ptr_add(active_experts, experts, 4))) { preexit(); return; }
    reg u32 group = ldg32_persist(ptr_add(active_experts, active_idx, 4));
    reg u32 start = ldg32_persist(ptr_add(group_row_offset, group, 4)); reg u32 end = ldg32_persist(ptr_add(group_row_offset, group + 1, 4));
    if (start >= end) { preexit(); return; }
    reg u32 tile_stride = total_cells * 272; reg u32 k_iters = in_dim >> 7; reg u32 block_cell0 = n_block * CELLS;
    reg u64 group_cells = ptr_add(ptr_add(cells, group * (in_dim >> 5), tile_stride), block_cell0, 272);
    reg u32 w_off0 = 0; reg u32 w_off1 = 0; reg u32 w_off2 = 0;
    cell_fp4_init_woff(CELLS, tid, tile_stride, w_off0, w_off1, w_off2);
    reg u64 r0 = recv_base; reg u64 r1 = ptr_add(recv_base, 1, recv_stride[0] << 1);
    reg u64 r2 = ptr_add(recv_base, 2, recv_stride[0] << 1); reg u64 r3 = ptr_add(recv_base, 3, recv_stride[0] << 1);
    for (reg u32 first = start; first < end; first += 4) {
        reg u32 count = (end - first < 4) ? (end - first) : 4; reg u32 src_tok[4];
        unroll (r = 0..4) {
            src_tok[r] = 0;
            if (r < count) { if constexpr (MODE_RECV == 0) { src_tok[r] = ldg32_persist(ptr_add(route_source_token, first + r, 4)); } else { src_tok[r] = first + r; } }
        }
        reg f32 acc[4];
        cell_fp4_kloop(CELLS, MODE_RECV, s_w, s_act, group_cells, act_bf16, r0, r1, r2, r3, routes * slice_w, slice_w, slice_w >> 5, in_dim, k_iters, count, src_tok, tile_stride, w_off0, w_off1, w_off2, tid, wid, half, sub, acc);
        unroll (r = 0..4) { acc[r] = acc[r] + shfl_xor(acc[r], 16); }
        if (half == 0) {
            reg u32 col = (block_cell0 + wid) * 16 + sub;
            unroll (r = 0..4) { if (r < count) { stg16(ptr_add(ptr_add(output_bf16, first + r, out_dim << 1), col, 2), f32_to_bf16(acc[r])); } }
        }
        if (first + 4 < end) { barrier(); }
    }
    preexit();
}

instantiate d41_cell_fp4_gemv_tpl<4, 0> as d41_cell_fp4_gemv_c4_m0;
instantiate d41_cell_fp4_gemv_tpl<4, 1> as d41_cell_fp4_gemv_c4_m1;
instantiate d41_cell_fp4_gemv_tpl<8, 0> as d41_cell_fp4_gemv_c8_m0;
instantiate d41_cell_fp4_gemv_tpl<8, 1> as d41_cell_fp4_gemv_c8_m1;
