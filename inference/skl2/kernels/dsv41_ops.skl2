import "stdlib/math.skl2";

const D41O_BLK256 = 256;
const D41O_NEG_INF = 0xFF800000;
const D41O_POS_INF = 0x7F800000;
const D41O_LOG2E = 1.4426950408889634f;
const D41O_KV_FP4_FLOOR = 0.01171875f;

macro d41o_e2m1_round_f32(val, out_f) {
    reg u32 sgn = f32_as_u32(val) & 0x80000000;
    reg f32 a = fabsf(val);
    reg f32 mag = 6.0f;
    if (a <= 0.25f) { mag = 0.0f; }
    else if (a < 0.75f) { mag = 0.5f; }
    else if (a <= 1.25f) { mag = 1.0f; }
    else if (a < 1.75f) { mag = 1.5f; }
    else if (a <= 2.5f) { mag = 2.0f; }
    else if (a < 3.5f) { mag = 3.0f; }
    else if (a <= 5.0f) { mag = 4.0f; }
    out_f = u32_as_f32(sgn | f32_as_u32(mag));
}

macro d41o_sqrt_nr1(x, out_s) {
    if (x <= 0.0f) {
        out_s = 0.0f;
    } else {
        reg f32 r = rsqrt(x);
        r = r * fma(-0.5f * x, r * r, 1.5f);
        out_s = x * r;
    }
}

macro d41o_block_sum_u32(val, scratch, wid, lane, out_sum) {
    reg u32 v = val;
    v = v + shfl_down(v, 16);
    v = v + shfl_down(v, 8);
    v = v + shfl_down(v, 4);
    v = v + shfl_down(v, 2);
    v = v + shfl_down(v, 1);
    if (lane == 0) { sts32(scratch, wid, v); }
    barrier();
    reg u32 b = 0;
    if (lane < 8) { b = lds32(scratch, lane); }
    b = b + shfl_down(b, 4);
    b = b + shfl_down(b, 2);
    b = b + shfl_down(b, 1);
    out_sum = shfl_idx(b, 0);
}

macro d41o_e2m1_qdq8_scale(raw, sc, inv, exact_div, out_u4) {
    reg f32 v0 = bf16_lo(raw[0]); reg f32 v1 = bf16_hi(raw[0]);
    reg f32 v2 = bf16_lo(raw[1]); reg f32 v3 = bf16_hi(raw[1]);
    reg f32 v4 = bf16_lo(raw[2]); reg f32 v5 = bf16_hi(raw[2]);
    reg f32 v6 = bf16_lo(raw[3]); reg f32 v7 = bf16_hi(raw[3]);
    if (exact_div != 0) {
        div_nr1_f32(v0, sc, inv, v0); div_nr1_f32(v1, sc, inv, v1);
        div_nr1_f32(v2, sc, inv, v2); div_nr1_f32(v3, sc, inv, v3);
        div_nr1_f32(v4, sc, inv, v4); div_nr1_f32(v5, sc, inv, v5);
        div_nr1_f32(v6, sc, inv, v6); div_nr1_f32(v7, sc, inv, v7);
    } else {
        v0 = v0 * inv; v1 = v1 * inv; v2 = v2 * inv; v3 = v3 * inv;
        v4 = v4 * inv; v5 = v5 * inv; v6 = v6 * inv; v7 = v7 * inv;
    }
    d41o_e2m1_round_f32(minf(maxf(v0, -6.0f), 6.0f), v0);
    d41o_e2m1_round_f32(minf(maxf(v1, -6.0f), 6.0f), v1);
    d41o_e2m1_round_f32(minf(maxf(v2, -6.0f), 6.0f), v2);
    d41o_e2m1_round_f32(minf(maxf(v3, -6.0f), 6.0f), v3);
    d41o_e2m1_round_f32(minf(maxf(v4, -6.0f), 6.0f), v4);
    d41o_e2m1_round_f32(minf(maxf(v5, -6.0f), 6.0f), v5);
    d41o_e2m1_round_f32(minf(maxf(v6, -6.0f), 6.0f), v6);
    d41o_e2m1_round_f32(minf(maxf(v7, -6.0f), 6.0f), v7);
    out_u4 = pack_u32x4(
        pack_bf16x2(v0 * sc, v1 * sc), pack_bf16x2(v2 * sc, v3 * sc),
        pack_bf16x2(v4 * sc, v5 * sc), pack_bf16x2(v6 * sc, v7 * sc)
    );
}

macro d41o_amax8(raw, out_am) {
    reg f32 m0 = maxf(maxf(fabsf(bf16_lo(raw[0])), fabsf(bf16_hi(raw[0]))), maxf(fabsf(bf16_lo(raw[1])), fabsf(bf16_hi(raw[1]))));
    reg f32 m1 = maxf(maxf(fabsf(bf16_lo(raw[2])), fabsf(bf16_hi(raw[2]))), maxf(fabsf(bf16_lo(raw[3])), fabsf(bf16_hi(raw[3]))));
    out_am = maxf(m0, m1);
}

@pdl
@concept(quant)
kernel[D41O_BLK256, 48] d41_kv_fp4_qdq_vec_256(
    global u32* data_bf16, u64 row_stride, u32 row_count, u32 width
) {
    acqbulk();
    reg u32 oct_row = width >> 3;
    reg u32 idx = ctaid_x() * ntid_x() + tid_x();
    if (idx >= row_count * oct_row) { preexit(); return; }
    reg u32 r = 0; reg u32 c = 0;
    u32_divmod(idx, oct_row, r, c);
    reg u64 p = ptr_add(ptr_add(data_bf16, r, row_stride[0] << 1), c, 16);
    reg u32x4 raw = ldg128_stream(p);
    reg f32 am = 0.0f;
    d41o_amax8(raw, am);
    am = maxf(maxf(am, shfl_xor(am, 1)), D41O_KV_FP4_FLOOR);
    reg f32 inv6 = 0.0f; rcp_nr1_f32(6.0f, inv6);
    reg f32 qsc = 0.0f; div_nr1_f32(am, 6.0f, inv6, qsc);
    reg f32 sc = e4m3_to_f32(cvt_f32x2_e4m3x2(qsc, 0.0f) & 0xFF);
    reg f32 inv = 0.0f; rcp_nr1_f32(sc, inv);
    reg u32x4 out_v = pack_u32x4(0, 0, 0, 0);
    d41o_e2m1_qdq8_scale(raw, sc, inv, 1, out_v);
    stg128(p, out_v);
    preexit();
}

@pdl
@concept(quant)
kernel[D41O_BLK256, 40] d41_kv_fp4_qdq_256(
    global u32* data_bf16, u64 row_stride, u32 row_count, u32 width
) {
    acqbulk();
    reg u32 gpr = width >> 4;
    reg u32 grp = ctaid_x() * ntid_x() + tid_x();
    if (grp >= row_count * gpr) { preexit(); return; }
    reg u32 r = 0; reg u32 c = 0;
    u32_divmod(grp, gpr, r, c);
    reg u64 base = ptr_add(ptr_add(data_bf16, r, row_stride[0] << 1), c << 4, 2);
    reg f32 am = 0.0f;
    for (reg u32 e = 0; e < 16; e += 1) {
        am = maxf(am, fabsf(bf16_lo(ldg16_stream(ptr_add(base, e, 2)))));
    }
    reg f32 inv6 = 0.0f; rcp_nr1_f32(6.0f, inv6);
    reg f32 qsc = 0.0f; div_nr1_f32(maxf(am, D41O_KV_FP4_FLOOR), 6.0f, inv6, qsc);
    reg f32 sc = e4m3_to_f32(cvt_f32x2_e4m3x2(qsc, 0.0f) & 0xFF);
    reg f32 inv = 0.0f; rcp_nr1_f32(sc, inv);
    for (reg u32 e = 0; e < 16; e += 1) {
        reg f32 v = bf16_lo(ldg16_stream(ptr_add(base, e, 2)));
        reg f32 qv = 0.0f; div_nr1_f32(v, sc, inv, qv);
        reg f32 rv = 0.0f;
        d41o_e2m1_round_f32(minf(maxf(qv, -6.0f), 6.0f), rv);
        stg16(ptr_add(base, e, 2), f32_to_bf16(rv * sc));
    }
    preexit();
}

@pdl
@concept(norm)
kernel[D41O_BLK256, 48] d41_engram_gate_256(
    global u32* streams_bf16, global u32* kv_bf16,
    global u32* q_weight_bf16, global u32* k_weight_bf16,
    u32 hc, u32 dimension, f32 epsilon
) {
    shared f32 s_red[8];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 copy = ctaid_y();
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u64 s_ptr = ptr_add(streams_bf16, row * hc + copy, dimension << 1);
    reg u64 kv_row = ptr_add(kv_bf16, row * (hc + 1), dimension << 1);
    reg u64 k_ptr = ptr_add(kv_row, copy, dimension << 1);
    reg u64 v_ptr = ptr_add(kv_row, hc, dimension << 1);
    reg u64 qw_ptr = ptr_add(q_weight_bf16, copy, dimension << 1);
    reg u64 kw_ptr = ptr_add(k_weight_bf16, copy, dimension << 1);
    reg f32 h_sq = 0.0f; reg f32 k_sq = 0.0f; reg f32 dot = 0.0f;
    for (reg u32 e = tid; e < dimension; e += 256) {
        reg f32 hv = bf16_lo(ldg16_stream(ptr_add(s_ptr, e, 2)));
        reg f32 kv = bf16_lo(ldg16_stream(ptr_add(k_ptr, e, 2)));
        reg f32 qw = bf16_lo(ldg16_persist(ptr_add(qw_ptr, e, 2)));
        reg f32 kw = bf16_lo(ldg16_persist(ptr_add(kw_ptr, e, 2)));
        h_sq = fma(hv, hv, h_sq);
        k_sq = fma(kv, kv, k_sq);
        dot = fma(hv * (qw * kw), kv, dot);
    }
    reg f32 h_tot = 0.0f; reg f32 k_tot = 0.0f; reg f32 d_tot = 0.0f;
    block_reduce_sum_exact(h_sq, s_red, wid, lane, h_tot);
    barrier();
    block_reduce_sum_exact(k_sq, s_red, wid, lane, k_tot);
    barrier();
    block_reduce_sum_exact(dot, s_red, wid, lane, d_tot);
    reg f32 dim_f = u32_to_f32(dimension);
    reg f32 rh = 0.0f; reg f32 rk = 0.0f;
    rsqrt_exact_div(h_tot, dim_f, epsilon, rh);
    rsqrt_exact_div(k_tot, dim_f, epsilon, rk);
    reg f32 inv_sd = rsqrt(dim_f);
    inv_sd = inv_sd * fma(-0.5f * dim_f, inv_sd * inv_sd, 1.5f);
    reg f32 scaled = d_tot * (rh * rk) * inv_sd;
    reg f32 mag = 0.0f;
    d41o_sqrt_nr1(maxf(fabsf(scaled), 1.0e-6f), mag);
    reg f32 sm = u32_as_f32((f32_as_u32(scaled) & 0x80000000) | f32_as_u32(mag));
    reg f32 gate = 0.0f;
    sigmoid_exact_f32(sm, gate);
    for (reg u32 e = tid; e < dimension; e += 256) {
        reg f32 hv = bf16_lo(ldg16_stream(ptr_add(s_ptr, e, 2)));
        reg f32 vv = bf16_lo(ldg16_stream(ptr_add(v_ptr, e, 2)));
        stg16(ptr_add(s_ptr, e, 2), f32_to_bf16(fma(gate, vv, hv)));
    }
    preexit();
}

macro d41o_cand_apply_thr(blocks, blk_cnt, thr, need, ninf) {
    reg u32 taken = 0;
    for (reg u32 blk = 0; blk < blk_cnt; blk += 1) {
        reg f32 bv = u32_as_f32(ldg32_stream(ptr_add(blocks, blk, 4)));
        reg u32 ok = 0;
        f32_topk_key(bv, ok);
        if (ok == thr) {
            reg u32 keep_it = 0;
            if (taken < need && bv > ninf) { keep_it = 1; taken = taken + 1; }
            stg32(ptr_add(blocks, blk, 4), (keep_it != 0) ? D41O_POS_INF : D41O_NEG_INF);
        } else if (ok < thr) {
            stg32(ptr_add(blocks, blk, 4), D41O_NEG_INF);
        }
    }
}

macro d41o_cand_filter(blocks, blk_cnt, topk_blocks, s_cnt, s_thr, tid, wid, lane, ninf) {
    reg u32 prefix = 0;
    for (reg u32 b = 0; b < 32; b += 1) {
        reg u32 cand = prefix | (1 << (31 - b));
        reg u32 gr = 0;
        for (reg u32 blk = tid; blk < blk_cnt; blk += 256) {
            reg u32 ok = 0;
            f32_topk_key(u32_as_f32(ldg32_stream(ptr_add(blocks, blk, 4))), ok);
            if (ok >= cand) { gr = gr + 1; }
        }
        reg u32 tot = 0;
        d41o_block_sum_u32(gr, s_cnt, wid, lane, tot);
        barrier();
        if (tot >= topk_blocks) { prefix = cand; }
    }
    if (tid == 0) { sts32(s_thr, 0, prefix); }
    barrier();
    reg u32 thr = lds32(s_thr, 0);
    reg u32 gr = 0;
    for (reg u32 blk = tid; blk < blk_cnt; blk += 256) {
        reg u32 ok = 0;
        f32_topk_key(u32_as_f32(ldg32_stream(ptr_add(blocks, blk, 4))), ok);
        if (ok > thr) { gr = gr + 1; }
    }
    reg u32 tot_g = 0;
    d41o_block_sum_u32(gr, s_cnt, wid, lane, tot_g);
    barrier();
    if (tid == 0) { d41o_cand_apply_thr(blocks, blk_cnt, thr, topk_blocks - tot_g, ninf); }
    barrier();
}

@pdl
@concept(route_topk)
kernel[D41O_BLK256, 48] d41_candidate_mask_256(
    global f32* scores_f32, global u32* widths, u64 row_stride,
    global f32* block_scores_f32, u64 block_stride, u32 block_size, u32 topk_blocks
) {
    shared u32 s_cnt[8];
    shared u32 s_thr[1];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 width = ldg32_persist(ptr_add(widths, row, 4));
    if (width == 0) { preexit(); return; }
    reg u64 scores = ptr_add(scores_f32, row, row_stride[0] << 2);
    reg u64 blocks = ptr_add(block_scores_f32, row, block_stride[0] << 2);
    reg u32 blk_cnt = 0; reg u32 rem = 0;
    u32_divmod(width + block_size - 1, block_size, blk_cnt, rem);
    reg u32 last_blk = blk_cnt - 1;
    reg f32 ninf = u32_as_f32(D41O_NEG_INF);
    for (reg u32 blk = tid; blk < blk_cnt; blk += 256) {
        reg f32 best = ninf;
        reg u32 end_e = ((blk + 1) * block_size < width) ? ((blk + 1) * block_size) : width;
        for (reg u32 e = blk * block_size; e < end_e; e += 1) {
            best = maxf(best, u32_as_f32(ldg32_stream(ptr_add(scores, e, 4))));
        }
        stg32(ptr_add(blocks, blk, 4), (blk == last_blk) ? D41O_POS_INF : f32_as_u32(best));
    }
    barrier();
    if (blk_cnt > topk_blocks) {
        d41o_cand_filter(blocks, blk_cnt, topk_blocks, s_cnt, s_thr, tid, wid, lane, ninf);
    }
    for (reg u32 e = tid; e < width; e += 256) {
        reg u32 qb = 0; reg u32 rb = 0;
        u32_divmod(e, block_size, qb, rb);
        reg f32 bv = u32_as_f32(ldg32_stream(ptr_add(blocks, qb, 4)));
        if (bv <= ninf) { stg32(ptr_add(scores, e, 4), D41O_NEG_INF); }
    }
    preexit();
}

@pdl
@concept(route_topk)
kernel[D41O_BLK256, 48] d41_shard_block_max_256(
    global f32* scores_f32, u64 score_stride, blob[12, 4] shard,
    global u32* seq_of_row, global u32* ctx_len, global u32* row_pos,
    global f32* block_scores_f32, u32 block_stride
) {
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 tid = tid_x();
    reg u64 scores = ptr_add(scores_f32, row, score_stride[0] << 2);
    reg u64 blocks = ptr_add(block_scores_f32, row, block_stride << 2);
    reg u32 reach = ldg32_persist(ptr_add(ctx_len, ldg32_persist(ptr_add(seq_of_row, row, 4)), 4));
    reg u32 rp = ldg32_persist(ptr_add(row_pos, row, 4));
    if (rp + 1 < reach) { reach = rp + 1; }
    reg u32 deg = param_u32(shard, 0);
    reg u32 rk = param_u32(shard, 4);
    reg u32 gr = param_u32(shard, 8);
    reg u32 local = 0;
    kv_shard_local_keys(deg, rk, gr, reach, local);
    reg u32 pinned = 0xFFFFFFFF;
    if (reach != 0) { reg u32 rem = 0; u32_divmod(reach - 1, gr, pinned, rem); }
    reg f32 ninf = u32_as_f32(D41O_NEG_INF);
    for (reg u32 blk = tid; blk < block_stride; blk += 256) {
        reg f32 best = ninf;
        reg u32 beg = blk * gr;
        reg u32 end_e = (beg + gr < local) ? (beg + gr) : local;
        for (reg u32 e = beg; e < end_e; e += 1) {
            best = maxf(best, u32_as_f32(ldg32_stream(ptr_add(scores, e, 4))));
        }
        reg u32 is_pin = 0;
        if (beg < local && blk * deg + rk == pinned) { is_pin = 1; }
        stg32(ptr_add(blocks, blk, 4), (is_pin != 0) ? D41O_POS_INF : f32_as_u32(best));
    }
    preexit();
}

@pdl
@concept(route_topk)
kernel[D41O_BLK256, 32] d41_shard_block_mask_256(
    u32 global_stride, global u32* selected, u32 keep,
    blob[12, 4] blocks, global u8* mask, u32 block_stride
) {
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 tid = tid_x();
    reg u64 line = ptr_add(mask, row, block_stride);
    for (reg u32 blk = tid; blk < block_stride; blk += 256) { stg8(ptr_add(line, blk, 1), 0); }
    barrier();
    reg u32 deg = param_u32(blocks, 0);
    reg u32 rk = param_u32(blocks, 4);
    reg u64 sel_row = ptr_add(selected, row, keep << 2);
    for (reg u32 e = tid; e < keep; e += 256) {
        reg u32 blk = ldg32_stream(ptr_add(sel_row, e, 4));
        if (blk < global_stride) {
            reg u32 q = 0; reg u32 r = 0;
            u32_divmod(blk, deg, q, r);
            if (r == rk && q < block_stride) { stg8(ptr_add(line, q, 1), 1); }
        }
    }
    preexit();
}

@pdl
@concept(route_topk)
kernel[D41O_BLK256, 32] d41_shard_block_apply_256(
    global f32* scores_f32, u64 score_stride, u32 grain, global u8* mask, u32 block_stride
) {
    acqbulk();
    reg u32 row = ctaid_y();
    reg u64 scores = ptr_add(scores_f32, row, score_stride[0] << 2);
    reg u64 line = ptr_add(mask, row, block_stride);
    reg u32 step = grid_x() * ntid_x();
    reg u32 sstride = score_stride[0];
    for (reg u32 e = ctaid_x() * ntid_x() + tid_x(); e < sstride; e += step) {
        reg u32 qb = 0; reg u32 rb = 0;
        u32_divmod(e, grain, qb, rb);
        reg u32 drop = 1;
        if (qb < block_stride) {
            if (ldg8_stream(ptr_add(line, qb, 1)) != 0) { drop = 0; }
        }
        if (drop != 0) { stg32(ptr_add(scores, e, 4), D41O_NEG_INF); }
    }
    preexit();
}

@pdl
@concept(quant)
kernel[D41O_BLK256, 40] d41_act_quant_256(
    global u32* input_bf16, global f32* output_f32, u32 row_count, u32 width
) {
    acqbulk();
    reg u32 groups = width >> 5;
    reg u32 grp = ctaid_x() * ntid_x() + tid_x();
    if (grp >= row_count * groups) { preexit(); return; }
    reg u32 r = 0; reg u32 g = 0;
    u32_divmod(grp, groups, r, g);
    reg u64 src = ptr_add(ptr_add(input_bf16, r, width << 1), g << 5, 2);
    reg u64 dst = ptr_add(ptr_add(output_f32, r, width << 2), g << 5, 4);
    reg f32 am = 0.0f;
    for (reg u32 e = 0; e < 32; e += 1) { am = maxf(am, fabsf(bf16_lo(ldg16_stream(ptr_add(src, e, 2))))); }
    reg u32 sbits = pow2_ceil_e8m0_bits(maxf(am, 1.0e-4f)) << 23;
    reg f32 sc = u32_as_f32(sbits);
    reg f32 inv = u32_as_f32(0x7F000000 - sbits);
    for (reg u32 e = 0; e < 32; e += 1) {
        reg f32 v = bf16_lo(ldg16_stream(ptr_add(src, e, 2)));
        reg u32 q = cvt_f32x2_e4m3x2(minf(maxf(v * inv, -448.0f), 448.0f), 0.0f);
        stg32(ptr_add(dst, e, 4), f32_as_u32(e4m3_to_f32(q & 0xFF) * sc));
    }
    preexit();
}

@pdl
@concept(linear)
kernel[D41O_BLK256, 48] d41_fp8_block_linear_256(
    global u8* weight_e4m3, global u8* scale_ue8m0, global f32* activation_f32,
    global u32* output_bf16, u32 input_dimension, u32 output_dimension
) {
    acqbulk();
    reg u32 lane = lane_id();
    reg u32 out_i = ctaid_x() * 8 + warp_id();
    reg u32 row = ctaid_y();
    if (out_i >= output_dimension) { preexit(); return; }
    reg u32 sc_cols = input_dimension >> 5;
    reg u64 act = ptr_add(activation_f32, row, input_dimension << 2);
    reg u64 wt = ptr_add(weight_e4m3, out_i, input_dimension);
    reg u64 sc_row = ptr_add(scale_ue8m0, out_i >> 5, sc_cols);
    reg f32 total = 0.0f;
    for (reg u32 k = lane << 4; k < input_dimension; k += 512) {
        reg u32x4 pk = ldg128_stream(ptr_add(wt, k, 1));
        reg f32 sc = ue8m0_to_f32(ldg8_persist(ptr_add(sc_row, k >> 5, 1)));
        reg f32 part = 0.0f;
        unroll (w = 0..4) {
            reg f32x4 fw = cvt_e4m3x4_f32x4(pk[w]);
            reg u32x4 av = ldg128_persist(ptr_add(act, k + w * 4, 4));
            part = fma(fw[3], u32_as_f32(av[3]), fma(fw[2], u32_as_f32(av[2]), fma(fw[1], u32_as_f32(av[1]), fma(fw[0], u32_as_f32(av[0]), part))));
        }
        total = fma(part, sc, total);
    }
    warp_sum_down(total);
    if (lane == 0) { stg16(ptr_add(ptr_add(output_bf16, row, output_dimension << 1), out_i, 2), f32_to_bf16(total)); }
    preexit();
}

@pdl
@concept(norm)
kernel[D41O_BLK256, 32] d41_rms_norm_256(
    global u32* input_bf16, global u32* weight_bf16, global u32* output_bf16,
    u32 dimension, f32 epsilon
) {
    shared f32 s_red[8];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 tid = tid_x();
    reg u64 in_p = ptr_add(input_bf16, row, dimension << 1);
    reg u64 out_p = ptr_add(output_bf16, row, dimension << 1);
    reg f32 sq = 0.0f;
    for (reg u32 e = tid; e < dimension; e += 256) {
        reg f32 v = bf16_lo(ldg16_stream(ptr_add(in_p, e, 2)));
        sq = fma(v, v, sq);
    }
    reg f32 tot = 0.0f;
    block_reduce_sum_exact(sq, s_red, warp_id(), lane_id(), tot);
    reg f32 inv = 0.0f;
    rsqrt_exact_div(tot, u32_to_f32(dimension), epsilon, inv);
    for (reg u32 e = tid; e < dimension; e += 256) {
        reg f32 v = bf16_lo(ldg16_stream(ptr_add(in_p, e, 2)));
        reg f32 w = bf16_lo(ldg16_persist(ptr_add(weight_bf16, e, 2)));
        stg16(ptr_add(out_p, e, 2), f32_to_bf16(w * (v * inv)));
    }
    preexit();
}

@pdl
@concept(elementwise)
kernel[D41O_BLK256, 32] d41_rope_op_256(
    global u32* data_bf16, global f32* cos_sin_f32,
    u32 head_count, u32 head_dimension, u32 rope_dimension, u32 inverse
) {
    acqbulk();
    reg u32 head = ctaid_x();
    if (head >= head_count) { preexit(); return; }
    reg u32 pairs = rope_dimension >> 1;
    for (reg u32 pair = tid_x(); pair < pairs; pair += 256) {
        reg u64 p = ptr_add(ptr_add(data_bf16, head, head_dimension << 1), head_dimension - rope_dimension + (pair << 1), 2);
        reg f32 cs = u32_as_f32(ldg32_persist(ptr_add(cos_sin_f32, pair << 1, 4)));
        reg f32 sn = u32_as_f32(ldg32_persist(ptr_add(cos_sin_f32, (pair << 1) + 1, 4)));
        if (inverse != 0) { sn = 0.0f - sn; }
        reg f32 rl = bf16_lo(ldg16_stream(p));
        reg f32 im = bf16_lo(ldg16_stream(ptr_add(p, 1, 2)));
        stg16(p, f32_to_bf16(fma(rl, cs, 0.0f - im * sn)));
        stg16(ptr_add(p, 1, 2), f32_to_bf16(fma(rl, sn, im * cs)));
    }
    preexit();
}

@pdl
@concept(quant)
kernel[D41O_BLK256, 32] d41_fp8_qdq_256(
    global u32* source_bf16, global u32* data_bf16, u32 group_count
) {
    acqbulk();
    reg u32 grp = ctaid_x() * 8 + warp_id();
    reg u32 lane = lane_id();
    if (grp >= group_count) { preexit(); return; }
    reg u32 off = (grp << 5) + lane;
    reg f32 v = bf16_lo(ldg16_stream(ptr_add(source_bf16, off, 2)));
    reg u32 qb = 0;
    fp8_e4m3_qdq_lane_bf16(v, qb);
    stg16(ptr_add(data_bf16, off, 2), qb);
    preexit();
}

@pdl
@concept(attention)
kernel[D41O_BLK256, 48] d41_sink_attention_256(
    global u32* query_bf16, global u32* keys_bf16, global u32* indices,
    u32 index_count, global f32* sink_f32, global u32* output_bf16,
    u32 head_dimension, f32 softmax_scale
) {
    shared f32 probs[1024];
    shared f32 rounded[1024];
    shared f32 scratch[1];
    acqbulk();
    reg u32 head = ctaid_x();
    reg u32 tid = tid_x();
    reg u32 lane = lane_id();
    reg u32 wid = warp_id();
    reg u64 qp = ptr_add(query_bf16, head, head_dimension << 1);
    for (reg u32 sl = wid; sl < index_count; sl += 8) {
        reg u32 idx = ldg32_persist(ptr_add(indices, sl, 4));
        reg f32 sc = 0.0f;
        if ((idx >> 31) == 0) {
            reg u64 kp = ptr_add(keys_bf16, idx, head_dimension << 1);
            for (reg u32 e = lane; e < head_dimension; e += 32) {
                sc = fma(bf16_lo(ldg16_persist(ptr_add(qp, e, 2))), bf16_lo(ldg16_stream(ptr_add(kp, e, 2))), sc);
            }
        }
        warp_sum_down(sc);
        if (lane == 0) {
            sts32(probs, sl, ((idx >> 31) == 0) ? (sc * softmax_scale) : u32_as_f32(D41O_NEG_INF));
        }
    }
    barrier();
    if (tid == 0) {
        reg f32 top = -1.0e30f;
        for (reg u32 sl = 0; sl < index_count; sl += 1) { top = maxf(top, lds32(probs, sl)); }
        sts32(scratch, 0, top);
    }
    barrier();
    reg f32 top = lds32(scratch, 0);
    for (reg u32 sl = tid; sl < index_count; sl += 256) {
        reg f32 val = exp2_ftz((lds32(probs, sl) - top) * D41O_LOG2E);
        sts32(probs, sl, val);
        sts32(rounded, sl, bf16_lo(f32_to_bf16(val)));
    }
    barrier();
    if (tid == 0) {
        reg f32 den = 0.0f;
        for (reg u32 sl = 0; sl < index_count; sl += 1) { den = den + lds32(probs, sl); }
        reg f32 sk = u32_as_f32(ldg32_persist(ptr_add(sink_f32, head, 4)));
        sts32(scratch, 0, den + exp2_ftz((sk - top) * D41O_LOG2E));
    }
    barrier();
    reg f32 den = lds32(scratch, 0);
    reg f32 inv_d = 0.0f; rcp_nr1_f32(den, inv_d);
    reg u64 dst = ptr_add(output_bf16, head, head_dimension << 1);
    for (reg u32 e = tid; e < head_dimension; e += 256) {
        reg f32 acc = 0.0f;
        for (reg u32 sl = 0; sl < index_count; sl += 1) {
            reg u32 idx = ldg32_persist(ptr_add(indices, sl, 4));
            if ((idx >> 31) == 0) {
                acc = fma(lds32(rounded, sl), bf16_lo(ldg16_stream(ptr_add(ptr_add(keys_bf16, idx, head_dimension << 1), e, 2))), acc);
            }
        }
        reg f32 out_f = 0.0f;
        div_nr1_f32(acc, den, inv_d, out_f);
        stg16(ptr_add(dst, e, 2), f32_to_bf16(out_f));
    }
    preexit();
}

@pdl
@concept(linear)
kernel[D41O_BLK256, 48] d41_grouped_fp8_linear_256(
    global u8* weight_e4m3, global u8* scale_ue8m0, global u32* input_bf16,
    global u32* output_bf16, u32 input_dimension, u32 output_dimension, u32 outputs_per_group
) {
    acqbulk();
    reg u32 lane = lane_id();
    reg u32 out_i = ctaid_x() * 8 + warp_id();
    if (out_i >= output_dimension) { preexit(); return; }
    reg u32 sc_cols = input_dimension >> 5;
    reg u32 og = 0; reg u32 orem = 0;
    u32_divmod(out_i, outputs_per_group, og, orem);
    reg u64 act = ptr_add(input_bf16, og, input_dimension << 1);
    reg u64 wt = ptr_add(weight_e4m3, out_i, input_dimension);
    reg u64 sc_row = ptr_add(scale_ue8m0, out_i >> 5, sc_cols);
    reg f32 total = 0.0f;
    for (reg u32 k = lane << 4; k < input_dimension; k += 512) {
        reg u32x4 pk = ldg128_stream(ptr_add(wt, k, 1));
        reg f32 sc = ue8m0_to_f32(ldg8_persist(ptr_add(sc_row, k >> 5, 1)));
        reg u32x4 a0 = ldg128_persist(ptr_add(act, k, 2));
        reg u32x4 a1 = ldg128_persist(ptr_add(act, k + 8, 2));
        reg f32x4 f0 = cvt_e4m3x4_f32x4(pk[0]);
        reg f32x4 f1 = cvt_e4m3x4_f32x4(pk[1]);
        reg f32x4 f2 = cvt_e4m3x4_f32x4(pk[2]);
        reg f32x4 f3 = cvt_e4m3x4_f32x4(pk[3]);
        reg f32 part = fma(f0[1] * sc, bf16_hi(a0[0]), (f0[0] * sc) * bf16_lo(a0[0]));
        part = fma(f0[3] * sc, bf16_hi(a0[1]), fma(f0[2] * sc, bf16_lo(a0[1]), part));
        part = fma(f1[1] * sc, bf16_hi(a0[2]), fma(f1[0] * sc, bf16_lo(a0[2]), part));
        part = fma(f1[3] * sc, bf16_hi(a0[3]), fma(f1[2] * sc, bf16_lo(a0[3]), part));
        part = fma(f2[1] * sc, bf16_hi(a1[0]), fma(f2[0] * sc, bf16_lo(a1[0]), part));
        part = fma(f2[3] * sc, bf16_hi(a1[1]), fma(f2[2] * sc, bf16_lo(a1[1]), part));
        part = fma(f3[1] * sc, bf16_hi(a1[2]), fma(f3[0] * sc, bf16_lo(a1[2]), part));
        part = fma(f3[3] * sc, bf16_hi(a1[3]), fma(f3[2] * sc, bf16_lo(a1[3]), part));
        total = total + part;
    }
    warp_sum_down(total);
    if (lane == 0) { stg16(ptr_add(output_bf16, out_i, 2), f32_to_bf16(total)); }
    preexit();
}

macro d41o_gate_pick_one(scores, bias_f32, chosen, expert_count, pick, ninf, out_best) {
    out_best = 0xFFFFFFFF;
    reg f32 best_v = ninf;
    for (reg u32 exp = 0; exp < expert_count; exp += 1) {
        reg f32 v = lds32(scores, exp) + u32_as_f32(ldg32_persist(ptr_add(bias_f32, exp, 4)));
        for (reg u32 p = 0; p < pick; p += 1) {
            if (lds32(chosen, p) == exp) { v = ninf; }
        }
        if (v > best_v) { best_v = v; out_best = exp; }
    }
}

@pdl
@concept(route_topk)
kernel[D41O_BLK256, 48] d41_gate_256(
    global u32* input_bf16, global u32* weight_bf16, global f32* bias_f32,
    global u32* indices_out, global f32* weights_out,
    u32 expert_count, u32 dimension, u32 topk, f32 route_scale
) {
    shared f32 scores[512];
    shared u32 chosen[16];
    acqbulk();
    reg u32 lane = lane_id();
    reg u32 wid = warp_id();
    for (reg u32 exp = wid; exp < expert_count; exp += 8) {
        reg f32 total = 0.0f;
        reg u64 wp = ptr_add(weight_bf16, exp, dimension << 1);
        for (reg u32 e = lane; e < dimension; e += 32) {
            total = fma(bf16_lo(ldg16_persist(ptr_add(input_bf16, e, 2))), bf16_lo(ldg16_stream(ptr_add(wp, e, 2))), total);
        }
        warp_sum_down(total);
        if (lane == 0) {
            reg f32 sp = 0.0f;
            softplus_exact_f32(total, sp);
            reg f32 sq = 0.0f;
            d41o_sqrt_nr1(maxf(sp, 0.0f), sq);
            sts32(scores, exp, sq);
        }
    }
    barrier();
    if (tid_x() == 0) {
        reg f32 sum = 0.0f;
        reg f32 ninf = u32_as_f32(D41O_NEG_INF);
        for (reg u32 pick = 0; pick < topk; pick += 1) {
            reg u32 best = 0xFFFFFFFF;
            d41o_gate_pick_one(scores, bias_f32, chosen, expert_count, pick, ninf, best);
            sts32(chosen, pick, best);
            sum = sum + lds32(scores, best);
        }
        reg f32 denom = sum + 1.0e-20f;
        reg f32 inv_d = 0.0f; rcp_nr1_f32(denom, inv_d);
        for (reg u32 pick = 0; pick < topk; pick += 1) {
            reg u32 ch = lds32(chosen, pick);
            stg32(ptr_add(indices_out, pick, 4), ch);
            reg f32 q = 0.0f;
            div_nr1_f32(lds32(scores, ch), denom, inv_d, q);
            stg32(ptr_add(weights_out, pick, 4), f32_as_u32(q * route_scale));
        }
    }
    preexit();
}

@pdl
@concept(linear)
kernel[D41O_BLK256, 48] d41_mxfp4_linear_256(
    global u8* payload_e2m1, global u8* scale_ue8m0, global f32* activation_f32,
    global u32* output_bf16, u32 input_dimension, u32 output_dimension
) {
    acqbulk();
    reg u32 lane = lane_id();
    reg u32 out_i = ctaid_x() * 8 + warp_id();
    if (out_i >= output_dimension) { preexit(); return; }
    reg u64 wt = ptr_add(payload_e2m1, out_i, input_dimension >> 1);
    reg u64 sc_row = ptr_add(scale_ue8m0, out_i, input_dimension >> 5);
    reg f32 total = 0.0f;
    for (reg u32 k = lane << 5; k < input_dimension; k += 1024) {
        reg u32x4 pk = ldg128_stream(ptr_add(wt, k >> 1, 1));
        reg f32 part = 0.0f;
        unroll (w = 0..4) {
            reg f32x4 d0 = cvt_e2m1x4_f32x4(pk[w], 0);
            reg f32x4 d1 = cvt_e2m1x4_f32x4(pk[w], 16);
            reg u32x4 a0 = ldg128_persist(ptr_add(activation_f32, k + w * 8, 4));
            reg u32x4 a1 = ldg128_persist(ptr_add(activation_f32, k + w * 8 + 4, 4));
            part = fma(d0[3], u32_as_f32(a0[3]), fma(d0[2], u32_as_f32(a0[2]), fma(d0[1], u32_as_f32(a0[1]), fma(d0[0], u32_as_f32(a0[0]), part))));
            part = fma(d1[3], u32_as_f32(a1[3]), fma(d1[2], u32_as_f32(a1[2]), fma(d1[1], u32_as_f32(a1[1]), fma(d1[0], u32_as_f32(a1[0]), part))));
        }
        total = fma(part, ue8m0_to_f32(ldg8_persist(ptr_add(sc_row, k >> 5, 1))), total);
    }
    warp_sum_down(total);
    if (lane == 0) { stg16(ptr_add(output_bf16, out_i, 2), f32_to_bf16(total)); }
    preexit();
}

@pdl
@concept(elementwise)
kernel[D41O_BLK256, 32] d41_swiglu_256(
    global u32* gate_bf16, global u32* up_bf16, global u32* output_bf16,
    u32 width, f32 limit, f32 weight
) {
    acqbulk();
    reg u32 e = ctaid_x() * ntid_x() + tid_x();
    if (e < width) {
        reg f32 g = minf(bf16_lo(ldg16_stream(ptr_add(gate_bf16, e, 2))), limit);
        reg f32 u = minf(maxf(bf16_lo(ldg16_stream(ptr_add(up_bf16, e, 2))), 0.0f - limit), limit);
        reg f32 sv = 0.0f;
        silu_exact_f32(g, sv);
        stg16(ptr_add(output_bf16, e, 2), f32_to_bf16(weight * (sv * u)));
    }
    preexit();
}

@pdl
@concept(elementwise)
kernel[D41O_BLK256, 24] d41_accumulate_256(
    global f32* accumulator_f32, global u32* value_bf16, u32 width
) {
    acqbulk();
    reg u32 e = ctaid_x() * ntid_x() + tid_x();
    if (e < width) {
        reg u64 dst = ptr_add(accumulator_f32, e, 4);
        reg f32 acc = u32_as_f32(ldg32_stream(dst)) + bf16_lo(ldg16_stream(ptr_add(value_bf16, e, 2)));
        stg32(dst, f32_as_u32(acc));
    }
    preexit();
}

@pdl
@concept(elementwise)
kernel[D41O_BLK256, 24] d41_narrow_256(
    global f32* input_f32, global u32* output_bf16, u32 width
) {
    acqbulk();
    reg u32 e = ctaid_x() * ntid_x() + tid_x();
    if (e < width) {
        stg16(ptr_add(output_bf16, e, 2), f32_to_bf16(u32_as_f32(ldg32_stream(ptr_add(input_f32, e, 4)))));
    }
    preexit();
}

@pdl
@concept(linear)
kernel[D41O_BLK256, 32] d41_bf16_linear_256(
    global u32* weight_bf16, global u32* input_bf16,
    global f32* output_f32, global u32* output_bf16,
    u32 input_dimension, u32 output_dimension
) {
    acqbulk();
    reg u32 lane = lane_id();
    reg u32 out_i = ctaid_x() * 8 + warp_id();
    if (out_i >= output_dimension) { preexit(); return; }
    reg u64 wt = ptr_add(weight_bf16, out_i, input_dimension << 1);
    reg f32 total = 0.0f;
    for (reg u32 k = lane; k < input_dimension; k += 32) {
        total = fma(bf16_lo(ldg16_stream(ptr_add(wt, k, 2))), bf16_lo(ldg16_persist(ptr_add(input_bf16, k, 2))), total);
    }
    warp_sum_down(total);
    if (lane == 0) {
        if ((output_f32[0] | output_f32[1]) != 0) { stg32(ptr_add(output_f32, out_i, 4), f32_as_u32(total)); }
        if ((output_bf16[0] | output_bf16[1]) != 0) { stg16(ptr_add(output_bf16, out_i, 2), f32_to_bf16(total)); }
    }
    preexit();
}

@pdl
@concept(attention)
kernel[D41O_BLK256, 40] d41_compress_pool_256(
    global f32* kv_state_f32, global f32* score_state_f32, global u32* pooled_bf16,
    u32 ratio, u32 width
) {
    acqbulk();
    reg u32 ch = ctaid_x() * ntid_x() + tid_x();
    if (ch >= width) { preexit(); return; }
    reg f32 top = u32_as_f32(D41O_NEG_INF);
    for (reg u32 s = 0; s < ratio; s += 1) {
        top = maxf(top, u32_as_f32(ldg32_stream(ptr_add(ptr_add(score_state_f32, s, width << 2), ch, 4))));
    }
    reg f32 sum = 0.0f;
    for (reg u32 s = 0; s < ratio; s += 1) {
        reg f32 sc = u32_as_f32(ldg32_stream(ptr_add(ptr_add(score_state_f32, s, width << 2), ch, 4)));
        sum = sum + exp2_ftz((sc - top) * D41O_LOG2E);
    }
    reg f32 inv_s = 0.0f; rcp_nr1_f32(sum, inv_s);
    reg f32 total = 0.0f;
    for (reg u32 s = 0; s < ratio; s += 1) {
        reg f32 kv = u32_as_f32(ldg32_stream(ptr_add(ptr_add(kv_state_f32, s, width << 2), ch, 4)));
        reg f32 sc = u32_as_f32(ldg32_stream(ptr_add(ptr_add(score_state_f32, s, width << 2), ch, 4)));
        reg f32 wt = 0.0f;
        div_nr1_f32(exp2_ftz((sc - top) * D41O_LOG2E), sum, inv_s, wt);
        total = fma(kv, wt, total);
    }
    stg16(ptr_add(pooled_bf16, ch, 2), f32_to_bf16(total));
    preexit();
}

@pdl
@concept(quant)
kernel[D41O_BLK256, 48] d41_fp4_pow2_qdq_vec_256(
    global u32* data_bf16, u64 octets
) {
    acqbulk();
    reg u32 idx = ctaid_x() * ntid_x() + tid_x();
    if (idx >= octets[0]) { preexit(); return; }
    reg u64 p = ptr_add(data_bf16, idx, 16);
    reg u32x4 raw = ldg128_stream(p);
    reg f32 am = 0.0f;
    d41o_amax8(raw, am);
    am = maxf(am, shfl_xor(am, 1));
    am = maxf(am, shfl_xor(am, 2));
    reg f32 floored = maxf(am, 6.0f * 1.1754943508222875e-38f);
    reg u32 sbits = (f32_as_u32(floored * (1.0f / 6.0f)) + 0x007FFFFF) & 0xFF800000;
    reg f32 sc = u32_as_f32(sbits);
    reg f32 inv = u32_as_f32(0x7F000000 - sbits);
    reg u32x4 out_v = pack_u32x4(0, 0, 0, 0);
    d41o_e2m1_qdq8_scale(raw, sc, inv, 0, out_v);
    stg128(p, out_v);
    preexit();
}

@pdl
@concept(quant)
kernel[D41O_BLK256, 40] d41_fp4_pow2_qdq_256(
    global u32* data_bf16, u32 group_count, u32 group_size
) {
    acqbulk();
    reg u32 grp = ctaid_x() * ntid_x() + tid_x();
    if (grp >= group_count) { preexit(); return; }
    reg u64 base = ptr_add(data_bf16, grp, group_size << 1);
    reg f32 am = 0.0f;
    for (reg u32 e = 0; e < group_size; e += 1) { am = maxf(am, fabsf(bf16_lo(ldg16_stream(ptr_add(base, e, 2))))); }
    reg f32 floored = maxf(am, 6.0f * 1.1754943508222875e-38f);
    reg u32 sbits = (f32_as_u32(floored * (1.0f / 6.0f)) + 0x007FFFFF) & 0xFF800000;
    reg f32 sc = u32_as_f32(sbits);
    reg f32 inv = u32_as_f32(0x7F000000 - sbits);
    for (reg u32 e = 0; e < group_size; e += 1) {
        reg f32 v = bf16_lo(ldg16_stream(ptr_add(base, e, 2)));
        reg f32 rv = 0.0f;
        d41o_e2m1_round_f32(minf(maxf(v * inv, -6.0f), 6.0f), rv);
        stg16(ptr_add(base, e, 2), f32_to_bf16(rv * sc));
    }
    preexit();
}

@pdl
@concept(attention)
kernel[D41O_BLK256, 40] d41_index_score_ref_256(
    global u32* query_bf16, global u32* keys_bf16, global u32* head_weights_bf16,
    global f32* scores_f32, u32 key_count, u32 head_count, u32 head_dimension
) {
    acqbulk();
    reg u32 lane = lane_id();
    reg u32 key = ctaid_x() * 8 + warp_id();
    if (key >= key_count) { preexit(); return; }
    reg u64 kp = ptr_add(keys_bf16, key, head_dimension << 1);
    reg f32 total = 0.0f;
    for (reg u32 h = 0; h < head_count; h += 1) {
        reg u64 qp = ptr_add(query_bf16, h, head_dimension << 1);
        reg f32 dot = 0.0f;
        for (reg u32 e = lane; e < head_dimension; e += 32) {
            dot = fma(bf16_lo(ldg16_persist(ptr_add(qp, e, 2))), bf16_lo(ldg16_stream(ptr_add(kp, e, 2))), dot);
        }
        dot = warp_sum(dot);
        reg f32 dr = maxf(bf16_lo(f32_to_bf16(dot)), 0.0f);
        reg f32 hw = bf16_lo(ldg16_persist(ptr_add(head_weights_bf16, h, 2)));
        total = total + bf16_lo(f32_to_bf16(dr * hw));
    }
    if (lane == 0) { stg32(ptr_add(scores_f32, key, 4), f32_as_u32(bf16_lo(f32_to_bf16(total)))); }
    preexit();
}
