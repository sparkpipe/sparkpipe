            reg u32 d4 = ((lh * total_prior + (prior_off + pos)) * 2) * 32;
            stg128(ptr_add(kv_prior, d4 + lane, 16), ldg128_persist(ptr_add(src_base, s4 + lane, 16)));
            stg128(ptr_add(kv_prior, d4 + 32 + lane, 16), ldg128_persist(ptr_add(src_base, s4 + 32 + lane, 16)));
        }
    }
    preexit();
}

macro gqa_stage_kv_tile(BLOCK_T, kv_view, seq, t0, cnt, fork, slot_off, kv_head, kvh, tid, st_off, s_k, s_v) {
    for (reg u32 idx = tid; idx < (cnt << 5); idx += BLOCK_T) {
        reg u32 dt = idx >> 5;
        reg u32 ln = idx & 31;
        reg u32 sem = t0 + dt;
        reg u32 phys_pos = (sem < fork) ? sem : (sem + slot_off);
        reg u64 slot = 0; reg u32 ok = 0;
        kv_shard_slot_addr(kv_view, seq, phys_pos, kvh << 10, slot, ok);
        if (ok != 0) {
            ldgsts128(s_k, st_off + (idx << 2), ptr_add(slot, (kv_head << 5) + ln, 16));
            ldgsts128(s_v, st_off + (idx << 2), ptr_add(slot, ((kvh + kv_head) << 5) + ln, 16));
        }
    }
    ldgdepbar();
}

macro gqa_decode_tile_step(s_k, s_v, st_off, cnt, lane, qk_scale, qf, acc, rmax, rsum) {
    for (reg u32 dt = 0; dt < cnt; dt += 1) {
        reg u32 so = st_off + ((dt << 5) + lane) * 4;
        reg u32x4 kv = lds128(s_k, so);
        reg u32x4 vv = lds128(s_v, so);
        reg f32 score = 0.0f;
        unroll (i = 0..4) {
            score = fma(qf[i * 2], bf16_lo(kv[i]), score);
            score = fma(qf[i * 2 + 1], bf16_hi(kv[i]), score);
        }
        score = warp_sum(score) * qk_scale;
        reg f32 prev = rmax;
        rmax = maxf(prev, score);
        reg f32 rescale = exp2_ftz((prev - rmax) * 1.4426950408889634f);
        reg f32 w = exp2_ftz((score - rmax) * 1.4426950408889634f);
        rsum = fma(rsum, rescale, w);
        reg f32 vw = bf16_lo(f32_to_bf16(w));
        unroll (i = 0..4) {
            acc[i * 2] = fma(acc[i * 2], rescale, vw * bf16_lo(vv[i]));
            acc[i * 2 + 1] = fma(acc[i * 2 + 1], rescale, vw * bf16_hi(vv[i]));
        }
    }
}

macro gqa_store_gated_row(attn_local, merged_out, row, head, heads, qkv_v, lane, acc, rsum) {
    reg f32 denom = maxf(rsum, 1.0e-20f);
    reg f32 inv_d = 0.0f;
    rcp_nr1_f32(denom, inv_d);
    reg u32x4 gv = ldg128_stream(ptr_add(attn_local, row * qkv_v + (head * 2 + 1) * 32 + lane, 16));
    unroll (k = 0..4) {
        gqa_gate_pair(acc[k * 2], acc[k * 2 + 1], denom, inv_d, gv[k], gv[k]);
    }
    stg128(ptr_add(merged_out, (row * heads + head) * 32 + lane, 16), gv);
}

macro gqa_store_split_partial(attn_local, merged_out, partials, row, head, heads, qkv_v, split, begin, end, limit, lane, acc, rmax, rsum) {
    reg u32 is_single = 0;
    if (begin == 0 && end == limit) { is_single = 1; }
    if (is_single != 0) {
        gqa_store_gated_row(attn_local, merged_out, row, head, heads, qkv_v, lane, acc, rsum);
    } else {
        reg u32 pb = ((row * 12 + split) * heads + head) * 260;
        stg128(ptr_add(partials, pb + (lane << 3), 4), pack_u32x4(f32_as_u32(acc[0]), f32_as_u32(acc[1]), f32_as_u32(acc[2]), f32_as_u32(acc[3])));
        stg128(ptr_add(partials, pb + (lane << 3) + 4, 4), pack_u32x4(f32_as_u32(acc[4]), f32_as_u32(acc[5]), f32_as_u32(acc[6]), f32_as_u32(acc[7])));
        if (lane == 0) {
            stg32(ptr_add(partials, pb + 256, 4), f32_as_u32(rmax));
            stg32(ptr_add(partials, pb + 257, 4), f32_as_u32(rsum));
        }
    }
}

macro gqa_decode_loop(BLOCK_T, kv_view, seq, begin, end, fork, slot_off, kv_head, kvh, tid, lane, qk_scale, s_k, s_v, qf, acc, rmax, rsum) {
    if (begin < end) {
        reg u32 cnt0 = (end - begin < 8) ? (end - begin) : 8;
        gqa_stage_kv_tile(BLOCK_T, kv_view, seq, begin, cnt0, fork, slot_off, kv_head, kvh, tid, 0, s_k, s_v);
        reg u32 cur = 0;
        for (reg u32 t = begin; t < end; t += 8) {
            reg u32 cnt = (end - t < 8) ? (end - t) : 8;
            reg u32 nt = t + 8;
            if (nt < end) {
                gqa_stage_kv_tile(BLOCK_T, kv_view, seq, nt, (end - nt < 8) ? (end - nt) : 8, fork, slot_off, kv_head, kvh, tid, (cur ^ 1) << 10, s_k, s_v);
                depbar_le(1);
            } else {
                depbar_le(0);
            }
            barrier();
            gqa_decode_tile_step(s_k, s_v, cur << 10, cnt, lane, qk_scale, qf, acc, rmax, rsum);
            cur = cur ^ 1;
            if (nt < end) { barrier(); }
        }
    }
}

macro gqa_split_bounds(limit, row, fork_positions, slot_offsets, out_split, out_begin, out_end, out_fork, out_soff) {
    out_split = ctaid_z();
    reg u32 slen = (limit <= 64) ? ((limit > 0) ? limit : 1) : (((((limit + 767) >> 8) * 21846) >> 16) << 6);
    out_begin = out_split * slen;
    out_end = (out_begin + slen < limit) ? (out_begin + slen) : limit;
    if ((fork_positions[0] | fork_positions[1]) != 0) {
        reg u32 fp = ldg32_persist(ptr_add(fork_positions, row, 4));
        if (fp < limit) { out_fork = fp; }
    }
    if ((slot_offsets[0] | slot_offsets[1]) != 0) {
        out_soff = ldg32_persist(ptr_add(slot_offsets, row, 4));
    }
}

@pdl
@concept(attention)
template kernel[BLOCK_T, 96] qwen_gqa_decode_tpl<IS_SPLIT, IS_GEN, BLOCK_T>(
    blob[56, 8] kv_view, global u32* query_bf16, global u32* attn_local,
    global u32* sequence_of_row, global u32* context_length, global u32* row_position,
    if (IS_SPLIT == 1) global u32* fork_positions,
    if (IS_SPLIT == 1) global u32* slot_offsets,
    f32 qk_scale,
    if (IS_SPLIT == 1) global u32* partials,
    global u32* merged_out, u32 rows,
    if (IS_GEN == 1) u32 heads_in,
    if (IS_GEN == 1) u32 kvh_in,
    if (IS_GEN == 1) u32 qkv_v_in
) {
    shared u32 s_k[2048];
    shared u32 s_v[2048];
    acqbulk();
    reg u32 heads = 24; reg u32 kvh = 4; reg u32 qkv_v = 1792;
    if constexpr (IS_GEN == 1) { heads = heads_in; kvh = kvh_in; qkv_v = qkv_v_in; }
    reg u32 row = ctaid_x(); reg u32 kv_head = ctaid_y();
    reg u32 wid = warp_id(); reg u32 lane = lane_id(); reg u32 tid = tid_x();
    reg u32 grp = BLOCK_T / 32;
    if constexpr (IS_GEN == 1) { reg u32 tr = 0; u32_divmod(heads, kvh, grp, tr); }
    reg u32 head = kv_head * grp + wid;
    if (row >= rows || wid >= grp) { preexit(); return; }
    if (head >= heads) { preexit(); return; }
    reg u32 seq = ldg32_persist(ptr_add(sequence_of_row, row, 4));
    if (seq >= param_u32(kv_view, 20)) { preexit(); return; }
    reg u32 limit = ldg32_persist(ptr_add(context_length, seq, 4));
    if ((row_position[0] | row_position[1]) != 0) {
        reg u32 rp = ldg32_persist(ptr_add(row_position, row, 4));
        if (rp != 0xFFFFFFFF && rp + 1 < limit) { limit = rp + 1; }
    }
    reg u32 begin = 0; reg u32 end = limit; reg u32 split = 0; reg u32 fork = limit; reg u32 slot_off = 0;
    if constexpr (IS_SPLIT == 1) {
        gqa_split_bounds(limit, row, fork_positions, slot_offsets, split, begin, end, fork, slot_off);
        if (begin >= limit) { preexit(); return; }
    }
    reg u32x4 qv = ldg128_persist(ptr_add(query_bf16, (row * heads + head) * 32 + lane, 16));
    reg f32 qf[8]; reg f32 acc[8];
    unroll (i = 0..4) {
        qf[i * 2] = bf16_lo(qv[i]); qf[i * 2 + 1] = bf16_hi(qv[i]);
        acc[i * 2] = 0.0f; acc[i * 2 + 1] = 0.0f;
    }
    reg f32 rmax = u32_as_f32(0xFF800000); reg f32 rsum = 0.0f;
    gqa_decode_loop(BLOCK_T, kv_view, seq, begin, end, fork, slot_off, kv_head, kvh, tid, lane, qk_scale, s_k, s_v, qf, acc, rmax, rsum);
    if constexpr (IS_SPLIT == 0) {
        gqa_store_gated_row(attn_local, merged_out, row, head, heads, qkv_v, lane, acc, rsum);
    } else {
        gqa_store_split_partial(attn_local, merged_out, partials, row, head, heads, qkv_v, split, begin, end, limit, lane, acc, rmax, rsum);
    }
    preexit();
}

