import "stdlib/math.skl2";

const BLOCK = 256;
const WARPS = 8;

@concept(attention)
kernel[BLOCK, 80] latent_attn_decode_512_64(
    global u32* q_nope_bf16, global u32* q_rope_bf16,
    global u32* kv_nope_bf16, global u32* kv_rope_bf16,
    global u16* out_bf16,
    u32 num_heads, u32 kv_len, f32 scale
) {
    shared f32 smem_max[8];
    shared f32 smem_sum[8];
    shared f32 smem_out[4096];

    reg u32 head = ctaid_x();
    if (head >= num_heads) { return; }

    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    ureg u64 qn_base = ptr_add(q_nope_bf16, head * 32, 32);
    ureg u64 qr_base = ptr_add(q_rope_bf16, head * 4, 32);

    reg u32x8 qn_packed = ldg256_persist(ptr_add(qn_base, lane, 32));
    reg u32 qr_packed = ldg32_persist(ptr_add(qr_base, lane, 4));
    reg f32 slog2 = scale * 1.4426950408889634f;
    reg f32 qn[16];
    unroll (i = 0..8) {
        qn[i * 2] = bf16_lo(qn_packed[i]) * slog2;
        qn[i * 2 + 1] = bf16_hi(qn_packed[i]) * slog2;
    }
    reg f32 qr0 = bf16_lo(qr_packed) * slog2;
    reg f32 qr1 = bf16_hi(qr_packed) * slog2;

    ureg u64 kv_nope_lane = ptr_add(kv_nope_bf16, lane, 32);
    ureg u64 kv_rope_lane = ptr_add(kv_rope_bf16, lane, 4);

    reg f32 acc[16];
    unroll (i = 0..16) { acc[i] = 0.0f; }
    reg f32 m_val = -1.0e30f;
    reg f32 l_val = 0.0f;

    for (reg u32 tok = wid; tok < kv_len; tok += WARPS) {
        reg u32x8 kn = ldg256_stream(ptr_add(kv_nope_lane, tok, 1024));
        reg u32 kr = ldg32_stream(ptr_add(kv_rope_lane, tok, 128));
        reg f32 kv[16];
        unroll (i = 0..8) {
            kv[i * 2] = bf16_lo(kn[i]);
            kv[i * 2 + 1] = bf16_hi(kn[i]);
        }
        reg f32 d0 = fma(qn[0], kv[0], qr0 * bf16_lo(kr));
        reg f32 d1 = fma(qn[1], kv[1], qr1 * bf16_hi(kr));
        reg f32 d2 = qn[2] * kv[2];
        reg f32 d3 = qn[3] * kv[3];
        unroll (g = 1..4) {
            d0 = fma(qn[g * 4], kv[g * 4], d0);
            d1 = fma(qn[g * 4 + 1], kv[g * 4 + 1], d1);
            d2 = fma(qn[g * 4 + 2], kv[g * 4 + 2], d2);
            d3 = fma(qn[g * 4 + 3], kv[g * 4 + 3], d3);
        }
        reg f32 logit = warp_sum((d0 + d1) + (d2 + d3));
        reg f32 m_new = maxf(m_val, logit);
        reg f32 alpha = exp2_ftz(m_val - m_new);
        reg f32 p = exp2_ftz(logit - m_new);
        l_val = fma(l_val, alpha, p);
        m_val = m_new;
        unroll (i = 0..16) { acc[i] *= alpha; }
        unroll (i = 0..16) { acc[i] = fma(p, kv[i], acc[i]); }
    }

    if (lane == 0) {
        sts32(smem_max, wid, m_val);
        sts32(smem_sum, wid, l_val);
    }
    reg u32 sbase = wid * 512 + lane * 16;
    unroll (i = 0..16) { sts32(smem_out, sbase + i, acc[i]); }
    barrier();

    reg u32 tid = tid_x();
    reg f32 gmax = -1.0e30f;
    unroll (w = 0..8) { gmax = maxf(gmax, lds32(smem_max, w)); }
    reg f32 gsum = 0.0f;
    reg f32 o0 = 0.0f;
    reg f32 o1 = 0.0f;
    unroll (w = 0..8) {
        reg f32 mw = lds32(smem_max, w);
        reg f32 lw = lds32(smem_sum, w);
        reg f32 wt = exp2_ftz(mw - gmax);
        gsum = fma(lw, wt, gsum);
        o0 = fma(lds32(smem_out, w * 512 + tid), wt, o0);
        o1 = fma(lds32(smem_out, w * 512 + 256 + tid), wt, o1);
    }
    reg f32 inv_l = rcp(gsum);
    ureg u64 obase = ptr_add(out_bf16, head * 512, 2);
    stg16(ptr_add(obase, tid, 2), f32_to_bf16(o0 * inv_l));
    stg16(ptr_add(obase, 256 + tid, 2), f32_to_bf16(o1 * inv_l));
}

macro gqa_gate_pair(a0, a1, denom, inv_d, gate_word, out_word) {
    reg f32 q0 = 0.0f;
    reg f32 q1 = 0.0f;
    div_nr1_f32(a0, denom, inv_d, q0);
    div_nr1_f32(a1, denom, inv_d, q1);
    reg f32 r0 = bf16_lo(f32_to_bf16(q0));
    reg f32 r1 = bf16_lo(f32_to_bf16(q1));
    reg f32 s0 = 0.0f;
    reg f32 s1 = 0.0f;
    sigmoid_exact_f32(bf16_lo(gate_word), s0);
    sigmoid_exact_f32(bf16_hi(gate_word), s1);
    out_word = pack_bf16x2(r0 * s0, r1 * s1);
}

@pdl
@concept(attention)
template kernel[BLOCK, 64] gqa_split_reduce_tpl<IS_GEN>(
    global u32* partials_f32, global u32* attn_local_bf16,
    global u32* sequence_of_row, global u32* context_length,
    global u32* row_position, global u32* merged_out_bf16,
    u32 rows,
    if (IS_GEN == 1) u32 heads_in,
    if (IS_GEN == 1) u32 qkv_v_in
) {
    acqbulk();
    reg u32 heads = 24; reg u32 qkv_v = 1792;
    if constexpr (IS_GEN == 1) { heads = heads_in; qkv_v = qkv_v_in; }
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 head = ctaid_x() * 8 + wid;
    reg u32 row = ctaid_y();
    if (row >= rows || head >= heads) {
        preexit();
        return;
    }
    reg u32 seq = ldg32_persist(ptr_add(sequence_of_row, row, 4));
    reg u32 limit = ldg32_persist(ptr_add(context_length, seq, 4));
    reg u32 rp_nz = row_position[0] | row_position[1];
    if (rp_nz != 0) {
        reg u32 rp = ldg32_persist(ptr_add(row_position, row, 4));
        if (rp != 0xFFFFFFFF && rp + 1 < limit) {
            limit = rp + 1;
        }
    }
    if (limit <= 64) {
        preexit();
        return;
    }
    reg u32 slen = ((((limit + 767) >> 8) * 21846) >> 16) << 6;
    if (slen >= limit) {
        preexit();
        return;
    }
    reg f32 gmax = u32_as_f32(0xFF800000);
    reg f32 gsum = 0.0f;
    reg f32 acc[8];
    unroll (i = 0..8) { acc[i] = 0.0f; }
    reg u32 lane8 = lane << 3;
    for (reg u32 s = 0; s < 12; s += 1) {
        if (s * slen < limit) {
            reg u32 in_base = ((row * 12 + s) * heads + head) * 260;
            reg f32 sm = u32_as_f32(ldg32_stream(ptr_add(partials_f32, in_base + 256, 4)));
            reg f32 sl = u32_as_f32(ldg32_stream(ptr_add(partials_f32, in_base + 257, 4)));
            reg f32 prev = gmax;
            gmax = maxf(prev, sm);
            reg f32 sc_old = 0.0f;
            if (f32_as_u32(prev) != 0xFF800000) { sc_old = exp2_ftz((prev - gmax) * 1.4426950408889634f); }
            reg f32 sc_new = 0.0f;
            if (f32_as_u32(sm) != 0xFF800000) { sc_new = exp2_ftz((sm - gmax) * 1.4426950408889634f); }
            gsum = fma(gsum, sc_old, sl * sc_new);
            reg u32x4 a0 = ldg128_stream(ptr_add(partials_f32, in_base + lane8, 4));
            reg u32x4 a1 = ldg128_stream(ptr_add(partials_f32, in_base + lane8 + 4, 4));
            unroll (k = 0..4) {
                acc[k] = fma(acc[k], sc_old, u32_as_f32(a0[k]) * sc_new);
                acc[4 + k] = fma(acc[4 + k], sc_old, u32_as_f32(a1[k]) * sc_new);
            }
        }
    }
    reg f32 denom = maxf(gsum, 1.0e-20f);
    reg f32 inv_d = 0.0f;
    rcp_nr1_f32(denom, inv_d);
    reg u32x4 gv = ldg128_stream(ptr_add(attn_local_bf16, row * qkv_v + (head * 2 + 1) * 32 + lane, 16));
    unroll (k = 0..4) {
        gqa_gate_pair(acc[k * 2], acc[k * 2 + 1], denom, inv_d, gv[k], gv[k]);
    }
    stg128(ptr_add(merged_out_bf16, (row * heads + head) * 32 + lane, 16), gv);
    preexit();
}

instantiate gqa_split_reduce_tpl<0> as gqa_split_reduce_sigmoid_gate_pdl_exact_bf16;
instantiate gqa_split_reduce_tpl<1> as qwen_gqa_split_reduce_gate_gen;

macro plan_read_u32(plan, base_off, idx, out_val) {
    out_val = param_u32(plan, base_off);
    unroll (i = 1..64) {
        out_val = (idx == i) ? param_u32(plan, base_off + i * 4) : out_val;
    }
}

macro attn_norm_rope_head256(v, norm_w, rope_smem, wid, lane, pos_f, rounded_rope, out_v) {
    reg f32 sq = 0.0f;
    unroll (k = 0..4) {
        reg f32 x0 = bf16_lo(v[k]);
        reg f32 x1 = bf16_hi(v[k]);
        sq = fma(x0, x0, sq);
        sq = fma(x1, x1, sq);
    }
    reg f32 total = warp_sum(sq);
    reg f32 scale = rsqrt(fma(total, 0.00390625f, 1.0e-6f));
    reg u32x8 wv = ldg256_persist(ptr_add(norm_w, lane, 32));
    unroll (k = 0..4) {
        reg f32 y0 = bf16_lo(v[k]) * scale * u32_as_f32(wv[k * 2]);
        reg f32 y1 = bf16_hi(v[k]) * scale * u32_as_f32(wv[k * 2 + 1]);
        out_v[k] = pack_bf16x2(y0, y1);
    }
    reg u32 rbase = wid << 6;
    if (lane < 8) {
        unroll (k = 0..4) {
            sts32(rope_smem, rbase + (lane << 3) + k * 2, out_v[k] & 0xFFFF);
            sts32(rope_smem, rbase + (lane << 3) + k * 2 + 1, out_v[k] >> 16);
        }
    }
    rbase = shfl_idx(rbase, 0);
    reg f32 angle = pos_f * exp2_ftz(u32_to_f32(lane) * -0.7266717707566105f);
    reg f32 sv = 0.0f; reg f32 cv = 0.0f;
    sincos_pos_f32(angle, sv, cv);
    reg f32 a = bf16_lo(lds32(rope_smem, rbase + lane));
    reg f32 b = bf16_lo(lds32(rope_smem, rbase + 32 + lane));
    if (rounded_rope != 0) {
        reg f32 cb = bf16_lo(f32_to_bf16(cv));
        reg f32 sb = bf16_lo(f32_to_bf16(sv));
        sts32(rope_smem, rbase + lane, f32_to_bf16(bf16_lo(f32_to_bf16(a * cb)) + bf16_lo(f32_to_bf16((-b) * sb))));
        sts32(rope_smem, rbase + 32 + lane, f32_to_bf16(bf16_lo(f32_to_bf16(b * cb)) + bf16_lo(f32_to_bf16(a * sb))));
    } else {
        sts32(rope_smem, rbase + lane, f32_to_bf16((a * cv) - (b * sv)));
        sts32(rope_smem, rbase + 32 + lane, f32_to_bf16((a * sv) + (b * cv)));
    }
    rbase = shfl_idx(rbase, 0);
    if (lane < 8) {
        unroll (k = 0..4) {
            reg u32 p0 = lds32(rope_smem, rbase + (lane << 3) + k * 2);
            reg u32 p1 = lds32(rope_smem, rbase + (lane << 3) + k * 2 + 1);
            out_v[k] = pack_u16x2(p0, p1);
        }
    }
}

macro attn_load_vec8_gen(gathered, rows, row, attn_rows_v, logical_v, tp_deg, rank_heads_flag, q2_v, kv_v, out_v) {
    if (tp_deg <= 1) {
        out_v = ldg128_stream(ptr_add(gathered, row * attn_rows_v + logical_v, 16));
    } else if (rank_heads_flag != 0) {
        reg u32 q_rv = 0; reg u32 kv_rv = 0; reg u32 tmp_r = 0;
        u32_divmod(q2_v, tp_deg, q_rv, tmp_r);
        u32_divmod(kv_v, tp_deg, kv_rv, tmp_r);
        reg u32 rk = 0; reg u32 el = 0;
        if (logical_v < q2_v) {
            u32_divmod(logical_v, q_rv, rk, el);
        } else if (logical_v < q2_v + kv_v) {
            u32_divmod(logical_v - q2_v, kv_rv, rk, el);
            el = q_rv + el;
        } else {
            u32_divmod(logical_v - q2_v - kv_v, kv_rv, rk, el);
            el = q_rv + kv_rv + el;
        }
        out_v = ldg128_stream(ptr_add(gathered, (rk * rows + row) * attn_rows_v + el, 16));
    } else {
        reg u32 rk = 0; reg u32 el = 0;
        u32_divmod(logical_v, attn_rows_v, rk, el);
        out_v = ldg128_stream(ptr_add(gathered, (rk * rows + row) * attn_rows_v + el, 16));
    }
}

macro attn_prep_load_kv_mode(IS_LOCAL, IS_V, gathered, rows, row, attn_rows_v, q2_v, kv_v, tp_deg, flags, gather_mode, h_idx, lane, out_v) {
    if (gather_mode != 0) {
        reg u32 kv_rv = 0; reg u32 tr = 0; u32_divmod(kv_v, tp_deg, kv_rv, tr);
        reg u32 rk = 0; reg u32 el = 0; u32_divmod((h_idx << 5) + lane, kv_rv, rk, el);
        if constexpr (IS_LOCAL == 1) {
            out_v = ldg128_stream(ptr_add(gathered, (rk * rows + row) * (kv_rv << 1) + (IS_V * kv_rv) + el, 16));
        } else {
            reg u32 q_rv = 0; u32_divmod(q2_v >> 1, tp_deg, q_rv, tr);
            out_v = ldg128_stream(ptr_add(gathered, (rk * rows + row) * (q_rv + (kv_rv << 1)) + q_rv + (IS_V * kv_rv) + el, 16));
        }
    } else {
        attn_load_vec8_gen(gathered, rows, row, attn_rows_v, q2_v + (IS_V * kv_v) + (h_idx << 5) + lane, tp_deg, flags & 1, q2_v, kv_v, out_v);
    }
}

macro attn_prep_load_q_mode(IS_LOCAL, IS_GEN, attn_local, gathered, rows, row, attn_rows_v, q2_v, kv_v, tp_deg, flags, gather_mode, task, h, lane, out_v) {
    if constexpr (IS_GEN == 0) {
        out_v = ldg128_stream(ptr_add(gathered, row * attn_rows_v + (h << 6) + lane, 16));
    } else if constexpr (IS_LOCAL == 1) {
        if (gather_mode != 0) { out_v = ldg128_stream(ptr_add(attn_local, row * attn_rows_v + (task << 6) + lane, 16)); }
        else { attn_load_vec8_gen(gathered, rows, row, attn_rows_v, (h << 6) + lane, tp_deg, flags & 1, q2_v, kv_v, out_v); }
    } else if (gather_mode != 0) {
        reg u32 q_rv = 0; reg u32 kv_rv = 0; reg u32 tr = 0;
        u32_divmod(q2_v >> 1, tp_deg, q_rv, tr); u32_divmod(kv_v, tp_deg, kv_rv, tr);
        reg u32 rk = 0; reg u32 el = 0; u32_divmod((h << 5) + lane, q_rv, rk, el);
        out_v = ldg128_stream(ptr_add(gathered, (rk * rows + row) * (q_rv + (kv_rv << 1)) + el, 16));
    } else {
        attn_load_vec8_gen(gathered, rows, row, attn_rows_v, (h << 6) + lane, tp_deg, flags & 1, q2_v, kv_v, out_v);
    }
}

macro attn_prep_kv_task(IS_LOCAL, IS_GEN, IS_V, gathered, k_norm, kv_cur, slot, ok, rows, row, attn_rows_v, q2_v, kv_v, tp_deg, flags, gather_mode, rounded_rope, pos_f, h_idx, kv_first, local_kvh, rope_smem, wid, lane) {
    reg u32 need = 0;
    if constexpr (IS_LOCAL == 1) { if (h_idx >= kv_first && h_idx < kv_first + local_kvh) { need = 1; } }
    if ((ok | need) != 0) {
        reg u32x4 v = pack_u32x4(0, 0, 0, 0);
        if constexpr (IS_GEN == 0) { v = ldg128_stream(ptr_add(gathered, row * attn_rows_v + q2_v + (IS_V * kv_v) + (h_idx << 5) + lane, 16)); }
        else { attn_prep_load_kv_mode(IS_LOCAL, IS_V, gathered, rows, row, attn_rows_v, q2_v, kv_v, tp_deg, flags, gather_mode, h_idx, lane, v); }
        if constexpr (IS_V == 0) {
            reg u32x4 k_out = pack_u32x4(0, 0, 0, 0);
            attn_norm_rope_head256(v, k_norm, rope_smem, wid, lane, pos_f, rounded_rope, k_out);
            v = k_out;
        }
        if (ok != 0) { stg128(ptr_add(slot, (IS_V * kv_v) + (h_idx << 5) + lane, 16), v); }
        if constexpr (IS_LOCAL == 1) {
            if (need != 0) { stg128(ptr_add(kv_cur, (((h_idx - kv_first) * rows + row) * 2 + IS_V) * 32 + lane, 16), v); }
        }
    }
}

macro attn_prep_gate_slice(IS_GEN, gathered, merged_gate, rows, row, attn_rows_v, tp_rank, attn_width, h, lane, tp_deg, flags, gather_mode, q2_v, kv_v) {
    if constexpr (IS_GEN == 1) {
        reg u32 gb_v = (tp_rank * attn_width) >> 3; reg u32 aw_v = attn_width >> 3; reg u32 gv_i = (h << 5) + lane;
        if (tp_deg > 1 && gather_mode == 0) {
            if (gv_i >= gb_v && gv_i < gb_v + aw_v) {
                reg u32x4 gv = pack_u32x4(0, 0, 0, 0);
                attn_load_vec8_gen(gathered, rows, row, attn_rows_v, ((h * 2 + 1) << 5) + lane, tp_deg, flags & 1, q2_v, kv_v, gv);
                stg128(ptr_add(merged_gate, row * aw_v + (gv_i - gb_v), 16), gv);
            }
        }
    }
}

@pdl
@concept(attention)
template kernel[BLOCK, 88] qwen_attn_prep_tpl<IS_LOCAL, IS_GEN>(
    if (IS_LOCAL == 1) global u32* attn_local,
    global u32* gathered, global u32* q_norm, global u32* k_norm,
    global u32* positions,
    if (IS_LOCAL == 0) global u32* store_positions,
    global u32* sequence_of_row, blob[56, 8] kv_view,
    global u32* attn_query, global u32* merged_gate,
    if (IS_LOCAL == 1) global u32* kv_cur,
    u32 rows, u32 attn_rows, u32 tp_rank, u32 attn_width,
    if (IS_LOCAL == 1) u32 q_first,
    if (IS_LOCAL == 1) u32 rank_heads,
    if (IS_LOCAL == 1) u32 kv_first,
    if (IS_LOCAL == 1) u32 local_kvh,
    if (IS_GEN == 1) u32 heads_in,
    if (IS_GEN == 1) u32 kv_heads_in,
    if (IS_GEN == 1) u32 tp_deg_in,
    if (IS_GEN == 1) u32 flags_in
) {
    shared u32 rope_smem[512];
    acqbulk();
    reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u32 task = ctaid_x() * 8 + wid; reg u32 row = ctaid_y();
    reg u32 heads = 24; reg u32 kvh = 4; reg u32 tp_deg = 1; reg u32 flags = 4;
    if constexpr (IS_GEN == 1) { heads = heads_in; kvh = kv_heads_in; tp_deg = tp_deg_in; flags = flags_in; }
    reg u32 nq = heads;
    if constexpr (IS_LOCAL == 1) { nq = rank_heads; }
    if (task >= nq + (kvh << 1) || row >= rows) { preexit(); return; }
    reg u32 attn_rows_v = attn_rows >> 3;
    reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
    reg f32 pos_f = u32_to_f32(pos);
    reg u32 q2_v = heads << 6; reg u32 kv_v = kvh << 5;
    reg u32 gather_mode = (flags >> 1) & 1;
    reg u32 rounded_rope = (flags >> 2) & 1;
    if (task < nq) {
        reg u32 h = task;
        if constexpr (IS_LOCAL == 1) { h = q_first + task; }
        reg u32x4 qv = pack_u32x4(0, 0, 0, 0);
        if constexpr (IS_LOCAL == 1) { attn_prep_load_q_mode(1, IS_GEN, attn_local, gathered, rows, row, attn_rows_v, q2_v, kv_v, tp_deg, flags, gather_mode, task, h, lane, qv); }
        else { attn_prep_load_q_mode(0, IS_GEN, gathered, gathered, rows, row, attn_rows_v, q2_v, kv_v, tp_deg, flags, gather_mode, task, h, lane, qv); }
        reg u32x4 q_out = pack_u32x4(0, 0, 0, 0);
        attn_norm_rope_head256(qv, q_norm, rope_smem, wid, lane, pos_f, rounded_rope, q_out);
        stg128(ptr_add(attn_query, (row * nq + task) * 32 + lane, 16), q_out);
        attn_prep_gate_slice(IS_GEN, gathered, merged_gate, rows, row, attn_rows_v, tp_rank, attn_width, h, lane, tp_deg, flags, gather_mode, q2_v, kv_v);
        preexit();
        return;
    }
    reg u32 store_pos = pos;
    if constexpr (IS_LOCAL == 0) { store_pos = ldg32_persist(ptr_add(store_positions, row, 4)); }
    reg u32 seq = ldg32_persist(ptr_add(sequence_of_row, row, 4));
    reg u64 slot = 0; reg u32 ok = 0;
    kv_shard_slot_addr(kv_view, seq, store_pos, kvh << 10, slot, ok);
    if (task < nq + kvh) {
        if constexpr (IS_LOCAL == 1) { attn_prep_kv_task(1, IS_GEN, 0, gathered, k_norm, kv_cur, slot, ok, rows, row, attn_rows_v, q2_v, kv_v, tp_deg, flags, gather_mode, rounded_rope, pos_f, task - nq, kv_first, local_kvh, rope_smem, wid, lane); }
        else { attn_prep_kv_task(0, IS_GEN, 0, gathered, k_norm, attn_query, slot, ok, rows, row, attn_rows_v, q2_v, kv_v, tp_deg, flags, gather_mode, rounded_rope, pos_f, task - nq, 0, 0, rope_smem, wid, lane); }
    } else {
