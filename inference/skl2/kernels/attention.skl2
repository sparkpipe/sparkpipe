@pdl
@concept(attention)
template kernel[BLOCK, 48] qwen_pack_local_attn_tpl<IS_QKV>(
    global u32* attn_local, global u32* dst_send,
    u32 rows, u32 attn_rows, u32 first_v, u32 kv_local_v
) {
    acqbulk();
    reg u32 attn_rows_v = attn_rows >> 3;
    reg u32 pack_v = kv_local_v;
    if constexpr (IS_QKV == 1) { pack_v = first_v + kv_local_v; }
    reg u32 total = rows * pack_v;
    reg u32 stride = grid_x() * BLOCK;
    for (reg u32 idx = ctaid_x() * BLOCK + tid_x(); idx < total; idx += stride) {
        reg u32 r = 0; reg u32 c = 0;
        u32_divmod(idx, pack_v, r, c);
        reg u32 src_c = first_v + c;
        if constexpr (IS_QKV == 1) {
            if (c < first_v) { src_c = ((c >> 5) << 6) + (c & 31); }
            else { src_c = (first_v << 1) + (c - first_v); }
        }
        stg128(ptr_add(dst_send, idx, 16), ldg128_persist(ptr_add(attn_local, r * attn_rows_v + src_c, 16)));
    }
    preexit();
}

