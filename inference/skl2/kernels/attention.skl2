@pdl
@concept(attention)
template kernel[BLOCK, 48] qwen_prior_kv_direct_tpl<IS_GEN>(
    blob[56, 8] kv_view, global u32* sequence_of_row, blob[1804, 4] plan,
    u32 kv_first, u32 local_kvh, global u32* kv_prior,
