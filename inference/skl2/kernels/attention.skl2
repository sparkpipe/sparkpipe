macro prior_kv_peer_pos(plan, idx, rank_v, degree, grain, s, out_pos, out_ok) {
    out_ok = 0; out_pos = 0;
    reg u32 pkeys = 0; reg u32 old_ctx = 0;
    plan_read_u32(plan, 1548, s, pkeys);
    plan_read_u32(plan, 780, s, old_ctx);
    reg u32 qg = 0; reg u32 rg = 0;
    u32_divmod(idx, grain, qg, rg);
    out_pos = (rank_v + qg * degree) * grain + rg;
    if (idx < pkeys && out_pos < old_ctx) { out_ok = 1; }
}

@pdl
@concept(attention)
kernel[BLOCK, 64] qwen_prior_kv_pack_gen(
    blob[56, 8] kv_view, global u32* sequence_of_row, blob[1804, 4] plan,
    u32 attn_width, u32 group, u32 local_kvh, u64 a2a_stride_bytes,
    global u32* send_bytes, u32 kv_heads
) {
    acqbulk();
