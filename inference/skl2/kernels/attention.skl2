                stg128(ptr_add(peer_dst, kd + lane, 16), ldg128_persist(ptr_add(slot, (kh << 5) + lane, 16)));
                stg128(ptr_add(peer_dst, kd + 32 + lane, 16), ldg128_persist(ptr_add(slot, ((kv_heads + kh) << 5) + lane, 16)));
            }
        }
    }
    preexit();
}

@pdl
@concept(attention)
kernel[BLOCK, 56] qwen_prior_kv_unpack_gen(
    u32 degree, u32 grain, global u32* recv_bytes, u64 a2a_stride_bytes,
    blob[1804, 4] plan, u32 local_kvh, global u32* kv_prior
) {
    acqbulk();
    reg u32 idx = ctaid_x() * 8 + warp_id(); reg u32 lane = lane_id();
    reg u32 src_rank = ctaid_y(); reg u32 s = ctaid_z();
    if (s >= param_u32(plan, 0) || src_rank >= degree) { preexit(); return; }
    reg u32 pos = 0; reg u32 pok = 0;
    prior_kv_peer_pos(plan, idx, src_rank, degree, grain, s, pos, pok);
    if (pok != 0) {
        reg u32 total_prior = param_u32(plan, 4); reg u32 total_peer = param_u32(plan, 8);
        reg u32 prior_off = 0; reg u32 peer_off = 0;
        plan_read_u32(plan, 1036, s, prior_off);
        plan_read_u32(plan, 1292, s, peer_off);
