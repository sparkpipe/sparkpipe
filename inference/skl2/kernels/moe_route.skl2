instantiate moe_nvfp4_skinny_w1w3_tpl<1, 8, 168> as moe_nvfp4_skinny_w1w3_batched_l8;
instantiate moe_nvfp4_skinny_w1w3_tpl<1, 16, 168> as moe_nvfp4_skinny_w1w3_batched_l16;
instantiate moe_nvfp4_skinny_w1w3_tpl<1, 32, 168> as moe_nvfp4_skinny_w1w3_batched_l32;

macro moe_nvfp4_w2_n4_one(LANES, w_base, s_base, glob, act_row, out, p_row, chunks, n_dim, n0, sub) {
    reg f32 acc[4];
    unroll (k = 0..4) { acc[k] = 0.0f; }
    for (reg u32 c = sub; c < chunks; c += LANES) {
        reg u32x4 a0 = ldg128_persist(ptr_add(act_row, c << 2, 16));
        reg u32x4 a1 = ldg128_persist(ptr_add(act_row, (c << 2) + 1, 16));
        reg u32x4 a2 = ldg128_persist(ptr_add(act_row, (c << 2) + 2, 16));
        reg u32x4 a3 = ldg128_persist(ptr_add(act_row, (c << 2) + 3, 16));
        unroll (k = 0..4) {
            if (n0 + k < n_dim) {
                reg u32x4 vw = ldg128_stream(ptr_add(w_base, k * chunks + c, 16));
                reg u32 sr = ldg16_persist(ptr_add(s_base, k * chunks + c, 2));
                reg f32 sc0 = 0.0f; reg f32 sc1 = 0.0f;
                nvfp4_ue4m3_decode(sr, glob, sc0); nvfp4_ue4m3_decode(sr >> 8, glob, sc1);
                reg f32 d0 = 0.0f; reg f32 d1 = 0.0f;
                nvfp4_e2m1_dot16(vw[0], vw[1], a0, a1, d0);
                nvfp4_e2m1_dot16(vw[2], vw[3], a2, a3, d1);
                acc[k] = fma(sc1, d1, fma(sc0, d0, acc[k]));
            }
        }
    }
    unroll (k = 0..4) { lanes_reduce_sum(LANES, acc[k]); }
    if (sub == 0) {
        unroll (k = 0..4) {
            if (n0 + k < n_dim) { stg16(ptr_add(out, p_row * n_dim + n0 + k, 2), f32_to_bf16(acc[k])); }
        }
    }
}

macro moe_nvfp4_w2_n1_batch4(LANES, wk, sk, glob, act, out, first, cnt, chunks, n_dim, col, sub) {
    reg u64 pa[4]; reg f32 acc[4];
    unroll (r = 0..4) {
        pa[r] = ptr_add(act, ((r < cnt) ? (first + r) : first) * (chunks << 2), 16);
        acc[r] = 0.0f;
    }
    for (reg u32 c = sub; c < chunks; c += LANES) {
        reg u32x4 vw = ldg128_stream(ptr_add(wk, c, 16));
        reg u32 sr = ldg16_persist(ptr_add(sk, c, 2));
        reg f32 sc0 = 0.0f; reg f32 sc1 = 0.0f;
        nvfp4_ue4m3_decode(sr, glob, sc0); nvfp4_ue4m3_decode(sr >> 8, glob, sc1);
        unroll (r = 0..4) {
            reg u32x4 a0 = ldg128_persist(ptr_add(pa[r], c << 2, 16));
            reg u32x4 a1 = ldg128_persist(ptr_add(pa[r], (c << 2) + 1, 16));
            reg f32 d0 = 0.0f;
            nvfp4_e2m1_dot16(vw[0], vw[1], a0, a1, d0);
            acc[r] = fma(sc0, d0, acc[r]);
            reg u32x4 a2 = ldg128_persist(ptr_add(pa[r], (c << 2) + 2, 16));
            reg u32x4 a3 = ldg128_persist(ptr_add(pa[r], (c << 2) + 3, 16));
            reg f32 d1 = 0.0f;
            nvfp4_e2m1_dot16(vw[2], vw[3], a2, a3, d1);
            acc[r] = fma(sc1, d1, acc[r]);
        }
    }
    unroll (r = 0..4) { lanes_reduce_sum(LANES, acc[r]); }
    if (sub == 0) {
        unroll (r = 0..4) {
            if (r < cnt) { stg16(ptr_add(out, (first + r) * n_dim + col, 2), f32_to_bf16(acc[r])); }
        }
    }
}

macro moe_nvfp4_w2_n4_batch4(LANES, wb, sb, glob, act, output, first, cnt, chunks, n_dim, n0, sub) {
    for (reg u32 k = 0; k < 4; k += 1) {
        if (n0 + k < n_dim) {
            moe_nvfp4_w2_n1_batch4(LANES, ptr_add(wb, k * chunks, 16), ptr_add(sb, k * chunks, 2), glob, act, output, first, cnt, chunks, n_dim, n0 + k, sub);
        }
    }
}

@pdl
@concept(moe)
template kernel[MOE_BLK256, REGS] moe_nvfp4_skinny_w2_tpl<IS_BATCHED, LANES, REGS>(
    global u32* w2, global u8* w2_scale_blob, global u32* act, global u32* group_row_offset,
    if (IS_BATCHED == 0) global u32* packed_expert,
    global u32* output, u32 k_dim, u32 n_dim, u32 groups
) {
    acqbulk();
    reg u32 chunks = k_dim >> 5;
    reg u32 tid = tid_x();
    reg u32 n0 = (ctaid_x() * (MOE_BLK256 / LANES) + (tid >> ((LANES == 32) ? 5 : ((LANES == 16) ? 4 : 3)))) << 2;
    reg u32 sub = tid & (LANES - 1);
    reg u32 by = ctaid_y();
    if constexpr (IS_BATCHED == 0) {
        if (by >= ldg32_persist(ptr_add(group_row_offset, groups, 4)) || n0 >= n_dim) { preexit(); return; }
        reg u32 grp = ldg32_persist(ptr_add(packed_expert, by, 4));
        reg u32 off0 = (grp * n_dim + n0) * chunks;
        reg u64 wb = ptr_add(w2, off0, 16);
        reg u64 sb = ptr_add(ptr_add(w2_scale_blob, groups, 4), off0, 2);
        reg f32 glob = u32_as_f32(ldg32_persist(ptr_add(w2_scale_blob, grp, 4)));
        moe_nvfp4_w2_n4_one(LANES, wb, sb, glob, ptr_add(act, by * (chunks << 2), 16), output, by, chunks, n_dim, n0, sub);
    } else {
        reg u32 beg = ldg32_persist(ptr_add(group_row_offset, by, 4));
        reg u32 end = ldg32_persist(ptr_add(group_row_offset, by + 1, 4));
        if (beg >= end || n0 >= n_dim) { preexit(); return; }
        reg u32 off0 = (by * n_dim + n0) * chunks;
        reg u64 wb = ptr_add(w2, off0, 16);
        reg u64 sb = ptr_add(ptr_add(w2_scale_blob, groups, 4), off0, 2);
        reg f32 glob = u32_as_f32(ldg32_persist(ptr_add(w2_scale_blob, by, 4)));
        for (reg u32 first = beg; first < end; first += 4) {
            reg u32 cnt = (end - first < 4) ? (end - first) : 4;
            if (cnt == 1) {
                moe_nvfp4_w2_n4_one(LANES, wb, sb, glob, ptr_add(act, first * (chunks << 2), 16), output, first, chunks, n_dim, n0, sub);
            } else {
                moe_nvfp4_w2_n4_batch4(LANES, wb, sb, glob, act, output, first, cnt, chunks, n_dim, n0, sub);
            }
        }
    }
    preexit();
}

instantiate moe_nvfp4_skinny_w2_tpl<0, 8, 96> as moe_nvfp4_skinny_w2_single_l8;
instantiate moe_nvfp4_skinny_w2_tpl<0, 16, 96> as moe_nvfp4_skinny_w2_single_l16;
instantiate moe_nvfp4_skinny_w2_tpl<0, 32, 96> as moe_nvfp4_skinny_w2_single_l32;
instantiate moe_nvfp4_skinny_w2_tpl<1, 8, 144> as moe_nvfp4_skinny_w2_batched_l8;
instantiate moe_nvfp4_skinny_w2_tpl<1, 16, 144> as moe_nvfp4_skinny_w2_batched_l16;
instantiate moe_nvfp4_skinny_w2_tpl<1, 32, 144> as moe_nvfp4_skinny_w2_batched_l32;
