import "stdlib/math.skl2";

const D41W_BLK256 = 256;
const D41W_BLK64 = 64;
const D41W_LATENT = 512;
const D41W_RECORD = 514;
const D41W_NO_ROW = 0xFFFFFFFF;
const D41W_NEG_INF = 0xFF800000;
const D41W_LOG2E = 1.4426950408889634f;
const D41W_ROPE_PAIRS = 32;

macro d41w_exp_fast(x, out_e) {
    out_e = exp2_ftz(x * D41W_LOG2E);
}

macro d41w_round_bf16(v, out_f) {
    out_f = bf16_lo(f32_to_bf16(v));
}

macro d41w_fp8_qdq8(v0, v1, v2, v3, v4, v5, v6, v7, out_u4) {
    reg f32 am = maxf(maxf(fabsf(v0), fabsf(v1)), maxf(fabsf(v2), fabsf(v3)));
    am = maxf(am, maxf(maxf(fabsf(v4), fabsf(v5)), maxf(fabsf(v6), fabsf(v7))));
    am = maxf(am, shfl_xor(am, 1));
    am = maxf(am, shfl_xor(am, 2));
    reg u32 sbits = pow2_ceil_e8m0_bits(maxf(am, 1.0e-4f)) << 23;
    reg f32 sc = u32_as_f32(sbits);
    reg f32 inv = u32_as_f32(0x7F000000 - sbits);
    reg u32 p0 = cvt_f32x2_e4m3x2(minf(maxf(v0 * inv, -448.0f), 448.0f), minf(maxf(v1 * inv, -448.0f), 448.0f));
    reg u32 p1 = cvt_f32x2_e4m3x2(minf(maxf(v2 * inv, -448.0f), 448.0f), minf(maxf(v3 * inv, -448.0f), 448.0f));
    reg u32 p2 = cvt_f32x2_e4m3x2(minf(maxf(v4 * inv, -448.0f), 448.0f), minf(maxf(v5 * inv, -448.0f), 448.0f));
    reg u32 p3 = cvt_f32x2_e4m3x2(minf(maxf(v6 * inv, -448.0f), 448.0f), minf(maxf(v7 * inv, -448.0f), 448.0f));
    reg f32x4 d0 = cvt_e4m3x4_f32x4(p0 | (p1 << 16));
    reg f32x4 d1 = cvt_e4m3x4_f32x4(p2 | (p3 << 16));
    out_u4 = pack_u32x4(
        pack_bf16x2(d0[0] * sc, d0[1] * sc),
        pack_bf16x2(d0[2] * sc, d0[3] * sc),
        pack_bf16x2(d1[0] * sc, d1[1] * sc),
        pack_bf16x2(d1[2] * sc, d1[3] * sc)
    );
}

macro d41w_fp8_quant8(v0, v1, v2, v3, v4, v5, v6, v7, out_c0, out_c1, out_exp) {
    reg f32 am = maxf(maxf(fabsf(v0), fabsf(v1)), maxf(fabsf(v2), fabsf(v3)));
    am = maxf(am, maxf(maxf(fabsf(v4), fabsf(v5)), maxf(fabsf(v6), fabsf(v7))));
    am = maxf(am, shfl_xor(am, 1));
    am = maxf(am, shfl_xor(am, 2));
    reg u32 sbits = pow2_ceil_e8m0_bits(maxf(am, 1.0e-4f)) << 23;
    reg f32 inv = u32_as_f32(0x7F000000 - sbits);
    reg u32 p0 = cvt_f32x2_e4m3x2(minf(maxf(v0 * inv, -448.0f), 448.0f), minf(maxf(v1 * inv, -448.0f), 448.0f));
    reg u32 p1 = cvt_f32x2_e4m3x2(minf(maxf(v2 * inv, -448.0f), 448.0f), minf(maxf(v3 * inv, -448.0f), 448.0f));
    reg u32 p2 = cvt_f32x2_e4m3x2(minf(maxf(v4 * inv, -448.0f), 448.0f), minf(maxf(v5 * inv, -448.0f), 448.0f));
    reg u32 p3 = cvt_f32x2_e4m3x2(minf(maxf(v6 * inv, -448.0f), 448.0f), minf(maxf(v7 * inv, -448.0f), 448.0f));
    out_c0 = p0 | (p1 << 16);
    out_c1 = p2 | (p3 << 16);
    out_exp = (sbits >> 23) & 0xFF;
}

macro d41w_fp8_qdq_lane(val_f, out_bf16) {
    fp8_e4m3_qdq_lane_bf16(val_f, out_bf16);
}

macro d41w_window_key_ptr(wave_kv, slot_ring, lane_rows, wave_first, window, at, out_ptr) {
    if (at >= wave_first) {
        reg u32 wr = ldg32_persist(ptr_add(lane_rows, at - wave_first, 4));
        out_ptr = ptr_add(wave_kv, wr, D41W_LATENT << 1);
    } else {
        reg u32 qm = 0; reg u32 rm = 0;
        u32_divmod(at, window, qm, rm);
        out_ptr = ptr_add(slot_ring, rm, D41W_LATENT << 1);
    }
}

macro d41w_ring_store_row_w1(wave_kv, ring, positions, row_lane, row_ordinal, seq_row_begin, rec_slot, ring_slot_stride, ring_rows, window, rows, commit, row, tid) {
    if (commit != 0 && row < rows) {
        reg u32 ln = ldg32_persist(ptr_add(row_lane, row, 4));
        reg u32 cnt = ldg32_persist(ptr_add(seq_row_begin, ln + 1, 4)) - ldg32_persist(ptr_add(seq_row_begin, ln, 4));
        reg u32 ord = ldg32_persist(ptr_add(row_ordinal, row, 4));
        if (ord < cnt && ord + window >= cnt) {
            reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
            reg u32 rslot = ldg32_persist(ptr_add(rec_slot, ln, 4));
            reg u32 qm = 0; reg u32 rm = 0;
            u32_divmod(pos, ring_rows, qm, rm);
            reg u64 dst = ptr_add(ptr_add(ring, rslot, ring_slot_stride[0] << 1), rm, D41W_LATENT << 1);
            reg u64 src = ptr_add(wave_kv, row, D41W_LATENT << 1);
            if (tid < 64) {
                stg128(ptr_add(dst, tid, 16), ldg128_stream(ptr_add(src, tid, 16)));
            }
        }
    }
}

macro d41w_comp_norm_store(s_val, s_red, norm, pooled, ss, row, width, norm_eps, wid, lane, tid) {
    reg f32 tot = 0.0f;
    block_reduce_sum_exact(ss, s_red, wid, lane, tot);
    reg f32 sc = 0.0f;
    rsqrt_exact_div(tot, u32_to_f32(width), norm_eps, sc);
    reg u64 dst = ptr_add(pooled, row, width << 1);
    for (reg u32 c = tid; c < width; c += 256) {
        reg f32 wv = bf16_lo(ldg16_persist(ptr_add(norm, c, 2)));
        stg16(ptr_add(dst, c, 2), f32_to_bf16(lds32(s_val, c) * sc * wv));
    }
}

macro d41w_comp_pool_write(kv0_p, sc0_p, kv_row, sc_row, pool_row, s_val, has_norm, c, ss) {
    reg f32 k0 = u32_as_f32(ldg32_stream(ptr_add(kv0_p, c, 4)));
    reg f32 s0 = u32_as_f32(ldg32_stream(ptr_add(sc0_p, c, 4)));
    reg f32 k1 = u32_as_f32(ldg32_stream(ptr_add(kv_row, c, 4)));
    reg f32 s1 = u32_as_f32(ldg32_stream(ptr_add(sc_row, c, 4)));
    reg f32 top = maxf(s0, s1);
    reg f32 e0 = 0.0f; reg f32 e1 = 0.0f;
    d41w_exp_fast(s0 - top, e0);
    d41w_exp_fast(s1 - top, e1);
    reg f32 inv_d = 0.0f;
    rcp_nr1_f32(e0 + e1, inv_d);
    reg f32 pv = 0.0f;
    div_nr1_f32(fma(k1, e1, k0 * e0), e0 + e1, inv_d, pv);
    reg u32 bf = f32_to_bf16(pv);
    if (has_norm != 0) {
        reg f32 vf = bf16_lo(bf);
        sts32(s_val, c, vf);
        ss = fma(vf, vf, ss);
    } else {
        stg16(ptr_add(pool_row, c, 2), bf);
    }
}

macro d41w_comp_r1_pass(kv_row, pool_row, s_val, s_red, norm, pooled, has_norm, row, width, norm_eps, wid, lane, tid) {
    reg f32 ss = 0.0f;
    for (reg u32 c = tid; c < width; c += 256) {
        reg u32 bf = f32_to_bf16(u32_as_f32(ldg32_stream(ptr_add(kv_row, c, 4))));
        if (has_norm != 0) {
            reg f32 vf = bf16_lo(bf);
            sts32(s_val, c, vf);
            ss = fma(vf, vf, ss);
        } else {
            stg16(ptr_add(pool_row, c, 2), bf);
        }
    }
    if (has_norm != 0) { d41w_comp_norm_store(s_val, s_red, norm, pooled, ss, row, width, norm_eps, wid, lane, tid); }
}

macro d41w_comp_resolve_prev(parent_rows, row_ordinal, seq_row_begin, seq_row_indices, row, ln, out_prev) {
    out_prev = D41W_NO_ROW;
    if ((parent_rows[0] | parent_rows[1]) != 0) {
        out_prev = ldg32_persist(ptr_add(parent_rows, row, 4));
    } else {
        reg u32 ord = ldg32_persist(ptr_add(row_ordinal, row, 4));
        if (ord > 0) {
            reg u32 beg = ldg32_persist(ptr_add(seq_row_begin, ln, 4));
            out_prev = ldg32_persist(ptr_add(seq_row_indices, beg + ord - 1, 4));
        }
    }
}

@pdl
@concept(attention)
kernel[D41W_BLK256, 48] d41_compressor_rows_256(
    global f32* kv, global f32* score, global u32* pooled, global u32* emit_row,
    global f32* state, global u32* positions, global u32* row_lane, global u32* row_ordinal,
    global u32* seq_row_begin, global u32* seq_row_indices, global u32* recurrent_slot,
    u32 ratio, u32 state_stride_floats, u32 width,
    global u32* slots, global u32* parent_rows, global u32* norm, f32 norm_eps, u32 save_inline
) {
    shared f32 s_val[D41W_LATENT];
    shared f32 s_red[8];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
    reg u32 tslot = pos;
    if ((slots[0] | slots[1]) != 0) { tslot = ldg32_persist(ptr_add(slots, row, 4)); }
    reg u32 has_norm = ((norm[0] | norm[1]) != 0) ? 1 : 0;
    reg u64 kv_row = ptr_add(kv, row, width << 2);
    reg u64 sc_row = ptr_add(score, row, width << 2);
    reg u64 pool_row = ptr_add(pooled, row, width << 1);
    if (ratio == 1) {
        d41w_comp_r1_pass(kv_row, pool_row, s_val, s_red, norm, pooled, has_norm, row, width, norm_eps, wid, lane, tid);
        if (tid == 0) { stg32(ptr_add(emit_row, row, 4), tslot); }
        preexit();
        return;
    }
    reg u32 ln = ldg32_persist(ptr_add(row_lane, row, 4));
    reg u32 rslot = ldg32_persist(ptr_add(recurrent_slot, ln, 4));
    reg u64 sstate = ptr_add(state, rslot, state_stride_floats << 2);
    reg u32 qp = 0; reg u32 rp = 0;
    u32_divmod(pos + 1, ratio, qp, rp);
    if (rp != 0) {
        if (save_inline != 0) {
            reg u64 sstate_s = ptr_add(sstate, width, 4);
            for (reg u32 c = tid; c < width; c += 256) {
                stg32(ptr_add(sstate, c, 4), ldg32_stream(ptr_add(kv_row, c, 4)));
                stg32(ptr_add(sstate_s, c, 4), ldg32_stream(ptr_add(sc_row, c, 4)));
            }
        }
        if (tid == 0) { stg32(ptr_add(emit_row, row, 4), D41W_NO_ROW); }
        preexit();
        return;
    }
    reg u32 prev = D41W_NO_ROW;
    d41w_comp_resolve_prev(parent_rows, row_ordinal, seq_row_begin, seq_row_indices, row, ln, prev);
    reg u64 kv0_p = (prev != D41W_NO_ROW) ? ptr_add(kv, prev, width << 2) : sstate;
    reg u64 sc0_p = (prev != D41W_NO_ROW) ? ptr_add(score, prev, width << 2) : ptr_add(sstate, width, 4);
    reg f32 ss = 0.0f;
    for (reg u32 c = tid; c < width; c += 256) {
        d41w_comp_pool_write(kv0_p, sc0_p, kv_row, sc_row, pool_row, s_val, has_norm, c, ss);
    }
    if (has_norm != 0) { d41w_comp_norm_store(s_val, s_red, norm, pooled, ss, row, width, norm_eps, wid, lane, tid); }
    reg u32 eq = 0; reg u32 er = 0;
    u32_divmod(tslot, ratio, eq, er);
    if (tid == 0) { stg32(ptr_add(emit_row, row, 4), eq); }
    preexit();
}

@pdl
@concept(attention)
kernel[D41W_BLK256, 56] d41_compressed_path_move_256(
    blob[56, 8] view, global u32* seq_of_row, global u32* positions,
    global u32* path_rows, global u32* path_count, global u32* slots,
    u32 ratio, u32 elements, u32 page_slots, u32 slot_bytes
) {
    acqbulk();
    reg u32 idx = ctaid_x();
    if (idx >= ldg32_persist(path_count)) { preexit(); return; }
    reg u32 row = ldg32_persist(ptr_add(path_rows, idx, 4));
    reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
    reg u32 q0 = 0; reg u32 r0 = 0;
    u32_divmod(pos + 1, ratio, q0, r0);
    if (r0 != 0) { preexit(); return; }
    reg u32 src_p = 0; reg u32 dst_p = 0; reg u32 rm1 = 0;
    u32_divmod(ldg32_persist(ptr_add(slots, row, 4)), ratio, src_p, rm1);
    u32_divmod(pos, ratio, dst_p, rm1);
    if (src_p == dst_p) { preexit(); return; }
    reg u32 seq = ldg32_persist(ptr_add(seq_of_row, row, 4));
    reg u64 from_p = 0; reg u32 ok_f = 0;
    kv_shard_slot_addr_gen(view, seq, src_p, page_slots, slot_bytes, from_p, ok_f);
    reg u64 to_p = 0; reg u32 ok_t = 0;
    kv_shard_slot_addr_gen(view, seq, dst_p, page_slots, slot_bytes, to_p, ok_t);
    if (ok_f != 0 && ok_t != 0) {
        for (reg u32 e = tid_x(); e < elements; e += 256) {
            stg16(ptr_add(to_p, e, 2), ldg16_stream(ptr_add(from_p, e, 2)));
        }
    }
    preexit();
}

@pdl
@concept(attention)
kernel[D41W_BLK256, 56] d41_store_compressed_256(
    blob[56, 8] view, global u32* latent, global u32* index_key,
    global u32* emit_row, global u32* seq_of_row, u32 index_width,
    u32 page_slots, u32 slot_bytes
) {
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 pos = ldg32_persist(ptr_add(emit_row, row, 4));
    if (pos == D41W_NO_ROW) { preexit(); return; }
    reg u32 seq = ldg32_persist(ptr_add(seq_of_row, row, 4));
    reg u64 slot = 0; reg u32 ok = 0;
    kv_shard_slot_addr_gen(view, seq, pos, page_slots, slot_bytes, slot, ok);
    if (ok == 0) { preexit(); return; }
    reg u32 tid = tid_x();
    reg u64 lat_src = ptr_add(latent, row, D41W_LATENT << 1);
    for (reg u32 c = tid; c < D41W_LATENT; c += 256) {
        stg16(ptr_add(slot, c, 2), ldg16_stream(ptr_add(lat_src, c, 2)));
    }
    if ((index_key[0] | index_key[1]) != 0) {
        reg u64 ik_src = ptr_add(index_key, row, index_width << 1);
        reg u64 ik_dst = ptr_add(slot, D41W_LATENT, 2);
        for (reg u32 c = tid; c < index_width; c += 256) {
            stg16(ptr_add(ik_dst, c, 2), ldg16_stream(ptr_add(ik_src, c, 2)));
        }
    }
    preexit();
}

macro d41w_fold_step_key(has_par, tree_rows, lane_rows, wave_kv, sring, wave_first, pos, at, degree, ring_rows, q0, q1, qk_scale, neg_inf, warp_sums, key_sums, tid, lane, wid, rmax, rsum, acc0, acc1) {
    reg u64 kp = 0;
    if (at >= wave_first) {
        reg u32 wr = 0;
        if (has_par != 0) { wr = lds32(tree_rows, pos - at); }
        else { wr = ldg32_persist(ptr_add(lane_rows, at - wave_first, 4)); }
        kp = ptr_add(wave_kv, wr, D41W_LATENT << 1);
    } else {
        reg u32 kq = 0; reg u32 kr = 0;
        u32_divmod(at, degree, kq, kr);
        reg u32 rq = 0; reg u32 rr = 0;
        u32_divmod(kq, ring_rows, rq, rr);
        kp = ptr_add(sring, rr, D41W_LATENT << 1);
    }
    reg f32 v0 = bf16_lo(ldg16_stream(ptr_add(kp, tid, 2)));
    reg f32 v1 = bf16_lo(ldg16_stream(ptr_add(kp, 256 + tid, 2)));
    reg f32 p = fma(q1, v1, q0 * v0);
    warp_sum_down(p);
    if (lane == 0) { sts32(warp_sums, wid, p); }
    barrier();
    if (tid == 0) {
        reg f32 tot = 0.0f;
        unroll (w = 0..8) { tot = tot + lds32(warp_sums, w); }
        sts32(key_sums, 0, tot * qk_scale);
    }
    barrier();
    reg f32 sc = lds32(key_sums, 0);
    reg f32 top = maxf(rmax, sc);
    reg f32 keep = 0.0f;
    if (rmax != neg_inf) { d41w_exp_fast(rmax - top, keep); }
    reg f32 add = 0.0f;
    d41w_exp_fast(sc - top, add);
    reg f32 wt = 0.0f;
    d41w_round_bf16(add, wt);
    rsum = fma(rsum, keep, add);
    acc0 = fma(acc0, keep, wt * v0);
    acc1 = fma(acc1, keep, wt * v1);
    rmax = top;
    barrier();
}

@pdl
@concept(attention)
kernel[D41W_BLK256, 64] d41_window_fold_256(
    global f32* records, u64 destination_stride, u32 heads_per_destination,
    global u32* query, u64 query_rank_stride, global u32* wave_kv, global u32* ring,
    global u32* positions, global u32* row_lane, global u32* row_ordinal,
    global u32* seq_row_begin, global u32* seq_row_indices, global u32* recurrent_slot,
    u64 ring_slot_stride, u32 ring_rows, u32 window, u32 degree, u32 rank,
    f32 qk_scale, u32 record_heads, u32 record_copies, global u32* parent_rows
) {
    shared f32 warp_sums[64];
    shared f32 key_sums[8];
    shared u32 tree_rows[128];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 head = ctaid_y();
    reg u32 tid = tid_x();
    reg u32 lane = lane_id();
    reg u32 wid = warp_id();
    reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
    reg u32 ln = ldg32_persist(ptr_add(row_lane, row, 4));
    reg u64 lane_rows = ptr_add(seq_row_indices, ldg32_persist(ptr_add(seq_row_begin, ln, 4)), 4);
    reg u32 has_par = ((parent_rows[0] | parent_rows[1]) != 0) ? 1 : 0;
    reg u32 wave_first = 0;
    if (has_par != 0) {
        wave_first = ldg32_persist(ptr_add(positions, ldg32_persist(lane_rows), 4));
        if (tid == 0) {
            reg u32 cur = row;
            for (reg u32 back = 0; back < 128; back += 1) {
                if (cur != D41W_NO_ROW) {
                    sts32(tree_rows, back, cur);
                    cur = ldg32_persist(ptr_add(parent_rows, cur, 4));
                }
            }
        }
        barrier();
    } else {
        wave_first = pos - ldg32_persist(ptr_add(row_ordinal, row, 4));
    }
    reg u32 first = (pos + 1 > window) ? (pos + 1 - window) : 0;
    reg u32 dest = 0; reg u32 local_h = 0;
    u32_divmod(head, heads_per_destination, dest, local_h);
    reg u64 q_ptr = ptr_add(ptr_add(query, dest, query_rank_stride[0] << 1), row * heads_per_destination + local_h, D41W_LATENT << 1);
    reg u32 rec_g = 0; reg u32 rec_h = 0;
    u32_divmod(head, record_heads, rec_g, rec_h);
    reg u64 rec = ptr_add(ptr_add(records, rec_g * record_copies, destination_stride[0] << 2), row * record_heads + rec_h, D41W_RECORD << 2);
    reg f32 rmax = u32_as_f32(ldg32_persist(rec));
    reg f32 rsum = u32_as_f32(ldg32_persist(ptr_add(rec, 1, 4)));
    reg f32 acc0 = u32_as_f32(ldg32_persist(ptr_add(rec, 2 + tid, 4)));
    reg f32 acc1 = u32_as_f32(ldg32_persist(ptr_add(rec, 2 + 256 + tid, 4)));
    reg f32 q0 = bf16_lo(ldg16_persist(ptr_add(q_ptr, tid, 2)));
    reg f32 q1 = bf16_lo(ldg16_persist(ptr_add(q_ptr, 256 + tid, 2)));
    reg u64 sring = ptr_add(ring, ldg32_persist(ptr_add(recurrent_slot, ln, 4)), ring_slot_stride[0] << 1);
    reg u32 fq = 0; reg u32 fr = 0;
    u32_divmod(first, degree, fq, fr);
    reg u32 aq = 0; reg u32 ar = 0;
    u32_divmod(rank + degree - fr, degree, aq, ar);
    reg f32 neg_inf = u32_as_f32(D41W_NEG_INF);
    for (reg u32 key = first + ar; key <= pos; key += degree) {
        d41w_fold_step_key(has_par, tree_rows, lane_rows, wave_kv, sring, wave_first, pos, key, degree, ring_rows, q0, q1, qk_scale, neg_inf, warp_sums, key_sums, tid, lane, wid, rmax, rsum, acc0, acc1);
    }
    for (reg u32 copy = 0; copy < record_copies; copy += 1) {
        reg u64 dst = ptr_add(rec, copy, destination_stride[0] << 2);
        stg32(ptr_add(dst, 2 + tid, 4), f32_as_u32(acc0));
        stg32(ptr_add(dst, 2 + 256 + tid, 4), f32_as_u32(acc1));
        if (tid == 0) {
            stg32(dst, f32_as_u32(rmax));
            stg32(ptr_add(dst, 1, 4), f32_as_u32(rsum));
        }
    }
    preexit();
}

macro d41w_tile_online_softmax(s_wsums, s_max, s_sum, s_keep, s_wt, n, qk_scale, h) {
    reg f32 rm = lds32(s_max, h);
    reg f32 rs = lds32(s_sum, h);
    reg f32 ninf = u32_as_f32(D41W_NEG_INF);
    for (reg u32 t = 0; t < n; t += 1) {
        reg u32 wb = (h * 16 + t) * 8;
        reg f32 tot = 0.0f;
        unroll (w = 0..8) { tot = tot + lds32(s_wsums, wb + w); }
        reg f32 sc = tot * qk_scale;
        reg f32 top = maxf(rm, sc);
        reg f32 kp = 0.0f;
        if (rm != ninf) { d41w_exp_fast(rm - top, kp); }
        reg f32 ad = 0.0f;
        d41w_exp_fast(sc - top, ad);
        rs = fma(rs, kp, ad);
        rm = top;
        sts32(s_keep, h * 16 + t, kp);
        reg f32 wt = 0.0f;
        d41w_round_bf16(ad, wt);
        sts32(s_wt, h * 16 + t, wt);
    }
    sts32(s_max, h, rm);
    sts32(s_sum, h, rs);
}

macro d41w_load_k_tile(kptr_lo, kptr_hi, s_k, j, n, tid) {
    reg u32 lim = n << 6;
    for (reg u32 idx = tid; idx < lim; idx += 256) {
        reg u32 t = idx >> 6;
        reg u32 qv = idx & 63;
        reg u64 kp;
        kp[0] = lds32(kptr_lo, j + t);
        kp[1] = lds32(kptr_hi, j + t);
        sts128(s_k, (t << 8) + (qv << 2), ldg128_persist(ptr_add(kp, qv, 16)));
    }
}

macro d41w_read_sk_bf16(s_k, t, tid, out_a, out_b) {
    reg u32 w0 = lds32(s_k, (t << 8) + (tid >> 1));
    reg u32 w1 = lds32(s_k, (t << 8) + 128 + (tid >> 1));
    out_a = ((tid & 1) == 0) ? bf16_lo(w0) : bf16_hi(w0);
    out_b = ((tid & 1) == 0) ? bf16_lo(w1) : bf16_hi(w1);
}

macro d41w_window_init_kptrs(row, positions, row_lane, row_ordinal, seq_row_begin, seq_row_indices, recurrent_slot, ring, ring_slot_stride, window, wave_kv, tid, kptr_lo, kptr_hi, out_count) {
    reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
    reg u32 ln = ldg32_persist(ptr_add(row_lane, row, 4));
    reg u32 wave_first = pos - ldg32_persist(ptr_add(row_ordinal, row, 4));
    reg u64 lane_rows = ptr_add(seq_row_indices, ldg32_persist(ptr_add(seq_row_begin, ln, 4)), 4);
    reg u32 first = (pos + 1 > window) ? (pos + 1 - window) : 0;
    out_count = pos + 1 - first;
    reg u64 sring = ptr_add(ring, ldg32_persist(ptr_add(recurrent_slot, ln, 4)), ring_slot_stride[0] << 1);
    if (tid < out_count) {
        reg u64 kp = 0;
        d41w_window_key_ptr(wave_kv, sring, lane_rows, wave_first, window, first + tid, kp);
        sts32(kptr_lo, tid, kp[0]);
        sts32(kptr_hi, tid, kp[1]);
    }
}

@pdl
@concept(attention)
kernel[D41W_BLK256, 64] d41_window_fold_whole_256(
    global f32* records, u32 heads, global u32* query, global u32* wave_kv, global u32* ring,
    global u32* positions, global u32* row_lane, global u32* row_ordinal,
    global u32* seq_row_begin, global u32* seq_row_indices, global u32* recurrent_slot,
    u64 ring_slot_stride, u32 window, f32 qk_scale
) {
    shared u32 kptr_lo[128];
    shared u32 kptr_hi[128];
    shared u32 s_k[4096];
    shared f32 s_wsums[128];
    shared f32 s_keep[16];
    shared f32 s_wt[16];
    shared f32 s_max[1];
    shared f32 s_sum[1];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 head = ctaid_y();
    reg u32 tid = tid_x();
    reg u32 lane = lane_id();
    reg u32 wid = warp_id();
    reg u32 count = 0;
    d41w_window_init_kptrs(row, positions, row_lane, row_ordinal, seq_row_begin, seq_row_indices, recurrent_slot, ring, ring_slot_stride, window, wave_kv, tid, kptr_lo, kptr_hi, count);
    reg u64 qp = ptr_add(query, row * heads + head, D41W_LATENT << 1);
    reg u64 rec = ptr_add(records, row * heads + head, D41W_RECORD << 2);
    reg f32 q0 = bf16_lo(ldg16_persist(ptr_add(qp, tid, 2)));
    reg f32 q1 = bf16_lo(ldg16_persist(ptr_add(qp, 256 + tid, 2)));
    reg f32 acc0 = u32_as_f32(ldg32_persist(ptr_add(rec, 2 + tid, 4)));
    reg f32 acc1 = u32_as_f32(ldg32_persist(ptr_add(rec, 2 + 256 + tid, 4)));
    if (tid == 0) {
        sts32(s_max, 0, u32_as_f32(ldg32_persist(rec)));
        sts32(s_sum, 0, u32_as_f32(ldg32_persist(ptr_add(rec, 1, 4))));
    }
    barrier();
    for (reg u32 j = 0; j < count; j += 16) {
        reg u32 n = (count - j < 16) ? (count - j) : 16;
        d41w_load_k_tile(kptr_lo, kptr_hi, s_k, j, n, tid);
        barrier();
        for (reg u32 t = 0; t < n; t += 1) {
            reg f32 a = 0.0f; reg f32 b = 0.0f;
            d41w_read_sk_bf16(s_k, t, tid, a, b);
            reg f32 p = fma(q1, b, q0 * a);
            warp_sum_down(p);
            if (lane == 0) { sts32(s_wsums, t * 8 + wid, p); }
        }
        barrier();
        if (tid == 0) { d41w_tile_online_softmax(s_wsums, s_max, s_sum, s_keep, s_wt, n, qk_scale, 0); }
        barrier();
        for (reg u32 t = 0; t < n; t += 1) {
            reg f32 va = 0.0f; reg f32 vb = 0.0f;
            d41w_read_sk_bf16(s_k, t, tid, va, vb);
            reg f32 kp = lds32(s_keep, t);
            reg f32 wt = lds32(s_wt, t);
            acc0 = fma(acc0, kp, wt * va);
            acc1 = fma(acc1, kp, wt * vb);
        }
        if (j + 16 < count) { barrier(); }
    }
    stg32(ptr_add(rec, 2 + tid, 4), f32_as_u32(acc0));
    stg32(ptr_add(rec, 2 + 256 + tid, 4), f32_as_u32(acc1));
    if (tid == 0) {
        stg32(rec, f32_as_u32(lds32(s_max, 0)));
        stg32(ptr_add(rec, 1, 4), f32_as_u32(lds32(s_sum, 0)));
    }
    preexit();
}

@pdl
@concept(attention)
kernel[D41W_BLK256, 80] d41_window_fold_whole_tiled4_256(
    global f32* records, u32 heads, global u32* query, global u32* wave_kv, global u32* ring,
    global u32* positions, global u32* row_lane, global u32* row_ordinal,
    global u32* seq_row_begin, global u32* seq_row_indices, global u32* recurrent_slot,
    u64 ring_slot_stride, u32 window, f32 qk_scale
) {
    shared u32 kptr_lo[128];
    shared u32 kptr_hi[128];
    shared u32 s_k[4096];
    shared f32 s_wsums[512];
    shared f32 s_keep[64];
    shared f32 s_wt[64];
    shared f32 s_max[4];
    shared f32 s_sum[4];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 hbase = ctaid_y() * 4;
    reg u32 tid = tid_x();
    reg u32 lane = lane_id();
    reg u32 wid = warp_id();
    reg u32 count = 0;
    d41w_window_init_kptrs(row, positions, row_lane, row_ordinal, seq_row_begin, seq_row_indices, recurrent_slot, ring, ring_slot_stride, window, wave_kv, tid, kptr_lo, kptr_hi, count);
    reg f32 q0[4]; reg f32 q1[4]; reg f32 acc0[4]; reg f32 acc1[4];
    unroll (h = 0..4) {
        reg u64 qp = ptr_add(query, row * heads + hbase + h, D41W_LATENT << 1);
        q0[h] = bf16_lo(ldg16_persist(ptr_add(qp, tid, 2)));
        q1[h] = bf16_lo(ldg16_persist(ptr_add(qp, 256 + tid, 2)));
        reg u64 rec = ptr_add(records, row * heads + hbase + h, D41W_RECORD << 2);
        acc0[h] = u32_as_f32(ldg32_persist(ptr_add(rec, 2 + tid, 4)));
        acc1[h] = u32_as_f32(ldg32_persist(ptr_add(rec, 2 + 256 + tid, 4)));
        if (tid == h) {
            sts32(s_max, h, u32_as_f32(ldg32_persist(rec)));
            sts32(s_sum, h, u32_as_f32(ldg32_persist(ptr_add(rec, 1, 4))));
        }
    }
    barrier();
    for (reg u32 j = 0; j < count; j += 16) {
        reg u32 n = (count - j < 16) ? (count - j) : 16;
        d41w_load_k_tile(kptr_lo, kptr_hi, s_k, j, n, tid);
        barrier();
        for (reg u32 t = 0; t < n; t += 1) {
            reg f32 a = 0.0f; reg f32 b = 0.0f;
            d41w_read_sk_bf16(s_k, t, tid, a, b);
            unroll (h = 0..4) {
                reg f32 p = fma(q1[h], b, q0[h] * a);
                warp_sum_down(p);
                if (lane == 0) { sts32(s_wsums, (h * 16 + t) * 8 + wid, p); }
            }
        }
        barrier();
        if (tid < 4) { d41w_tile_online_softmax(s_wsums, s_max, s_sum, s_keep, s_wt, n, qk_scale, tid); }
        barrier();
        for (reg u32 t = 0; t < n; t += 1) {
            reg f32 va = 0.0f; reg f32 vb = 0.0f;
            d41w_read_sk_bf16(s_k, t, tid, va, vb);
            unroll (h = 0..4) {
                reg f32 kp = lds32(s_keep, h * 16 + t);
                reg f32 wt = lds32(s_wt, h * 16 + t);
                acc0[h] = fma(acc0[h], kp, wt * va);
                acc1[h] = fma(acc1[h], kp, wt * vb);
            }
        }
        if (j + 16 < count) { barrier(); }
    }
    unroll (h = 0..4) {
        reg u64 rec = ptr_add(records, row * heads + hbase + h, D41W_RECORD << 2);
        stg32(ptr_add(rec, 2 + tid, 4), f32_as_u32(acc0[h]));
        stg32(ptr_add(rec, 2 + 256 + tid, 4), f32_as_u32(acc1[h]));
        if (tid == h) {
            stg32(rec, f32_as_u32(lds32(s_max, h)));
            stg32(ptr_add(rec, 1, 4), f32_as_u32(lds32(s_sum, h)));
        }
    }
    preexit();
}

macro d41w_spread_emit_head(s_k, output, row, heads, hbase, h, qdq, tid) {
    reg u64 dst = ptr_add(output, row * heads + hbase + h, D41W_LATENT << 1);
    if (qdq != 0) {
        reg f32 v0 = 0.0f; reg f32 v1 = 0.0f;
        d41w_read_sk_bf16(s_k, h, tid, v0, v1);
        reg u32 q0 = 0; reg u32 q1 = 0;
        d41w_fp8_qdq_lane(v0, q0);
        d41w_fp8_qdq_lane(v1, q1);
        stg16(ptr_add(dst, tid, 2), q0);
        stg16(ptr_add(dst, 256 + tid, 2), q1);
    } else if (tid < 64) {
        stg128(ptr_add(dst, tid, 16), lds128(s_k, (h << 8) + (tid << 2)));
    }
}

macro d41w_spread_pack_head(s_k, s_max, s_sum, sink, hbase, h, acc0, acc1, tid) {
    reg f32 mx = lds32(s_max, h);
    reg f32 top = maxf(-1.0e30f, mx);
    reg f32 sc = 0.0f;
    if (mx != u32_as_f32(D41W_NEG_INF)) { d41w_exp_fast(mx - top, sc); }
    reg f32 se = 0.0f;
    d41w_exp_fast(u32_as_f32(ldg32_persist(ptr_add(sink, hbase + h, 4))) - top, se);
    reg f32 den = fma(lds32(s_sum, h), sc, 0.0f) + se;
    reg f32 inv_d = 0.0f;
    rcp_nr1_f32(den, inv_d);
    reg f32 o0 = 0.0f; reg f32 o1 = 0.0f;
    div_nr1_f32(fma(acc0, sc, 0.0f), den, inv_d, o0);
    div_nr1_f32(fma(acc1, sc, 0.0f), den, inv_d, o1);
    reg f32 o0_hi = shfl_xor(o0, 1);
    reg f32 o1_hi = shfl_xor(o1, 1);
    if ((tid & 1) == 0) {
        sts32(s_k, (h << 8) + (tid >> 1), pack_bf16x2(o0, o0_hi));
        sts32(s_k, (h << 8) + 128 + (tid >> 1), pack_bf16x2(o1, o1_hi));
    }
}

macro d41w_spread_tile_pass(s_k, s_wsums, s_max, s_sum, s_keep, s_wt, n, qk_scale, q00, q10, q01, q11, acc00, acc10, acc01, acc11, tid, lane, wid) {
    for (reg u32 t = 0; t < n; t += 1) {
        reg f32 a = 0.0f; reg f32 b = 0.0f;
        d41w_read_sk_bf16(s_k, t, tid, a, b);
        reg f32 p0 = fma(q10, b, q00 * a);
        reg f32 p1 = fma(q11, b, q01 * a);
        warp_sum_down(p0);
        warp_sum_down(p1);
        if (lane == 0) { sts32(s_wsums, t * 8 + wid, p0); sts32(s_wsums, (16 + t) * 8 + wid, p1); }
    }
    barrier();
    if (tid < 2) { d41w_tile_online_softmax(s_wsums, s_max, s_sum, s_keep, s_wt, n, qk_scale, tid); }
    barrier();
    for (reg u32 t = 0; t < n; t += 1) {
        reg f32 va = 0.0f; reg f32 vb = 0.0f;
        d41w_read_sk_bf16(s_k, t, tid, va, vb);
        reg f32 kp0 = lds32(s_keep, t); reg f32 wt0 = lds32(s_wt, t);
        reg f32 kp1 = lds32(s_keep, 16 + t); reg f32 wt1 = lds32(s_wt, 16 + t);
        acc00 = fma(acc00, kp0, wt0 * va); acc10 = fma(acc10, kp0, wt0 * vb);
        acc01 = fma(acc01, kp1, wt1 * va); acc11 = fma(acc11, kp1, wt1 * vb);
    }
    barrier();
}

macro d41w_spread_load_carried(has_carried, records, row, heads, hbase, tid, s_max, s_sum, acc00, acc10, acc01, acc11) {
    if (has_carried != 0) {
        reg u64 r0 = ptr_add(records, row * heads + hbase, D41W_RECORD << 2);
        reg u64 r1 = ptr_add(r0, D41W_RECORD, 4);
        acc00 = u32_as_f32(ldg32_persist(ptr_add(r0, 2 + tid, 4)));
        acc10 = u32_as_f32(ldg32_persist(ptr_add(r0, 2 + 256 + tid, 4)));
        acc01 = u32_as_f32(ldg32_persist(ptr_add(r1, 2 + tid, 4)));
        acc11 = u32_as_f32(ldg32_persist(ptr_add(r1, 2 + 256 + tid, 4)));
        if (tid == 0) { sts32(s_max, 0, u32_as_f32(ldg32_persist(r0))); sts32(s_sum, 0, u32_as_f32(ldg32_persist(ptr_add(r0, 1, 4)))); }
        if (tid == 1) { sts32(s_max, 1, u32_as_f32(ldg32_persist(r1))); sts32(s_sum, 1, u32_as_f32(ldg32_persist(ptr_add(r1, 1, 4)))); }
    } else if (tid < 2) {
        sts32(s_max, tid, u32_as_f32(D41W_NEG_INF));
        sts32(s_sum, tid, 0.0f);
    }
}

@pdl
@concept(attention)
kernel[D41W_BLK256, 80] d41_window_fold_spread_256(
    global f32* records, u32 has_carried, u32 heads, global u32* query,
    global u32* wave_kv, global u32* ring, global u32* positions, global u32* row_lane,
    global u32* row_ordinal, global u32* seq_row_begin, global u32* seq_row_indices,
    global u32* recurrent_slot, u64 ring_slot_stride, u32 ring_rows, u32 window,
    f32 qk_scale, global f32* sink, global f32* rope_sc, global u32* output,
    u32 qdq, u32 rows, u32 commit
) {
    shared u32 kptr_lo[128];
    shared u32 kptr_hi[128];
    shared u32 s_k[4096];
    shared f32 s_wsums[256];
    shared f32 s_keep[32];
    shared f32 s_wt[32];
    shared f32 s_max[2];
    shared f32 s_sum[2];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 hbase = ctaid_y() * 2;
    reg u32 tid = tid_x();
    reg u32 lane = lane_id();
    reg u32 wid = warp_id();
    reg u32 count = 0;
    d41w_window_init_kptrs(row, positions, row_lane, row_ordinal, seq_row_begin, seq_row_indices, recurrent_slot, ring, ring_slot_stride, window, wave_kv, tid, kptr_lo, kptr_hi, count);
    reg u64 qp0 = ptr_add(query, row * heads + hbase, D41W_LATENT << 1);
    reg u64 qp1 = ptr_add(qp0, D41W_LATENT, 2);
    reg f32 q00 = bf16_lo(ldg16_persist(ptr_add(qp0, tid, 2)));
    reg f32 q10 = bf16_lo(ldg16_persist(ptr_add(qp0, 256 + tid, 2)));
    reg f32 q01 = bf16_lo(ldg16_persist(ptr_add(qp1, tid, 2)));
    reg f32 q11 = bf16_lo(ldg16_persist(ptr_add(qp1, 256 + tid, 2)));
    reg f32 acc00 = 0.0f; reg f32 acc10 = 0.0f; reg f32 acc01 = 0.0f; reg f32 acc11 = 0.0f;
    d41w_spread_load_carried(has_carried, records, row, heads, hbase, tid, s_max, s_sum, acc00, acc10, acc01, acc11);
    barrier();
    for (reg u32 j = 0; j < count; j += 16) {
        reg u32 n = (count - j < 16) ? (count - j) : 16;
        d41w_load_k_tile(kptr_lo, kptr_hi, s_k, j, n, tid);
        barrier();
        d41w_spread_tile_pass(s_k, s_wsums, s_max, s_sum, s_keep, s_wt, n, qk_scale, q00, q10, q01, q11, acc00, acc10, acc01, acc11, tid, lane, wid);
    }
    d41w_spread_pack_head(s_k, s_max, s_sum, sink, hbase, 0, acc00, acc10, tid);
    d41w_spread_pack_head(s_k, s_max, s_sum, sink, hbase, 1, acc01, acc11, tid);
    barrier();
    if (tid < D41W_ROPE_PAIRS) {
        reg u64 rp = ptr_add(rope_sc, row * D41W_ROPE_PAIRS + tid, 8);
        reg f32 sn = 0.0f - u32_as_f32(ldg32_persist(rp));
        reg f32 cs = u32_as_f32(ldg32_persist(ptr_add(rp, 1, 4)));
        unroll (h = 0..2) {
            reg u32 w = lds32(s_k, (h << 8) + 224 + tid);
            reg f32 rl = bf16_lo(w); reg f32 im = bf16_hi(w);
            sts32(s_k, (h << 8) + 224 + tid, pack_bf16x2(fma(rl, cs, 0.0f - im * sn), fma(rl, sn, im * cs)));
        }
    }
    barrier();
    d41w_spread_emit_head(s_k, output, row, heads, hbase, 0, qdq, tid);
    d41w_spread_emit_head(s_k, output, row, heads, hbase, 1, qdq, tid);
    if (ctaid_y() == 0) {
        d41w_ring_store_row_w1(wave_kv, ring, positions, row_lane, row_ordinal, seq_row_begin, recurrent_slot, ring_slot_stride, ring_rows, window, rows, commit, row, tid);
    }
    preexit();
}

@pdl
@concept(elementwise)
kernel[D41W_BLK64, 16] d41_l2_prefetch_64(
    global u8* ptr0, u64 bytes0, global u8* ptr1, u64 bytes1
) {
    acqbulk();
    preexit();
}

@pdl
@concept(elementwise)
kernel[D41W_BLK256, 24] d41_wave_row_indices_256(
    global u32* indices, u32 count
) {
    acqbulk();
    reg u32 idx = ctaid_x() * ntid_x() + tid_x();
    if (idx < count) { stg32(ptr_add(indices, idx, 4), idx); }
    preexit();
}

macro d41w_rms_load_bf16x8(src_ptr, off, dst_smem) {
    reg u32x4 b = ldg128_stream(ptr_add(src_ptr, off, 2));
    dyn_sts128(off, pack_u32x4(f32_as_u32(bf16_lo(b[0])), f32_as_u32(bf16_hi(b[0])), f32_as_u32(bf16_lo(b[1])), f32_as_u32(bf16_hi(b[1]))));
    dyn_sts128(off + 4, pack_u32x4(f32_as_u32(bf16_lo(b[2])), f32_as_u32(bf16_hi(b[2])), f32_as_u32(bf16_lo(b[3])), f32_as_u32(bf16_hi(b[3]))));
}

macro d41w_rms_norm_write8(off, base_off, scale, weight, output, quantized, mx_codes, mx_scales, has_out, has_mx, tid) {
    reg u32x4 lv0 = dyn_lds128(off);
    reg u32x4 lv1 = dyn_lds128(off + 4);
    reg u32x4 wb = ldg128_persist(ptr_add(weight, off, 2));
    reg f32 v0 = u32_as_f32(lv0[0]) * scale * bf16_lo(wb[0]);
    reg f32 v1 = u32_as_f32(lv0[1]) * scale * bf16_hi(wb[0]);
    reg f32 v2 = u32_as_f32(lv0[2]) * scale * bf16_lo(wb[1]);
    reg f32 v3 = u32_as_f32(lv0[3]) * scale * bf16_hi(wb[1]);
    reg f32 v4 = u32_as_f32(lv1[0]) * scale * bf16_lo(wb[2]);
    reg f32 v5 = u32_as_f32(lv1[1]) * scale * bf16_hi(wb[2]);
    reg f32 v6 = u32_as_f32(lv1[2]) * scale * bf16_lo(wb[3]);
    reg f32 v7 = u32_as_f32(lv1[3]) * scale * bf16_hi(wb[3]);
    reg u32x4 nm = pack_u32x4(pack_bf16x2(v0, v1), pack_bf16x2(v2, v3), pack_bf16x2(v4, v5), pack_bf16x2(v6, v7));
    if (has_out != 0) { stg128(ptr_add(output, base_off + off, 2), nm); }
    reg f32 r0 = bf16_lo(nm[0]); reg f32 r1 = bf16_hi(nm[0]);
    reg f32 r2 = bf16_lo(nm[1]); reg f32 r3 = bf16_hi(nm[1]);
    reg f32 r4 = bf16_lo(nm[2]); reg f32 r5 = bf16_hi(nm[2]);
    reg f32 r6 = bf16_lo(nm[3]); reg f32 r7 = bf16_hi(nm[3]);
    if (has_mx != 0) {
        reg u32 c0 = 0; reg u32 c1 = 0; reg u32 sc_b = 0;
        d41w_fp8_quant8(r0, r1, r2, r3, r4, r5, r6, r7, c0, c1, sc_b);
        stg64(ptr_add(mx_codes, base_off + off, 1), pack_u32x2(c0, c1));
        if ((tid & 3) == 0) { stg8(ptr_add(mx_scales, (base_off + off) >> 5, 1), sc_b); }
    } else {
        reg u32x4 qv = pack_u32x4(0, 0, 0, 0);
        d41w_fp8_qdq8(r0, r1, r2, r3, r4, r5, r6, r7, qv);
        stg128(ptr_add(quantized, base_off + off, 2), qv);
    }
}

macro d41w_dyn_rms_scale(dim, eps, s_red, tid, wid, lane, out_sc) {
    barrier();
    reg f32 total = 0.0f;
    for (reg u32 i = tid; i < dim; i += 256) {
        reg f32 v = dyn_lds32_f32(i);
        total = fma(v, v, total);
    }
    reg f32 sum = 0.0f;
    block_reduce_sum_exact(total, s_red, wid, lane, sum);
    rsqrt_exact_div(sum, u32_to_f32(dim), eps, out_sc);
}

@pdl
@concept(norm)
kernel[D41W_BLK256, 64] d41_rms_norm_qdq_256(
    global u32* input, global u32* streams, global f32* pre,
    global u32* weight, global u32* output, global u32* quantized,
    u32 dimension, f32 epsilon, global u8* mx_codes, global u8* mx_scales
) {
    shared f32 s_red[8];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 span = 0; reg u32 srem = 0;
    u32_divmod(dimension, grid_y(), span, srem);
    reg u32 begin = ctaid_y() * span;
    reg u32 has_str = ((streams[0] | streams[1]) != 0) ? 1 : 0;
    reg u32 has_out = ((output[0] | output[1]) != 0) ? 1 : 0;
    reg u32 has_mx = ((mx_codes[0] | mx_codes[1]) != 0) ? 1 : 0;
    reg u32 base_off = row * dimension;
    reg u64 in_row = ptr_add(input, row, dimension << 1);
    for (reg u32 off = tid << 3; off < dimension; off += 2048) {
        if (has_str != 0) {
            reg f32 a0 = 0.0f; reg f32 a1 = 0.0f; reg f32 a2 = 0.0f; reg f32 a3 = 0.0f;
            reg f32 a4 = 0.0f; reg f32 a5 = 0.0f; reg f32 a6 = 0.0f; reg f32 a7 = 0.0f;
            unroll (copy = 0..4) {
                reg f32 pw = u32_as_f32(ldg32_persist(ptr_add(pre, row * 4 + copy, 4)));
                reg u32x4 sb = ldg128_stream(ptr_add(ptr_add(streams, row * 4 + copy, dimension << 1), off, 2));
                a0 = fma(pw, bf16_lo(sb[0]), a0); a1 = fma(pw, bf16_hi(sb[0]), a1);
                a2 = fma(pw, bf16_lo(sb[1]), a2); a3 = fma(pw, bf16_hi(sb[1]), a3);
                a4 = fma(pw, bf16_lo(sb[2]), a4); a5 = fma(pw, bf16_hi(sb[2]), a5);
                a6 = fma(pw, bf16_lo(sb[3]), a6); a7 = fma(pw, bf16_hi(sb[3]), a7);
            }
            reg u32 p0 = pack_bf16x2(a0, a1); reg u32 p1 = pack_bf16x2(a2, a3);
            reg u32 p2 = pack_bf16x2(a4, a5); reg u32 p3 = pack_bf16x2(a6, a7);
            dyn_sts128(off, pack_u32x4(f32_as_u32(bf16_lo(p0)), f32_as_u32(bf16_hi(p0)), f32_as_u32(bf16_lo(p1)), f32_as_u32(bf16_hi(p1))));
            dyn_sts128(off + 4, pack_u32x4(f32_as_u32(bf16_lo(p2)), f32_as_u32(bf16_hi(p2)), f32_as_u32(bf16_lo(p3)), f32_as_u32(bf16_hi(p3))));
        } else {
            d41w_rms_load_bf16x8(in_row, off, 0);
        }
    }
    reg f32 sc = 0.0f;
    d41w_dyn_rms_scale(dimension, epsilon, s_red, tid, wid, lane, sc);
    for (reg u32 off = begin + (tid << 3); off < begin + span; off += 2048) {
        d41w_rms_norm_write8(off, base_off, sc, weight, output, quantized, mx_codes, mx_scales, has_out, has_mx, tid);
    }
    preexit();
}

macro d41w_rope_pair_f32(rl, im, sn, cs, out_r, out_i) {
    out_r = bf16_lo(f32_to_bf16(fma(rl, cs, 0.0f - im * sn)));
    out_i = bf16_lo(f32_to_bf16(fma(rl, sn, im * cs)));
}

macro d41w_get_rope_sc(rope_sc, has_rsc, inv_freq, pos, row, pair, out_sn, out_cs) {
    if (has_rsc != 0) {
        reg u64 rp = ptr_add(rope_sc, row * D41W_ROPE_PAIRS + pair, 8);
        out_sn = u32_as_f32(ldg32_persist(rp));
        out_cs = u32_as_f32(ldg32_persist(ptr_add(rp, 1, 4)));
    } else {
        reg f32 ang = u32_to_f32(pos) * u32_as_f32(ldg32_persist(ptr_add(inv_freq, pair, 4)));
        sincos_pos_f32(ang, out_sn, out_cs);
    }
}

@pdl
@concept(norm)
kernel[D41W_BLK256, 80] d41_qkv_norm_rope_qdq_256(
    global u32* q_in, global u32* q_w, global u32* q_qdq,
    global u8* mx_codes, global u8* mx_scales, u32 q_dim, u32 q_parts,
    global u32* kv_in, global u32* kv_w, global u32* positions,
    global f32* inv_freq, global u32* kv_out, u32 kv_dim, u32 rope_offset,
    f32 epsilon, global f32* rope_sc
) {
    shared f32 s_red[8];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 by = ctaid_y();
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    if (by < q_parts) {
        reg u32 span = 0; reg u32 srem = 0;
        u32_divmod(q_dim, q_parts, span, srem);
        reg u32 begin = by * span;
        reg u32 base_off = row * q_dim;
        reg u64 q_row = ptr_add(q_in, row, q_dim << 1);
        for (reg u32 off = tid << 3; off < q_dim; off += 2048) {
            d41w_rms_load_bf16x8(q_row, off, 0);
        }
        reg f32 sc = 0.0f;
        d41w_dyn_rms_scale(q_dim, epsilon, s_red, tid, wid, lane, sc);
        reg u32 has_mx = ((mx_codes[0] | mx_codes[1]) != 0) ? 1 : 0;
        for (reg u32 off = begin + (tid << 3); off < begin + span; off += 2048) {
            d41w_rms_norm_write8(off, base_off, sc, q_w, q_qdq, q_qdq, mx_codes, mx_scales, 0, has_mx, tid);
        }
        preexit();
        return;
    }
    reg u64 kv_row = ptr_add(kv_in, row, kv_dim << 1);
    for (reg u32 off = tid << 3; off < kv_dim; off += 2048) {
        d41w_rms_load_bf16x8(kv_row, off, 0);
    }
    reg f32 sc = 0.0f;
    d41w_dyn_rms_scale(kv_dim, epsilon, s_red, tid, wid, lane, sc);
    reg u32 has_rsc = ((rope_sc[0] | rope_sc[1]) != 0) ? 1 : 0;
    reg u32 pos = 0;
    if (has_rsc == 0) { pos = ldg32_persist(ptr_add(positions, row, 4)); }
    reg u64 kvo_row = ptr_add(kv_out, row, kv_dim << 1);
    for (reg u32 off = tid << 3; off < kv_dim; off += 2048) {
        reg u32x4 lv0 = dyn_lds128(off);
        reg u32x4 lv1 = dyn_lds128(off + 4);
        reg u32x4 wb = ldg128_persist(ptr_add(kv_w, off, 2));
        reg f32 v0 = bf16_lo(f32_to_bf16(u32_as_f32(lv0[0]) * sc * bf16_lo(wb[0])));
        reg f32 v1 = bf16_lo(f32_to_bf16(u32_as_f32(lv0[1]) * sc * bf16_hi(wb[0])));
        reg f32 v2 = bf16_lo(f32_to_bf16(u32_as_f32(lv0[2]) * sc * bf16_lo(wb[1])));
        reg f32 v3 = bf16_lo(f32_to_bf16(u32_as_f32(lv0[3]) * sc * bf16_hi(wb[1])));
        reg f32 v4 = bf16_lo(f32_to_bf16(u32_as_f32(lv1[0]) * sc * bf16_lo(wb[2])));
        reg f32 v5 = bf16_lo(f32_to_bf16(u32_as_f32(lv1[1]) * sc * bf16_hi(wb[2])));
        reg f32 v6 = bf16_lo(f32_to_bf16(u32_as_f32(lv1[2]) * sc * bf16_lo(wb[3])));
        reg f32 v7 = bf16_lo(f32_to_bf16(u32_as_f32(lv1[3]) * sc * bf16_hi(wb[3])));
        if (off >= rope_offset) {
            reg u32 pbase = (off - rope_offset) >> 1;
            reg f32 sn = 0.0f; reg f32 cs = 0.0f;
            d41w_get_rope_sc(rope_sc, has_rsc, inv_freq, pos, row, pbase, sn, cs);
            d41w_rope_pair_f32(v0, v1, sn, cs, v0, v1);
            d41w_get_rope_sc(rope_sc, has_rsc, inv_freq, pos, row, pbase + 1, sn, cs);
            d41w_rope_pair_f32(v2, v3, sn, cs, v2, v3);
            d41w_get_rope_sc(rope_sc, has_rsc, inv_freq, pos, row, pbase + 2, sn, cs);
            d41w_rope_pair_f32(v4, v5, sn, cs, v4, v5);
            d41w_get_rope_sc(rope_sc, has_rsc, inv_freq, pos, row, pbase + 3, sn, cs);
            d41w_rope_pair_f32(v6, v7, sn, cs, v6, v7);
        }
        reg u32x4 qv = pack_u32x4(0, 0, 0, 0);
        d41w_fp8_qdq8(v0, v1, v2, v3, v4, v5, v6, v7, qv);
        stg128(ptr_add(kvo_row, off, 2), qv);
    }
    preexit();
}
