import "stdlib/math.skl2";

const BLOCK_CONV = 256;
const BLOCK_DELTA = 128;

macro delta_l2norm_to_smem(USE_SCALE, src_ptr, rh, lane, scale_v, dst_s) {
    ureg u64 bp = ptr_add(ptr_add(src_ptr, rh, 256), lane, 2);
    reg f32 p[4];
    reg f32 sq[4];
    unroll (i = 0..4) { p[i] = bf16_lo(ldg16_persist(ptr_add(bp, i * 32, 2))); }
    unroll (i = 0..4) { sq[i] = p[i] * p[i]; }
    unroll (i = 0..4) {
        warp_sum_down(sq[i]);
        sq[i] = shfl_idx(sq[i], 0);
    }
    reg f32 total_s = 0.0f;
    unroll (i = 0..4) {
        if (lane == i) { total_s = sq[i]; }
    }
    total_s = total_s + shfl_down(total_s, 4);
    total_s = total_s + shfl_down(total_s, 2);
    total_s = total_s + shfl_down(total_s, 1);
    total_s = shfl_idx(total_s, 0);
    reg f32 fac = rsqrt(total_s + 1.0e-6f);
    if constexpr (USE_SCALE == 1) { fac = fac * scale_v; }
    unroll (i = 0..4) {
        sts32(dst_s, lane + i * 32, p[i] * fac);
    }
}

macro delta_stage_step_smem(wid, lane, rh, key_bf16, query_bf16, forget_gate, write_gate, q_scale, key_s, query_s, forget_s, beta_s) {
    if (wid == 0) {
        delta_l2norm_to_smem(0, key_bf16, rh, lane, q_scale, key_s);
        ureg u64 fg_ptr = ptr_add(ptr_add(forget_gate, rh, 512), lane, 4);
        unroll (i = 0..4) {
            sts32(forget_s, lane + i * 32, u32_as_f32(ldg32_persist(ptr_add(fg_ptr, i * 32, 4))));
        }
        if (lane == 0) {
            sts32(beta_s, 0, u32_as_f32(ldg32_persist(ptr_add(write_gate, rh, 4))));
        }
    } else if (wid == 1) {
        delta_l2norm_to_smem(1, query_bf16, rh, lane, q_scale, query_s);
    }
    barrier();
}

macro delta_update_state_fast(DO_COMMIT, col_state, key_s, forget_s, query_s, s, coeff, total) {
    unroll (g = 0..32) {
        reg f32x4 kv = lds128(key_s, g * 4);
        reg f32x4 fv = lds128(forget_s, g * 4);
        reg f32x4 qv = lds128(query_s, g * 4);
        reg f32 n[4];
        unroll (j = 0..4) {
            n[j] = fma(fv[j], s[g * 4 + j], coeff * kv[j]);
        }
        if constexpr (DO_COMMIT == 1) {
            unroll (j = 0..4) {
                stg32_stream(ptr_add(col_state, g * 4 + j, 512), f32_as_u32(n[j]));
            }
        }
        unroll (j = 0..4) {
            total = fma(n[j], qv[j], total);
        }
    }
}

macro delta_decode1_fast_path(
    wid, lane, col, begin, head, key_heads, value_heads_per_key, commit, has_sri,
    sequence_row_indices, key_bf16, query_bf16, value_bf16, forget_gate, write_gate,
    output_bf16, col_state, q_scale, key_s, query_s, forget_s, beta_s
) {
    reg u32 current = begin;
    if (has_sri != 0) { current = ldg32_persist(ptr_add(sequence_row_indices, begin, 4)); }
    reg u32 rh = current * key_heads + head;
    delta_stage_step_smem(wid, lane, rh, key_bf16, query_bf16, forget_gate, write_gate, q_scale, key_s, query_s, forget_s, beta_s);
    reg f32 s[128];
    unroll (i = 0..128) {
        s[i] = u32_as_f32(ldg32_stream(ptr_add(col_state, i, 512)));
    }
    reg f32 pred = 0.0f;
    unroll (g = 0..32) {
        reg f32x4 kv = lds128(key_s, g * 4);
        reg f32x4 fv = lds128(forget_s, g * 4);
        unroll (j = 0..4) {
            pred = fma(s[g * 4 + j] * kv[j], fv[j], pred);
        }
    }
    ureg u64 v_row = ptr_add(value_bf16, rh * value_heads_per_key, 256);
    reg f32 val = bf16_lo(ldg16_persist(ptr_add(v_row, col, 2)));
    reg f32 coeff = lds32(beta_s, 0) * (val - pred);
    reg f32 total = 0.0f;
    if (commit != 0) {
        delta_update_state_fast(1, col_state, key_s, forget_s, query_s, s, coeff, total);
    } else {
        delta_update_state_fast(0, col_state, key_s, forget_s, query_s, s, coeff, total);
    }
    stg16(ptr_add(ptr_add(output_bf16, rh, 256), col, 2), f32_to_bf16(total));
}

@pdl
@concept(recurrent)
kernel[BLOCK_DELTA, 192] delta_rule_decode1_256_128_128_4_pdl(
    global u32* state_pool, u32 slot_bytes, global u32* state_index,
    global u32* sequence_row_begin, global u32* query_bf16, global u32* key_bf16,
    global u32* value_bf16, global u32* forget_gate, global u32* write_gate,
    global u32* output_bf16, u32 key_heads, u32 value_heads_per_key,
    u32 sequences, u32 commit, global u32* sequence_row_indices
) {
    shared f32 key_s[128];
    shared f32 query_s[128];
    shared f32 forget_s[128];
    shared f32 beta_s[4];

    reg u32 lane = lane_id();
    reg u32 wid = warp_id();
    reg u32 sequence = ctaid_x();
    reg u32 head = ctaid_y();
    reg u32 col = ((ctaid_z() << 2) + wid) * 32 + lane;
    if (sequence >= sequences || head >= key_heads || col >= 128) {
        preexit();
        return;
    }

    acqbulk();
    reg u32 has_srb = sequence_row_begin[0] | sequence_row_begin[1];
    reg u32 begin = sequence;
    reg u32 end = sequence + 1;
    if (has_srb != 0) {
        begin = ldg32_persist(ptr_add(sequence_row_begin, sequence, 4));
        end = ldg32_persist(ptr_add(sequence_row_begin, sequence + 1, 4));
    }
    reg u32 count = 0;
    if (end > begin) { count = end - begin; }
    if (count == 0) {
        preexit();
        return;
    }

    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 col_state = ptr_add(ptr_add(ptr_add(state_pool, sidx, slot_bytes), head, 65536), col, 4);
    reg f32 q_scale = 0.08838834613561630249f;
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];

    if (count == 1) {
        delta_decode1_fast_path(
            wid, lane, col, begin, head, key_heads, value_heads_per_key, commit, has_sri,
            sequence_row_indices, key_bf16, query_bf16, value_bf16, forget_gate, write_gate,
            output_bf16, col_state, q_scale, key_s, query_s, forget_s, beta_s
        );
        preexit();
        return;
    }

    for (reg u32 step = 0; step < count; step += 1) {
        reg u32 current = begin + step;
        if (has_sri != 0) { current = ldg32_persist(ptr_add(sequence_row_indices, begin + step, 4)); }
        reg u32 rh = current * key_heads + head;
        if (step != 0) { barrier(); }
        delta_stage_step_smem(wid, lane, rh, key_bf16, query_bf16, forget_gate, write_gate, q_scale, key_s, query_s, forget_s, beta_s);
        reg f32 pred = 0.0f;
        for (reg u32 k = 0; k < 128; k += 1) {
            reg f32 sv = u32_as_f32(ldg32_stream(ptr_add(col_state, k, 512)));
            pred = fma(sv * lds32(key_s, k), lds32(forget_s, k), pred);
        }
        ureg u64 v_row = ptr_add(value_bf16, rh * value_heads_per_key, 256);
        reg f32 val = bf16_lo(ldg16_persist(ptr_add(v_row, col, 2)));
        reg f32 coeff = lds32(beta_s, 0) * (val - pred);
        reg f32 total = 0.0f;
        for (reg u32 k = 0; k < 128; k += 1) {
            reg f32 sv = u32_as_f32(ldg32_stream(ptr_add(col_state, k, 512)));
            reg f32 nv = fma(lds32(forget_s, k), sv, coeff * lds32(key_s, k));
            if (commit != 0) { stg32_stream(ptr_add(col_state, k, 512), f32_as_u32(nv)); }
            total = fma(nv, lds32(query_s, k), total);
        }
        stg16(ptr_add(ptr_add(output_bf16, rh, 256), col, 2), f32_to_bf16(total));
    }
    preexit();
}

macro conv_seq_bounds(sequence, sequence_row_begin, sequence_row_count, out_begin, out_end) {
    reg u32 has_srb = sequence_row_begin[0] | sequence_row_begin[1];
    out_begin = sequence;
    out_end = sequence + 1;
    if (has_srb != 0) {
        out_begin = ldg32_persist(ptr_add(sequence_row_begin, sequence, 4));
        out_end = ldg32_persist(ptr_add(sequence_row_begin, sequence + 1, 4));
    }
    reg u32 has_src = sequence_row_count[0] | sequence_row_count[1];
    if (has_src != 0) {
        out_end = out_begin + ldg32_persist(ptr_add(sequence_row_count, sequence, 4));
    }
}

macro conv_tap4_swish_bf16(t0, t1, t2, t3, tw0, tw1, tw2, tw3, out_b) {
    reg f32 tot = t0 * tw0;
    tot = fma(t1, tw1, tot);
    tot = fma(t2, tw2, tot);
    tot = fma(t3, tw3, tot);
    reg f32 tr = bf16_lo(f32_to_bf16(tot));
    reg f32 sr = 0.0f;
    sigmoid_exact_f32(tr, sr);
    out_b = f32_to_bf16(tr * sr);
}

macro conv_tiled_tail_sync(tile, slot, channel, lane, group, live, count, commit, last_tile) {
    reg u32 need_sync = 0;
    if (last_tile == 0) { need_sync = 1; }
    if (commit != 0) { need_sync = 1; }
    if (need_sync != 0) {
        barrier();
        if (group == 0 && live != 0) {
            if (commit != 0 && last_tile != 0) {
                reg u32 c0 = lds32(tile, ((count - 1) << 5) + lane);
                reg u32 c1 = lds32(tile, (count << 5) + lane);
                reg u32 c2 = lds32(tile, ((count + 1) << 5) + lane);
                reg u32 c3 = lds32(tile, ((count + 2) << 5) + lane);
                stg64(ptr_add(slot, channel, 8), pack_u32x2(pack_u16x2(c0, c1), pack_u16x2(c2, c3)));
            }
            if (last_tile == 0) {
                sts32(tile, lane, lds32(tile, (count << 5) + lane));
                sts32(tile, 32 + lane, lds32(tile, ((count + 1) << 5) + lane));
                sts32(tile, 64 + lane, lds32(tile, ((count + 2) << 5) + lane));
            }
        }
    }
}

macro conv_split_store_out(channel, gdn_qk, gdn_v, row, heads, repeat, query_heads, key_heads, value, out_b) {
    if (channel < gdn_qk) {
        ureg u64 qd = ptr_add(ptr_add(query_heads, row * heads + (channel >> 7) * repeat, 256), channel & 127, 2);
        for (reg u32 r = 0; r < repeat; r += 1) { stg16(ptr_add(qd, r, 256), out_b); }
    } else if (channel < (gdn_qk << 1)) {
        reg u32 kc = channel - gdn_qk;
        ureg u64 kd = ptr_add(ptr_add(key_heads, row * heads + (kc >> 7) * repeat, 256), kc & 127, 2);
        for (reg u32 r = 0; r < repeat; r += 1) { stg16(ptr_add(kd, r, 256), out_b); }
    } else {
        stg16(ptr_add(ptr_add(value, row, gdn_v << 1), channel - (gdn_qk << 1), 2), out_b);
    }
}

macro conv_tiled_load_stage(IS_SPLIT, group, count, base, has_sri, sequence_row_indices, input_bf16, replay_qkv, input_stride, ch_bytes, channel, lane, tile) {
    for (reg u32 off = group; off < count; off += 8) {
        reg u32 row = base + off;
        if (has_sri != 0) { row = ldg32_persist(ptr_add(sequence_row_indices, base + off, 4)); }
        reg u32 in_val = 0;
        if constexpr (IS_SPLIT == 1) {
            in_val = ldg16_stream(ptr_add(ptr_add(input_bf16, row, input_stride << 1), channel, 2));
            reg u32 has_replay = replay_qkv[0] | replay_qkv[1];
            if (has_replay != 0) { stg16(ptr_add(ptr_add(replay_qkv, row, ch_bytes), channel, 2), in_val); }
        } else {
            in_val = ldg16_stream(ptr_add(ptr_add(input_bf16, row, ch_bytes), channel, 2));
        }
        sts32(tile, ((3 + off) << 5) + lane, in_val);
    }
}

macro conv_tiled_compute_stage(
    IS_SPLIT, group, count, base, has_sri, sequence_row_indices, tile, lane,
    tw0, tw1, tw2, tw3, channel, gdn_qk, gdn_v, heads, repeat, ch_bytes,
    query_heads, key_heads, value, output_bf16
) {
    for (reg u32 off = group; off < count; off += 8) {
        reg u32 row = base + off;
        if (has_sri != 0) { row = ldg32_persist(ptr_add(sequence_row_indices, base + off, 4)); }
        reg u32 out_b = 0;
        conv_tap4_swish_bf16(
            bf16_lo(lds32(tile, (off << 5) + lane)),
            bf16_lo(lds32(tile, ((off + 1) << 5) + lane)),
            bf16_lo(lds32(tile, ((off + 2) << 5) + lane)),
            bf16_lo(lds32(tile, ((off + 3) << 5) + lane)),
            tw0, tw1, tw2, tw3, out_b
        );
        if constexpr (IS_SPLIT == 1) {
            conv_split_store_out(channel, gdn_qk, gdn_v, row, heads, repeat, query_heads, key_heads, value, out_b);
        } else {
            stg16(ptr_add(ptr_add(output_bf16, row, ch_bytes), channel, 2), out_b);
        }
    }
}

macro conv_load_4weights(live, weight, channel, tw0, tw1, tw2, tw3) {
    if (live != 0) {
        reg u32x2 w2 = ldg64_persist(ptr_add(weight, channel, 8));
        tw0 = bf16_lo(w2[0]); tw1 = bf16_hi(w2[0]);
        tw2 = bf16_lo(w2[1]); tw3 = bf16_hi(w2[1]);
    }
}

macro conv_tiled_init_window(group, live, slot, channel, lane, tile) {
    if (group == 0 && live != 0) {
        reg u32x2 w = ldg64_stream(ptr_add(slot, channel, 8));
        sts32(tile, lane, w[0] >> 16);
        sts32(tile, 32 + lane, w[1] & 0xFFFF);
        sts32(tile, 64 + lane, w[1] >> 16);
    }
}

macro conv_tiled_repeat_factor(IS_SPLIT, gdn_qk, heads, out_repeat) {
    out_repeat = 1;
    if constexpr (IS_SPLIT == 1) {
        reg u32 qk_heads = gdn_qk >> 7;
        if (qk_heads > 0 && qk_heads != heads) {
            reg u32 rq = 0;
            reg u32 rrem = 0;
            u32_divmod(heads, qk_heads, rq, rrem);
            out_repeat = rq;
        }
    }
}

@pdl
@concept(recurrent)
template kernel[BLOCK_CONV, REGS] causal_conv_tiled_pdl<IS_SPLIT, REGS>(
    global u32* window, global u32* state_index, global u32* sequence_row_begin,
    global u32* sequence_row_count, global u32* input_bf16, global u32* weight,
    if (IS_SPLIT == 1) global u32* query_heads,
    if (IS_SPLIT == 1) global u32* key_heads,
    if (IS_SPLIT == 1) global u32* value,
    if (IS_SPLIT == 1) global u32* replay_qkv,
    if (IS_SPLIT == 1) u32 gdn_qk,
    if (IS_SPLIT == 1) u32 gdn_v,
    if (IS_SPLIT == 1) u32 heads,
    if (IS_SPLIT == 1) u32 input_stride,
    if (IS_SPLIT == 0) global u32* output_bf16,
    if (IS_SPLIT == 0) u32 channels_in,
    u32 sequences, u32 commit, global u32* sequence_row_indices
) {
    shared u32 tile[2144];
    reg u32 sequence = ctaid_x();
    if (sequence >= sequences) {
        acqbulk();
        preexit();
        return;
    }
    reg u32 tid = tid_x();
    reg u32 lane = tid & 31;
    reg u32 group = tid >> 5;
    reg u32 channels = 0;
    if constexpr (IS_SPLIT == 1) { channels = (gdn_qk << 1) + gdn_v; } else { channels = channels_in; }
    reg u32 channel = (ctaid_y() << 5) + lane;
    reg u32 live = 0;
    if (channel < channels) { live = 1; }
    reg f32 tw0 = 0.0f; reg f32 tw1 = 0.0f; reg f32 tw2 = 0.0f; reg f32 tw3 = 0.0f;
    conv_load_4weights(live, weight, channel, tw0, tw1, tw2, tw3);
    acqbulk();
    reg u32 repeat = 1;
    if constexpr (IS_SPLIT == 1) { conv_tiled_repeat_factor(1, gdn_qk, heads, repeat); }
    reg u32 begin = 0;
    reg u32 end = 0;
    conv_seq_bounds(sequence, sequence_row_begin, sequence_row_count, begin, end);
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 slot = ptr_add(window, sidx, channels << 3);
    reg u32 ch_bytes = channels << 1;
    conv_tiled_init_window(group, live, slot, channel, lane, tile);
    for (reg u32 base = begin; base < end; base += 64) {
        reg u32 rem_rows = end - base;
        reg u32 count = 64;
        if (rem_rows < 64) { count = rem_rows; }
        if (base != begin) { barrier(); }
        if (live != 0) {
            if constexpr (IS_SPLIT == 1) {
                conv_tiled_load_stage(1, group, count, base, has_sri, sequence_row_indices, input_bf16, replay_qkv, input_stride, ch_bytes, channel, lane, tile);
            } else {
                conv_tiled_load_stage(0, group, count, base, has_sri, sequence_row_indices, input_bf16, input_bf16, 0, ch_bytes, channel, lane, tile);
            }
        }
        barrier();
        if (live != 0) {
            if constexpr (IS_SPLIT == 1) {
                conv_tiled_compute_stage(1, group, count, base, has_sri, sequence_row_indices, tile, lane, tw0, tw1, tw2, tw3, channel, gdn_qk, gdn_v, heads, repeat, ch_bytes, query_heads, key_heads, value, input_bf16);
            } else {
                conv_tiled_compute_stage(0, group, count, base, has_sri, sequence_row_indices, tile, lane, tw0, tw1, tw2, tw3, channel, 0, 0, 0, repeat, ch_bytes, output_bf16, output_bf16, output_bf16, output_bf16);
            }
        }
        reg u32 last_tile = 0;
        if (base + count == end) { last_tile = 1; }
        conv_tiled_tail_sync(tile, slot, channel, lane, group, live, count, commit, last_tile);
    }
    preexit();
}

instantiate causal_conv_tiled_pdl<1, 56> as gdn_conv_split_tiled_4_128_pdl;
instantiate causal_conv_tiled_pdl<0, 48> as causal_conv_tiled_4_swish_bf16_pdl;

macro conv_load_parent_tap(anc, miss, miss_val, slot_off, input_bf16, parent_rows, slot, ch_bytes, channel, advance, out_tap) {
    if (anc != 0xFFFFFFFF) {
        out_tap = ldg16_stream(ptr_add(ptr_add(input_bf16, anc, ch_bytes), channel, 2));
        if constexpr (advance == 1) { anc = ldg32_persist(ptr_add(parent_rows, anc, 4)); }
    } else {
        if (miss == 4) { miss = miss_val; }
        out_tap = ldg16_stream(ptr_add(slot, (channel << 2) + slot_off + miss, 2));
    }
}

@pdl
@concept(recurrent)
kernel[BLOCK_CONV, 48] causal_conv_serial_256_4_swish_bf16_pdl(
    global u32* window, global u32* state_index, global u32* sequence_row_begin,
    global u32* sequence_row_count, global u32* input_bf16, global u32* weight,
    global u32* output_bf16, u32 channels, u32 sequences, u32 commit,
    global u32* sequence_row_indices, global u32* parent_rows
) {
    reg u32 sequence = ctaid_x();
    reg u32 channel = ctaid_y() * BLOCK_CONV + tid_x();
    if (sequence >= sequences || channel >= channels) {
        preexit();
        return;
    }
    reg u32x2 w2 = ldg64_persist(ptr_add(weight, channel, 8));
    reg f32 tw0 = bf16_lo(w2[0]); reg f32 tw1 = bf16_hi(w2[0]);
    reg f32 tw2 = bf16_lo(w2[1]); reg f32 tw3 = bf16_hi(w2[1]);
    acqbulk();
    reg u32 begin = 0;
    reg u32 end = 0;
    conv_seq_bounds(sequence, sequence_row_begin, sequence_row_count, begin, end);
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];
    reg u32 has_par = parent_rows[0] | parent_rows[1];
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 slot = ptr_add(window, sidx, channels << 3);
    reg u32x2 sw = ldg64_stream(ptr_add(slot, channel, 8));
    reg u32 tap0 = sw[0] & 0xFFFF; reg u32 tap1 = sw[0] >> 16;
    reg u32 tap2 = sw[1] & 0xFFFF; reg u32 tap3 = sw[1] >> 16;
    reg u32 ch_bytes = channels << 1;
    for (reg u32 ordinal = begin; ordinal < end; ordinal += 1) {
        reg u32 row = ordinal;
        if (has_sri != 0) { row = ldg32_persist(ptr_add(sequence_row_indices, ordinal, 4)); }
        if (has_par != 0) {
            reg u32 anc = row;
            reg u32 miss = 4;
            conv_load_parent_tap(anc, miss, 0, 3, input_bf16, parent_rows, slot, ch_bytes, channel, 1, tap3);
            conv_load_parent_tap(anc, miss, 1, 2, input_bf16, parent_rows, slot, ch_bytes, channel, 1, tap2);
            conv_load_parent_tap(anc, miss, 2, 1, input_bf16, parent_rows, slot, ch_bytes, channel, 1, tap1);
            conv_load_parent_tap(anc, miss, 3, 0, input_bf16, parent_rows, slot, ch_bytes, channel, 0, tap0);
        } else {
            tap0 = tap1; tap1 = tap2; tap2 = tap3;
            tap3 = ldg16_stream(ptr_add(ptr_add(input_bf16, row, ch_bytes), channel, 2));
        }
        reg u32 out_b = 0;
        conv_tap4_swish_bf16(bf16_lo(tap0), bf16_lo(tap1), bf16_lo(tap2), bf16_lo(tap3), tw0, tw1, tw2, tw3, out_b);
        stg16(ptr_add(ptr_add(output_bf16, row, ch_bytes), channel, 2), out_b);
    }
    if (commit != 0 && has_par == 0) {
        stg64(ptr_add(slot, channel, 8), pack_u32x2(pack_u16x2(tap0, tap1), pack_u16x2(tap2, tap3)));
    }
    preexit();
}

macro gdn_write_head_gates(row, head, heads, lane, ba, a_val, dt_val, retention, write_gate) {
    reg f32 factor = 0.0f;
    if (lane == 0) {
        reg u32 ba_base = row * (heads << 1);
        reg f32 shifted = bf16_lo(ldg16_stream(ptr_add(ba, ba_base + heads + head, 2))) + dt_val;
        gdn_decay_f32(a_val, shifted, factor);
        reg f32 beta = 0.0f;
        sigmoid_exact_f32(bf16_lo(ldg16_stream(ptr_add(ba, ba_base + head, 2))), beta);
        stg32(ptr_add(write_gate, row * heads + head, 4), f32_as_u32(beta));
    }
    factor = shfl_idx(factor, 0);
    reg u32 fb = f32_as_u32(factor);
    stg128(ptr_add(retention, ((row * heads + head) << 5) + lane, 16), pack_u32x4(fb, fb, fb, fb));
}

@pdl
@concept(recurrent)
kernel[BLOCK_CONV, 64] qwen_gdn_conv_split_serial_4_128_pdl(
    global u32* window, global u32* state_index, global u32* sequence_row_begin,
    global u32* sequence_row_count, global u32* input_bf16, global u32* weight,
    global u32* ba, global u32* a_log, global u32* dt_bias,
    global u32* query_heads, global u32* key_heads, global u32* value,
    global u32* retention, global u32* write_gate, global u32* replay_qkv,
    u32 gdn_qk, u32 gdn_v, u32 heads, u32 input_stride, u32 conv_blocks,
    u32 sequences, u32 commit, global u32* sequence_row_indices
) {
    reg u32 sequence = ctaid_x();
    if (sequence >= sequences) {
        acqbulk();
        preexit();
        return;
    }
    reg u32 by = ctaid_y();
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];
    if (by >= conv_blocks) {
        reg u32 wid = warp_id();
        reg u32 lane = lane_id();
        reg u32 head = (by - conv_blocks) * 8 + wid;
        acqbulk();
        if (head < heads) {
            reg u32 begin = 0; reg u32 end = 0;
            conv_seq_bounds(sequence, sequence_row_begin, sequence_row_count, begin, end);
            reg f32 a_val = u32_as_f32(ldg32_persist(ptr_add(a_log, head, 4)));
            reg f32 dt_val = u32_as_f32(ldg32_persist(ptr_add(dt_bias, head, 4)));
            for (reg u32 ord = begin; ord < end; ord += 1) {
                reg u32 row = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, ord, 4)) : ord;
                gdn_write_head_gates(row, head, heads, lane, ba, a_val, dt_val, retention, write_gate);
            }
        }
        preexit();
        return;
    }
    reg u32 channels = (gdn_qk << 1) + gdn_v;
    reg u32 channel = by * BLOCK_CONV + tid_x();
    if (channel >= channels) {
        acqbulk();
        preexit();
        return;
    }
    reg u32x2 w2 = ldg64_persist(ptr_add(weight, channel, 8));
    reg f32 tw0 = bf16_lo(w2[0]); reg f32 tw1 = bf16_hi(w2[0]);
    reg f32 tw2 = bf16_lo(w2[1]); reg f32 tw3 = bf16_hi(w2[1]);
    acqbulk();
    reg u32 repeat = 1;
    conv_tiled_repeat_factor(1, gdn_qk, heads, repeat);
    reg u32 begin = 0; reg u32 end = 0;
    conv_seq_bounds(sequence, sequence_row_begin, sequence_row_count, begin, end);
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 slot = ptr_add(window, sidx, channels << 3);
    reg u32x2 sw = ldg64_stream(ptr_add(slot, channel, 8));
    reg u32 tap0 = sw[0] & 0xFFFF; reg u32 tap1 = sw[0] >> 16;
    reg u32 tap2 = sw[1] & 0xFFFF; reg u32 tap3 = sw[1] >> 16;
    reg u32 has_replay = replay_qkv[0] | replay_qkv[1];
    for (reg u32 ord = begin; ord < end; ord += 1) {
        reg u32 row = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, ord, 4)) : ord;
        tap0 = tap1; tap1 = tap2; tap2 = tap3;
        tap3 = ldg16_stream(ptr_add(ptr_add(input_bf16, row, input_stride << 1), channel, 2));
        if (has_replay != 0) { stg16(ptr_add(ptr_add(replay_qkv, row, channels << 1), channel, 2), tap3); }
        reg u32 out_b = 0;
        conv_tap4_swish_bf16(bf16_lo(tap0), bf16_lo(tap1), bf16_lo(tap2), bf16_lo(tap3), tw0, tw1, tw2, tw3, out_b);
        conv_split_store_out(channel, gdn_qk, gdn_v, row, heads, repeat, query_heads, key_heads, value, out_b);
    }
    if (commit != 0) {
        stg64(ptr_add(slot, channel, 8), pack_u32x2(pack_u16x2(tap0, tap1), pack_u16x2(tap2, tap3)));
    }
    preexit();
}

macro conv_prefill_load_stage(group, live, tile_idx, count, base, has_sri, sequence_row_indices, slot, input_bf16, input_stride, channel, lane, tile) {
    if (group == 0 && live != 0) {
        if (tile_idx == 0) {
            conv_tiled_init_window(0, 1, slot, channel, lane, tile);
        } else {
            unroll (tap = 0..3) {
                reg u32 ho = base - 3 + tap;
                reg u32 hr = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, ho, 4)) : ho;
                sts32(tile, (tap << 5) + lane, ldg16_persist(ptr_add(ptr_add(input_bf16, hr, input_stride << 1), channel, 2)));
            }
        }
    }
    for (reg u32 off = group; off < count; off += 8) {
        if (live != 0) {
            reg u32 row = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, base + off, 4)) : (base + off);
            sts32(tile, ((3 + off) << 5) + lane, ldg16_persist(ptr_add(ptr_add(input_bf16, row, input_stride << 1), channel, 2)));
        }
    }
    barrier();
}

macro conv_prefill_compute_stage(group, live, count, base, has_sri, sequence_row_indices, tile, lane, tw0, tw1, tw2, tw3, channel, gdn_qk, gdn_v, query_qk, key_qk, value) {
    for (reg u32 off = group; off < count; off += 8) {
        if (live != 0) {
            reg u32 row = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, base + off, 4)) : (base + off);
            reg u32 out_b = 0;
            conv_tap4_swish_bf16(
                bf16_lo(lds32(tile, (off << 5) + lane)), bf16_lo(lds32(tile, ((off + 1) << 5) + lane)),
                bf16_lo(lds32(tile, ((off + 2) << 5) + lane)), bf16_lo(lds32(tile, ((off + 3) << 5) + lane)),
                tw0, tw1, tw2, tw3, out_b
            );
            if (channel < gdn_qk) { stg16(ptr_add(ptr_add(query_qk, row, gdn_qk << 1), channel, 2), out_b); }
            else if (channel < (gdn_qk << 1)) { stg16(ptr_add(ptr_add(key_qk, row, gdn_qk << 1), channel - gdn_qk, 2), out_b); }
            else { stg16(ptr_add(ptr_add(value, row, gdn_v << 1), channel - (gdn_qk << 1), 2), out_b); }
        }
    }
}

@pdl
@concept(recurrent)
kernel[BLOCK_CONV, 56] qwen_gdn_conv_prefill_2d_4_128_pdl(
    global u32* window, global u32* state_index, global u32* sequence_row_begin,
    global u32* sequence_row_count, global u32* input_bf16, global u32* weight,
    global u32* query_qk, global u32* key_qk, global u32* value,
    u32 gdn_qk, u32 gdn_v, u32 input_stride, u32 sequences,
    u32 commit_inline, global u32* sequence_row_indices
) {
    shared u32 tile[2144];
    reg u32 sequence = ctaid_x();
    if (sequence >= sequences) { acqbulk(); preexit(); return; }
    reg u32 tid = tid_x();
    reg u32 lane = tid & 31;
    reg u32 group = tid >> 5;
    reg u32 channels = (gdn_qk << 1) + gdn_v;
    reg u32 channel = (ctaid_y() << 5) + lane;
    reg u32 live = (channel < channels) ? 1 : 0;
    reg f32 tw0 = 0.0f; reg f32 tw1 = 0.0f; reg f32 tw2 = 0.0f; reg f32 tw3 = 0.0f;
    conv_load_4weights(live, weight, channel, tw0, tw1, tw2, tw3);
    acqbulk();
    reg u32 begin = 0; reg u32 end = 0;
    conv_seq_bounds(sequence, sequence_row_begin, sequence_row_count, begin, end);
    reg u32 tile_idx = ctaid_z();
    reg u32 base = begin + (tile_idx << 6);
    if (base >= end) { preexit(); return; }
    reg u32 count = (end - base < 64) ? (end - base) : 64;
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 slot = ptr_add(window, sidx, channels << 3);
    conv_prefill_load_stage(group, live, tile_idx, count, base, has_sri, sequence_row_indices, slot, input_bf16, input_stride, channel, lane, tile);
    conv_prefill_compute_stage(group, live, count, base, has_sri, sequence_row_indices, tile, lane, tw0, tw1, tw2, tw3, channel, gdn_qk, gdn_v, query_qk, key_qk, value);
    if (commit_inline != 0 && base + count == end) {
        barrier();
        if (group == 0 && live != 0) {
            reg u32 c0 = lds32(tile, ((count - 1) << 5) + lane);
            reg u32 c1 = lds32(tile, (count << 5) + lane);
            reg u32 c2 = lds32(tile, ((count + 1) << 5) + lane);
            reg u32 c3 = lds32(tile, ((count + 2) << 5) + lane);
            stg64(ptr_add(slot, channel, 8), pack_u32x2(pack_u16x2(c0, c1), pack_u16x2(c2, c3)));
        }
    }
    preexit();
}

@pdl
@concept(recurrent)
kernel[BLOCK_CONV, 48] qwen_gdn_conv_window_commit_4_pdl(
    global u32* window, global u32* state_index, global u32* sequence_row_begin,
    global u32* sequence_row_count, global u32* input_bf16,
    u32 channels, u32 input_stride, u32 sequences, global u32* sequence_row_indices
) {
    acqbulk();
    reg u32 sequence = ctaid_x();
    reg u32 channel = ctaid_y() * BLOCK_CONV + tid_x();
    if (sequence >= sequences || channel >= channels) {
        preexit();
        return;
    }
    reg u32 begin = 0; reg u32 end = 0;
    conv_seq_bounds(sequence, sequence_row_begin, sequence_row_count, begin, end);
    if (end <= begin) {
        preexit();
        return;
    }
    reg u32 count = end - begin;
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 slot = ptr_add(window, sidx, channels << 3);
    reg u32 o[4];
    if (count >= 4) {
        unroll (tap = 0..4) {
            reg u32 ord = end - 4 + tap;
            reg u32 r = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, ord, 4)) : ord;
            o[tap] = ldg16_persist(ptr_add(ptr_add(input_bf16, r, input_stride << 1), channel, 2));
        }
    } else {
        reg u32x2 pv = ldg64_stream(ptr_add(slot, channel, 8));
        unroll (tap = 0..4) {
            reg u32 idx = count + tap;
            if (idx < 4) {
                reg u32 word = (idx < 2) ? pv[0] : pv[1];
                o[tap] = ((idx & 1) == 0) ? (word & 0xFFFF) : (word >> 16);
            } else {
                reg u32 ord = begin + idx - 4;
                reg u32 r = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, ord, 4)) : ord;
                o[tap] = ldg16_persist(ptr_add(ptr_add(input_bf16, r, input_stride << 1), channel, 2));
            }
        }
    }
    stg64(ptr_add(slot, channel, 8), pack_u32x2(pack_u16x2(o[0], o[1]), pack_u16x2(o[2], o[3])));
    preexit();
}

@pdl
@concept(recurrent)
kernel[BLOCK_CONV, 40] qwen_gdn_gate_only_128_pdl(
    global u32* ba, global u32* a_log, global u32* dt_bias,
    global u32* retention, global u32* write_gate, u32 heads, u32 rows
) {
    acqbulk();
    reg u32 head = ctaid_x() * 8 + warp_id();
    reg u32 row = ctaid_y();
    if (row < rows && head < heads) {
        reg f32 a_val = u32_as_f32(ldg32_persist(ptr_add(a_log, head, 4)));
        reg f32 dt_val = u32_as_f32(ldg32_persist(ptr_add(dt_bias, head, 4)));
        gdn_write_head_gates(row, head, heads, lane_id(), ba, a_val, dt_val, retention, write_gate);
    }
    preexit();
}

@pdl
@concept(recurrent)
kernel[BLOCK_CONV, 56] qwen_gdn_split_expand_gate_256_128_pdl(
    global u32* qkv, global u32* ba, global u32* a_log, global u32* dt_bias,
    global u32* query_heads, global u32* key_heads, global u32* value,
    global u32* retention, global u32* write_gate,
    u32 gdn_qk, u32 gdn_v, u32 heads, u32 rows
) {
    acqbulk();
    reg u32 row = ctaid_x();
    if (row >= rows) {
        preexit();
        return;
    }
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 repeat = 1;
    conv_tiled_repeat_factor(1, gdn_qk, heads, repeat);
    reg u32 total_ch = (gdn_qk << 1) + gdn_v;
    ureg u64 src4 = ptr_add(qkv, row, total_ch << 1);
    reg u32 qk_v = gdn_qk >> 3;
    reg u32 v_v = gdn_v >> 3;
    ureg u64 qh4 = ptr_add(query_heads, row * heads, 256);
    ureg u64 kh4 = ptr_add(key_heads, row * heads, 256);
    ureg u64 val4 = ptr_add(value, row, gdn_v << 1);
    for (reg u32 c = tid; c < qk_v; c += BLOCK_CONV) {
        reg u32 h = c >> 4;
        reg u32 wi = c & 15;
        reg u32x4 qv = ldg128_stream(ptr_add(src4, c, 16));
        reg u32x4 kv = ldg128_stream(ptr_add(src4, qk_v + c, 16));
        for (reg u32 r = 0; r < repeat; r += 1) {
            reg u32 d = ((h * repeat + r) << 4) + wi;
            stg128(ptr_add(qh4, d, 16), qv);
            stg128(ptr_add(kh4, d, 16), kv);
        }
    }
    for (reg u32 c = tid; c < v_v; c += BLOCK_CONV) {
        stg128(ptr_add(val4, c, 16), ldg128_stream(ptr_add(src4, (qk_v << 1) + c, 16)));
    }
    for (reg u32 h = wid; h < heads; h += 8) {
        reg f32 a_val = u32_as_f32(ldg32_persist(ptr_add(a_log, h, 4)));
        reg f32 dt_val = u32_as_f32(ldg32_persist(ptr_add(dt_bias, h, 4)));
        gdn_write_head_gates(row, h, heads, lane, ba, a_val, dt_val, retention, write_gate);
    }
    preexit();
}

macro gdn_seq_prologue(a_log, dt_bias, head, sequence, sequence_row_begin, sequence_row_count, sequence_row_indices, out_a, out_dt, out_begin, out_end, out_sri) {
    out_a = u32_as_f32(ldg32_persist(ptr_add(a_log, head, 4)));
    out_dt = u32_as_f32(ldg32_persist(ptr_add(dt_bias, head, 4)));
    acqbulk();
    conv_seq_bounds(sequence, sequence_row_begin, sequence_row_count, out_begin, out_end);
    out_sri = sequence_row_indices[0] | sequence_row_indices[1];
}

macro gdn_qk_head_of(head, heads, qk_heads, out_qk_head) {
    reg u32 rep = 1; reg u32 rep_r = 0;
    u32_divmod(heads, qk_heads, rep, rep_r);
    reg u32 qk_r = 0;
    u32_divmod(head, rep, out_qk_head, qk_r);
}

macro gdn_edge_bounds(PRE_EDGE, begin, end, positions, sequence_row_indices, has_sri, out_eb, out_ec) {
    out_eb = begin;
    out_ec = 0;
    if (end > begin) {
        reg u32 count = end - begin;
        reg u32 row0 = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, begin, 4)) : begin;
        reg u32 pos0 = ((positions[0] | positions[1]) != 0) ? ldg32_persist(ptr_add(positions, row0, 4)) : 0;
        reg u32 rem = pos0 & 31;
        reg u32 lead = (rem != 0) ? ((32 - rem < count) ? (32 - rem) : count) : 0;
        reg u32 mid_end = lead + ((count - lead) & 0xFFFFFFE0);
        if constexpr (PRE_EDGE == 1) {
            out_eb = begin;
            out_ec = lead;
        } else {
            out_eb = begin + mid_end;
            out_ec = count - mid_end;
        }
    }
}

macro gdn_edge_step(wid, lane, row, qk_rh, head, heads, col_base, a_val, dt_val, key_qk, query_qk, value_bf16, ba_bf16, output_bf16, state_s, key_s, query_s, forget_s, value_s, coeff_s, beta_s) {
    if (wid == 0) {
        delta_l2norm_to_smem(0, key_qk, qk_rh, lane, 0.08838834613561630249f, key_s);
        reg f32 fac = 0.0f;
        if (lane == 0) {
            reg u32 bab = row * (heads << 1);
            gdn_decay_f32(a_val, bf16_lo(ldg16_persist(ptr_add(ba_bf16, bab + heads + head, 2))) + dt_val, fac);
            reg f32 bv = 0.0f;
            sigmoid_exact_f32(bf16_lo(ldg16_persist(ptr_add(ba_bf16, bab + head, 2))), bv);
            sts32(beta_s, 0, bv);
        }
        fac = shfl_idx(fac, 0);
        unroll (p = 0..4) { sts32(forget_s, (p << 5) + lane, fac); }
    } else if (wid == 1) {
        delta_l2norm_to_smem(1, query_qk, qk_rh, lane, 0.08838834613561630249f, query_s);
        sts32(value_s, lane, bf16_lo(ldg16_persist(ptr_add(ptr_add(value_bf16, row * heads + head, 256), col_base + lane, 2))));
    }
    barrier();
    if (wid == 0) {
        reg f32 pr = 0.0f;
        for (reg u32 k = 0; k < 128; k += 1) {
            pr = fma(lds32(state_s, (k << 5) + lane) * lds32(key_s, k), lds32(forget_s, k), pr);
        }
        sts32(coeff_s, lane, lds32(beta_s, 0) * (lds32(value_s, lane) - pr));
    }
    barrier();
    reg f32 cf = lds32(coeff_s, lane);
    for (reg u32 k = wid << 5; k < (wid + 1) << 5; k += 1) {
        reg f32 nv = fma(lds32(forget_s, k), lds32(state_s, (k << 5) + lane), cf * lds32(key_s, k));
        sts32(state_s, (k << 5) + lane, nv);
    }
    barrier();
    if (wid == 0) {
        reg f32 tot = 0.0f;
        for (reg u32 k = 0; k < 128; k += 1) {
            tot = fma(lds32(state_s, (k << 5) + lane), lds32(query_s, k), tot);
        }
        stg16(ptr_add(ptr_add(output_bf16, row * heads + head, 256), col_base + lane, 2), f32_to_bf16(tot));
    }
    barrier();
}

@pdl
@concept(recurrent)
template kernel[BLOCK_DELTA, 80] qwen_gdn_exact_edge_tpl<PRE_EDGE>(
    global u32* state_pool, u32 slot_bytes, global u32* state_index,
    global u32* sequence_row_begin, global u32* sequence_row_count, global u32* positions,
    global u32* query_qk, global u32* key_qk, global u32* value_bf16,
    global u32* ba_bf16, global u32* a_log, global u32* dt_bias,
    global u32* output_bf16, u32 qk_heads, u32 heads, u32 sequences,
    u32 commit, global u32* sequence_row_indices
) {
    shared f32 state_s[4096];
    shared f32 key_s[128];
    shared f32 query_s[128];
    shared f32 forget_s[128];
    shared f32 value_s[32];
    shared f32 coeff_s[32];
    shared f32 beta_s[4];
    reg u32 sequence = ctaid_x();
    reg u32 head = ctaid_y();
    reg u32 col_base = ctaid_z() << 5;
    if (sequence >= sequences || head >= heads || col_base >= 128) { acqbulk(); preexit(); return; }
    reg f32 a_val = 0.0f; reg f32 dt_val = 0.0f;
    reg u32 begin = 0; reg u32 end = 0; reg u32 has_sri = 0;
    gdn_seq_prologue(a_log, dt_bias, head, sequence, sequence_row_begin, sequence_row_count, sequence_row_indices, a_val, dt_val, begin, end, has_sri);
    reg u32 eb = 0; reg u32 ec = 0;
    gdn_edge_bounds(PRE_EDGE, begin, end, positions, sequence_row_indices, has_sri, eb, ec);
    if (ec == 0) { preexit(); return; }
    reg u32 qk_head = 0;
    gdn_qk_head_of(head, heads, qk_heads, qk_head);
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 state_p = ptr_add(ptr_add(state_pool, sidx, slot_bytes), head, 65536);
    for (reg u32 idx = tid; idx < 4096; idx += BLOCK_DELTA) {
        sts32(state_s, idx, u32_as_f32(ldg32_stream(ptr_add(state_p, ((idx >> 5) << 7) + col_base + (idx & 31), 4))));
    }
    barrier();
    for (reg u32 step = 0; step < ec; step += 1) {
        reg u32 row = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, eb + step, 4)) : (eb + step);
        gdn_edge_step(wid, lane, row, row * qk_heads + qk_head, head, heads, col_base, a_val, dt_val, key_qk, query_qk, value_bf16, ba_bf16, output_bf16, state_s, key_s, query_s, forget_s, value_s, coeff_s, beta_s);
    }
    if (commit != 0) {
        for (reg u32 idx = tid; idx < 4096; idx += BLOCK_DELTA) {
            stg32_stream(ptr_add(state_p, ((idx >> 5) << 7) + col_base + (idx & 31), 4), f32_as_u32(lds32(state_s, idx)));
        }
    }
    preexit();
}

instantiate qwen_gdn_exact_edge_tpl<1> as qwen_gdn_exact_edge_pre_128_128_pdl;
instantiate qwen_gdn_exact_edge_tpl<0> as qwen_gdn_exact_edge_post_128_128_pdl;

macro gdn_chunk_load_norm(wid, lane, tid, rows, begin, first, has_sri, sequence_row_indices, key_qk, query_qk, value_bf16, ba_bf16, qk_head, qk_heads, head, heads, a_val, dt_val) {
    for (reg u32 rw = wid; rw < rows; rw += 8) {
        reg u32 r = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, begin + first + rw, 4)) : (begin + first + rw);
        reg u32 qk_rh = r * qk_heads + qk_head;
        reg u32x2 rk = ldg64_stream(ptr_add(ptr_add(key_qk, qk_rh, 256), lane, 8));
        reg u32x2 rq = ldg64_stream(ptr_add(ptr_add(query_qk, qk_rh, 256), lane, 8));
        reg f32 k0 = bf16_lo(rk[0]); reg f32 k1 = bf16_hi(rk[0]); reg f32 k2 = bf16_lo(rk[1]); reg f32 k3 = bf16_hi(rk[1]);
        reg f32 q0 = bf16_lo(rq[0]); reg f32 q1 = bf16_hi(rq[0]); reg f32 q2 = bf16_lo(rq[1]); reg f32 q3 = bf16_hi(rq[1]);
        reg f32 ki = rsqrt(warp_sum(fma(k0, k0, fma(k1, k1, fma(k2, k2, k3 * k3)))) + 1.0e-6f);
        reg f32 qi = rsqrt(warp_sum(fma(q0, q0, fma(q1, q1, fma(q2, q2, q3 * q3)))) + 1.0e-6f) * 0.08838834613561630249f;
        reg u32 bo = (rw << 7) + (lane << 2);
        dyn_sts32(bo, f32_as_u32(k0 * ki)); dyn_sts32(bo + 1, f32_as_u32(k1 * ki));
        dyn_sts32(bo + 2, f32_as_u32(k2 * ki)); dyn_sts32(bo + 3, f32_as_u32(k3 * ki));
        dyn_sts32(4096 + bo, f32_as_u32(q0 * qi)); dyn_sts32(4096 + bo + 1, f32_as_u32(q1 * qi));
        dyn_sts32(4096 + bo + 2, f32_as_u32(q2 * qi)); dyn_sts32(4096 + bo + 3, f32_as_u32(q3 * qi));
        reg u32x2 rv = ldg64_stream(ptr_add(ptr_add(value_bf16, r * heads + head, 256), lane, 8));
        dyn_sts32(8192 + bo, f32_as_u32(bf16_lo(rv[0]))); dyn_sts32(8192 + bo + 1, f32_as_u32(bf16_hi(rv[0])));
        dyn_sts32(8192 + bo + 2, f32_as_u32(bf16_lo(rv[1]))); dyn_sts32(8192 + bo + 3, f32_as_u32(bf16_hi(rv[1])));
    }
    if (tid < rows) {
        reg u32 r = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, begin + first + tid, 4)) : (begin + first + tid);
        reg u32 bab = r * (heads << 1);
        reg f32 dec = 0.0f; reg f32 bv = 0.0f;
        gdn_decay_f32(a_val, bf16_lo(ldg16_persist(ptr_add(ba_bf16, bab + heads + head, 2))) + dt_val, dec);
        sigmoid_exact_f32(bf16_lo(ldg16_persist(ptr_add(ba_bf16, bab + head, 2))), bv);
        dyn_sts32(12288 + tid, f32_as_u32(dec));
        dyn_sts32(12320 + tid, f32_as_u32(bv));
        dyn_sts32(12352 + tid, r);
    }
    barrier();
}

@pdl
@concept(recurrent)
kernel[BLOCK_CONV, 120] qwen_gdn_scalar_chunk_128_128_128_pdl(
    global u32* state_pool, u32 slot_bytes, global u32* state_index,
    global u32* sequence_row_begin, global u32* sequence_row_count, global u32* positions,
    global u32* query_qk, global u32* key_qk, global u32* value_bf16,
    global u32* ba_bf16, global u32* a_log, global u32* dt_bias,
    global u32* output_bf16, u32 qk_heads, u32 heads, u32 sequences,
    u32 commit, global u32* sequence_row_indices
) {
    reg u32 sequence = ctaid_x();
    reg u32 head = ctaid_y();
    if (sequence >= sequences || head >= heads || ctaid_z() != 0) {
        acqbulk();
        preexit();
        return;
    }
    reg f32 a_val = 0.0f; reg f32 dt_val = 0.0f;
    reg u32 begin = 0; reg u32 end = 0; reg u32 has_sri = 0;
    gdn_seq_prologue(a_log, dt_bias, head, sequence, sequence_row_begin, sequence_row_count, sequence_row_indices, a_val, dt_val, begin, end, has_sri);
    reg u32 count = (end > begin) ? (end - begin) : 0;
    if (count != 0 && (positions[0] | positions[1]) != 0) {
        reg u32 row0 = (has_sri != 0) ? ldg32_persist(ptr_add(sequence_row_indices, begin, 4)) : begin;
        reg u32 rem = ldg32_persist(ptr_add(positions, row0, 4)) & 31;
        reg u32 skip = (rem != 0) ? ((32 - rem < count) ? (32 - rem) : count) : 0;
        begin = begin + skip;
        count = (count - skip) & 0xFFFFFFE0;
    }
    if (count == 0) {
        preexit();
        return;
    }
    reg u32 qk_head = 0;
    gdn_qk_head_of(head, heads, qk_heads, qk_head);
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 v = tid & 127;
    reg u32 khalf = tid >> 7;
    reg u32 k0_off = khalf << 6;
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 state_col = ptr_add(ptr_add(ptr_add(state_pool, sidx, slot_bytes), head, 65536), (k0_off << 7) + v, 4);
    reg f32 s[64];
    unroll (k = 0..64) { s[k] = u32_as_f32(ldg32_stream(ptr_add(state_col, k, 512))); }
    for (reg u32 first = 0; first < count; first += 32) {
        reg u32 rows = (count - first < 32) ? (count - first) : 32;
        gdn_chunk_load_norm(wid, lane, tid, rows, begin, first, has_sri, sequence_row_indices, key_qk, query_qk, value_bf16, ba_bf16, qk_head, qk_heads, head, heads, a_val, dt_val);
        for (reg u32 t = 0; t < rows; t += 1) {
            reg u32 tb = t << 7;
            reg f32 ph = 0.0f;
            unroll (k = 0..64) { ph = fma(s[k], dyn_lds32_f32(tb + k0_off + k), ph); }
            dyn_sts32(12416 + tid, f32_as_u32(ph));
            barrier();
            reg f32 dec = dyn_lds32_f32(12288 + t);
            reg f32 pred = (dyn_lds32_f32(12416 + v) + dyn_lds32_f32(12544 + v)) * dec;
            reg f32 coeff = dyn_lds32_f32(12320 + t) * (dyn_lds32_f32(8192 + tb + v) - pred);
            reg f32 oh = 0.0f;
            unroll (k = 0..64) {
                s[k] = fma(dec, s[k], coeff * dyn_lds32_f32(tb + k0_off + k));
                oh = fma(s[k], dyn_lds32_f32(4096 + tb + k0_off + k), oh);
            }
            dyn_sts32(12416 + tid, f32_as_u32(oh));
            barrier();
            if (khalf == 0) {
                reg u32 out_row = dyn_lds32(12352 + t);
                stg16(ptr_add(ptr_add(output_bf16, out_row * heads + head, 256), v, 2), f32_to_bf16(dyn_lds32_f32(12416 + v) + dyn_lds32_f32(12544 + v)));
            }
            barrier();
        }
    }
    if (commit != 0) {
        unroll (k = 0..64) { stg32_stream(ptr_add(state_col, k, 512), f32_as_u32(s[k])); }
    }
    preexit();
}
