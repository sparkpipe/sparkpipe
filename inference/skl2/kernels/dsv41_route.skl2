import "stdlib/math.skl2";

const D41R_BLK256 = 256;
const D41R_EXPERTS = 384;
const D41R_TOPK = 6;
const D41R_HIDDEN = 5120;
const D41R_CHUNKS = 640;
const D41R_SPAN = 80;

macro d41r_topk_warp_row_e384(scores, bias, has_bias, route_scale, fault, route_expert, route_weight, row, lane) {
    reg u32 ck[12];
    reg u64 srow = ptr_add(scores, row * D41R_EXPERTS, 4);
    unroll (sl = 0..12) {
        reg u32 ei = lane + sl * 32;
        reg f32 lg = u32_as_f32(ldg32_persist(ptr_add(srow, ei, 4)));
        reg f32 sv = 0.0f;
        sqrt_softplus_f32(lg, sv);
        if (has_bias != 0) { sv = sv + u32_as_f32(ldg32_persist(ptr_add(bias, ei, 4))); }
        route_f32_sort_key(sv, ck[sl]);
    }
    reg u32 chosen = 0;
    reg u32 last_bk = 0;
    unroll (rnd = 0..6) {
        reg u32 bk = 0; reg u32 bi = 0;
        unroll (sl = 0..12) {
            reg u32 ci = 0xFFFFFFFF - (lane + sl * 32);
            u32_argmax_step(ck[sl], ci, bk, bi);
        }
        warp_argmax_u32(bk, bi);
        reg u32 win_e = 0xFFFFFFFF - bi;
        if (lane == rnd) { chosen = win_e; }
        last_bk = bk;
        unroll (sl = 0..12) {
            if (lane + sl * 32 == win_e) { ck[sl] = 0; }
        }
    }
    if (lane == 0 && last_bk == 0) { stg32(fault, 1); }
    reg f32 val = 0.0f;
    if (lane < D41R_TOPK) {
        stg32(ptr_add(route_expert, row * D41R_TOPK + lane, 4), chosen);
        reg f32 lgc = u32_as_f32(ldg32_persist(ptr_add(srow, chosen, 4)));
        sqrt_softplus_f32(lgc, val);
    }
    reg f32 qv = 0.0f;
    warp_norm_sum_f32((lane < D41R_TOPK) ? val : 0.0f, lane, qv);
    if (lane < D41R_TOPK) {
        stg32(ptr_add(route_weight, row * D41R_TOPK + lane, 4), f32_as_u32(qv * route_scale));
    }
}

macro d41r_topk_rows_block(scores, bias, route_scale, fault, route_expert, route_weight, rows, row_valid, wid, lane) {
    reg u32 has_bias = ((bias[0] | bias[1]) != 0) ? 1 : 0;
    reg u32 has_rv = ((row_valid[0] | row_valid[1]) != 0) ? 1 : 0;
    for (reg u32 row = wid; row < rows; row += 8) {
        reg u32 valid = 1;
        if (has_rv != 0) {
            if (ldg32_persist(ptr_add(row_valid, row, 4)) == 0) { valid = 0; }
        }
        if (valid == 0) {
            if (lane < D41R_TOPK) {
                stg32(ptr_add(route_expert, row * D41R_TOPK + lane, 4), 0xFFFFFFFF);
                stg32(ptr_add(route_weight, row * D41R_TOPK + lane, 4), 0);
            }
        } else {
            d41r_topk_warp_row_e384(scores, bias, has_bias, route_scale, fault, route_expert, route_weight, row, lane);
        }
    }
    barrier();
}

macro d41r_load_balance_tables(owner, backup, group, copies, ranks, s_owner, s_backup, s_group, s_erank, s_rload, s_whist, tid) {
    for (reg u32 e = tid; e < D41R_EXPERTS; e += 256) {
        sts32(s_owner, e, ldg8_persist(ptr_add(owner, e, 1)));
        sts32(s_group, e, ldg8_persist(ptr_add(group, e, 1)));
        sts32(s_erank, e, 255);
    }
    reg u32 cb = copies * D41R_EXPERTS;
    for (reg u32 i = tid; i < cb; i += 256) {
        sts32(s_backup, i, ldg8_persist(ptr_add(backup, i, 1)));
    }
    if (tid < ranks) { sts32(s_rload, tid, 0); }
    for (reg u32 i = tid; i < 2048; i += 256) { sts32(s_whist, i, 0); }
    barrier();
}

macro d41r_pick_rank_rowinv(expert, copies, ranks, load_lo, load_hi, s_owner, s_backup, out_chosen) {
    out_chosen = lds32(s_owner, expert);
    reg u32 cload = (out_chosen < 8) ? ((load_lo >> (out_chosen << 2)) & 15) : ((load_hi >> ((out_chosen - 8) << 2)) & 15);
    for (reg u32 cp = 0; cp < copies; cp += 1) {
        reg u32 cand = lds32(s_backup, cp * D41R_EXPERTS + expert);
        if (cand < ranks) {
            reg u32 kload = (cand < 8) ? ((load_lo >> (cand << 2)) & 15) : ((load_hi >> ((cand - 8) << 2)) & 15);
            if (kload < cload) { out_chosen = cand; cload = kload; }
        }
    }
    if (out_chosen < 8) { load_lo = load_lo + (1 << (out_chosen << 2)); }
    else { load_hi = load_hi + (1 << ((out_chosen - 8) << 2)); }
}

macro d41r_balance_row_inv(route_expert, route_weight, route_global, rows, top_k, rank, copies, ranks, groups, row_valid, s_owner, s_backup, s_group, tid) {
    reg u32 has_rv = ((row_valid[0] | row_valid[1]) != 0) ? 1 : 0;
    for (reg u32 row = tid; row < rows; row += 256) {
        reg u32 dead_row = 0;
        if (has_rv != 0) {
            if (ldg32_persist(ptr_add(row_valid, row, 4)) == 0) { dead_row = 1; }
        }
        reg u32 load_lo = 0; reg u32 load_hi = 0;
        for (reg u32 k = 0; k < top_k; k += 1) {
            reg u32 route = row * top_k + k;
            reg u32 expert = ldg32_persist(ptr_add(route_expert, route, 4));
            if (dead_row != 0) { expert = 0xFFFFFFFF; }
            stg32(ptr_add(route_global, route, 4), expert);
            reg u32 chosen = ranks;
            if (expert < D41R_EXPERTS) {
                d41r_pick_rank_rowinv(expert, copies, ranks, load_lo, load_hi, s_owner, s_backup, chosen);
            }
            reg u32 loc = groups;
            if (chosen == rank && expert < D41R_EXPERTS) {
                reg u32 g = lds32(s_group, expert);
                if (g < groups) { loc = g; }
            }
            stg32(ptr_add(route_expert, route, 4), loc);
            if (loc == groups) { stg32(ptr_add(route_weight, route, 4), 0); }
        }
    }
    barrier();
}

macro d41r_seq_assign_expert(expert, copies, ranks, s_owner, s_backup, s_erank, s_rload, unseen) {
    reg u32 cached = lds32(s_erank, expert);
    if (cached < ranks) {
        sts32(s_rload, cached, lds32(s_rload, cached) + 1);
    } else {
        reg u32 chosen = lds32(s_owner, expert);
        reg u32 cload = lds32(s_rload, chosen);
        for (reg u32 cp = 0; cp < copies; cp += 1) {
            reg u32 cand = lds32(s_backup, cp * D41R_EXPERTS + expert);
            if (cand < ranks) {
                reg u32 kload = lds32(s_rload, cand);
                if (kload < cload) { chosen = cand; cload = kload; }
            }
        }
        sts32(s_erank, expert, chosen);
        sts32(s_rload, chosen, cload + 17);
        unseen = unseen - 1;
    }
}

macro d41r_seq_pass_rank(route_expert, routes, top_k, copies, ranks, has_rv, row_valid, s_owner, s_backup, s_erank, s_rload) {
    reg u32 unseen = D41R_EXPERTS;
    for (reg u32 r = 0; r < routes; r += 1) {
        if (unseen != 0) {
            reg u32 dead = 0;
            if (has_rv != 0) {
                reg u32 rw = 0; reg u32 rk = 0;
                u32_divmod(r, top_k, rw, rk);
                if (ldg32_persist(ptr_add(row_valid, rw, 4)) == 0) { dead = 1; }
            }
            reg u32 expert = ldg32_persist(ptr_add(route_expert, r, 4));
            if (dead == 0 && expert < D41R_EXPERTS) {
                d41r_seq_assign_expert(expert, copies, ranks, s_owner, s_backup, s_erank, s_rload, unseen);
            }
        }
    }
}

macro d41r_balance_seq(route_expert, route_weight, route_global, routes, top_k, rank, copies, ranks, groups, row_valid, s_owner, s_backup, s_group, s_erank, s_rload, tid) {
    reg u32 has_rv = ((row_valid[0] | row_valid[1]) != 0) ? 1 : 0;
    if (tid == 0) {
        d41r_seq_pass_rank(route_expert, routes, top_k, copies, ranks, has_rv, row_valid, s_owner, s_backup, s_erank, s_rload);
    }
    barrier();
    for (reg u32 r = tid; r < routes; r += 256) {
        reg u32 dead = 0;
        if (has_rv != 0) {
            reg u32 rw = 0; reg u32 rk = 0;
            u32_divmod(r, top_k, rw, rk);
            if (ldg32_persist(ptr_add(row_valid, rw, 4)) == 0) { dead = 1; }
        }
        reg u32 expert = ldg32_persist(ptr_add(route_expert, r, 4));
        if (dead != 0) { expert = 0xFFFFFFFF; }
        stg32(ptr_add(route_global, r, 4), expert);
        reg u32 loc = groups;
        if (expert < D41R_EXPERTS) {
            if (lds32(s_erank, expert) == rank) {
                reg u32 g = lds32(s_group, expert);
                if (g < groups) { loc = g; }
            }
        }
        stg32(ptr_add(route_expert, r, 4), loc);
        if (loc == groups) { stg32(ptr_add(route_weight, r, 4), 0); }
    }
    barrier();
}

macro d41r_balance_prefix(held_plus_one, tile_m, neuron_tiles_up, neuron_tiles_down, group_row_offset, tile_prefix_up, tile_prefix_down, s_whist, s_warp_tot, tid, wid, lane) {
    reg u32 c = 0;
    if (tid < held_plus_one) {
        unroll (w = 0..8) { c = c + lds32(s_whist, (w << 8) + tid); }
    }
    reg u32 mt = 0;
    if (c != 0) {
        reg u32 mr = 0;
        u32_divmod(c + tile_m - 1, tile_m, mt, mr);
    }
    reg u32 up = mt * neuron_tiles_up;
    reg u32 dn = mt * neuron_tiles_down;
    reg u32 ic = c; reg u32 iu = up; reg u32 id = dn;
    warp_prefix_u32(ic, lane);
    warp_prefix_u32(iu, lane);
    warp_prefix_u32(id, lane);
    if (lane == 31) {
        sts32(s_warp_tot, wid, ic);
        sts32(s_warp_tot, 8 + wid, iu);
        sts32(s_warp_tot, 16 + wid, id);
    }
    barrier();
    reg u32 bc = ic - c; reg u32 bu = iu - up; reg u32 bd = id - dn;
    unroll (w = 0..7) {
        if (wid > w) {
            bc = bc + lds32(s_warp_tot, w);
            bu = bu + lds32(s_warp_tot, 8 + w);
            bd = bd + lds32(s_warp_tot, 16 + w);
        }
    }
    reg u32 has_tp = 0;
    if ((tile_prefix_up[0] | tile_prefix_up[1]) != 0 && (tile_prefix_down[0] | tile_prefix_down[1]) != 0) { has_tp = 1; }
    if (tid < held_plus_one) {
        stg32(ptr_add(group_row_offset, tid, 4), bc);
        if (has_tp != 0) {
            stg32(ptr_add(tile_prefix_up, tid, 4), bu);
            stg32(ptr_add(tile_prefix_down, tid, 4), bd);
        }
        if (tid + 1 == held_plus_one) {
            stg32(ptr_add(group_row_offset, held_plus_one, 4), bc + c);
            if (has_tp != 0) {
                stg32(ptr_add(tile_prefix_up, held_plus_one, 4), bu + up);
                stg32(ptr_add(tile_prefix_down, held_plus_one, 4), bd + dn);
            }
        }
        reg u32 run = bc;
        unroll (w = 0..8) {
            reg u32 cnt = lds32(s_whist, (w << 8) + tid);
            sts32(s_whist, (w << 8) + tid, run);
            run = run + cnt;
        }
    }
    barrier();
}

macro d41r_balance_scan_scatter(route_expert, route_weight, routes, top_k, held_plus_one, tile_m, neuron_tiles_up, neuron_tiles_down, group_row_offset, tile_prefix_up, tile_prefix_down, route_packed_row, route_source_token, packed_weight, s_whist, s_warp_tot, tid, wid, lane) {
    reg u32 slice = (routes + 7) >> 3;
    reg u32 w_beg = wid * slice;
    reg u32 w_end = (w_beg + slice < routes) ? (w_beg + slice) : routes;
    if (lane == 0) {
        for (reg u32 i = w_beg; i < w_end; i += 1) {
            reg u32 e = ldg32_persist(ptr_add(route_expert, i, 4));
            if (e < held_plus_one) {
                reg u32 idx = (wid << 8) + e;
                sts32(s_whist, idx, lds32(s_whist, idx) + 1);
            }
        }
    }
    barrier();
    d41r_balance_prefix(held_plus_one, tile_m, neuron_tiles_up, neuron_tiles_down, group_row_offset, tile_prefix_up, tile_prefix_down, s_whist, s_warp_tot, tid, wid, lane);
    if (lane == 0) {
        for (reg u32 i = w_beg; i < w_end; i += 1) {
            reg u32 e = ldg32_persist(ptr_add(route_expert, i, 4));
            if (e < held_plus_one) {
                reg u32 idx = (wid << 8) + e;
                reg u32 packed = lds32(s_whist, idx);
                sts32(s_whist, idx, packed + 1);
                stg32(ptr_add(route_packed_row, i, 4), packed);
                reg u32 src_tok = 0; reg u32 sr = 0;
                u32_divmod(i, top_k, src_tok, sr);
                stg32(ptr_add(route_source_token, packed, 4), src_tok);
                reg u32 wt = ldg32_persist(ptr_add(route_weight, i, 4));
                stg32(ptr_add(packed_weight, packed, 4), wt);
            }
        }
    }
}

macro d41r_warp8_prefix(s_warp, lane) {
    reg u32 w = 0;
    if (lane < 8) { w = lds32(s_warp, lane); }
    reg u32 s1 = shfl_up(w, 1); w = (lane >= 1) ? (w + s1) : w;
    reg u32 s2 = shfl_up(w, 2); w = (lane >= 2) ? (w + s2) : w;
    reg u32 s4 = shfl_up(w, 4); w = (lane >= 4) ? (w + s4) : w;
    if (lane < 8) { sts32(s_warp, lane, w); }
}

macro d41r_scan256_half(v, s_warp, wid, lane, out_off, out_tot) {
    reg u32 x = v;
    warp_prefix_u32(x, lane);
    if (lane == 31) { sts32(s_warp, wid, x); }
    barrier();
    if (wid == 0) { d41r_warp8_prefix(s_warp, lane); }
    barrier();
    out_tot = lds32(s_warp, 7);
    reg u32 wb = 0;
    if (wid > 0) { wb = lds32(s_warp, wid - 1); }
    out_off = wb + x - v;
    barrier();
}

macro d41r_scan512(arr, s_warp, tid, wid, lane, out_tot) {
    reg u32 v0 = 0; reg u32 v1 = 0;
    if (tid < D41R_EXPERTS) { v0 = lds32(arr, tid); }
    if (tid + 256 < D41R_EXPERTS) { v1 = lds32(arr, tid + 256); }
    reg u32 off0 = 0; reg u32 tot0 = 0;
    d41r_scan256_half(v0, s_warp, wid, lane, off0, tot0);
    reg u32 off1 = 0; reg u32 tot1 = 0;
    d41r_scan256_half(v1, s_warp, wid, lane, off1, tot1);
    if (tid < D41R_EXPERTS) { sts32(arr, tid, off0); }
    if (tid + 256 < D41R_EXPERTS) { sts32(arr, tid + 256, tot0 + off1); }
    out_tot = tot0 + tot1;
}

macro d41r_packed_hist(route_expert, route_weight, routes, row_valid, s_off, s_re, s_rw, tid) {
    reg u32 has_rv = ((row_valid[0] | row_valid[1]) != 0) ? 1 : 0;
    if (tid < routes) {
        reg u32 dead = 0;
        if (has_rv != 0) {
            reg u32 rw = 0; reg u32 rk = 0;
            u32_divmod(tid, D41R_TOPK, rw, rk);
            if (ldg32_persist(ptr_add(row_valid, rw, 4)) == 0) { dead = 1; }
        }
        reg u32 e = ldg32_persist(ptr_add(route_expert, tid, 4));
        if (e >= D41R_EXPERTS) { dead = 1; }
        if (dead != 0) {
            sts32(s_re, tid, 0xFFFFFFFF);
            sts32(s_rw, tid, 0);
        } else {
            sts32(s_re, tid, e);
            sts32(s_rw, tid, ldg32_persist(ptr_add(route_weight, tid, 4)));
        }
    }
    barrier();
    if (tid == 0) {
        for (reg u32 i = 0; i < routes; i += 1) {
            reg u32 e = lds32(s_re, i);
            if (e < D41R_EXPERTS) { sts32(s_off, e, lds32(s_off, e) + 1); }
        }
    }
    barrier();
}

macro d41r_packed_emit_tiles(tile_m, neuron_tiles_up, neuron_tiles_down, group_row_offset, tile_prefix_up, tile_prefix_down, s_off, s_up, s_dn, s_warp, tid, wid, lane) {
    for (reg u32 i = tid; i < D41R_EXPERTS; i += 256) {
        reg u32 c = lds32(s_off, i);
        reg u32 mt = 0;
        if (c != 0) { reg u32 mr = 0; u32_divmod(c + tile_m - 1, tile_m, mt, mr); }
        sts32(s_up, i, mt * neuron_tiles_up);
        sts32(s_dn, i, mt * neuron_tiles_down);
    }
    barrier();
    reg u32 tot_off = 0; reg u32 tot_up = 0; reg u32 tot_dn = 0;
    d41r_scan512(s_off, s_warp, tid, wid, lane, tot_off);
    d41r_scan512(s_up, s_warp, tid, wid, lane, tot_up);
    d41r_scan512(s_dn, s_warp, tid, wid, lane, tot_dn);
    for (reg u32 i = tid; i < D41R_EXPERTS; i += 256) {
        stg32(ptr_add(group_row_offset, i, 4), lds32(s_off, i));
        stg32(ptr_add(tile_prefix_up, i, 4), lds32(s_up, i));
        stg32(ptr_add(tile_prefix_down, i, 4), lds32(s_dn, i));
    }
    if (tid == 0) {
        stg32(ptr_add(group_row_offset, D41R_EXPERTS, 4), tot_off);
        stg32(ptr_add(tile_prefix_up, D41R_EXPERTS, 4), tot_up);
        stg32(ptr_add(tile_prefix_down, D41R_EXPERTS, 4), tot_dn);
    }
}

macro d41r_packed_emit_active(group_row_offset, active_out, s_off, s_up, s_warp, tid, wid, lane) {
    for (reg u32 i = tid; i < 512; i += 256) {
        reg u32 act = 0;
        if (i < D41R_EXPERTS) {
            if (lds32(s_off, i) != 0) { act = 1; }
        }
        sts32(s_up, i, act);
    }
    barrier();
    reg u32 tot_off = 0; reg u32 tot_act = 0;
    d41r_scan512(s_off, s_warp, tid, wid, lane, tot_off);
    for (reg u32 i = tid; i < D41R_EXPERTS; i += 256) {
        stg32(ptr_add(group_row_offset, i, 4), lds32(s_off, i));
    }
    if (tid == 0) { stg32(ptr_add(group_row_offset, D41R_EXPERTS, 4), tot_off); }
    reg u32 a0 = 0; reg u32 a1 = 0;
    if (tid < D41R_EXPERTS) { a0 = lds32(s_up, tid); }
    if (tid + 256 < D41R_EXPERTS) { a1 = lds32(s_up, tid + 256); }
    d41r_scan512(s_up, s_warp, tid, wid, lane, tot_act);
    if (a0 != 0) { stg32(ptr_add(active_out, lds32(s_up, tid), 4), tid); }
    if (a1 != 0) { stg32(ptr_add(active_out, lds32(s_up, tid + 256), 4), tid + 256); }
    if (tid == 0) { stg32(ptr_add(active_out, D41R_EXPERTS, 4), tot_act); }
}

macro d41r_topk_packed_body(scores, bias, route_scale, fault, route_expert, route_weight, group_row_offset, route_packed_row, route_source_token, tile_m, neuron_tiles_up, tile_prefix_up, neuron_tiles_down, tile_prefix_down, packed_weight, rows, row_valid, active_out, s_off, s_up, s_dn, s_warp, s_re, s_rw, tid, wid, lane) {
    reg u32 routes = rows * D41R_TOPK;
    for (reg u32 i = tid; i < 512; i += 256) { sts32(s_off, i, 0); }
    d41r_topk_rows_block(scores, bias, route_scale, fault, route_expert, route_weight, rows, row_valid, wid, lane);
    d41r_packed_hist(route_expert, route_weight, routes, row_valid, s_off, s_re, s_rw, tid);
    if ((active_out[0] | active_out[1]) == 0) {
        d41r_packed_emit_tiles(tile_m, neuron_tiles_up, neuron_tiles_down, group_row_offset, tile_prefix_up, tile_prefix_down, s_off, s_up, s_dn, s_warp, tid, wid, lane);
    } else {
        d41r_packed_emit_active(group_row_offset, active_out, s_off, s_up, s_warp, tid, wid, lane);
    }
    barrier();
    if (tid < routes) {
        reg u32 e = lds32(s_re, tid);
        if (e < D41R_EXPERTS) {
            reg u32 ord = 0;
            for (reg u32 p = 0; p < tid; p += 1) {
                if (lds32(s_re, p) == e) { ord = ord + 1; }
            }
            reg u32 packed = lds32(s_off, e) + ord;
            stg32(ptr_add(route_packed_row, tid, 4), packed);
            reg u32 src_tok = 0; reg u32 sr = 0;
            u32_divmod(tid, D41R_TOPK, src_tok, sr);
            stg32(ptr_add(route_source_token, packed, 4), src_tok);
            stg32(ptr_add(packed_weight, packed, 4), lds32(s_rw, tid));
        } else {
            stg32(ptr_add(route_packed_row, tid, 4), routes);
        }
    }
}

macro d41r_router_gate_split(MAX_R, router_w, x, router_logits, rows, row_valid, s_part, wid, lane) {
    reg u32 e = ctaid_x();
    reg u32 first = wid * D41R_SPAN;
    reg u64 wr = ptr_add(router_w, e * D41R_CHUNKS + first, 16);
    reg u32x4 w0 = ldg128_stream(ptr_add(wr, lane, 16));
    reg u32x4 w1 = ldg128_stream(ptr_add(wr, lane + 32, 16));
    reg u32x4 w2 = pack_u32x4(0, 0, 0, 0);
    if (lane < 16) { w2 = ldg128_stream(ptr_add(wr, lane + 64, 16)); }
    unroll (r = 0..MAX_R) {
        reg u32 rr = (r < rows) ? r : 0;
        reg u64 xr = ptr_add(x, rr * D41R_CHUNKS + first, 16);
        reg f32 s = 0.0f;
        reg u32x4 x0 = ldg128_persist(ptr_add(xr, lane, 16));
        bf16_dot8_acc(s, w0, x0);
        reg u32x4 x1 = ldg128_persist(ptr_add(xr, lane + 32, 16));
        bf16_dot8_acc(s, w1, x1);
        if (lane < 16) {
            reg u32x4 x2 = ldg128_persist(ptr_add(xr, lane + 64, 16));
            bf16_dot8_acc(s, w2, x2);
        }
        s = warp_sum(s);
        if (lane == 0) { sts32(s_part, wid * 16 + r, s); }
    }
    barrier();
    if (wid == 0 && lane < rows) {
        reg u32 valid = 1;
        if ((row_valid[0] | row_valid[1]) != 0) {
            if (ldg32_persist(ptr_add(row_valid, lane, 4)) == 0) { valid = 0; }
        }
        reg f32 tot = 0.0f;
        if (valid != 0) {
            unroll (w = 0..8) { tot = tot + lds32(s_part, w * 16 + lane); }
        }
        stg32(ptr_add(router_logits, lane * D41R_EXPERTS + e, 4), f32_as_u32(tot));
    }
}

macro d41r_balance_core(route_expert, route_weight, route_global, rows, top_k, rank, copies, row_invariant, owner, backup, group, group_row_offset, route_packed_row, route_source_token, tile_m, neuron_tiles_up, tile_prefix_up, neuron_tiles_down, tile_prefix_down, packed_weight, row_valid, ranks, local_experts, held_plus_one, s_owner, s_backup, s_group, s_erank, s_rload, s_warp_tot, s_whist, tid, wid, lane) {
    reg u32 routes = rows * top_k;
    reg u32 groups = local_experts + copies * local_experts;
    d41r_load_balance_tables(owner, backup, group, copies, ranks, s_owner, s_backup, s_group, s_erank, s_rload, s_whist, tid);
    if (row_invariant != 0) {
        d41r_balance_row_inv(route_expert, route_weight, route_global, rows, top_k, rank, copies, ranks, groups, row_valid, s_owner, s_backup, s_group, tid);
    } else {
        d41r_balance_seq(route_expert, route_weight, route_global, routes, top_k, rank, copies, ranks, groups, row_valid, s_owner, s_backup, s_group, s_erank, s_rload, tid);
    }
    d41r_balance_scan_scatter(route_expert, route_weight, routes, top_k, held_plus_one, tile_m, neuron_tiles_up, neuron_tiles_down, group_row_offset, tile_prefix_up, tile_prefix_down, route_packed_row, route_source_token, packed_weight, s_whist, s_warp_tot, tid, wid, lane);
}

@pdl
@concept(route)
kernel[D41R_BLK256, 96] d41_balance_route_256(
    global u32* route_expert, global f32* route_weight, global u32* route_global,
    u32 rows, u32 top_k, u32 rank, u32 copies, u32 row_invariant,
    global u8* owner, global u8* backup, global u8* group,
    global u32* group_row_offset, global u32* route_packed_row, global u32* route_source_token,
    u32 tile_m, u32 neuron_tiles_up, global u32* tile_prefix_up,
    u32 neuron_tiles_down, global u32* tile_prefix_down, global f32* packed_weight,
    u32 ranks, u32 local_experts, u32 held_plus_one
) {
    shared u32 s_owner[384];
    shared u32 s_backup[768];
    shared u32 s_group[384];
    shared u32 s_erank[384];
    shared u32 s_rload[16];
    shared u32 s_warp_tot[24];
    shared u32 s_whist[2048];
    acqbulk();
    reg u64 null_rv = 0;
    d41r_balance_core(route_expert, route_weight, route_global, rows, top_k, rank, copies, row_invariant, owner, backup, group, group_row_offset, route_packed_row, route_source_token, tile_m, neuron_tiles_up, tile_prefix_up, neuron_tiles_down, tile_prefix_down, packed_weight, null_rv, ranks, local_experts, held_plus_one, s_owner, s_backup, s_group, s_erank, s_rload, s_warp_tot, s_whist, tid_x(), warp_id(), lane_id());
    preexit();
}

@pdl
@concept(route)
kernel[D41R_BLK256, 112] d41_topk_balance_route_256(
    global f32* router_logits, global f32* router_bias, f32 route_scale,
    global u32* fault, global u32* route_expert, global f32* route_weight, global u32* route_global,
    u32 rows, u32 rank, u32 copies, u32 row_invariant,
    global u8* owner, global u8* backup, global u8* group,
    global u32* group_row_offset, global u32* route_packed_row, global u32* route_source_token,
    u32 tile_m, u32 neuron_tiles_up, global u32* tile_prefix_up,
    u32 neuron_tiles_down, global u32* tile_prefix_down, global f32* packed_weight,
    u32 ranks, u32 local_experts, u32 held_plus_one, u32 do_topk
) {
    shared u32 s_owner[384];
    shared u32 s_backup[768];
    shared u32 s_group[384];
    shared u32 s_erank[384];
    shared u32 s_rload[16];
    shared u32 s_warp_tot[24];
    shared u32 s_whist[2048];
    acqbulk();
    reg u64 null_rv = 0;
    if (do_topk != 0) {
        d41r_topk_rows_block(router_logits, router_bias, route_scale, fault, route_expert, route_weight, rows, null_rv, warp_id(), lane_id());
    }
    d41r_balance_core(route_expert, route_weight, route_global, rows, D41R_TOPK, rank, copies, row_invariant, owner, backup, group, group_row_offset, route_packed_row, route_source_token, tile_m, neuron_tiles_up, tile_prefix_up, neuron_tiles_down, tile_prefix_down, packed_weight, null_rv, ranks, local_experts, held_plus_one, s_owner, s_backup, s_group, s_erank, s_rload, s_warp_tot, s_whist, tid_x(), warp_id(), lane_id());
    preexit();
}

@pdl
@concept(route)
kernel[D41R_BLK256, 96] d41_topk_route_packed_256(
    global f32* router_logits, global f32* router_bias, f32 route_scale,
    global u32* fault, global u32* route_expert, global f32* route_weight,
    global u32* group_row_offset, global u32* route_packed_row, global u32* route_source_token,
    u32 tile_m, u32 neuron_tiles_up, global u32* tile_prefix_up,
    u32 neuron_tiles_down, global u32* tile_prefix_down, global f32* packed_weight,
    u32 rows, global u32* row_valid, global u32* active_out
) {
    shared u32 s_off[512];
    shared u32 s_up[512];
    shared u32 s_dn[512];
    shared u32 s_warp[8];
    shared u32 s_re[128];
    shared u32 s_rw[128];
    acqbulk();
    d41r_topk_packed_body(router_logits, router_bias, route_scale, fault, route_expert, route_weight, group_row_offset, route_packed_row, route_source_token, tile_m, neuron_tiles_up, tile_prefix_up, neuron_tiles_down, tile_prefix_down, packed_weight, rows, row_valid, active_out, s_off, s_up, s_dn, s_warp, s_re, s_rw, tid_x(), warp_id(), lane_id());
    preexit();
}

@pdl
@concept(route)
template kernel[D41R_BLK256, 128] d41_fused_router_balance_tpl<MAX_R>(
    global u32* router_w, global u32* x, global f32* router_logits,
    global f32* router_bias, f32 route_scale, global u32* fault,
    global u32* route_expert, global f32* route_weight, global u32* route_global,
    u32 rows, u32 rank, u32 copies, u32 row_invariant,
    global u8* owner, global u8* backup, global u8* group,
    global u32* group_row_offset, global u32* route_packed_row, global u32* route_source_token,
    u32 tile_m, u32 neuron_tiles_up, global u32* tile_prefix_up,
    u32 neuron_tiles_down, global u32* tile_prefix_down, global f32* packed_weight,
    global u32* counter, global u32* row_valid,
    u32 ranks, u32 local_experts, u32 held_plus_one
) {
    shared f32 s_part[128];
    shared u32 s_last[1];
    shared u32 s_owner[384];
    shared u32 s_backup[768];
    shared u32 s_group[384];
    shared u32 s_erank[384];
    shared u32 s_rload[16];
    shared u32 s_warp_tot[24];
    shared u32 s_whist[2048];
    acqbulk();
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    d41r_router_gate_split(MAX_R, router_w, x, router_logits, rows, row_valid, s_part, wid, lane);
    reg u32 is_last = 0;
    fused_last_arrival(counter, D41R_EXPERTS, tid, s_last, is_last);
    if (is_last != 0) {
        d41r_topk_rows_block(router_logits, router_bias, route_scale, fault, route_expert, route_weight, rows, row_valid, wid, lane);
        d41r_balance_core(route_expert, route_weight, route_global, rows, D41R_TOPK, rank, copies, row_invariant, owner, backup, group, group_row_offset, route_packed_row, route_source_token, tile_m, neuron_tiles_up, tile_prefix_up, neuron_tiles_down, tile_prefix_down, packed_weight, row_valid, ranks, local_experts, held_plus_one, s_owner, s_backup, s_group, s_erank, s_rload, s_warp_tot, s_whist, tid, wid, lane);
    }
    preexit();
}

instantiate d41_fused_router_balance_tpl<1> as d41_fused_router_balance_r1_256;
instantiate d41_fused_router_balance_tpl<4> as d41_fused_router_balance_r4_256;
instantiate d41_fused_router_balance_tpl<8> as d41_fused_router_balance_r8_256;
instantiate d41_fused_router_balance_tpl<12> as d41_fused_router_balance_r12_256;

