import "stdlib/math.skl2";

const G5O_BLK32 = 32;
const G5O_BLK64 = 64;
const G5O_BLK128 = 128;
const G5O_BLK256 = 256;
const G5O_LATENT = 512;
const G5O_KPOOL = 4;
const G5O_TOPK = 2048;
const G5O_WIDTH = 2051;

macro g5o_exact_linear_stage_w(LANES, s_w, weight, n0, chunks, output_dim, k_base, st, tid) {
    if (tid < (LANES << 2)) {
        reg u32 wn = (LANES == 32) ? (tid >> 5) : (tid >> 4);
        reg u32 wc = tid & (LANES - 1);
        reg u32 neuron = n0 + wn;
        reg u32 c = k_base + wc;
        reg u32 ok = 0;
        if (neuron < output_dim) { if (c < chunks) { ok = 1; } }
        reg u64 src = (ok != 0) ? ptr_add(ptr_add(weight, neuron, chunks << 4), c, 16) : weight;
        ldgsts128_z(smem_base(s_w) + ((st << 2) + wn) * (LANES << 4) + (wc << 4), src, ok);
    }
    ldgdepbar();
}

macro g5o_exact_linear_store_row(output_bf16, output_f32, row, n0, output_dim, use_f32, RPG, r, acc) {
    reg u64 ob = ptr_add(output_bf16, row, output_dim << 1);
    reg u64 of = ptr_add(output_f32, row, output_dim << 2);
    unroll (n = 0..4) {
        if (n0 + n < output_dim) {
            if (use_f32 != 0) { stg32(ptr_add(of, n0 + n, 4), f32_as_u32(acc[n * RPG + r])); }
            else { stg16(ptr_add(ob, n0 + n, 2), f32_to_bf16(acc[n * RPG + r])); }
        }
    }
}

macro g5o_exact_linear_epilogue(LANES, RPG, output_bf16, output_f32, wf_row, row_cnt, n0, output_dim, use_f32, sub, acc) {
    unroll (n = 0..4) {
        unroll (r = 0..RPG) {
            lanes_reduce_sum(LANES, acc[n * RPG + r]);
        }
    }
    if (sub == 0) {
        unroll (r = 0..RPG) {
            if (r < row_cnt) {
                g5o_exact_linear_store_row(output_bf16, output_f32, wf_row + r, n0, output_dim, use_f32, RPG, r, acc);
            }
        }
    }
}

macro g5o_exact_linear_step(LANES, RPG, s_w, activation, wf_row, row_cnt, in_b, cur, sub, c, acc) {
    reg u32x4 wv[4];
    unroll (n = 0..4) {
        wv[n] = lds128(s_w, (((cur << 2) + n) * LANES + sub) << 2);
    }
    unroll (r = 0..RPG) {
        reg u32 row = (r < row_cnt) ? (wf_row + r) : 0;
        reg u32x4 va = ldg128_persist(ptr_add(ptr_add(activation, row, in_b), c, 16));
        unroll (n = 0..4) {
            bf16_dot8_acc(acc[n * RPG + r], wv[n], va);
        }
    }
}

@pdl
@concept(linear)
template kernel[G5O_BLK256, REGS] g5n_exact_linear_tpl<LANES, RPG, REGS>(
    global u32* weight,
    global u32* activation,
    global u32* output_bf16,
    global f32* output_f32,
    u32 rows,
    u32 input_dim,
    u32 output_dim,
    u32 use_f32
) {
    shared u32 s_w[2 * 4 * LANES * 4];
    acqbulk();
    reg u32 tid = tid_x();
    reg u32 n0 = ctaid_x() << 2;
    reg u32 grp = (LANES == 32) ? (tid >> 5) : (tid >> 4);
    reg u32 sub = tid & (LANES - 1);
    reg u32 tile_rows = (256 / LANES) * RPG;
    reg u32 wf_row = ctaid_y() * tile_rows + grp * RPG;
    reg u32 row_cnt = (wf_row < rows) ? ((rows - wf_row < RPG) ? (rows - wf_row) : RPG) : 0;
    reg u32 chunks = input_dim >> 3;
    reg u32 in_b = input_dim << 1;
    g5o_exact_linear_stage_w(LANES, s_w, weight, n0, chunks, output_dim, 0, 0, tid);
    reg f32 acc[4 * RPG];
    unroll (z = 0..(4 * RPG)) { acc[z] = 0.0f; }
    reg u32 cur = 0;
    for (reg u32 k_base = 0; k_base < chunks; k_base += LANES) {
        reg u32 has_nxt = (k_base + LANES < chunks) ? 1 : 0;
        if (has_nxt != 0) {
            g5o_exact_linear_stage_w(LANES, s_w, weight, n0, chunks, output_dim, k_base + LANES, cur ^ 1, tid);
            depbar_le(1);
        } else {
            depbar_le(0);
        }
        barrier();
        reg u32 c = k_base + sub;
        if (row_cnt != 0 && c < chunks) {
            g5o_exact_linear_step(LANES, RPG, s_w, activation, wf_row, row_cnt, in_b, cur, sub, c, acc);
        }
        cur = cur ^ 1;
        if (has_nxt != 0) { barrier(); }
    }
    if (row_cnt != 0) {
        g5o_exact_linear_epilogue(LANES, RPG, output_bf16, output_f32, wf_row, row_cnt, n0, output_dim, use_f32, sub, acc);
    }
    preexit();
}

instantiate g5n_exact_linear_tpl<32, 8, 128> as g5n_exact_linear_l32_r8;
instantiate g5n_exact_linear_tpl<16, 4, 96> as g5n_exact_linear_l16_r4;

@pdl
@concept(linear)
kernel[G5O_BLK256, 128] g5n_exact_split_linear_256(
    global u32* weight,
    global u32* activation,
    global u32* output_bf16,
    global f32* output_f32,
    u32 rows,
    u32 input_dim,
    u32 output_dim,
    u32 use_f32
) {
    shared f32 partial[256];
    acqbulk();
    reg u32 wid = warp_id();
    reg u32 sub = lane_id();
    reg u32 col0 = ctaid_x() << 2;
    reg u32 r0 = ctaid_y() << 3;
    reg u32 cnt = (rows - r0 < 8) ? (rows - r0) : 8;
    reg u32 chunks = input_dim >> 3;
    reg u32 first = (chunks * wid) >> 3;
    reg u32 last = (chunks * (wid + 1)) >> 3;
    reg u32 seg = last - first;
    reg u32 in_b = input_dim << 1;
    reg u64 w_rows[4];
    unroll (b = 0..4) {
        reg u32 wr = (col0 + b < output_dim) ? (col0 + b) : 0;
        w_rows[b] = ptr_add(ptr_add(weight, wr, in_b), first, 16);
    }
    reg f32 acc[32];
    unroll (z = 0..32) { acc[z] = 0.0f; }
    for (reg u32 c = sub; c < seg; c += 32) {
        reg u32x4 wv[4];
        unroll (b = 0..4) { wv[b] = ldg128_persist(ptr_add(w_rows[b], c, 16)); }
        reg u32 col_c = first + c;
        unroll (r = 0..8) {
            reg u32 rr = r0 + ((r < cnt) ? r : 0);
            reg u32x4 va = ldg128_persist(ptr_add(ptr_add(activation, rr, in_b), col_c, 16));
            unroll (b = 0..4) { bf16_dot8_acc(acc[(b << 3) + r], wv[b], va); }
        }
    }
    unroll (b = 0..4) {
        unroll (r = 0..8) {
            reg f32 s = warp_sum(acc[(b << 3) + r]);
            if (sub == 0) { sts32(partial, (wid << 5) + (b << 3) + r, s); }
        }
    }
    barrier();
    if (wid == 0) {
        reg u32 b = sub >> 3;
        reg u32 r = sub & 7;
        if (col0 + b < output_dim && r < cnt) {
            reg f32 tot = 0.0f;
            unroll (w = 0..8) { tot = tot + lds32(partial, (w << 5) + (b << 3) + r); }
            if (use_f32 != 0) { stg32(ptr_add(ptr_add(output_f32, r0 + r, output_dim << 2), col0 + b, 4), f32_as_u32(tot)); }
            else { stg16(ptr_add(ptr_add(output_bf16, r0 + r, output_dim << 1), col0 + b, 2), f32_to_bf16(tot)); }
        }
    }
    preexit();
}

@pdl
@concept(index)
kernel[G5O_BLK256, 48] g5n_index_pack_256(
    global u32* key_bf16,
    global u32* gate_bf16,
    global u32* packed_bf16,
    u32 dimension
) {
    acqbulk();
    reg u32 tid = tid_x();
    reg u32 row = ctaid_x();
    reg u32 two_d = dimension << 1;
    reg u64 krow = ptr_add(key_bf16, row, two_d);
    reg u64 grow = ptr_add(gate_bf16, row, two_d);
    reg u64 prow = ptr_add(packed_bf16, row, (two_d + 1) << 1);
    for (reg u32 i = tid; i < two_d; i += 256) {
        reg u32 val = 0;
        if (i < dimension) { val = ldg16_persist(ptr_add(krow, i, 2)); }
        else { val = ldg16_persist(ptr_add(grow, i - dimension, 2)); }
        stg16(ptr_add(prow, i, 2), val);
    }
    if (tid == 0) { stg16(ptr_add(prow, two_d, 2), 0x3F80); }
    preexit();
}

@pdl
@concept(index)
kernel[G5O_BLK256, 48] g5n_pool_permute_256(
    global f32* gathered,
    global f32* pool_scores,
    u32 pools,
    u32 local_stride,
    u64 peer_stride_bytes,
    u32 degree,
    global u32* sequence_of_row,
    global u32* context_length,
    global u32* row_positions,
    u32 dense_limit,
    u32 has_seq_ctx,
    u32 has_row_pos
) {
    acqbulk();
    reg u32 tid = tid_x();
    reg u32 row = ctaid_x();
    reg u32 limit = pools;
    if (dense_limit != 0 && has_seq_ctx != 0) {
        reg u32 seq = ldg32_persist(ptr_add(sequence_of_row, row, 4));
        reg u32 ctx = ldg32_persist(ptr_add(context_length, seq, 4));
        if (has_row_pos != 0) {
            reg u32 rp = ldg32_persist(ptr_add(row_positions, row, 4)) + 1;
            if (rp < ctx) { ctx = rp; }
        }
        if (ctx <= dense_limit) { preexit(); return; }
        reg u32 active = ctx >> 2;
        if (active < limit) { limit = active; }
    }
    reg u64 dst_row = ptr_add(pool_scores, row, pools << 2);
    reg u32 row_loc_b = (row * local_stride) << 2;
    for (reg u32 pool = tid; pool < limit; pool += 256) {
        reg u32 owner = 0; reg u32 loc = pool;
        if (degree > 1) {
            u32_divmod(pool, degree, loc, owner);
        }
        reg u64 src_p = ptr_add(ptr_add(gathered, owner, peer_stride_bytes[0]), row_loc_b + (loc << 2), 1);
        stg32(ptr_add(dst_row, pool, 4), ldg32_persist(src_p));
    }
    preexit();
}

@pdl
@concept(index)
kernel[G5O_BLK256, 48] g5n_pool_expand_256(
    global u32* selected_pools,
    global u32* sequence_of_row,
    global u32* context_length,
    global u32* row_positions,
    global u32* selected_positions,
    u32 rows,
    u32 dense_limit,
    u32 fill_dense
) {
    acqbulk();
    reg u32 tid = tid_x();
    reg u32 row = ctaid_x();
    if (row >= rows) { preexit(); return; }
    reg u32 seq = ldg32_persist(ptr_add(sequence_of_row, row, 4));
    reg u32 cl = ldg32_persist(ptr_add(context_length, seq, 4));
    reg u32 rp = ldg32_persist(ptr_add(row_positions, row, 4)) + 1;
    reg u32 ctx = (cl < rp) ? cl : rp;
    reg u64 dst_row = ptr_add(selected_positions, row, G5O_WIDTH << 2);
    if (dense_limit != 0 && ctx <= dense_limit) {
        if (fill_dense != 0) {
            for (reg u32 i = tid; i < G5O_WIDTH; i += 256) {
                stg32(ptr_add(dst_row, i, 4), (i < ctx) ? i : 0xFFFFFFFF);
            }
        }
        preexit();
        return;
    }
    reg u32 pooled = ctx & 0xFFFFFFFC;
    reg u64 src_row = ptr_add(selected_pools, row, 512 << 2);
    for (reg u32 i = tid; i < G5O_WIDTH; i += 256) {
        reg u32 pos = 0xFFFFFFFF;
        if (i < G5O_TOPK) {
            reg u32 cand = (ldg32_persist(ptr_add(src_row, i >> 2, 4)) << 2) + (i & 3);
            if (cand < pooled) { pos = cand; }
        } else {
            reg u32 cand = pooled + i - G5O_TOPK;
            if (cand < ctx) { pos = cand; }
        }
        stg32(ptr_add(dst_row, i, 4), pos);
    }
    preexit();
}

macro g5o_kda_conv_seed_taps(slot, in_p, seq_row_indices, has_seq_idx, beg, rb, ch_b, ch, t0, t1, t2, t3) {
    if (rb < 3) {
        reg u32x2 w = ldg64_persist(slot);
        t0 = w[0] & 0xFFFF; t1 = w[0] >> 16; t2 = w[1] & 0xFFFF; t3 = w[1] >> 16;
        for (reg u32 p = 0; p < rb; p += 1) {
            reg u32 pr = beg + p;
            if (has_seq_idx != 0) { pr = ldg32_persist(ptr_add(seq_row_indices, beg + p, 4)); }
            t0 = t1; t1 = t2; t2 = t3;
            t3 = ldg16_persist(ptr_add(ptr_add(in_p, pr, ch_b), ch, 2));
        }
    } else {
        reg u32 r0 = beg + rb - 3; reg u32 r1 = beg + rb - 2; reg u32 r2 = beg + rb - 1;
        if (has_seq_idx != 0) {
            r0 = ldg32_persist(ptr_add(seq_row_indices, beg + rb - 3, 4));
            r1 = ldg32_persist(ptr_add(seq_row_indices, beg + rb - 2, 4));
            r2 = ldg32_persist(ptr_add(seq_row_indices, beg + rb - 1, 4));
        }
        t1 = ldg16_persist(ptr_add(ptr_add(in_p, r0, ch_b), ch, 2));
        t2 = ldg16_persist(ptr_add(ptr_add(in_p, r1, ch_b), ch, 2));
        t3 = ldg16_persist(ptr_add(ptr_add(in_p, r2, ch_b), ch, 2));
    }
}

macro g5o_kda_conv_run_tile(in_p, out_p, seq_row_indices, has_seq_idx, beg, rb, r_end, ch_b, ch, tw0, tw1, tw2, tw3, t0, t1, t2, t3) {
    for (reg u32 o = rb; o < r_end; o += 1) {
        reg u32 row = beg + o;
        if (has_seq_idx != 0) { row = ldg32_persist(ptr_add(seq_row_indices, beg + o, 4)); }
        t0 = t1; t1 = t2; t2 = t3;
        t3 = ldg16_persist(ptr_add(ptr_add(in_p, row, ch_b), ch, 2));
        reg f32 tot = bf16_lo(t0) * tw0;
        tot = tot + bf16_lo(t1) * tw1;
        tot = tot + bf16_lo(t2) * tw2;
        tot = tot + bf16_lo(t3) * tw3;
        reg f32 tb = bf16_lo(f32_to_bf16(tot));
        reg f32 sg = 0.0f;
        sigmoid_exact_f32(tb, sg);
        stg16(ptr_add(ptr_add(out_p, row, ch_b), ch, 2), f32_to_bf16(tb * sg));
    }
}

@pdl
@concept(recurrent)
kernel[G5O_BLK128, 48] g5n_kda_causal_conv_prefill_128(
    global u32* win_q,
    global u32* win_k,
    global u32* win_v,
    global u32* state_index,
    global u32* seq_row_begin,
    global u32* seq_row_indices,
    global u32* in_q,
    global u32* in_k,
    global u32* in_v,
    global u32* w_q,
    global u32* w_k,
    global u32* w_v,
    global u32* out_q,
    global u32* out_k,
    global u32* out_v,
    u32 channels,
    u32 rows,
    u32 has_seq_begin,
    u32 has_seq_idx
) {
    acqbulk();
    reg u32 bps = channels >> 7;
    reg u32 sid = 0; reg u32 bi = 0;
    u32_divmod(ctaid_y(), bps, sid, bi);
    reg u32 ch = (bi << 7) + tid_x();
    reg u32 rb = ctaid_x() << 3;
    reg u64 win_b = (sid == 0) ? win_q : ((sid == 1) ? win_k : win_v);
    reg u64 in_p = (sid == 0) ? in_q : ((sid == 1) ? in_k : in_v);
    reg u64 w_p = (sid == 0) ? w_q : ((sid == 1) ? w_k : w_v);
    reg u64 out_p = (sid == 0) ? out_q : ((sid == 1) ? out_k : out_v);
    reg u32x2 ww = ldg64_persist(ptr_add(w_p, ch, 8));
    reg f32 tw0 = bf16_lo(ww[0]); reg f32 tw1 = bf16_hi(ww[0]);
    reg f32 tw2 = bf16_lo(ww[1]); reg f32 tw3 = bf16_hi(ww[1]);
    reg u32 beg = 0; reg u32 end = rows;
    if (has_seq_begin != 0) {
        beg = ldg32_persist(seq_row_begin);
        end = ldg32_persist(ptr_add(seq_row_begin, 1, 4));
    }
    reg u32 cnt = (end > beg) ? (end - beg) : 0;
    if (rb >= cnt) { preexit(); return; }
    reg u32 sidx = ldg32_persist(state_index);
    reg u64 slot = ptr_add(ptr_add(win_b, sidx * channels, 8), ch, 8);
    reg u32 t0 = 0; reg u32 t1 = 0; reg u32 t2 = 0; reg u32 t3 = 0;
    reg u32 ch_b = channels << 1;
    g5o_kda_conv_seed_taps(slot, in_p, seq_row_indices, has_seq_idx, beg, rb, ch_b, ch, t0, t1, t2, t3);
    reg u32 r_end = (rb + 8 < cnt) ? (rb + 8) : cnt;
    g5o_kda_conv_run_tile(in_p, out_p, seq_row_indices, has_seq_idx, beg, rb, r_end, ch_b, ch, tw0, tw1, tw2, tw3, t0, t1, t2, t3);
    preexit();
}

macro g5o_kda_commit_taps(slot, in_p, seq_row_indices, has_seq_idx, beg, cnt, ch_b, ch, taps) {
    if (cnt < 4) {
        reg u32x2 ow = ldg64_persist(slot);
        reg u32 p0 = ow[0] & 0xFFFF; reg u32 p1 = ow[0] >> 16;
        reg u32 p2 = ow[1] & 0xFFFF; reg u32 p3 = ow[1] >> 16;
        unroll (t = 0..4) {
            if (cnt + t >= 4) {
                reg u32 off = cnt + t - 4;
                reg u32 row = beg + off;
                if (has_seq_idx != 0) { row = ldg32_persist(ptr_add(seq_row_indices, beg + off, 4)); }
                taps[t] = ldg16_persist(ptr_add(ptr_add(in_p, row, ch_b), ch, 2));
            } else {
                reg u32 pi = cnt + t;
                taps[t] = (pi == 0) ? p0 : ((pi == 1) ? p1 : ((pi == 2) ? p2 : p3));
            }
        }
    } else {
        unroll (t = 0..4) {
            reg u32 off = cnt - 4 + t;
            reg u32 row = beg + off;
            if (has_seq_idx != 0) { row = ldg32_persist(ptr_add(seq_row_indices, beg + off, 4)); }
            taps[t] = ldg16_persist(ptr_add(ptr_add(in_p, row, ch_b), ch, 2));
        }
    }
}

@pdl
@concept(recurrent)
kernel[G5O_BLK128, 48] g5n_kda_conv_window_commit_128(
    global u32* win_q,
    global u32* win_k,
    global u32* win_v,
    global u32* state_index,
    global u32* seq_row_begin,
    global u32* seq_row_indices,
    global u32* in_q,
    global u32* in_k,
    global u32* in_v,
    u32 channels,
    u32 rows,
    u32 has_seq_begin,
    u32 has_seq_idx
) {
    acqbulk();
    reg u32 bps = channels >> 7;
    reg u32 sid = 0; reg u32 bi = 0;
    u32_divmod(ctaid_x(), bps, sid, bi);
    reg u32 ch = (bi << 7) + tid_x();
    reg u64 win_b = (sid == 0) ? win_q : ((sid == 1) ? win_k : win_v);
    reg u64 in_p = (sid == 0) ? in_q : ((sid == 1) ? in_k : in_v);
    reg u32 beg = 0; reg u32 end = rows;
    if (has_seq_begin != 0) {
        beg = ldg32_persist(seq_row_begin);
        end = ldg32_persist(ptr_add(seq_row_begin, 1, 4));
    }
    reg u32 cnt = (end > beg) ? (end - beg) : 0;
    if (cnt == 0) { preexit(); return; }
    reg u32 sidx = ldg32_persist(state_index);
    reg u64 slot = ptr_add(ptr_add(win_b, sidx * channels, 8), ch, 8);
    reg u32 taps[4];
    g5o_kda_commit_taps(slot, in_p, seq_row_indices, has_seq_idx, beg, cnt, channels << 1, ch, taps);
    stg64(slot, pack_u32x2(pack_u16x2(taps[0], taps[1]), pack_u16x2(taps[2], taps[3])));
    preexit();
}

@pdl
@concept(recurrent)
kernel[G5O_BLK256, 48] g5n_kda_decay_beta_256(
    global u32* logit_bf16,
    global f32* channel_bias,
    global f32* head_log_scale,
    global u32* beta_bf16,
    global f32* retention,
    global f32* write_gate,
    u32 heads,
    u32 rows
) {
    acqbulk();
    reg u32 tid = tid_x();
    reg u32 row = ctaid_x();
    if (row < rows) {
        reg u32 rank_qk = heads << 7;
        reg u64 l_row = ptr_add(logit_bf16, row, rank_qk << 1);
        reg u64 r_row = ptr_add(retention, row, rank_qk << 2);
        for (reg u32 i = tid; i < rank_qk; i += 256) {
            reg f32 lg = bf16_lo(ldg16_persist(ptr_add(l_row, i, 2)));
            reg f32 bi = u32_as_f32(ldg32_persist(ptr_add(channel_bias, i, 4)));
            reg f32 ls = u32_as_f32(ldg32_persist(ptr_add(head_log_scale, i >> 7, 4)));
            reg f32 dec = 0.0f;
            bounded_decay_f32(lg, bi, ls, -5.0f, dec);
            stg32(ptr_add(r_row, i, 4), f32_as_u32(dec));
        }
        for (reg u32 h = tid; h < heads; h += 256) {
            reg f32 bv = bf16_lo(ldg16_persist(ptr_add(beta_bf16, row * heads + h, 2)));
            reg f32 sg = 0.0f;
            sigmoid_exact_f32(bv, sg);
            stg32(ptr_add(write_gate, row * heads + h, 4), f32_as_u32(bf16_lo(f32_to_bf16(sg))));
        }
    }
    preexit();
}

@pdl
@concept(memory)
kernel[G5O_BLK256, 32] g5n_copy_new_kv_256(
    global u32* kv_slot,
    global u32* positions,
    global u32* kv_all,
    u32 rows,
    u32 total_ctx
) {
    acqbulk();
    reg u32 tid = tid_x();
    reg u32 row = ctaid_x();
    if (row < rows) {
        reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
        if (pos < total_ctx && tid < 64) {
            reg u32x4 v = ldg128_persist(ptr_add(ptr_add(kv_slot, row, 1024), tid, 16));
            stg128(ptr_add(ptr_add(kv_all, pos, 1024), tid, 16), v);
        }
    }
    preexit();
}

@pdl
@concept(memory)
kernel[G5O_BLK32, 32] g5n_gather_meta_32(
    global u32* sequence_of_row,
    u32 old_ctx,
    global u32* gather_seq,
    global u32* gather_offset,
    global u32* gather_prior_ctx
) {
    acqbulk();
    if (tid_x() == 0) {
        reg u32 seq = ldg32_persist(sequence_of_row);
        stg32(gather_seq, seq);
        stg32(ptr_add(gather_offset, seq, 4), 0);
        stg32(ptr_add(gather_prior_ctx, seq, 4), old_ctx);
    }
    preexit();
}

@pdl
@concept(memory)
kernel[G5O_BLK64, 32] g5n_unpack_prior_kv_64(
    u32 degree,
    u32 grain,
    global u8* gathered_bytes,
    u64 rank_stride,
    u32 prior_local_keys,
    u32 old_ctx,
    global u32* kv_all
) {
    acqbulk();
    reg u32 loc = ctaid_x();
    reg u32 srank = ctaid_y();
    reg u32 pos = 0;
    kv_shard_local_pos(degree, srank, grain, loc, pos);
    if (loc < prior_local_keys && srank < degree) {
        if (pos < old_ctx) {
            reg u32 tid = tid_x();
            reg u64 src = ptr_add(ptr_add(gathered_bytes, srank, rank_stride[0]), (loc << 10) + (tid << 4), 1);
            stg128(ptr_add(ptr_add(kv_all, pos, 1024), tid, 16), ldg128_persist(src));
        }
    }
    preexit();
}

@pdl
@concept(memory)
kernel[G5O_BLK256, 32] g5n_pad_floats_256(
    global f32* dst,
    u32 rows,
    u32 padded_rows,
    u32 stride
) {
    acqbulk();
    reg u32 first = rows * stride;
    reg u32 total = padded_rows * stride;
    reg u32 step = grid_x() << 8;
    for (reg u32 i = first + (ctaid_x() << 8) + tid_x(); i < total; i += step) {
        stg32(ptr_add(dst, i, 4), 0xFF800000);
    }
    preexit();
}

@pdl
@concept(memory)
kernel[G5O_BLK256, 32] g5n_pad_candidates_256(
    global u32* dst,
    u32 rows,
    u32 padded_rows,
    u32 keep
) {
    acqbulk();
    reg u32 first = rows * keep;
    reg u32 total = padded_rows * keep;
    reg u32 step = grid_x() << 8;
    reg u32x2 empty = pack_u32x2(0, 0xFFFFFFFF);
    for (reg u32 i = first + (ctaid_x() << 8) + tid_x(); i < total; i += step) {
        stg64(ptr_add(dst, i, 8), empty);
    }
    preexit();
}
