import "stdlib/math.skl2";

const D41RP_BLK256 = 256;
const D41RP_BLK32 = 32;
const D41RP_LATENT = 512;
const D41RP_RECORD = 514;
const D41RP_ROPE_PAIRS = 32;
const D41RP_NO_ROW = 0xFFFFFFFF;
const D41RP_NEG_INF = 0xFF800000;
const D41RP_NEG_BIG = 0xF193E593;
const D41RP_LOG2E = 1.4426950408889634f;
const D41RP_BACKUP_FLAG = 0x80000000;

macro d41rp_pos_f32(pos, shift, out_f) {
    if (shift < 0) {
        reg u32 ns = 0 - shift;
        if (pos >= ns) {
            out_f = u32_to_f32(pos - ns);
        } else {
            out_f = 0.0f - u32_to_f32(ns - pos);
        }
    } else {
        out_f = u32_to_f32(pos + shift);
    }
}

macro d41rp_rope_pair_u32(bits, sn, cs, out_bits) {
    reg f32 re = bf16_lo(bits);
    reg f32 im = bf16_hi(bits);
    reg f32 nr = fma(re, cs, 0.0f - im * sn);
    reg f32 ni = fma(re, sn, im * cs);
    out_bits = pack_bf16x2(nr, ni);
}

macro d41rp_ring_copy512(src, dst, tid) {
    if (((dst[0] | src[0]) & 15) == 0) {
        if (tid < 64) {
            reg u32x4 v = ldg128_stream(ptr_add(src, tid, 16));
            stg128(ptr_add(dst, tid, 16), v);
        }
    } else {
        for (reg u32 c = tid; c < D41RP_LATENT; c += 256) {
            reg u32 v = ldg16_stream(ptr_add(src, c, 2));
            stg16(ptr_add(dst, c, 2), v);
        }
    }
}

macro d41rp_ring_store_body(wave_kv, ring, positions, row_lane, row_ordinal, seq_row_begin, rec_slot, ring_slot_stride, ring_rows, window, degree, rank, rows, commit, lane_count, path_rows, row_in, tid) {
    if (commit != 0 && row_in < rows) {
        reg u32 has_pr = ((path_rows[0] | path_rows[1]) != 0) ? 1 : 0;
        reg u32 has_lc = ((lane_count[0] | lane_count[1]) != 0) ? 1 : 0;
        reg u32 ln = 0;
        reg u32 cnt = 0;
        reg u32 ord = row_in;
        reg u32 row = row_in;
        if (has_pr != 0) {
            if (has_lc != 0) { cnt = ldg32_persist(lane_count); }
            if (ord < cnt && ord + window >= cnt) { row = ldg32_persist(ptr_add(path_rows, ord, 4)); }
        } else {
            ln = ldg32_persist(ptr_add(row_lane, row, 4));
            if (has_lc != 0) { cnt = ldg32_persist(ptr_add(lane_count, ln, 4)); }
            else { cnt = ldg32_persist(ptr_add(seq_row_begin, ln + 1, 4)) - ldg32_persist(ptr_add(seq_row_begin, ln, 4)); }
            ord = ldg32_persist(ptr_add(row_ordinal, row, 4));
        }
        reg u32 in_win = 0;
        if (ord < cnt && ord + window >= cnt) { in_win = 1; }
        if (in_win != 0) {
            reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
            reg u32 qd = pos; reg u32 rd = 0;
            if (degree > 1) { u32_divmod(pos, degree, qd, rd); }
            if (rd == rank) {
                reg u32 qr = 0; reg u32 rr = 0;
                u32_divmod(qd, ring_rows, qr, rr);
                reg u32 rslot = ldg32_persist(ptr_add(rec_slot, ln, 4));
                reg u64 dst = ptr_add(ptr_add(ring, rslot, ring_slot_stride[0] << 1), rr, D41RP_LATENT << 1);
                reg u64 src = ptr_add(wave_kv, row, D41RP_LATENT << 1);
                d41rp_ring_copy512(src, dst, tid);
            }
        }
    }
}

macro d41rp_merge_sink_stats(partials, source_stride, sources, heads, sink, row, head, s_scales, s_denom, tid, out_denom, out_inv_d) {
    reg u32 base = (row * heads + head) * D41RP_RECORD;
    if (tid < 32) {
        reg f32 max_l = u32_as_f32(D41RP_NEG_BIG);
        reg f32 den_l = 0.0f;
        if (tid < sources) {
            reg u64 p_s = ptr_add(ptr_add(partials, tid, source_stride[0] << 2), base, 4);
            max_l = u32_as_f32(ldg32_persist(p_s));
            den_l = u32_as_f32(ldg32_persist(ptr_add(p_s, 1, 4)));
        }
        reg f32 top = warp_max(max_l);
        reg f32 sc_l = 0.0f;
        if (tid < sources) {
            if (f32_as_u32(max_l) != D41RP_NEG_INF) {
                sc_l = exp2_ftz((max_l - top) * D41RP_LOG2E);
            }
            sts32(s_scales, tid, sc_l);
        }
        reg f32 dsum = 0.0f;
        for (reg u32 s = 0; s < sources; s += 1) {
            dsum = fma(shfl_idx(den_l, s), shfl_idx(sc_l, s), dsum);
        }
        if (tid == 0) {
            reg f32 sk = u32_as_f32(ldg32_persist(ptr_add(sink, head, 4)));
            sts32(s_denom, 0, dsum + exp2_ftz((sk - top) * D41RP_LOG2E));
        }
    }
    barrier();
    out_denom = lds32(s_denom, 0);
    rcp_nr1_f32(out_denom, out_inv_d);
}

macro d41rp_spread_head_body(partials, source_stride, heads, sink, positions, inv_freq, output, qdq, row, head, s_scales, s_denom, s_merged, tid) {
    reg f32 denom = 0.0f; reg f32 inv_d = 0.0f;
    d41rp_merge_sink_stats(partials, source_stride, 1, heads, sink, row, head, s_scales, s_denom, tid, denom, inv_d);
    reg f32 sc0 = lds32(s_scales, 0);
    reg u32 base = (row * heads + head) * D41RP_RECORD;
    reg u64 first_src = ptr_add(partials, base + 2, 4);
    reg f32 p0 = u32_as_f32(ldg32_stream(ptr_add(first_src, tid << 1, 4)));
    reg f32 p1 = u32_as_f32(ldg32_stream(ptr_add(first_src, (tid << 1) + 1, 4)));
    reg f32 q0 = 0.0f; reg f32 q1 = 0.0f;
    div_nr1_f32(p0 * sc0, denom, inv_d, q0);
    div_nr1_f32(p1 * sc0, denom, inv_d, q1);
    sts32(s_merged, tid, pack_bf16x2(q0, q1));
    barrier();
    if (tid < D41RP_ROPE_PAIRS) {
        reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
        reg f32 frq = u32_as_f32(ldg32_persist(ptr_add(inv_freq, tid, 4)));
        reg f32 sn = 0.0f; reg f32 cs = 0.0f;
        sincos_exact_f32(u32_to_f32(pos) * frq, sn, cs);
        reg u32 bits = lds32(s_merged, 224 + tid);
        reg u32 rot = 0;
        d41rp_rope_pair_u32(bits, 0.0f - sn, cs, rot);
        sts32(s_merged, 224 + tid, rot);
    }
    barrier();
    reg u64 target = ptr_add(output, row * heads + head, D41RP_LATENT << 1);
    for (reg u32 e = tid; e < D41RP_LATENT; e += 256) {
        reg u32 w = lds32(s_merged, e >> 1);
        reg u32 bf = ((e & 1) == 0) ? (w & 0xFFFF) : (w >> 16);
        if (qdq != 0) { fp8_e4m3_qdq_lane_bf16(bf16_lo(bf), bf); }
        stg16(ptr_add(target, e, 2), bf);
    }
}

@pdl
@concept(elementwise)
kernel[D41RP_BLK256, 64] d41_window_ring_store_256(
    global u16* wave_kv, global u16* ring, global u32* positions, global u32* row_lane,
    global u32* row_ordinal, global u32* seq_row_begin, global u32* rec_slot,
    u64 ring_slot_stride, u32 ring_rows, u32 window, u32 degree, u32 rank,
    u32 rows, u32 commit, global u32* lane_count, global u32* path_rows
) {
    acqbulk();
    d41rp_ring_store_body(wave_kv, ring, positions, row_lane, row_ordinal, seq_row_begin, rec_slot, ring_slot_stride, ring_rows, window, degree, rank, rows, commit, lane_count, path_rows, ctaid_x(), tid_x());
    preexit();
}

@pdl
@concept(attention)
kernel[D41RP_BLK256, 48] d41_merge_sink_256(
    global f32* partials, u64 source_stride, u32 sources, u32 heads,
    global f32* sink, global u16* output
) {
    shared f32 s_scales[16];
    shared f32 s_denom[1];
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 head = ctaid_y();
    reg u32 tid = tid_x();
    reg f32 denom = 0.0f; reg f32 inv_d = 0.0f;
    d41rp_merge_sink_stats(partials, source_stride, sources, heads, sink, row, head, s_scales, s_denom, tid, denom, inv_d);
    reg u32 base = (row * heads + head) * D41RP_RECORD;
    reg u64 first_src = ptr_add(partials, base + 2, 4);
    reg u64 out_p = ptr_add(output, row * heads + head, D41RP_LATENT << 1);
    reg u32 s_ok = 0;
    if (sources == 1) { s_ok = 1; }
    else if ((source_stride[0] & 3) == 0) { s_ok = 1; }
    reg u32 aligned16 = 0;
    if (((first_src[0] | out_p[0]) & 15) == 0 && s_ok != 0) { aligned16 = 1; }
    if (aligned16 != 0) {
        if (tid < 128) {
            reg f32 m0 = 0.0f; reg f32 m1 = 0.0f; reg f32 m2 = 0.0f; reg f32 m3 = 0.0f;
            for (reg u32 s = 0; s < sources; s += 1) {
                reg f32 sc = lds32(s_scales, s);
                reg u32x4 p = ldg128_stream(ptr_add(ptr_add(first_src, s, source_stride[0] << 2), tid, 16));
                m0 = fma(u32_as_f32(p[0]), sc, m0); m1 = fma(u32_as_f32(p[1]), sc, m1);
                m2 = fma(u32_as_f32(p[2]), sc, m2); m3 = fma(u32_as_f32(p[3]), sc, m3);
            }
            reg f32 q0 = 0.0f; reg f32 q1 = 0.0f; reg f32 q2 = 0.0f; reg f32 q3 = 0.0f;
            div_nr1_f32(m0, denom, inv_d, q0); div_nr1_f32(m1, denom, inv_d, q1);
            div_nr1_f32(m2, denom, inv_d, q2); div_nr1_f32(m3, denom, inv_d, q3);
            stg64(ptr_add(out_p, tid, 8), pack_u32x2(pack_bf16x2(q0, q1), pack_bf16x2(q2, q3)));
        }
    } else {
        for (reg u32 e = tid; e < D41RP_LATENT; e += 256) {
            reg f32 m = 0.0f;
            for (reg u32 s = 0; s < sources; s += 1) {
                reg f32 sc = lds32(s_scales, s);
                reg f32 pv = u32_as_f32(ldg32_stream(ptr_add(ptr_add(first_src, s, source_stride[0] << 2), e, 4)));
                m = fma(pv, sc, m);
            }
            reg f32 q = 0.0f;
            div_nr1_f32(m, denom, inv_d, q);
            stg16(ptr_add(out_p, e, 2), f32_to_bf16(q));
        }
    }
    preexit();
}

@pdl
@concept(elementwise)
kernel[D41RP_BLK256, 32] d41_columns_256(
    global u16* source, u32 source_stride, global u16* target, u32 target_stride, u32 width
) {
    acqbulk();
    reg u32 by = ctaid_y();
    reg u64 src = ptr_add(source, by, source_stride << 1);
    reg u64 dst = ptr_add(target, by, target_stride << 1);
    reg u32 idx = ctaid_x() * ntid_x() + tid_x();
    reg u32 step = grid_x() * ntid_x();
    reg u32 fast = 0;
    if ((width & 7) == 0 && ((src[0] | dst[0]) & 15) == 0) { fast = 1; }
    if (fast != 0) {
        reg u32 oct = width >> 3;
        for (reg u32 q = idx; q < oct; q += step) {
            reg u32x4 v = ldg128_stream(ptr_add(src, q, 16));
            stg128(ptr_add(dst, q, 16), v);
        }
    } else {
        for (reg u32 i = idx; i < width; i += step) {
            reg u32 v = ldg16_stream(ptr_add(src, i, 2));
            stg16(ptr_add(dst, i, 2), v);
        }
    }
    preexit();
}

@pdl
@concept(route)
kernel[D41RP_BLK256, 32] d41_route_local_256(
    global u32* route_expert, global f32* route_weight, global u32* route_global,
    u32 routes, global u8* group, u32 local_experts, u32 groups, u32 experts
) {
    acqbulk();
    reg u32 route = ctaid_x() * ntid_x() + tid_x();
    if (route >= routes) { preexit(); return; }
    reg u32 value = ldg32_persist(ptr_add(route_expert, route, 4));
    reg u32 expert = value & 0x7FFFFFFF;
    reg u32 loc = groups;
    if (expert < experts) { loc = ldg8_persist(ptr_add(group, expert, 1)); }
    stg32(ptr_add(route_global, route, 4), expert);
    reg u32 keep = 0;
    if ((value & D41RP_BACKUP_FLAG) != 0) {
        if (loc >= local_experts && loc < groups) { keep = 1; }
    } else {
        if (loc < local_experts) { keep = 1; }
    }
    if (keep != 0) {
        stg32(ptr_add(route_expert, route, 4), loc);
    } else {
        stg32(ptr_add(route_expert, route, 4), groups);
        stg32(ptr_add(route_weight, route, 4), 0);
    }
    preexit();
}

@pdl
@concept(norm)
kernel[D41RP_BLK32, 40] d41_rope_table_32(
    global u32* positions, global f32* freq, global u32* full_sc, global u32* comp_sc, u32 rows
) {
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 pair = tid_x();
    if (row >= rows || pair >= D41RP_ROPE_PAIRS) { preexit(); return; }
    reg f32 pos_f = u32_to_f32(ldg32_persist(ptr_add(positions, row, 4)));
    reg f32 f0 = u32_as_f32(ldg32_persist(ptr_add(freq, pair, 4)));
    reg f32 f1 = u32_as_f32(ldg32_persist(ptr_add(freq, D41RP_ROPE_PAIRS + pair, 4)));
    reg f32 s0 = 0.0f; reg f32 c0 = 0.0f;
    sincos_exact_f32(pos_f * f0, s0, c0);
    reg f32 s1 = 0.0f; reg f32 c1 = 0.0f;
    sincos_exact_f32(pos_f * f1, s1, c1);
    reg u32 idx = row * D41RP_ROPE_PAIRS + pair;
    stg64(ptr_add(full_sc, idx, 8), pack_u32x2(f32_as_u32(s0), f32_as_u32(c0)));
    stg64(ptr_add(comp_sc, idx, 8), pack_u32x2(f32_as_u32(s1), f32_as_u32(c1)));
    preexit();
}

@pdl
@concept(norm)
kernel[D41RP_BLK32, 40] d41_rope_rows_32(
    global u16* data, u32 heads, u32 head_stride, u32 rope_offset,
    global u32* positions, i32 shift, global f32* inv_freq, u32 inverse,
    global u32* row_valid, global u32* rope_sc
) {
    acqbulk();
    reg u32 row = ctaid_x();
    reg u32 head = ctaid_y();
    reg u32 pair = tid_x();
    if (pair >= D41RP_ROPE_PAIRS || head >= heads) { preexit(); return; }
    if ((row_valid[0] | row_valid[1]) != 0) {
        if (ldg32_persist(ptr_add(row_valid, row, 4)) == D41RP_NO_ROW) { preexit(); return; }
    }
    reg u64 target = ptr_add(data, (row * heads + head) * head_stride + rope_offset + (pair << 1), 2);
    reg f32 sn = 0.0f; reg f32 cs = 0.0f;
    reg u32 use_sc = 0;
    if ((rope_sc[0] | rope_sc[1]) != 0 && shift == 0) { use_sc = 1; }
    if (use_sc != 0) {
        reg u32x2 sc = ldg64_persist(ptr_add(rope_sc, row * D41RP_ROPE_PAIRS + pair, 8));
        sn = u32_as_f32(sc[0]); cs = u32_as_f32(sc[1]);
    } else {
        reg u32 pos = ldg32_persist(ptr_add(positions, row, 4));
        reg f32 pos_f = 0.0f;
        d41rp_pos_f32(pos, shift, pos_f);
        reg f32 frq = u32_as_f32(ldg32_persist(ptr_add(inv_freq, pair, 4)));
        sincos_exact_f32(pos_f * frq, sn, cs);
    }
    if (inverse != 0) { sn = 0.0f - sn; }
    reg u32 bits = ldg32_stream(target);
    reg u32 rot = 0;
    d41rp_rope_pair_u32(bits, sn, cs, rot);
    stg32(target, rot);
    preexit();
}

@pdl
@concept(attention)
kernel[D41RP_BLK256, 56] d41_spread_output_256(
    global f32* partials, u64 source_stride, u32 heads, global f32* sink,
    global u32* positions, global f32* inv_freq, global u16* output, u32 qdq
) {
    shared f32 s_scales[16];
    shared f32 s_denom[1];
    shared u32 s_merged[256];
    acqbulk();
    d41rp_spread_head_body(partials, source_stride, heads, sink, positions, inv_freq, output, qdq, ctaid_x(), ctaid_y(), s_scales, s_denom, s_merged, tid_x());
    preexit();
}

@pdl
@concept(attention)
kernel[D41RP_BLK256, 80] d41_spread_output_ring_256(
    global f32* partials, u64 source_stride, u32 heads, global f32* sink,
    global u32* positions, global f32* inv_freq, global u16* output, u32 qdq,
    global u16* wave_kv, global u16* ring, global u32* row_lane, global u32* row_ordinal,
    global u32* seq_row_begin, global u32* rec_slot, u64 ring_slot_stride, u32 ring_rows,
    u32 window, u32 rows, u32 commit
) {
    shared f32 s_scales[16];
    shared f32 s_denom[1];
    shared u32 s_merged[256];
    acqbulk();
    reg u32 bx = ctaid_x();
    reg u32 tid = tid_x();
    reg u32 total_heads = rows * heads;
    if (bx < total_heads) {
        reg u32 row = 0; reg u32 head = 0;
        u32_divmod(bx, heads, row, head);
        d41rp_spread_head_body(partials, source_stride, heads, sink, positions, inv_freq, output, qdq, row, head, s_scales, s_denom, s_merged, tid);
    } else {
        reg u64 null_ptr = 0;
        d41rp_ring_store_body(wave_kv, ring, positions, row_lane, row_ordinal, seq_row_begin, rec_slot, ring_slot_stride, ring_rows, window, 1, 0, rows, commit, null_ptr, null_ptr, bx - total_heads, tid);
    }
    preexit();
}
