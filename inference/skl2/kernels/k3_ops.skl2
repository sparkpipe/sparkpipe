import "stdlib/math.skl2";

const K3_OPS_BLK256 = 256;
const K3_OPS_BLK224 = 224;
const K3_OPS_BLK128 = 128;

macro k3_topk_pick_round(ck, ci, out_bk, out_bi) {
    out_bk = 0; out_bi = 0;
    unroll (sl = 0..4) { u32_argmax_step(ck[sl], ci[sl], out_bk, out_bi); }
    warp_argmax_u32(out_bk, out_bi);
    unroll (sl = 0..4) {
        if (ck[sl] == out_bk && ci[sl] == out_bi) { ck[sl] = 0; ci[sl] = 0; }
    }
}

macro k3_topk_row1_warp0(s_wk, s_wi, sel, router_logits, route_expert, route_weight, route_fault, experts, scale, lane) {
    reg u32 ck[4]; reg u32 ci[4];
    unroll (sl = 0..4) {
        ck[sl] = lds32(s_wk, lane + (sl << 5));
        ci[sl] = lds32(s_wi, lane + (sl << 5));
    }
    reg u32 chosen = 0; reg u32 last_k = 0;
    for (reg u32 rd = 0; rd < 16; rd += 1) {
        reg u32 bk = 0; reg u32 bi = 0;
        k3_topk_pick_round(ck, ci, bk, bi);
        last_k = bk;
        if (lane == rd) { chosen = 0xFFFFFFFF - bi; }
    }
    if (lane == 0 && last_k == 0) { stg32(route_fault, 1); }
    reg f32 val = 0.0f;
    if (lane < 16) {
        sts32(sel, lane, chosen);
        stg32(ptr_add(route_expert, lane, 4), chosen);
        if (chosen < experts) {
            sigmoid_exact_f32(u32_as_f32(ldg32_persist(ptr_add(router_logits, chosen, 4))), val);
        }
    }
    reg f32 wv = 0.0f;
    warp_norm_sum_f32(val, lane, wv);
    if (lane < 16) {
        stg32(ptr_add(route_weight, lane, 4), f32_as_u32(wv * scale));
    }
}

macro k3_topk_row1_scatter(sel, group_row_offset, route_packed_row, route_source_token, active_experts, experts, tid) {
    reg u32 has_act = ((active_experts[0] | active_experts[1]) != 0) ? 1 : 0;
    if (tid < 16) {
        reg u32 mine = lds32(sel, tid); reg u32 packed = 0;
        unroll (j = 0..16) {
            reg u32 o = lds32(sel, j);
            if (o < mine) { packed = packed + 1; }
            else if (o == mine) { if (j < tid) { packed = packed + 1; } }
        }
        stg32(ptr_add(route_packed_row, tid, 4), packed);
        stg32(ptr_add(route_source_token, packed, 4), 0);
        if (has_act != 0) { stg32(ptr_add(active_experts, 1 + packed, 4), mine); }
    }
    if (tid == 0 && has_act != 0) { stg32(active_experts, 16); }
    for (reg u32 e = tid; e <= experts; e += K3_OPS_BLK256) {
        reg u32 before = 0;
        unroll (j = 0..16) { if (lds32(sel, j) < e) { before = before + 1; } }
        stg32(ptr_add(group_row_offset, e, 4), before);
    }
}

@pdl
@concept(route_topk)
kernel[K3_OPS_BLK256, 80] k3_topk_route_build_row1_256(
    global f32* router_logits, global f32* router_bias,
    global u32* route_expert, global f32* route_weight, global u32* route_fault,
    global u32* group_row_offset, global u32* route_packed_row,
    global u32* route_source_token, global u32* active_experts,
    u32 experts, f32 scale
) {
    shared u32 s_wk[128];
    shared u32 s_wi[128];
    shared u32 sel[16];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u32 has_bias = ((router_bias[0] | router_bias[1]) != 0) ? 1 : 0;
    reg u32 ck[4]; reg u32 ci[4];
    unroll (sl = 0..4) {
        reg u32 idx = (wid << 7) + lane + (sl << 5);
        ck[sl] = 0; ci[sl] = 0;
        if (idx < experts) {
            reg f32 sg = 0.0f;
            sigmoid_exact_f32(u32_as_f32(ldg32_persist(ptr_add(router_logits, idx, 4))), sg);
            reg f32 bv = 0.0f;
            if (has_bias != 0) { bv = u32_as_f32(ldg32_persist(ptr_add(router_bias, idx, 4))); }
            route_f32_sort_key(sg + bv, ck[sl]);
            ci[sl] = 0xFFFFFFFF - idx;
        }
    }
    for (reg u32 rd = 0; rd < 16; rd += 1) {
        reg u32 bk = 0; reg u32 bi = 0;
        k3_topk_pick_round(ck, ci, bk, bi);
        if (lane == 0) { sts32(s_wk, (wid << 4) + rd, bk); sts32(s_wi, (wid << 4) + rd, bi); }
    }
    barrier();
    if (wid == 0) {
        k3_topk_row1_warp0(s_wk, s_wi, sel, router_logits, route_expert, route_weight, route_fault, experts, scale, lane);
    }
    barrier();
    k3_topk_row1_scatter(sel, group_row_offset, route_packed_row, route_source_token, active_experts, experts, tid);
    preexit();
}

macro k3_route_build_chunk(base_e, experts, tid, wid, lane, has_act, w_hist, warp_tot, act_tot, s_base, group_row_offset, active_experts) {
    reg u32 e = base_e + tid;
    reg u32 c = 0; reg u32 w_off[8];
    unroll (w = 0..8) { w_off[w] = 0; }
    if (e < experts) {
        unroll (w = 0..8) {
            w_off[w] = c;
            c = c + lds32(w_hist, w * experts + e);
        }
    }
    reg u32 scan = c;
    reg u32 is_act = 0;
    if (e < experts && c > 0) { is_act = 1; }
    reg u32 ascan = is_act;
    unroll (sh = 0..5) {
        reg u32 u0 = shfl_up(scan, 1 << sh); reg u32 u1 = shfl_up(ascan, 1 << sh);
        if (lane >= (1 << sh)) { scan = scan + u0; ascan = ascan + u1; }
    }
    if (lane == 31) { sts32(warp_tot, wid, scan); sts32(act_tot, wid, ascan); }
    barrier();
    reg u32 w_pre = 0; reg u32 a_pre = 0; reg u32 c_add = 0; reg u32 a_add = 0;
    unroll (w = 0..8) {
        reg u32 wt = lds32(warp_tot, w); reg u32 at = lds32(act_tot, w);
        if (w < wid) { w_pre = w_pre + wt; a_pre = a_pre + at; }
        c_add = c_add + wt; a_add = a_add + at;
    }
    reg u32 ex_off = lds32(s_base, 0) + w_pre + (scan - c);
    reg u32 act_i = lds32(s_base, 1) + a_pre + (ascan - is_act);
    if (e < experts) {
        stg32(ptr_add(group_row_offset, e, 4), ex_off);
        unroll (w = 0..8) { sts32(w_hist, w * experts + e, ex_off + w_off[w]); }
        if (is_act != 0 && has_act != 0) { stg32(ptr_add(active_experts, 1 + act_i, 4), e); }
    }
    barrier();
    if (tid == 0) {
        sts32(s_base, 0, lds32(s_base, 0) + c_add);
        sts32(s_base, 1, lds32(s_base, 1) + a_add);
    }
    barrier();
}

@pdl
@concept(route_topk)
kernel[K3_OPS_BLK256, 80] k3_route_build_fast_256(
    global u32* route_expert, u32 routes, u32 experts, u32 top_k,
    global u32* group_row_offset, global u32* route_packed_row,
    global u32* route_source_token, global u32* active_experts
) {
    shared u32 w_hist[8 * 896];
    shared u32 warp_tot[8];
    shared u32 act_tot[8];
    shared u32 s_base[2];
    acqbulk();
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    for (reg u32 i = tid; i < 8 * experts; i += K3_OPS_BLK256) { sts32(w_hist, i, 0); }
    if (tid == 0) { sts32(s_base, 0, 0); sts32(s_base, 1, 0); }
    barrier();
    reg u32 w_beg = 0; reg u32 w_end = 0;
    route_warp_hist_count(route_expert, routes, experts, wid, lane, w_hist, w_beg, w_end);
    reg u32 has_act = ((active_experts[0] | active_experts[1]) != 0) ? 1 : 0;
    for (reg u32 base_e = 0; base_e < experts; base_e += K3_OPS_BLK256) {
        k3_route_build_chunk(base_e, experts, tid, wid, lane, has_act, w_hist, warp_tot, act_tot, s_base, group_row_offset, active_experts);
    }
    if (tid == 0) {
        stg32(ptr_add(group_row_offset, experts, 4), lds32(s_base, 0));
        if (has_act != 0) { stg32(active_experts, lds32(s_base, 1)); }
    }
    barrier();
    route_warp_scatter(0, route_expert, route_expert, experts, top_k, wid, lane, w_beg, w_end, w_hist, route_packed_row, route_source_token, route_expert, route_expert);
    preexit();
}

@pdl
@concept(moe)
kernel[K3_OPS_BLK128, 64] k3_moe_finalize_warp_slice_128(
    global u32* packed_slice_bf16, global u32* route_packed_row, global f32* route_weight,
    global u32* output_bf16, u32 tokens, u32 col_offset, u32 slice_cols, u32 total_cols
) {
    acqbulk();
    reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u32 tok = (ctaid_x() << 2) + wid;
    if (tok >= tokens) { preexit(); return; }
    reg u32 my_pr = 0; reg f32 my_rw = 0.0f;
    if (lane < 16) {
        my_pr = ldg32_persist(ptr_add(route_packed_row, (tok << 4) + lane, 4));
        my_rw = u32_as_f32(ldg32_persist(ptr_add(route_weight, (tok << 4) + lane, 4)));
    }
    for (reg u32 elem = lane << 3; elem < slice_cols; elem += 256) {
        reg f32 tot[8];
        unroll (k = 0..8) { tot[k] = 0.0f; }
        unroll (rt = 0..16) {
            reg u32 pr = shfl_idx(my_pr, rt);
            reg f32 rw = shfl_idx(my_rw, rt);
            reg u32x4 v = ldg128_stream(ptr_add(packed_slice_bf16, pr * slice_cols + elem, 2));
            bf16x8_fma_scalar(tot, v, rw);
        }
        reg u32x4 ov;
        unroll (k = 0..4) { ov[k] = pack_bf16x2(tot[k * 2], tot[k * 2 + 1]); }
        stg128(ptr_add(output_bf16, tok * total_cols + col_offset + elem, 2), ov);
    }
    preexit();
}

@pdl
@concept(moe)
kernel[K3_OPS_BLK224, 64] k3_moe_finalize_token224_224(
    global u32* packed_bf16, global u32* route_packed_row, global f32* route_weight,
    global u32* output_bf16, u32 tokens, u32 total_cols
) {
    shared u32 s_pr[16];
    shared f32 s_rw[16];
    acqbulk();
    reg u32 tok = ctaid_x();
    if (tok >= tokens) { preexit(); return; }
    reg u32 tid = tid_x();
    if (tid < 16) {
        reg u32 slot = (tok << 4) + tid;
        sts32(s_pr, tid, ldg32_persist(ptr_add(route_packed_row, slot, 4)));
        sts32(s_rw, tid, u32_as_f32(ldg32_persist(ptr_add(route_weight, slot, 4))));
    }
    barrier();
    reg u32 e0 = tid << 3; reg u32 e1 = (tid + 224) << 3;
    reg f32 t0[8]; reg f32 t1[8];
    unroll (k = 0..8) { t0[k] = 0.0f; t1[k] = 0.0f; }
    unroll (rt = 0..16) {
        reg u32 rbase = lds32(s_pr, rt) * total_cols;
        reg f32 rw = lds32(s_rw, rt);
        reg u32x4 v0 = ldg128_stream(ptr_add(packed_bf16, rbase + e0, 2));
        reg u32x4 v1 = ldg128_stream(ptr_add(packed_bf16, rbase + e1, 2));
        bf16x8_fma_scalar(t0, v0, rw);
        bf16x8_fma_scalar(t1, v1, rw);
    }
    reg u32x4 o0; reg u32x4 o1;
    unroll (k = 0..4) {
        o0[k] = pack_bf16x2(t0[k * 2], t0[k * 2 + 1]);
        o1[k] = pack_bf16x2(t1[k * 2], t1[k * 2 + 1]);
    }
    stg128(ptr_add(output_bf16, tok * total_cols + e0, 2), o0);
    stg128(ptr_add(output_bf16, tok * total_cols + e1, 2), o1);
    preexit();
}

@pdl
@concept(linear)
kernel[K3_OPS_BLK128, 64] k3_index_head_skip_128(
    global u32* weight, global u32* activation, global u32* output,
    global u32* seq_of_row, global u32* ctx_len, global u32* positions,
    u32 rows, u32 hidden, u32 heads, u32 topk
) {
    acqbulk();
    reg u32 row = ctaid_y();
    if (row >= rows) { preexit(); return; }
    reg u32 seq = ldg32_persist(ptr_add(seq_of_row, row, 4));
    reg u32 bnd = ldg32_persist(ptr_add(ctx_len, seq, 4));
    reg u32 p1 = ldg32_persist(ptr_add(positions, row, 4)) + 1;
    if (p1 < bnd) { bnd = p1; }
    if (bnd <= topk) { preexit(); return; }
    reg u32 head = (ctaid_x() << 2) + warp_id();
    if (head >= heads) { preexit(); return; }
    reg u32 lane = lane_id();
    reg u32 chunks = hidden >> 3;
    reg u64 w_row = ptr_add(weight, head * chunks, 16);
    reg u64 a_row = ptr_add(activation, row * chunks, 16);
    reg f32 acc = 0.0f;
    for (reg u32 c = lane; c < chunks; c += 32) {
        reg u32x4 vw = ldg128_stream(ptr_add(w_row, c, 16));
        reg u32x4 va = ldg128_persist(ptr_add(a_row, c, 16));
        bf16_dot8_acc(acc, vw, va);
    }
    acc = warp_sum(acc);
    if (lane == 0) { stg16(ptr_add(output, row * heads + head, 2), f32_to_bf16(acc)); }
    preexit();
}

macro k3_idxq_compact(seq_of_row, ctx_len, positions, r_base, rows, topk, s_rows, s_cnt) {
    reg u32 cnt = 0;
    reg u32 lim = (rows - r_base < 8) ? (rows - r_base) : 8;
    for (reg u32 r = 0; r < lim; r += 1) {
        reg u32 row = r_base + r;
        reg u32 seq = ldg32_persist(ptr_add(seq_of_row, row, 4));
        reg u32 bnd = ldg32_persist(ptr_add(ctx_len, seq, 4));
        reg u32 p1 = ldg32_persist(ptr_add(positions, row, 4)) + 1;
        if (p1 < bnd) { bnd = p1; }
        if (bnd > topk) { sts32(s_rows, cnt, row); cnt = cnt + 1; }
    }
    sts32(s_cnt, 0, cnt);
}

macro k3_idxq_run_chunk(cnt, s_rows, activation, w0, w1, output, chunks, n_dim, col0, lane) {
    reg f32 a0[8]; reg f32 a1[8];
    bf16_exact_2col_rows8(cnt, s_rows, activation, w0, w1, chunks, lane, a0, a1);
    unroll (r = 0..8) {
        if (r < cnt) {
            a0[r] = warp_sum(a0[r]); a1[r] = warp_sum(a1[r]);
            if (lane == 0) {
                stg32(ptr_add(output, lds32(s_rows, r) * n_dim + col0, 2), pack_bf16x2(a0[r], a1[r]));
            }
        }
    }
}

@pdl
@concept(linear)
kernel[K3_OPS_BLK128, 96] k3_index_q_exact_skip_128(
    global u32* weight, global u32* activation, global u32* output,
    global u32* seq_of_row, global u32* ctx_len, global u32* positions,
    u32 rows, u32 k_dim, u32 n_dim, u32 topk
) {
    shared u32 s_rows[8];
    shared u32 s_cnt[1];
    acqbulk();
    reg u32 col0 = ((ctaid_x() << 2) + warp_id()) << 1;
    if (col0 >= n_dim) { preexit(); return; }
    reg u32 tid = tid_x(); reg u32 lane = lane_id();
    reg u32 chunks = k_dim >> 3;
    reg u64 w0 = ptr_add(weight, col0 * chunks, 16);
    reg u64 w1 = ptr_add(w0, chunks, 16);
    for (reg u32 r_base = 0; r_base < rows; r_base += 8) {
        if (tid == 0) { k3_idxq_compact(seq_of_row, ctx_len, positions, r_base, rows, topk, s_rows, s_cnt); }
        barrier();
        reg u32 cnt = lds32(s_cnt, 0);
        if (cnt != 0) {
            k3_idxq_run_chunk(cnt, s_rows, activation, w0, w1, output, chunks, n_dim, col0, lane);
        }
        if (r_base + 8 < rows) { barrier(); }
    }
    preexit();
}

@pdl
@concept(linear)
template kernel[K3_OPS_BLK256, REGS] k3_shared_w1_situ_skinny_tpl<RG, REGS>(
    global u32* weight, global u32* activation, global u32* output_bf16,
    u32 rows, u32 hidden, u32 channels, f32 beta, f32 lin_beta
) {
    shared f32 partial[8 * 2 * RG];
    acqbulk();
    reg u32 c0 = ctaid_x(); reg u32 base_row = ctaid_y() * RG;
    reg u32 count = (base_row < rows) ? ((rows - base_row < RG) ? (rows - base_row) : RG) : 0;
    if (count == 0) { preexit(); return; }
    if (c0 >= channels) { preexit(); return; }
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 sub = lane_id();
    reg u32 chunks = hidden >> 3;
    reg u32 first = (chunks * wid) >> 3;
    reg u32 last = (chunks * (wid + 1)) >> 3;
    reg u64 wg = ptr_add(weight, c0 * chunks, 16);
    reg u64 wu = ptr_add(weight, (channels + c0) * chunks, 16);
    reg f32 acc_g[RG]; reg f32 acc_u[RG];
    unroll (r = 0..RG) { acc_g[r] = 0.0f; acc_u[r] = 0.0f; }
    for (reg u32 c = first + sub; c < last; c += 32) {
        reg u32x4 vwg = ldg128_stream(ptr_add(wg, c, 16));
        reg u32x4 vwu = ldg128_stream(ptr_add(wu, c, 16));
        unroll (r = 0..RG) {
            if (r < count) {
                reg u32x4 va = ldg128_persist(ptr_add(activation, (base_row + r) * chunks + c, 16));
                bf16_dot8_acc(acc_g[r], vwg, va);
                bf16_dot8_acc(acc_u[r], vwu, va);
            }
        }
    }
    unroll (r = 0..RG) {
        acc_g[r] = warp_sum(acc_g[r]);
        acc_u[r] = warp_sum(acc_u[r]);
    }
    if (sub == 0) {
        unroll (r = 0..RG) {
            sts32(partial, (wid * 2) * RG + r, acc_g[r]);
            sts32(partial, (wid * 2 + 1) * RG + r, acc_u[r]);
        }
    }
    barrier();
    if (tid < count) {
        reg f32 gv = 0.0f; reg f32 uv = 0.0f;
        unroll (w = 0..8) {
            gv = gv + lds32(partial, (w * 2) * RG + tid);
            uv = uv + lds32(partial, (w * 2 + 1) * RG + tid);
        }
        reg f32 out_v = 0.0f;
        situ_exact_f32(bf16_lo(f32_to_bf16(gv)), bf16_lo(f32_to_bf16(uv)), beta, lin_beta, out_v);
        stg16(ptr_add(output_bf16, (base_row + tid) * channels + c0, 2), f32_to_bf16(out_v));
    }
    preexit();
}

instantiate k3_shared_w1_situ_skinny_tpl<1, 64> as k3_shared_w1_situ_skinny_r1;
instantiate k3_shared_w1_situ_skinny_tpl<4, 80> as k3_shared_w1_situ_skinny_r4;
instantiate k3_shared_w1_situ_skinny_tpl<8, 96> as k3_shared_w1_situ_skinny_r8;
instantiate k3_shared_w1_situ_skinny_tpl<12, 112> as k3_shared_w1_situ_skinny_r12;

macro k3_staged_out_col(RG, s_in, out_weight, output, col, base_row, count, hidden, lane) {
    reg u64 w0 = ptr_add(out_weight, col * 96, 16);
    reg f32 acc[RG];
    unroll (r = 0..RG) { acc[r] = 0.0f; }
    for (reg u32 c = lane; c < 96; c += 32) {
        reg u32x4 vw = ldg128_stream(ptr_add(w0, c, 16));
        unroll (r = 0..RG) {
            if (r < count) {
                reg u32x4 va = lds128(s_in, r * 384 + (c << 2));
                bf16_dot8_acc(acc[r], vw, va);
            }
        }
    }
    unroll (r = 0..RG) {
        if (r < count) {
            acc[r] = warp_sum(acc[r]);
            if (lane == 0) { stg16(ptr_add(output, (base_row + r) * hidden + col, 2), f32_to_bf16(acc[r])); }
        }
    }
}

macro k3_staged_out_gemv(RG, s_in, out_weight, output, base_row, count, hidden, wid, lane) {
    unroll (pass = 0..4) {
        reg u32 col = ((ctaid_x() << 2) + pass) * 8 + wid;
        if (col < hidden) {
            k3_staged_out_col(RG, s_in, out_weight, output, col, base_row, count, hidden, lane);
        }
    }
}

@pdl
@concept(linear)
template kernel[K3_OPS_BLK256, REGS] k3_kda_norm_gate_out_tpl<RG, REGS>(
    global u32* mixed, global u32* gate, global f32* norm_w,
    global u32* out_weight, global u32* output,
    u32 rows, u32 hidden, f32 eps
) {
    shared u32 s_in[RG * 384];
    shared f32 s_wsum[8];
    acqbulk();
    reg u32 base_row = ctaid_y() * RG;
    reg u32 count = (base_row < rows) ? ((rows - base_row < RG) ? (rows - base_row) : RG) : 0;
    if (count == 0) { preexit(); return; }
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    reg u32 half_id = tid >> 7; reg u32 within = tid & 127;
    reg u32 w_in_h = within >> 5;
    reg f32 nw = u32_as_f32(ldg32_persist(ptr_add(norm_w, within, 4)));
    for (reg u32 r = 0; r < count; r += 1) {
        reg u32 row = base_row + r;
        unroll (h0 = 0..3) {
            reg u32 h = (h0 << 1) + half_id;
            reg u32 idx = (row * 6 + h) * 128 + within;
            reg f32 v = bf16_lo(ldg16_persist(ptr_add(mixed, idx, 2)));
            reg f32 sq = warp_sum(v * v);
            if (lane == 0) { sts32(s_wsum, (half_id << 2) + w_in_h, sq); }
            barrier();
            reg f32 sm = lds32(s_wsum, half_id << 2) + lds32(s_wsum, (half_id << 2) + 1) + lds32(s_wsum, (half_id << 2) + 2) + lds32(s_wsum, (half_id << 2) + 3);
            reg f32 sc = 0.0f; rsqrt_exact_div(sm, 128.0f, eps, sc);
            reg f32 nrm = bf16_lo(f32_to_bf16((v * sc) * nw));
            reg f32 gv = bf16_lo(ldg16_persist(ptr_add(gate, idx, 2)));
            reg f32 sg = 0.0f; sigmoid_exact_f32(gv, sg);
            reg u32 out16 = f32_to_bf16(nrm * sg);
            reg u32 other = shfl_xor(out16, 1);
            if ((within & 1) == 0) { sts32(s_in, r * 384 + (h << 6) + (within >> 1), pack_u16x2(out16, other)); }
            barrier();
        }
    }
    k3_staged_out_gemv(RG, s_in, out_weight, output, base_row, count, hidden, wid, lane);
    preexit();
}

instantiate k3_kda_norm_gate_out_tpl<1, 64> as k3_kda_norm_gate_out_r1;
instantiate k3_kda_norm_gate_out_tpl<4, 80> as k3_kda_norm_gate_out_r4;
instantiate k3_kda_norm_gate_out_tpl<8, 96> as k3_kda_norm_gate_out_r8;
instantiate k3_kda_norm_gate_out_tpl<12, 112> as k3_kda_norm_gate_out_r12;

@pdl
@concept(linear)
template kernel[K3_OPS_BLK256, REGS] k3_mla_gate_out_tpl<RG, REGS>(
    global u32* value, global u32* gate, global u32* out_weight, global u32* output,
    u32 rows, u32 hidden
) {
    shared u32 s_in[RG * 384];
    acqbulk();
    reg u32 base_row = ctaid_y() * RG;
    reg u32 count = (base_row < rows) ? ((rows - base_row < RG) ? (rows - base_row) : RG) : 0;
    if (count == 0) { preexit(); return; }
    reg u32 tid = tid_x(); reg u32 wid = warp_id(); reg u32 lane = lane_id();
    for (reg u32 r = 0; r < count; r += 1) {
        reg u32 rbase = (base_row + r) * 384;
        for (reg u32 i = tid; i < 384; i += K3_OPS_BLK256) {
            reg u32 vv = ldg32_persist(ptr_add(value, rbase + i, 4));
            reg u32 gv = ldg32_persist(ptr_add(gate, rbase + i, 4));
            reg f32 s0 = 0.0f; reg f32 s1 = 0.0f;
            sigmoid_exact_f32(bf16_lo(gv), s0);
            sigmoid_exact_f32(bf16_hi(gv), s1);
            sts32(s_in, r * 384 + i, pack_bf16x2(bf16_lo(vv) * s0, bf16_hi(vv) * s1));
        }
    }
    barrier();
    k3_staged_out_gemv(RG, s_in, out_weight, output, base_row, count, hidden, wid, lane);
    preexit();
}

instantiate k3_mla_gate_out_tpl<1, 64> as k3_mla_gate_out_r1;
instantiate k3_mla_gate_out_tpl<4, 80> as k3_mla_gate_out_r4;
instantiate k3_mla_gate_out_tpl<8, 96> as k3_mla_gate_out_r8;
instantiate k3_mla_gate_out_tpl<12, 112> as k3_mla_gate_out_r12;
