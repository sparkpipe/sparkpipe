@pdl
@concept(linear)
template kernel[256, 64] splitk_reduce_tpl<IS_SITU>(
    if (IS_SITU == 0) blob[128, 8] args,
    if (IS_SITU == 1) global f32* scratch1, if (IS_SITU == 1) global u32* output1,
    if (IS_SITU == 1) u32 rows1, if (IS_SITU == 1) u32 channels1, if (IS_SITU == 1) u32 split_k1,
    if (IS_SITU == 1) f32 beta1, if (IS_SITU == 1) f32 lin_beta1
) {
    acqbulk();
    reg u32 row = ctaid_y(); reg u32 col = ((ctaid_x() << 8) + tid_x()) << 1;
    if constexpr (IS_SITU == 0) {
        reg u32 rows = param_u32(args, 100); reg u32 total_cols = param_u32(args, 88);
        if (row >= rows || col >= total_cols) { preexit(); return; }
        reg u32 t1_ft = param_u32(args, 76);
        reg u32 ft = param_u32(args, 36); reg u32 tgt_n = param_u32(args, 24);
        reg u32 stride = param_u32(args, 28); reg u32 coff = param_u32(args, 32);
        reg u32 f32_nz = param_u32(args, 16) | param_u32(args, 20);
        reg u64 of32 = param_u64(args, 16); reg u64 ob16 = param_u64(args, 8);
        if (param_u32(args, 80) > 1 && (col >> 5) >= t1_ft) {
            ft = t1_ft; tgt_n = param_u32(args, 64); stride = param_u32(args, 68); coff = param_u32(args, 72);
            f32_nz = param_u32(args, 56) | param_u32(args, 60); of32 = param_u64(args, 56); ob16 = param_u64(args, 48);
        }
        reg u32 local_c = col - (ft << 5);
        if (local_c >= tgt_n) { preexit(); return; }
        reg u32 split_k = param_u32(args, 96); reg u32 sk_stride = rows * total_cols;
        reg u64 src = ptr_add(param_u64(args, 120), row * total_cols + col, 4);
        reg f32 s0 = 0.0f; reg f32 s1 = 0.0f;
        for (reg u32 sk = 0; sk < split_k; sk += 1) { reg u32x2 v = ldg64_stream(ptr_add(src, sk * sk_stride, 4)); s0 = s0 + u32_as_f32(v[0]); s1 = s1 + u32_as_f32(v[1]); }
        reg u32 oidx = row * stride + coff + local_c;
        if (f32_nz != 0) { stg64(ptr_add(of32, oidx, 4), pack_u32x2(f32_as_u32(s0), f32_as_u32(s1))); }
        else { stg32(ptr_add(ob16, oidx, 2), pack_bf16x2(s0, s1)); }
    } else {
        if (row >= rows1 || col >= channels1) { preexit(); return; }
        reg u32 total_cols = channels1 << 1; reg u32 sk_stride = rows1 * total_cols;
        reg u64 g_src = ptr_add(scratch1, row * total_cols + col, 4); reg u64 u_src = ptr_add(g_src, channels1, 4);
        reg f32 g0 = 0.0f; reg f32 g1 = 0.0f; reg f32 u0 = 0.0f; reg f32 u1 = 0.0f;
        for (reg u32 sk = 0; sk < split_k1; sk += 1) {
            reg u32x2 gv = ldg64_stream(ptr_add(g_src, sk * sk_stride, 4)); reg u32x2 uv = ldg64_stream(ptr_add(u_src, sk * sk_stride, 4));
            g0 = g0 + u32_as_f32(gv[0]); g1 = g1 + u32_as_f32(gv[1]); u0 = u0 + u32_as_f32(uv[0]); u1 = u1 + u32_as_f32(uv[1]);
        }
        k3_situ_store_pair(output1, row, col, channels1, g0, g1, u0, u1, beta1, lin_beta1);
    }
    preexit();
}

