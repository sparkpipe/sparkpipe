@pdl
@concept(linear)
template kernel[WARPS_M * WARPS_N * 32, REGS] qwen_exact_bf16_gate_up_swiglu_tpl<WARPS_M, WARPS_N, RPG, NPG, REGS>(
    global u32* w_gate_up, global u32* activation, global u32* output,
    u32 rows, u32 input_dim, u32 ffn_rows
) {
    acqbulk();
    reg u32 sub = lane_id();
    reg u32 gr0 = 0; reg u32 gn0 = 0; reg u32 row_cnt = 0;
    exact_bf16_setup(WARPS_M, WARPS_N, RPG, NPG, ctaid_x(), rows, warp_id(), gr0, gn0, row_cnt);
    if (row_cnt == 0) { preexit(); return; }
    reg u32 chunks = input_dim >> 3;
    reg f32 acc_g[16]; reg f32 acc_u[16];
    unroll (i = 0..NPG * RPG) { acc_g[i] = 0.0f; acc_u[i] = 0.0f; }
    reg u64 a_row[RPG]; reg u64 wg_row[NPG];
    exact_bf16_init_ptrs(RPG, NPG, activation, w_gate_up, gr0, gn0, row_cnt, ffn_rows, chunks, sub, a_row, wg_row);
    reg u32 c_end = (chunks > sub) ? (chunks - sub) : 0;
    reg u32 ffn_ch = ffn_rows * chunks;
    reg u32 gr_rc_sub = (gr0 << 9) | (row_cnt << 5) | sub;
    exact_bf16_run_kloop(1, WARPS_M, RPG, NPG, c_end, ffn_ch, wg_row, a_row, acc_g, acc_u);
    exact_bf16_reduce_store(1, RPG, NPG, acc_g, acc_u, output, gr_rc_sub, gn0, ffn_rows);
    preexit();
}

