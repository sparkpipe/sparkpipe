const BLOCK_CONV = 256;
const BLOCK_DELTA = 128;

kernel[BLOCK_DELTA, 192] delta_rule_decode1_256_128_128_4_pdl(
    global u32* state_pool, u32 slot_bytes, global u32* state_index,
    global u32* sequence_row_begin, global u32* query_bf16, global u32* key_bf16,
    global u32* value_bf16, global u32* forget_gate, global u32* write_gate,
    global u32* output_bf16, u32 key_heads, u32 value_heads_per_key,
    u32 sequences, u32 commit, global u32* sequence_row_indices
) {
    shared f32 key_s[128];
    shared f32 query_s[128];
    shared f32 forget_s[128];
    shared f32 beta_s[4];

    reg u32 lane = lane_id();
    reg u32 wid = warp_id();
    reg u32 sequence = ctaid_x();
    reg u32 head = ctaid_y();
    reg u32 col = ((ctaid_z() << 2) + wid) * 32 + lane;
    if (sequence >= sequences) { return; }
    if (head >= key_heads) { return; }
    if (col >= 128) { return; }

    pdl_wait();
    reg u32 has_srb = sequence_row_begin[0] | sequence_row_begin[1];
    reg u32 begin = sequence;
    reg u32 end = sequence + 1;
    if (has_srb != 0) {
        begin = ldg32_persist(ptr_add(sequence_row_begin, sequence, 4));
        end = ldg32_persist(ptr_add(sequence_row_begin, sequence + 1, 4));
    }
    reg u32 count = 0;
    if (end > begin) {
        count = end - begin;
    }
    if (count == 0) {
        pdl_release();
        return;
    }

    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 slot_ptr = ptr_add(state_pool, sidx, slot_bytes);
    ureg u64 head_ptr = ptr_add(slot_ptr, head, 65536);
    ureg u64 col_state = ptr_add(head_ptr, col, 4);
    reg f32 q_scale = 0.08838834613561630249f;
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];

    if (count == 1) {
        reg u32 current = begin;
        if (has_sri != 0) {
            current = ldg32_persist(ptr_add(sequence_row_indices, begin, 4));
        }
        reg u32 rh = current * key_heads + head;
        if (wid == 0) {
            ureg u64 k_ptr = ptr_add(ptr_add(key_bf16, rh, 256), lane, 2);
            reg f32 kp0 = bf16_lo(ldg16_persist(k_ptr));
            reg f32 kp1 = bf16_lo(ldg16_persist(ptr_add(k_ptr, 32, 2)));
            reg f32 kp2 = bf16_lo(ldg16_persist(ptr_add(k_ptr, 64, 2)));
            reg f32 kp3 = bf16_lo(ldg16_persist(ptr_add(k_ptr, 96, 2)));
            reg f32 ks0 = kp0 * kp0;
            reg f32 ks1 = kp1 * kp1;
            reg f32 ks2 = kp2 * kp2;
            reg f32 ks3 = kp3 * kp3;
            ks0 = ks0 + shfl_down(ks0, 16);
            ks0 = ks0 + shfl_down(ks0, 8);
            ks0 = ks0 + shfl_down(ks0, 4);
            ks0 = ks0 + shfl_down(ks0, 2);
            ks0 = ks0 + shfl_down(ks0, 1);
            ks0 = shfl_idx(ks0, 0);
            ks1 = ks1 + shfl_down(ks1, 16);
            ks1 = ks1 + shfl_down(ks1, 8);
            ks1 = ks1 + shfl_down(ks1, 4);
            ks1 = ks1 + shfl_down(ks1, 2);
            ks1 = ks1 + shfl_down(ks1, 1);
            ks1 = shfl_idx(ks1, 0);
            ks2 = ks2 + shfl_down(ks2, 16);
            ks2 = ks2 + shfl_down(ks2, 8);
            ks2 = ks2 + shfl_down(ks2, 4);
            ks2 = ks2 + shfl_down(ks2, 2);
            ks2 = ks2 + shfl_down(ks2, 1);
            ks2 = shfl_idx(ks2, 0);
            ks3 = ks3 + shfl_down(ks3, 16);
            ks3 = ks3 + shfl_down(ks3, 8);
            ks3 = ks3 + shfl_down(ks3, 4);
            ks3 = ks3 + shfl_down(ks3, 2);
            ks3 = ks3 + shfl_down(ks3, 1);
            ks3 = shfl_idx(ks3, 0);
            reg f32 ksum = 0.0f;
            if (lane == 0) { ksum = ks0; }
            if (lane == 1) { ksum = ks1; }
            if (lane == 2) { ksum = ks2; }
            if (lane == 3) { ksum = ks3; }
            ksum = ksum + shfl_down(ksum, 4);
            ksum = ksum + shfl_down(ksum, 2);
            ksum = ksum + shfl_down(ksum, 1);
            ksum = shfl_idx(ksum, 0);
            reg f32 kinv = rsqrt(ksum + 1.0e-6f);
            sts32(key_s, lane, kp0 * kinv);
            sts32(key_s, lane + 32, kp1 * kinv);
            sts32(key_s, lane + 64, kp2 * kinv);
            sts32(key_s, lane + 96, kp3 * kinv);
            ureg u64 fg_ptr = ptr_add(ptr_add(forget_gate, rh, 512), lane, 4);
            sts32(forget_s, lane, u32_as_f32(ldg32_persist(fg_ptr)));
            sts32(forget_s, lane + 32, u32_as_f32(ldg32_persist(ptr_add(fg_ptr, 32, 4))));
            sts32(forget_s, lane + 64, u32_as_f32(ldg32_persist(ptr_add(fg_ptr, 64, 4))));
            sts32(forget_s, lane + 96, u32_as_f32(ldg32_persist(ptr_add(fg_ptr, 96, 4))));
            if (lane == 0) {
                sts32(beta_s, 0, u32_as_f32(ldg32_persist(ptr_add(write_gate, rh, 4))));
            }
        } else {
            if (wid == 1) {
                ureg u64 q_ptr = ptr_add(ptr_add(query_bf16, rh, 256), lane, 2);
                reg f32 qp0 = bf16_lo(ldg16_persist(q_ptr));
                reg f32 qp1 = bf16_lo(ldg16_persist(ptr_add(q_ptr, 32, 2)));
                reg f32 qp2 = bf16_lo(ldg16_persist(ptr_add(q_ptr, 64, 2)));
                reg f32 qp3 = bf16_lo(ldg16_persist(ptr_add(q_ptr, 96, 2)));
                reg f32 qs0 = qp0 * qp0;
                reg f32 qs1 = qp1 * qp1;
                reg f32 qs2 = qp2 * qp2;
                reg f32 qs3 = qp3 * qp3;
                qs0 = qs0 + shfl_down(qs0, 16);
                qs0 = qs0 + shfl_down(qs0, 8);
                qs0 = qs0 + shfl_down(qs0, 4);
                qs0 = qs0 + shfl_down(qs0, 2);
                qs0 = qs0 + shfl_down(qs0, 1);
                qs0 = shfl_idx(qs0, 0);
                qs1 = qs1 + shfl_down(qs1, 16);
                qs1 = qs1 + shfl_down(qs1, 8);
                qs1 = qs1 + shfl_down(qs1, 4);
                qs1 = qs1 + shfl_down(qs1, 2);
                qs1 = qs1 + shfl_down(qs1, 1);
                qs1 = shfl_idx(qs1, 0);
                qs2 = qs2 + shfl_down(qs2, 16);
                qs2 = qs2 + shfl_down(qs2, 8);
                qs2 = qs2 + shfl_down(qs2, 4);
                qs2 = qs2 + shfl_down(qs2, 2);
                qs2 = qs2 + shfl_down(qs2, 1);
                qs2 = shfl_idx(qs2, 0);
                qs3 = qs3 + shfl_down(qs3, 16);
                qs3 = qs3 + shfl_down(qs3, 8);
                qs3 = qs3 + shfl_down(qs3, 4);
                qs3 = qs3 + shfl_down(qs3, 2);
                qs3 = qs3 + shfl_down(qs3, 1);
                qs3 = shfl_idx(qs3, 0);
                reg f32 qsum = 0.0f;
                if (lane == 0) { qsum = qs0; }
                if (lane == 1) { qsum = qs1; }
                if (lane == 2) { qsum = qs2; }
                if (lane == 3) { qsum = qs3; }
                qsum = qsum + shfl_down(qsum, 4);
                qsum = qsum + shfl_down(qsum, 2);
                qsum = qsum + shfl_down(qsum, 1);
                qsum = shfl_idx(qsum, 0);
                reg f32 qfac = rsqrt(qsum + 1.0e-6f) * q_scale;
                sts32(query_s, lane, qp0 * qfac);
                sts32(query_s, lane + 32, qp1 * qfac);
                sts32(query_s, lane + 64, qp2 * qfac);
                sts32(query_s, lane + 96, qp3 * qfac);
            }
        }
        barrier();

        reg f32 s0 = u32_as_f32(ldg32_stream(col_state));
        reg f32 s1 = u32_as_f32(ldg32_stream(ptr_add(col_state, 1, 512)));
        reg f32 s2 = u32_as_f32(ldg32_stream(ptr_add(col_state, 2, 512)));
        reg f32 s3 = u32_as_f32(ldg32_stream(ptr_add(col_state, 3, 512)));
        reg f32 s4 = u32_as_f32(ldg32_stream(ptr_add(col_state, 4, 512)));
        reg f32 s5 = u32_as_f32(ldg32_stream(ptr_add(col_state, 5, 512)));
        reg f32 s6 = u32_as_f32(ldg32_stream(ptr_add(col_state, 6, 512)));
        reg f32 s7 = u32_as_f32(ldg32_stream(ptr_add(col_state, 7, 512)));
        reg f32 s8 = u32_as_f32(ldg32_stream(ptr_add(col_state, 8, 512)));
        reg f32 s9 = u32_as_f32(ldg32_stream(ptr_add(col_state, 9, 512)));
        reg f32 s10 = u32_as_f32(ldg32_stream(ptr_add(col_state, 10, 512)));
        reg f32 s11 = u32_as_f32(ldg32_stream(ptr_add(col_state, 11, 512)));
        reg f32 s12 = u32_as_f32(ldg32_stream(ptr_add(col_state, 12, 512)));
        reg f32 s13 = u32_as_f32(ldg32_stream(ptr_add(col_state, 13, 512)));
        reg f32 s14 = u32_as_f32(ldg32_stream(ptr_add(col_state, 14, 512)));
        reg f32 s15 = u32_as_f32(ldg32_stream(ptr_add(col_state, 15, 512)));
        reg f32 s16 = u32_as_f32(ldg32_stream(ptr_add(col_state, 16, 512)));
        reg f32 s17 = u32_as_f32(ldg32_stream(ptr_add(col_state, 17, 512)));
        reg f32 s18 = u32_as_f32(ldg32_stream(ptr_add(col_state, 18, 512)));
        reg f32 s19 = u32_as_f32(ldg32_stream(ptr_add(col_state, 19, 512)));
        reg f32 s20 = u32_as_f32(ldg32_stream(ptr_add(col_state, 20, 512)));
        reg f32 s21 = u32_as_f32(ldg32_stream(ptr_add(col_state, 21, 512)));
        reg f32 s22 = u32_as_f32(ldg32_stream(ptr_add(col_state, 22, 512)));
        reg f32 s23 = u32_as_f32(ldg32_stream(ptr_add(col_state, 23, 512)));
        reg f32 s24 = u32_as_f32(ldg32_stream(ptr_add(col_state, 24, 512)));
        reg f32 s25 = u32_as_f32(ldg32_stream(ptr_add(col_state, 25, 512)));
        reg f32 s26 = u32_as_f32(ldg32_stream(ptr_add(col_state, 26, 512)));
        reg f32 s27 = u32_as_f32(ldg32_stream(ptr_add(col_state, 27, 512)));
        reg f32 s28 = u32_as_f32(ldg32_stream(ptr_add(col_state, 28, 512)));
        reg f32 s29 = u32_as_f32(ldg32_stream(ptr_add(col_state, 29, 512)));
        reg f32 s30 = u32_as_f32(ldg32_stream(ptr_add(col_state, 30, 512)));
        reg f32 s31 = u32_as_f32(ldg32_stream(ptr_add(col_state, 31, 512)));
        reg f32 s32 = u32_as_f32(ldg32_stream(ptr_add(col_state, 32, 512)));
        reg f32 s33 = u32_as_f32(ldg32_stream(ptr_add(col_state, 33, 512)));
        reg f32 s34 = u32_as_f32(ldg32_stream(ptr_add(col_state, 34, 512)));
        reg f32 s35 = u32_as_f32(ldg32_stream(ptr_add(col_state, 35, 512)));
        reg f32 s36 = u32_as_f32(ldg32_stream(ptr_add(col_state, 36, 512)));
        reg f32 s37 = u32_as_f32(ldg32_stream(ptr_add(col_state, 37, 512)));
        reg f32 s38 = u32_as_f32(ldg32_stream(ptr_add(col_state, 38, 512)));
        reg f32 s39 = u32_as_f32(ldg32_stream(ptr_add(col_state, 39, 512)));
        reg f32 s40 = u32_as_f32(ldg32_stream(ptr_add(col_state, 40, 512)));
        reg f32 s41 = u32_as_f32(ldg32_stream(ptr_add(col_state, 41, 512)));
        reg f32 s42 = u32_as_f32(ldg32_stream(ptr_add(col_state, 42, 512)));
        reg f32 s43 = u32_as_f32(ldg32_stream(ptr_add(col_state, 43, 512)));
        reg f32 s44 = u32_as_f32(ldg32_stream(ptr_add(col_state, 44, 512)));
        reg f32 s45 = u32_as_f32(ldg32_stream(ptr_add(col_state, 45, 512)));
        reg f32 s46 = u32_as_f32(ldg32_stream(ptr_add(col_state, 46, 512)));
        reg f32 s47 = u32_as_f32(ldg32_stream(ptr_add(col_state, 47, 512)));
        reg f32 s48 = u32_as_f32(ldg32_stream(ptr_add(col_state, 48, 512)));
        reg f32 s49 = u32_as_f32(ldg32_stream(ptr_add(col_state, 49, 512)));
        reg f32 s50 = u32_as_f32(ldg32_stream(ptr_add(col_state, 50, 512)));
        reg f32 s51 = u32_as_f32(ldg32_stream(ptr_add(col_state, 51, 512)));
        reg f32 s52 = u32_as_f32(ldg32_stream(ptr_add(col_state, 52, 512)));
        reg f32 s53 = u32_as_f32(ldg32_stream(ptr_add(col_state, 53, 512)));
        reg f32 s54 = u32_as_f32(ldg32_stream(ptr_add(col_state, 54, 512)));
        reg f32 s55 = u32_as_f32(ldg32_stream(ptr_add(col_state, 55, 512)));
        reg f32 s56 = u32_as_f32(ldg32_stream(ptr_add(col_state, 56, 512)));
        reg f32 s57 = u32_as_f32(ldg32_stream(ptr_add(col_state, 57, 512)));
        reg f32 s58 = u32_as_f32(ldg32_stream(ptr_add(col_state, 58, 512)));
        reg f32 s59 = u32_as_f32(ldg32_stream(ptr_add(col_state, 59, 512)));
        reg f32 s60 = u32_as_f32(ldg32_stream(ptr_add(col_state, 60, 512)));
        reg f32 s61 = u32_as_f32(ldg32_stream(ptr_add(col_state, 61, 512)));
        reg f32 s62 = u32_as_f32(ldg32_stream(ptr_add(col_state, 62, 512)));
        reg f32 s63 = u32_as_f32(ldg32_stream(ptr_add(col_state, 63, 512)));
        reg f32 s64 = u32_as_f32(ldg32_stream(ptr_add(col_state, 64, 512)));
        reg f32 s65 = u32_as_f32(ldg32_stream(ptr_add(col_state, 65, 512)));
        reg f32 s66 = u32_as_f32(ldg32_stream(ptr_add(col_state, 66, 512)));
        reg f32 s67 = u32_as_f32(ldg32_stream(ptr_add(col_state, 67, 512)));
        reg f32 s68 = u32_as_f32(ldg32_stream(ptr_add(col_state, 68, 512)));
        reg f32 s69 = u32_as_f32(ldg32_stream(ptr_add(col_state, 69, 512)));
        reg f32 s70 = u32_as_f32(ldg32_stream(ptr_add(col_state, 70, 512)));
        reg f32 s71 = u32_as_f32(ldg32_stream(ptr_add(col_state, 71, 512)));
        reg f32 s72 = u32_as_f32(ldg32_stream(ptr_add(col_state, 72, 512)));
        reg f32 s73 = u32_as_f32(ldg32_stream(ptr_add(col_state, 73, 512)));
        reg f32 s74 = u32_as_f32(ldg32_stream(ptr_add(col_state, 74, 512)));
        reg f32 s75 = u32_as_f32(ldg32_stream(ptr_add(col_state, 75, 512)));
        reg f32 s76 = u32_as_f32(ldg32_stream(ptr_add(col_state, 76, 512)));
        reg f32 s77 = u32_as_f32(ldg32_stream(ptr_add(col_state, 77, 512)));
        reg f32 s78 = u32_as_f32(ldg32_stream(ptr_add(col_state, 78, 512)));
        reg f32 s79 = u32_as_f32(ldg32_stream(ptr_add(col_state, 79, 512)));
        reg f32 s80 = u32_as_f32(ldg32_stream(ptr_add(col_state, 80, 512)));
        reg f32 s81 = u32_as_f32(ldg32_stream(ptr_add(col_state, 81, 512)));
        reg f32 s82 = u32_as_f32(ldg32_stream(ptr_add(col_state, 82, 512)));
        reg f32 s83 = u32_as_f32(ldg32_stream(ptr_add(col_state, 83, 512)));
        reg f32 s84 = u32_as_f32(ldg32_stream(ptr_add(col_state, 84, 512)));
        reg f32 s85 = u32_as_f32(ldg32_stream(ptr_add(col_state, 85, 512)));
        reg f32 s86 = u32_as_f32(ldg32_stream(ptr_add(col_state, 86, 512)));
        reg f32 s87 = u32_as_f32(ldg32_stream(ptr_add(col_state, 87, 512)));
        reg f32 s88 = u32_as_f32(ldg32_stream(ptr_add(col_state, 88, 512)));
        reg f32 s89 = u32_as_f32(ldg32_stream(ptr_add(col_state, 89, 512)));
        reg f32 s90 = u32_as_f32(ldg32_stream(ptr_add(col_state, 90, 512)));
        reg f32 s91 = u32_as_f32(ldg32_stream(ptr_add(col_state, 91, 512)));
        reg f32 s92 = u32_as_f32(ldg32_stream(ptr_add(col_state, 92, 512)));
        reg f32 s93 = u32_as_f32(ldg32_stream(ptr_add(col_state, 93, 512)));
        reg f32 s94 = u32_as_f32(ldg32_stream(ptr_add(col_state, 94, 512)));
        reg f32 s95 = u32_as_f32(ldg32_stream(ptr_add(col_state, 95, 512)));
        reg f32 s96 = u32_as_f32(ldg32_stream(ptr_add(col_state, 96, 512)));
        reg f32 s97 = u32_as_f32(ldg32_stream(ptr_add(col_state, 97, 512)));
        reg f32 s98 = u32_as_f32(ldg32_stream(ptr_add(col_state, 98, 512)));
        reg f32 s99 = u32_as_f32(ldg32_stream(ptr_add(col_state, 99, 512)));
        reg f32 s100 = u32_as_f32(ldg32_stream(ptr_add(col_state, 100, 512)));
        reg f32 s101 = u32_as_f32(ldg32_stream(ptr_add(col_state, 101, 512)));
        reg f32 s102 = u32_as_f32(ldg32_stream(ptr_add(col_state, 102, 512)));
        reg f32 s103 = u32_as_f32(ldg32_stream(ptr_add(col_state, 103, 512)));
        reg f32 s104 = u32_as_f32(ldg32_stream(ptr_add(col_state, 104, 512)));
        reg f32 s105 = u32_as_f32(ldg32_stream(ptr_add(col_state, 105, 512)));
        reg f32 s106 = u32_as_f32(ldg32_stream(ptr_add(col_state, 106, 512)));
        reg f32 s107 = u32_as_f32(ldg32_stream(ptr_add(col_state, 107, 512)));
        reg f32 s108 = u32_as_f32(ldg32_stream(ptr_add(col_state, 108, 512)));
        reg f32 s109 = u32_as_f32(ldg32_stream(ptr_add(col_state, 109, 512)));
        reg f32 s110 = u32_as_f32(ldg32_stream(ptr_add(col_state, 110, 512)));
        reg f32 s111 = u32_as_f32(ldg32_stream(ptr_add(col_state, 111, 512)));
        reg f32 s112 = u32_as_f32(ldg32_stream(ptr_add(col_state, 112, 512)));
        reg f32 s113 = u32_as_f32(ldg32_stream(ptr_add(col_state, 113, 512)));
        reg f32 s114 = u32_as_f32(ldg32_stream(ptr_add(col_state, 114, 512)));
        reg f32 s115 = u32_as_f32(ldg32_stream(ptr_add(col_state, 115, 512)));
        reg f32 s116 = u32_as_f32(ldg32_stream(ptr_add(col_state, 116, 512)));
        reg f32 s117 = u32_as_f32(ldg32_stream(ptr_add(col_state, 117, 512)));
        reg f32 s118 = u32_as_f32(ldg32_stream(ptr_add(col_state, 118, 512)));
        reg f32 s119 = u32_as_f32(ldg32_stream(ptr_add(col_state, 119, 512)));
        reg f32 s120 = u32_as_f32(ldg32_stream(ptr_add(col_state, 120, 512)));
        reg f32 s121 = u32_as_f32(ldg32_stream(ptr_add(col_state, 121, 512)));
        reg f32 s122 = u32_as_f32(ldg32_stream(ptr_add(col_state, 122, 512)));
        reg f32 s123 = u32_as_f32(ldg32_stream(ptr_add(col_state, 123, 512)));
        reg f32 s124 = u32_as_f32(ldg32_stream(ptr_add(col_state, 124, 512)));
        reg f32 s125 = u32_as_f32(ldg32_stream(ptr_add(col_state, 125, 512)));
        reg f32 s126 = u32_as_f32(ldg32_stream(ptr_add(col_state, 126, 512)));
        reg f32 s127 = u32_as_f32(ldg32_stream(ptr_add(col_state, 127, 512)));

        reg f32 pred = 0.0f;
        if (1 == 1) {
            reg f32x4 kv = lds128(key_s, 0);
            reg f32x4 fv = lds128(forget_s, 0);
            pred = fma(s0 * kv[0], fv[0], pred);
            pred = fma(s1 * kv[1], fv[1], pred);
            pred = fma(s2 * kv[2], fv[2], pred);
            pred = fma(s3 * kv[3], fv[3], pred);
        }
        if (1 == 1) {
            reg f32x4 kv = lds128(key_s, 4);
            reg f32x4 fv = lds128(forget_s, 4);
            pred = fma(s4 * kv[0], fv[0], pred);
            pred = fma(s5 * kv[1], fv[1], pred);
            pred = fma(s6 * kv[2], fv[2], pred);
            pred = fma(s7 * kv[3], fv[3], pred);
        }
        if (1 == 1) {
            reg f32x4 kv = lds128(key_s, 8);
            reg f32x4 fv = lds128(forget_s, 8);
            pred = fma(s8 * kv[0], fv[0], pred);
            pred = fma(s9 * kv[1], fv[1], pred);
            pred = fma(s10 * kv[2], fv[2], pred);
            pred = fma(s11 * kv[3], fv[3], pred);
        }
        if (1 == 1) {
            reg f32x4 kv = lds128(key_s, 12);
            reg f32x4 fv = lds128(forget_s, 12);
            pred = fma(s12 * kv[0], fv[0], pred);
            pred = fma(s13 * kv[1], fv[1], pred);
            pred = fma(s14 * kv[2], fv[2], pred);
            pred = fma(s15 * kv[3], fv[3], pred);
        }
        if (1 == 1) {
            reg f32x4 kv = lds128(key_s, 16);
            reg f32x4 fv = lds128(forget_s, 16);
            pred = fma(s16 * kv[0], fv[0], pred);
