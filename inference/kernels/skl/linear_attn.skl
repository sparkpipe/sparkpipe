        return;
    }

    for (reg u32 step = 0; step < count; step += 1) {
        reg u32 current = begin + step;
        if (has_sri != 0) {
            current = ldg32_persist(ptr_add(sequence_row_indices, begin + step, 4));
        }
        reg u32 rh = current * key_heads + head;
        if (step != 0) {
            barrier();
        }
        if (wid == 0) {
            ureg u64 k_ptr = ptr_add(ptr_add(key_bf16, rh, 256), lane, 2);
            reg f32 kp0 = bf16_lo(ldg16_persist(k_ptr));
            reg f32 kp1 = bf16_lo(ldg16_persist(ptr_add(k_ptr, 32, 2)));
            reg f32 kp2 = bf16_lo(ldg16_persist(ptr_add(k_ptr, 64, 2)));
            reg f32 kp3 = bf16_lo(ldg16_persist(ptr_add(k_ptr, 96, 2)));
            reg f32 ks0 = kp0 * kp0;
            reg f32 ks1 = kp1 * kp1;
            reg f32 ks2 = kp2 * kp2;
            reg f32 ks3 = kp3 * kp3;
            ks0 = ks0 + shfl_down(ks0, 16);
            ks0 = ks0 + shfl_down(ks0, 8);
            ks0 = ks0 + shfl_down(ks0, 4);
            ks0 = ks0 + shfl_down(ks0, 2);
            ks0 = ks0 + shfl_down(ks0, 1);
            ks0 = shfl_idx(ks0, 0);
            ks1 = ks1 + shfl_down(ks1, 16);
            ks1 = ks1 + shfl_down(ks1, 8);
            ks1 = ks1 + shfl_down(ks1, 4);
            ks1 = ks1 + shfl_down(ks1, 2);
            ks1 = ks1 + shfl_down(ks1, 1);
            ks1 = shfl_idx(ks1, 0);
            ks2 = ks2 + shfl_down(ks2, 16);
            ks2 = ks2 + shfl_down(ks2, 8);
            ks2 = ks2 + shfl_down(ks2, 4);
            ks2 = ks2 + shfl_down(ks2, 2);
            ks2 = ks2 + shfl_down(ks2, 1);
            ks2 = shfl_idx(ks2, 0);
            ks3 = ks3 + shfl_down(ks3, 16);
            ks3 = ks3 + shfl_down(ks3, 8);
            ks3 = ks3 + shfl_down(ks3, 4);
            ks3 = ks3 + shfl_down(ks3, 2);
            ks3 = ks3 + shfl_down(ks3, 1);
            ks3 = shfl_idx(ks3, 0);
            reg f32 ksum = 0.0f;
            if (lane == 0) { ksum = ks0; }
            if (lane == 1) { ksum = ks1; }
            if (lane == 2) { ksum = ks2; }
            if (lane == 3) { ksum = ks3; }
            ksum = ksum + shfl_down(ksum, 4);
            ksum = ksum + shfl_down(ksum, 2);
            ksum = ksum + shfl_down(ksum, 1);
            ksum = shfl_idx(ksum, 0);
            reg f32 kinv = rsqrt(ksum + 1.0e-6f);
            sts32(key_s, lane, kp0 * kinv);
            sts32(key_s, lane + 32, kp1 * kinv);
            sts32(key_s, lane + 64, kp2 * kinv);
            sts32(key_s, lane + 96, kp3 * kinv);
            ureg u64 fg_ptr = ptr_add(ptr_add(forget_gate, rh, 512), lane, 4);
            sts32(forget_s, lane, u32_as_f32(ldg32_persist(fg_ptr)));
            sts32(forget_s, lane + 32, u32_as_f32(ldg32_persist(ptr_add(fg_ptr, 32, 4))));
            sts32(forget_s, lane + 64, u32_as_f32(ldg32_persist(ptr_add(fg_ptr, 64, 4))));
            sts32(forget_s, lane + 96, u32_as_f32(ldg32_persist(ptr_add(fg_ptr, 96, 4))));
            if (lane == 0) {
                sts32(beta_s, 0, u32_as_f32(ldg32_persist(ptr_add(write_gate, rh, 4))));
            }
        } else {
            if (wid == 1) {
                ureg u64 q_ptr = ptr_add(ptr_add(query_bf16, rh, 256), lane, 2);
                reg f32 qp0 = bf16_lo(ldg16_persist(q_ptr));
                reg f32 qp1 = bf16_lo(ldg16_persist(ptr_add(q_ptr, 32, 2)));
                reg f32 qp2 = bf16_lo(ldg16_persist(ptr_add(q_ptr, 64, 2)));
                reg f32 qp3 = bf16_lo(ldg16_persist(ptr_add(q_ptr, 96, 2)));
                reg f32 qs0 = qp0 * qp0;
                reg f32 qs1 = qp1 * qp1;
                reg f32 qs2 = qp2 * qp2;
                reg f32 qs3 = qp3 * qp3;
                qs0 = qs0 + shfl_down(qs0, 16);
                qs0 = qs0 + shfl_down(qs0, 8);
                qs0 = qs0 + shfl_down(qs0, 4);
                qs0 = qs0 + shfl_down(qs0, 2);
                qs0 = qs0 + shfl_down(qs0, 1);
                qs0 = shfl_idx(qs0, 0);
                qs1 = qs1 + shfl_down(qs1, 16);
                qs1 = qs1 + shfl_down(qs1, 8);
                qs1 = qs1 + shfl_down(qs1, 4);
                qs1 = qs1 + shfl_down(qs1, 2);
                qs1 = qs1 + shfl_down(qs1, 1);
                qs1 = shfl_idx(qs1, 0);
                qs2 = qs2 + shfl_down(qs2, 16);
                qs2 = qs2 + shfl_down(qs2, 8);
                qs2 = qs2 + shfl_down(qs2, 4);
                qs2 = qs2 + shfl_down(qs2, 2);
                qs2 = qs2 + shfl_down(qs2, 1);
                qs2 = shfl_idx(qs2, 0);
                qs3 = qs3 + shfl_down(qs3, 16);
                qs3 = qs3 + shfl_down(qs3, 8);
                qs3 = qs3 + shfl_down(qs3, 4);
                qs3 = qs3 + shfl_down(qs3, 2);
                qs3 = qs3 + shfl_down(qs3, 1);
                qs3 = shfl_idx(qs3, 0);
                reg f32 qsum = 0.0f;
                if (lane == 0) { qsum = qs0; }
                if (lane == 1) { qsum = qs1; }
                if (lane == 2) { qsum = qs2; }
                if (lane == 3) { qsum = qs3; }
                qsum = qsum + shfl_down(qsum, 4);
                qsum = qsum + shfl_down(qsum, 2);
                qsum = qsum + shfl_down(qsum, 1);
                qsum = shfl_idx(qsum, 0);
                reg f32 qfac = rsqrt(qsum + 1.0e-6f) * q_scale;
                sts32(query_s, lane, qp0 * qfac);
                sts32(query_s, lane + 32, qp1 * qfac);
                sts32(query_s, lane + 64, qp2 * qfac);
                sts32(query_s, lane + 96, qp3 * qfac);
            }
        }
        barrier();
        reg f32 pred = 0.0f;
        for (reg u32 k = 0; k < 128; k += 1) {
            reg f32 sv = u32_as_f32(ldg32_stream(ptr_add(col_state, k, 512)));
            pred = fma(sv * lds32(key_s, k), lds32(forget_s, k), pred);
        }
        ureg u64 v_row = ptr_add(value_bf16, rh * value_heads_per_key, 256);
        reg f32 val = bf16_lo(ldg16_persist(ptr_add(v_row, col, 2)));
        reg f32 coeff = lds32(beta_s, 0) * (val - pred);
        reg f32 total = 0.0f;
        for (reg u32 k = 0; k < 128; k += 1) {
            reg f32 sv = u32_as_f32(ldg32_stream(ptr_add(col_state, k, 512)));
            reg f32 nv = fma(lds32(forget_s, k), sv, coeff * lds32(key_s, k));
            if (commit != 0) {
                stg32_stream(ptr_add(col_state, k, 512), f32_as_u32(nv));
            }
            total = fma(nv, lds32(query_s, k), total);
        }
        ureg u64 o_row = ptr_add(output_bf16, rh, 256);
        stg16(ptr_add(o_row, col, 2), f32_to_bf16(total));
    }
    pdl_release();
}
kernel[BLOCK_CONV, 56] gdn_conv_split_tiled_4_128_pdl(
    global u32* window, global u32* state_index, global u32* sequence_row_begin,
    global u32* sequence_row_count, global u32* input_bf16, global u32* weight,
    global u32* query_heads, global u32* key_heads, global u32* value,
    global u32* replay_qkv, u32 gdn_qk, u32 gdn_v, u32 heads,
    u32 input_stride, u32 sequences, u32 commit, global u32* sequence_row_indices
) {
    shared u32 tile[2144];
    reg u32 sequence = ctaid_x();
    if (sequence >= sequences) {
        pdl_wait();
        pdl_release();
        return;
    }
    reg u32 tid = tid_x();
    reg u32 lane = tid & 31;
    reg u32 group = tid >> 5;
    reg u32 channels = (gdn_qk << 1) + gdn_v;
    reg u32 channel = (ctaid_y() << 5) + lane;
    reg u32 live = 0;
    if (channel < channels) {
        live = 1;
    }
    reg f32 tw0 = 0.0f;
    reg f32 tw1 = 0.0f;
    reg f32 tw2 = 0.0f;
    reg f32 tw3 = 0.0f;
    if (live != 0) {
        reg u32x2 w2 = ldg64_persist(ptr_add(weight, channel, 8));
        tw0 = bf16_lo(w2[0]);
        tw1 = bf16_hi(w2[0]);
        tw2 = bf16_lo(w2[1]);
        tw3 = bf16_hi(w2[1]);
    }
    pdl_wait();
    reg u32 qk_heads = gdn_qk >> 7;
    reg u32 repeat = 1;
    if (qk_heads > 0) {
        if (qk_heads != heads) {
            reg u32 rq = 0;
            reg u32 rrem = 0;
            for (reg u32 bit = 0; bit < 32; bit += 1) {
                reg u32 sh = 31 - bit;
                rrem = (rrem << 1) | ((heads >> sh) & 1);
                if (rrem >= qk_heads) {
                    rrem = rrem - qk_heads;
                    rq = rq | (1 << sh);
                }
            }
            repeat = rq;
        }
    }
    reg u32 has_srb = sequence_row_begin[0] | sequence_row_begin[1];
    reg u32 begin = sequence;
    reg u32 end = sequence + 1;
    if (has_srb != 0) {
        begin = ldg32_persist(ptr_add(sequence_row_begin, sequence, 4));
        end = ldg32_persist(ptr_add(sequence_row_begin, sequence + 1, 4));
    }
    reg u32 has_src = sequence_row_count[0] | sequence_row_count[1];
    if (has_src != 0) {
        end = begin + ldg32_persist(ptr_add(sequence_row_count, sequence, 4));
    }
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];
    reg u32 has_replay = replay_qkv[0] | replay_qkv[1];
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 slot = ptr_add(window, sidx, channels << 3);
    if (group == 0) {
        if (live != 0) {
            reg u32x2 w = ldg64_stream(ptr_add(slot, channel, 8));
            sts32(tile, lane, w[0] >> 16);
            sts32(tile, 32 + lane, w[1] & 0xFFFF);
            sts32(tile, 64 + lane, w[1] >> 16);
        }
    }
    for (reg u32 base = begin; base < end; base += 64) {
        reg u32 rem_rows = end - base;
        reg u32 count = 64;
        if (rem_rows < 64) {
            count = rem_rows;
        }
        if (base != begin) {
            barrier();
        }
        if (live != 0) {
            for (reg u32 off = group; off < count; off += 8) {
                reg u32 row = base + off;
                if (has_sri != 0) {
                    row = ldg32_persist(ptr_add(sequence_row_indices, base + off, 4));
                }
                ureg u64 in_row = ptr_add(input_bf16, row, input_stride << 1);
                reg u32 in_val = ldg16_stream(ptr_add(in_row, channel, 2));
                sts32(tile, ((3 + off) << 5) + lane, in_val);
                if (has_replay != 0) {
                    ureg u64 rep_row = ptr_add(replay_qkv, row, channels << 1);
                    stg16(ptr_add(rep_row, channel, 2), in_val);
                }
            }
        }
        barrier();
        if (live != 0) {
            for (reg u32 off = group; off < count; off += 8) {
                reg u32 row = base + off;
                if (has_sri != 0) {
                    row = ldg32_persist(ptr_add(sequence_row_indices, base + off, 4));
                }
                reg f32 t0 = bf16_lo(lds32(tile, (off << 5) + lane));
                reg f32 t1 = bf16_lo(lds32(tile, ((off + 1) << 5) + lane));
                reg f32 t2 = bf16_lo(lds32(tile, ((off + 2) << 5) + lane));
                reg f32 t3 = bf16_lo(lds32(tile, ((off + 3) << 5) + lane));
                reg f32 tot = t0 * tw0;
                tot = fma(t1, tw1, tot);
                tot = fma(t2, tw2, tot);
                tot = fma(t3, tw3, tot);
                reg f32 tr = bf16_lo(f32_to_bf16(tot));
                reg f32 sd = exp2_ftz(tr * -1.4426950408889634f) + 1.0f;
                reg f32 sr = rcp(sd);
                sr = fma(sr, fma(-sd, sr, 1.0f), sr);
                sr = fma(sr, fma(-sd, sr, 1.0f), sr);
                reg u32 out_b = f32_to_bf16(tr * sr);
                if (channel < gdn_qk) {
                    reg u32 h = channel >> 7;
                    reg u32 w = channel & 127;
                    ureg u64 qd = ptr_add(ptr_add(query_heads, row * heads + h * repeat, 256), w, 2);
                    for (reg u32 r = 0; r < repeat; r += 1) {
                        stg16(ptr_add(qd, r, 256), out_b);
                    }
                } else {
                    if (channel < (gdn_qk << 1)) {
                        reg u32 kc = channel - gdn_qk;
                        reg u32 h = kc >> 7;
                        reg u32 w = kc & 127;
                        ureg u64 kd = ptr_add(ptr_add(key_heads, row * heads + h * repeat, 256), w, 2);
                        for (reg u32 r = 0; r < repeat; r += 1) {
                            stg16(ptr_add(kd, r, 256), out_b);
                        }
                    } else {
                        ureg u64 vd = ptr_add(value, row, gdn_v << 1);
                        stg16(ptr_add(vd, channel - (gdn_qk << 1), 2), out_b);
                    }
                }
            }
        }
        reg u32 last_tile = 0;
        if (base + count == end) {
            last_tile = 1;
        }
        reg u32 need_sync = 0;
        if (last_tile == 0) {
            need_sync = 1;
        }
        if (commit != 0) {
            need_sync = 1;
        }
        if (need_sync != 0) {
            barrier();
            if (group == 0) {
                if (live != 0) {
                    if (commit != 0) {
                        if (last_tile != 0) {
                            reg u32 c0 = lds32(tile, ((count - 1) << 5) + lane);
                            reg u32 c1 = lds32(tile, (count << 5) + lane);
                            reg u32 c2 = lds32(tile, ((count + 1) << 5) + lane);
                            reg u32 c3 = lds32(tile, ((count + 2) << 5) + lane);
                            stg64(ptr_add(slot, channel, 8), pack_u32x2(pack_u16x2(c0, c1), pack_u16x2(c2, c3)));
                        }
                    }
                    if (last_tile == 0) {
                        reg u32 h0 = lds32(tile, (count << 5) + lane);
                        reg u32 h1 = lds32(tile, ((count + 1) << 5) + lane);
                        reg u32 h2 = lds32(tile, ((count + 2) << 5) + lane);
                        sts32(tile, lane, h0);
                        sts32(tile, 32 + lane, h1);
                        sts32(tile, 64 + lane, h2);
                    }
                }
            }
        }
    }
    pdl_release();
}

kernel[BLOCK_CONV, 48] causal_conv_serial_256_4_swish_bf16_pdl(
    global u32* window, global u32* state_index, global u32* sequence_row_begin,
    global u32* sequence_row_count, global u32* input_bf16, global u32* weight,
    global u32* output_bf16, u32 channels, u32 sequences, u32 commit,
    global u32* sequence_row_indices, global u32* parent_rows
) {
    reg u32 sequence = ctaid_x();
    reg u32 channel = ctaid_y() * BLOCK_CONV + tid_x();
    if (sequence >= sequences) { return; }
    if (channel >= channels) { return; }
    reg u32x2 w2 = ldg64_persist(ptr_add(weight, channel, 8));
    reg f32 tw0 = bf16_lo(w2[0]);
    reg f32 tw1 = bf16_hi(w2[0]);
    reg f32 tw2 = bf16_lo(w2[1]);
    reg f32 tw3 = bf16_hi(w2[1]);
    pdl_wait();
    reg u32 has_srb = sequence_row_begin[0] | sequence_row_begin[1];
    reg u32 begin = sequence;
    reg u32 end = sequence + 1;
    if (has_srb != 0) {
        begin = ldg32_persist(ptr_add(sequence_row_begin, sequence, 4));
        end = ldg32_persist(ptr_add(sequence_row_begin, sequence + 1, 4));
    }
    reg u32 has_src = sequence_row_count[0] | sequence_row_count[1];
    if (has_src != 0) {
        end = begin + ldg32_persist(ptr_add(sequence_row_count, sequence, 4));
    }
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];
    reg u32 has_par = parent_rows[0] | parent_rows[1];
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 slot = ptr_add(window, sidx, channels << 3);
    reg u32x2 sw = ldg64_stream(ptr_add(slot, channel, 8));
    reg u32 tap0 = sw[0] & 0xFFFF;
    reg u32 tap1 = sw[0] >> 16;
    reg u32 tap2 = sw[1] & 0xFFFF;
    reg u32 tap3 = sw[1] >> 16;
    reg u32 ch_bytes = channels << 1;
    for (reg u32 ordinal = begin; ordinal < end; ordinal += 1) {
        reg u32 row = ordinal;
        if (has_sri != 0) {
            row = ldg32_persist(ptr_add(sequence_row_indices, ordinal, 4));
        }
        if (has_par != 0) {
            reg u32 anc = row;
            reg u32 miss = 4;
            if (anc != 0xFFFFFFFF) {
                tap3 = ldg16_stream(ptr_add(ptr_add(input_bf16, anc, ch_bytes), channel, 2));
                anc = ldg32_persist(ptr_add(parent_rows, anc, 4));
            } else {
                miss = 0;
                tap3 = ldg16_stream(ptr_add(slot, (channel << 2) + 3, 2));
            }
            if (anc != 0xFFFFFFFF) {
                tap2 = ldg16_stream(ptr_add(ptr_add(input_bf16, anc, ch_bytes), channel, 2));
                anc = ldg32_persist(ptr_add(parent_rows, anc, 4));
            } else {
                if (miss == 4) { miss = 1; }
                tap2 = ldg16_stream(ptr_add(slot, (channel << 2) + (2 + miss), 2));
            }
            if (anc != 0xFFFFFFFF) {
                tap1 = ldg16_stream(ptr_add(ptr_add(input_bf16, anc, ch_bytes), channel, 2));
                anc = ldg32_persist(ptr_add(parent_rows, anc, 4));
            } else {
                if (miss == 4) { miss = 2; }
                tap1 = ldg16_stream(ptr_add(slot, (channel << 2) + (1 + miss), 2));
            }
            if (anc != 0xFFFFFFFF) {
                tap0 = ldg16_stream(ptr_add(ptr_add(input_bf16, anc, ch_bytes), channel, 2));
            } else {
                if (miss == 4) { miss = 3; }
                tap0 = ldg16_stream(ptr_add(slot, (channel << 2) + miss, 2));
            }
        } else {
            tap0 = tap1;
            tap1 = tap2;
            tap2 = tap3;
            tap3 = ldg16_stream(ptr_add(ptr_add(input_bf16, row, ch_bytes), channel, 2));
        }
        reg f32 tot = bf16_lo(tap0) * tw0;
        tot = fma(bf16_lo(tap1), tw1, tot);
        tot = fma(bf16_lo(tap2), tw2, tot);
        tot = fma(bf16_lo(tap3), tw3, tot);
        reg f32 tr = bf16_lo(f32_to_bf16(tot));
        reg f32 sd = exp2_ftz(tr * -1.4426950408889634f) + 1.0f;
        reg f32 sr = rcp(sd);
        sr = fma(sr, fma(-sd, sr, 1.0f), sr);
        sr = fma(sr, fma(-sd, sr, 1.0f), sr);
        stg16(ptr_add(ptr_add(output_bf16, row, ch_bytes), channel, 2), f32_to_bf16(tr * sr));
    }
    if (commit != 0) {
        if (has_par == 0) {
            stg64(ptr_add(slot, channel, 8), pack_u32x2(pack_u16x2(tap0, tap1), pack_u16x2(tap2, tap3)));
        }
    }
    pdl_release();
}

kernel[BLOCK_CONV, 48] causal_conv_tiled_4_swish_bf16_pdl(
    global u32* window, global u32* state_index, global u32* sequence_row_begin,
    global u32* sequence_row_count, global u32* input_bf16, global u32* weight,
    global u32* output_bf16, u32 channels, u32 sequences, u32 commit,
    global u32* sequence_row_indices
) {
    shared u32 tile[2144];
    reg u32 sequence = ctaid_x();
    if (sequence >= sequences) { return; }
    reg u32 tid = tid_x();
    reg u32 lane = tid & 31;
    reg u32 group = tid >> 5;
    reg u32 channel = (ctaid_y() << 5) + lane;
    reg u32 live = 0;
    if (channel < channels) {
        live = 1;
    }
    reg f32 tw0 = 0.0f;
    reg f32 tw1 = 0.0f;
    reg f32 tw2 = 0.0f;
    reg f32 tw3 = 0.0f;
    if (live != 0) {
        reg u32x2 w2 = ldg64_persist(ptr_add(weight, channel, 8));
        tw0 = bf16_lo(w2[0]);
        tw1 = bf16_hi(w2[0]);
        tw2 = bf16_lo(w2[1]);
        tw3 = bf16_hi(w2[1]);
    }
    pdl_wait();
    reg u32 has_srb = sequence_row_begin[0] | sequence_row_begin[1];
    reg u32 begin = sequence;
    reg u32 end = sequence + 1;
    if (has_srb != 0) {
        begin = ldg32_persist(ptr_add(sequence_row_begin, sequence, 4));
        end = ldg32_persist(ptr_add(sequence_row_begin, sequence + 1, 4));
    }
    reg u32 has_src = sequence_row_count[0] | sequence_row_count[1];
    if (has_src != 0) {
        end = begin + ldg32_persist(ptr_add(sequence_row_count, sequence, 4));
    }
    reg u32 has_sri = sequence_row_indices[0] | sequence_row_indices[1];
    reg u32 sidx = ldg32_persist(ptr_add(state_index, sequence, 4));
    ureg u64 slot = ptr_add(window, sidx, channels << 3);
    reg u32 ch_bytes = channels << 1;
    if (group == 0) {
        if (live != 0) {
            reg u32x2 w = ldg64_stream(ptr_add(slot, channel, 8));
            sts32(tile, lane, w[0] >> 16);
            sts32(tile, 32 + lane, w[1] & 0xFFFF);
            sts32(tile, 64 + lane, w[1] >> 16);
        }
    }
    for (reg u32 base = begin; base < end; base += 64) {
        reg u32 rem_rows = end - base;
        reg u32 count = 64;
        if (rem_rows < 64) {
            count = rem_rows;
        }
        if (base != begin) {
            barrier();
        }
        if (live != 0) {
            for (reg u32 off = group; off < count; off += 8) {
                reg u32 row = base + off;
                if (has_sri != 0) {
                    row = ldg32_persist(ptr_add(sequence_row_indices, base + off, 4));
                }
                reg u32 in_val = ldg16_stream(ptr_add(ptr_add(input_bf16, row, ch_bytes), channel, 2));
                sts32(tile, ((3 + off) << 5) + lane, in_val);
            }
        }
        barrier();
        if (live != 0) {
            for (reg u32 off = group; off < count; off += 8) {
                reg u32 row = base + off;
                if (has_sri != 0) {
                    row = ldg32_persist(ptr_add(sequence_row_indices, base + off, 4));
                }
                reg f32 t0 = bf16_lo(lds32(tile, (off << 5) + lane));
                reg f32 t1 = bf16_lo(lds32(tile, ((off + 1) << 5) + lane));
                reg f32 t2 = bf16_lo(lds32(tile, ((off + 2) << 5) + lane));
                reg f32 t3 = bf16_lo(lds32(tile, ((off + 3) << 5) + lane));
                reg f32 tot = t0 * tw0;
                tot = fma(t1, tw1, tot);
                tot = fma(t2, tw2, tot);
                tot = fma(t3, tw3, tot);
                reg f32 tr = bf16_lo(f32_to_bf16(tot));
                reg f32 sd = exp2_ftz(tr * -1.4426950408889634f) + 1.0f;
                reg f32 sr = rcp(sd);
                sr = fma(sr, fma(-sd, sr, 1.0f), sr);
                sr = fma(sr, fma(-sd, sr, 1.0f), sr);
                stg16(ptr_add(ptr_add(output_bf16, row, ch_bytes), channel, 2), f32_to_bf16(tr * sr));
            }
        }
        reg u32 last_tile = 0;
        if (base + count == end) {
            last_tile = 1;
        }
        reg u32 need_sync = 0;
        if (last_tile == 0) {
            need_sync = 1;
        }
        if (commit != 0) {
            need_sync = 1;
        }
        if (need_sync != 0) {
            barrier();
            if (group == 0) {
                if (live != 0) {
                    if (commit != 0) {
                        if (last_tile != 0) {
                            reg u32 c0 = lds32(tile, ((count - 1) << 5) + lane);
                            reg u32 c1 = lds32(tile, (count << 5) + lane);
                            reg u32 c2 = lds32(tile, ((count + 1) << 5) + lane);
                            reg u32 c3 = lds32(tile, ((count + 2) << 5) + lane);
                            stg64(ptr_add(slot, channel, 8), pack_u32x2(pack_u16x2(c0, c1), pack_u16x2(c2, c3)));
                        }
                    }
                    if (last_tile == 0) {
                        reg u32 h0 = lds32(tile, (count << 5) + lane);
                        reg u32 h1 = lds32(tile, ((count + 1) << 5) + lane);
                        reg u32 h2 = lds32(tile, ((count + 2) << 5) + lane);
                        sts32(tile, lane, h0);
                        sts32(tile, 32 + lane, h1);
                        sts32(tile, 64 + lane, h2);
                    }
                }
            }
        }
    }
    pdl_release();
}
