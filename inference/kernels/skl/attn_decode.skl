const BLOCK = 256;
const WARPS = 8;

kernel[BLOCK, 64] latent_attn_decode_512_64(
    global u32* q_nope_bf16, global u32* q_rope_bf16,
    global u32* kv_nope_bf16, global u32* kv_rope_bf16,
    global u16* out_bf16,
    u32 num_heads, u32 kv_len, f32 scale
) {
    shared f32 smem_max[8];
    shared f32 smem_sum[8];
    shared f32 smem_out[4096];

    reg u32 head = ctaid_x();
    if (head >= num_heads) { return; }

    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    ureg u64 qn_base = ptr_add(q_nope_bf16, head * 32, 32);
    ureg u64 qr_base = ptr_add(q_rope_bf16, head * 4, 32);

    reg u32x8 qn_packed = ldg256_persist(ptr_add(qn_base, lane, 32));
    reg u32 qr_packed = ldg32_persist(ptr_add(qr_base, lane, 4));
    reg f32 slog2 = scale * 1.4426950408889634f;
    reg f32 qn0 = bf16_lo(qn_packed[0]) * slog2;
    reg f32 qn1 = bf16_hi(qn_packed[0]) * slog2;
    reg f32 qn2 = bf16_lo(qn_packed[1]) * slog2;
    reg f32 qn3 = bf16_hi(qn_packed[1]) * slog2;
    reg f32 qn4 = bf16_lo(qn_packed[2]) * slog2;
    reg f32 qn5 = bf16_hi(qn_packed[2]) * slog2;
    reg f32 qn6 = bf16_lo(qn_packed[3]) * slog2;
    reg f32 qn7 = bf16_hi(qn_packed[3]) * slog2;
    reg f32 qn8 = bf16_lo(qn_packed[4]) * slog2;
    reg f32 qn9 = bf16_hi(qn_packed[4]) * slog2;
    reg f32 qn10 = bf16_lo(qn_packed[5]) * slog2;
    reg f32 qn11 = bf16_hi(qn_packed[5]) * slog2;
    reg f32 qn12 = bf16_lo(qn_packed[6]) * slog2;
    reg f32 qn13 = bf16_hi(qn_packed[6]) * slog2;
    reg f32 qn14 = bf16_lo(qn_packed[7]) * slog2;
    reg f32 qn15 = bf16_hi(qn_packed[7]) * slog2;
    reg f32 qr0 = bf16_lo(qr_packed) * slog2;
    reg f32 qr1 = bf16_hi(qr_packed) * slog2;

    ureg u64 kv_nope_lane = ptr_add(kv_nope_bf16, lane, 32);
    ureg u64 kv_rope_lane = ptr_add(kv_rope_bf16, lane, 4);

    reg f32 acc0 = 0.0f;
    reg f32 acc1 = 0.0f;
    reg f32 acc2 = 0.0f;
    reg f32 acc3 = 0.0f;
    reg f32 acc4 = 0.0f;
    reg f32 acc5 = 0.0f;
    reg f32 acc6 = 0.0f;
    reg f32 acc7 = 0.0f;
    reg f32 acc8 = 0.0f;
    reg f32 acc9 = 0.0f;
    reg f32 acc10 = 0.0f;
    reg f32 acc11 = 0.0f;
    reg f32 acc12 = 0.0f;
    reg f32 acc13 = 0.0f;
    reg f32 acc14 = 0.0f;
    reg f32 acc15 = 0.0f;

    reg f32 m_val = -1.0e30f;
    reg f32 l_val = 0.0f;

    for (reg u32 tok = wid; tok < kv_len; tok += WARPS) {
        reg u32x8 kn = ldg256_stream(ptr_add(kv_nope_lane, tok, 1024));
        reg u32 kr = ldg32_stream(ptr_add(kv_rope_lane, tok, 128));
        reg f32 kv0 = bf16_lo(kn[0]);
        reg f32 kv1 = bf16_hi(kn[0]);
        reg f32 kv2 = bf16_lo(kn[1]);
        reg f32 kv3 = bf16_hi(kn[1]);
        reg f32 kv4 = bf16_lo(kn[2]);
        reg f32 kv5 = bf16_hi(kn[2]);
        reg f32 kv6 = bf16_lo(kn[3]);
        reg f32 kv7 = bf16_hi(kn[3]);
        reg f32 kv8 = bf16_lo(kn[4]);
        reg f32 kv9 = bf16_hi(kn[4]);
        reg f32 kv10 = bf16_lo(kn[5]);
        reg f32 kv11 = bf16_hi(kn[5]);
        reg f32 kv12 = bf16_lo(kn[6]);
        reg f32 kv13 = bf16_hi(kn[6]);
        reg f32 kv14 = bf16_lo(kn[7]);
        reg f32 kv15 = bf16_hi(kn[7]);

        reg f32 d0 = fma(qn0, kv0, qr0 * bf16_lo(kr));
        reg f32 d1 = fma(qn1, kv1, qr1 * bf16_hi(kr));
        reg f32 d2 = qn2 * kv2;
        reg f32 d3 = qn3 * kv3;
        d0 = fma(qn4, kv4, d0);
        d1 = fma(qn5, kv5, d1);
        d2 = fma(qn6, kv6, d2);
        d3 = fma(qn7, kv7, d3);
        d0 = fma(qn8, kv8, d0);
        d1 = fma(qn9, kv9, d1);
        d2 = fma(qn10, kv10, d2);
        d3 = fma(qn11, kv11, d3);
        d0 = fma(qn12, kv12, d0);
        d1 = fma(qn13, kv13, d1);
        d2 = fma(qn14, kv14, d2);
        d3 = fma(qn15, kv15, d3);

        reg f32 logit = warp_sum((d0 + d1) + (d2 + d3));
        reg f32 m_new = maxf(m_val, logit);
        reg f32 alpha = exp2_ftz(m_val - m_new);
        reg f32 p = exp2_ftz(logit - m_new);
        l_val = fma(l_val, alpha, p);
        m_val = m_new;

        acc0 *= alpha;
        acc1 *= alpha;
        acc2 *= alpha;
        acc3 *= alpha;
        acc4 *= alpha;
        acc5 *= alpha;
        acc6 *= alpha;
        acc7 *= alpha;
        acc8 *= alpha;
        acc9 *= alpha;
        acc10 *= alpha;
        acc11 *= alpha;
        acc12 *= alpha;
        acc13 *= alpha;
        acc14 *= alpha;
        acc15 *= alpha;
        acc0 = fma(p, kv0, acc0);
        acc1 = fma(p, kv1, acc1);
        acc2 = fma(p, kv2, acc2);
        acc3 = fma(p, kv3, acc3);
        acc4 = fma(p, kv4, acc4);
        acc5 = fma(p, kv5, acc5);
        acc6 = fma(p, kv6, acc6);
        acc7 = fma(p, kv7, acc7);
        acc8 = fma(p, kv8, acc8);
        acc9 = fma(p, kv9, acc9);
        acc10 = fma(p, kv10, acc10);
        acc11 = fma(p, kv11, acc11);
        acc12 = fma(p, kv12, acc12);
        acc13 = fma(p, kv13, acc13);
        acc14 = fma(p, kv14, acc14);
        acc15 = fma(p, kv15, acc15);
    }

    if (lane == 0) {
        sts32(smem_max, wid, m_val);
        sts32(smem_sum, wid, l_val);
    }
    reg u32 sbase = wid * 512 + lane * 16;
    sts32(smem_out, sbase + 0, acc0);
    sts32(smem_out, sbase + 1, acc1);
    sts32(smem_out, sbase + 2, acc2);
    sts32(smem_out, sbase + 3, acc3);
    sts32(smem_out, sbase + 4, acc4);
    sts32(smem_out, sbase + 5, acc5);
    sts32(smem_out, sbase + 6, acc6);
    sts32(smem_out, sbase + 7, acc7);
    sts32(smem_out, sbase + 8, acc8);
    sts32(smem_out, sbase + 9, acc9);
    sts32(smem_out, sbase + 10, acc10);
    sts32(smem_out, sbase + 11, acc11);
    sts32(smem_out, sbase + 12, acc12);
    sts32(smem_out, sbase + 13, acc13);
    sts32(smem_out, sbase + 14, acc14);
    sts32(smem_out, sbase + 15, acc15);
    barrier();

    reg u32 tid = tid_x();
    reg f32 gmax = -1.0e30f;
    unroll (w = 0..8) {
        gmax = maxf(gmax, lds32(smem_max, w));
    }
    reg f32 gsum = 0.0f;
    reg f32 o0 = 0.0f;
    reg f32 o1 = 0.0f;
    unroll (w = 0..8) {
        reg f32 mw = lds32(smem_max, w);
        reg f32 lw = lds32(smem_sum, w);
        reg f32 wt = exp2_ftz(mw - gmax);
        gsum = fma(lw, wt, gsum);
        o0 = fma(lds32(smem_out, w * 512 + tid), wt, o0);
        o1 = fma(lds32(smem_out, w * 512 + 256 + tid), wt, o1);
    }
    reg f32 inv_l = rcp(gsum);
    ureg u64 obase = ptr_add(out_bf16, head * 512, 2);
    stg16(ptr_add(obase, tid, 2), f32_to_bf16(o0 * inv_l));
    stg16(ptr_add(obase, 256 + tid, 2), f32_to_bf16(o1 * inv_l));
}
