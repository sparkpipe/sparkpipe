const BLOCK = 256;
const WARPS = 8;

kernel[BLOCK, 80] latent_attn_decode_512_64(
    global u32* q_nope_bf16, global u32* q_rope_bf16,
    global u32* kv_nope_bf16, global u32* kv_rope_bf16,
    global u16* out_bf16,
    u32 num_heads, u32 kv_len, f32 scale
) {
    shared f32 smem_max[8];
    shared f32 smem_sum[8];
    shared f32 smem_out[4096];

    reg u32 head = ctaid_x();
    if (head >= num_heads) { return; }

    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    ureg u64 qn_base = ptr_add(q_nope_bf16, head * 32, 32);
    ureg u64 qr_base = ptr_add(q_rope_bf16, head * 4, 32);

    reg u32x8 qn_packed = ldg256_persist(ptr_add(qn_base, lane, 32));
    reg u32 qr_packed = ldg32_persist(ptr_add(qr_base, lane, 4));
    reg f32 qr0 = bf16_lo(qr_packed);
    reg f32 qr1 = bf16_hi(qr_packed);

    reg f32 acc0 = 0.0f;
    reg f32 acc1 = 0.0f;
    reg f32 acc2 = 0.0f;
    reg f32 acc3 = 0.0f;
    reg f32 acc4 = 0.0f;
    reg f32 acc5 = 0.0f;
    reg f32 acc6 = 0.0f;
    reg f32 acc7 = 0.0f;
    reg f32 acc8 = 0.0f;
    reg f32 acc9 = 0.0f;
    reg f32 acc10 = 0.0f;
    reg f32 acc11 = 0.0f;
    reg f32 acc12 = 0.0f;
    reg f32 acc13 = 0.0f;
    reg f32 acc14 = 0.0f;
    reg f32 acc15 = 0.0f;

    reg f32 m_val = -1.0e30f;
    reg f32 l_val = 0.0f;

    pipeline for (reg u32 tok = wid; tok < kv_len; tok += WARPS) {
        reg u32x8 kn = ldg256_stream(ptr_add(kv_nope_bf16, tok * 32 + lane, 32));
        reg u32 kr = ldg32_stream(ptr_add(kv_rope_bf16, tok * 32 + lane, 4));

        reg f32 d0 = fma(bf16_lo(qn_packed[0]), bf16_lo(kn[0]), fma(qr0, bf16_lo(kr), 0.0f));
        reg f32 d1 = fma(bf16_hi(qn_packed[0]), bf16_hi(kn[0]), fma(qr1, bf16_hi(kr), 0.0f));
        reg f32 d2 = bf16_lo(qn_packed[1]) * bf16_lo(kn[1]);
        reg f32 d3 = bf16_hi(qn_packed[1]) * bf16_hi(kn[1]);

        unroll (k = 1..4) {
            d0 = fma(bf16_lo(qn_packed[k * 2]), bf16_lo(kn[k * 2]), d0);
            d1 = fma(bf16_hi(qn_packed[k * 2]), bf16_hi(kn[k * 2]), d1);
            d2 = fma(bf16_lo(qn_packed[k * 2 + 1]), bf16_lo(kn[k * 2 + 1]), d2);
            d3 = fma(bf16_hi(qn_packed[k * 2 + 1]), bf16_hi(kn[k * 2 + 1]), d3);
        }

        reg f32 logit = warp_sum((d0 + d1) + (d2 + d3)) * scale;
        reg f32 m_new = maxf(m_val, logit);
        reg f32 alpha = expf_fast(m_val - m_new);
        reg f32 p = expf_fast(logit - m_new);
        l_val = fma(l_val, alpha, p);
        m_val = m_new;

        acc0 = fma(p, bf16_lo(kn[0]), acc0 * alpha);
        acc1 = fma(p, bf16_hi(kn[0]), acc1 * alpha);
        acc2 = fma(p, bf16_lo(kn[1]), acc2 * alpha);
        acc3 = fma(p, bf16_hi(kn[1]), acc3 * alpha);
        acc4 = fma(p, bf16_lo(kn[2]), acc4 * alpha);
        acc5 = fma(p, bf16_hi(kn[2]), acc5 * alpha);
        acc6 = fma(p, bf16_lo(kn[3]), acc6 * alpha);
        acc7 = fma(p, bf16_hi(kn[3]), acc7 * alpha);
        acc8 = fma(p, bf16_lo(kn[4]), acc8 * alpha);
        acc9 = fma(p, bf16_hi(kn[4]), acc9 * alpha);
        acc10 = fma(p, bf16_lo(kn[5]), acc10 * alpha);
        acc11 = fma(p, bf16_hi(kn[5]), acc11 * alpha);
        acc12 = fma(p, bf16_lo(kn[6]), acc12 * alpha);
        acc13 = fma(p, bf16_hi(kn[6]), acc13 * alpha);
        acc14 = fma(p, bf16_lo(kn[7]), acc14 * alpha);
        acc15 = fma(p, bf16_hi(kn[7]), acc15 * alpha);
    }

    if (lane == 0) {
        sts32(smem_max, wid, m_val);
        sts32(smem_sum, wid, l_val);
    }
    reg u32 sbase = wid * 512 + lane * 16;
    sts32(smem_out, sbase + 0, acc0);
    sts32(smem_out, sbase + 1, acc1);
    sts32(smem_out, sbase + 2, acc2);
    sts32(smem_out, sbase + 3, acc3);
    sts32(smem_out, sbase + 4, acc4);
    sts32(smem_out, sbase + 5, acc5);
    sts32(smem_out, sbase + 6, acc6);
    sts32(smem_out, sbase + 7, acc7);
    sts32(smem_out, sbase + 8, acc8);
    sts32(smem_out, sbase + 9, acc9);
    sts32(smem_out, sbase + 10, acc10);
    sts32(smem_out, sbase + 11, acc11);
    sts32(smem_out, sbase + 12, acc12);
    sts32(smem_out, sbase + 13, acc13);
    sts32(smem_out, sbase + 14, acc14);
    sts32(smem_out, sbase + 15, acc15);
    barrier();

    reg u32 tid = tid_x();
    reg f32 gmax = -1.0e30f;
    unroll (w = 0..8) {
        gmax = maxf(gmax, lds32(smem_max, w));
    }
    reg f32 gsum = 0.0f;
    reg f32 o0 = 0.0f;
    reg f32 o1 = 0.0f;
    unroll (w = 0..8) {
        reg f32 mw = lds32(smem_max, w);
        reg f32 lw = lds32(smem_sum, w);
        reg f32 wt = expf_fast(mw - gmax);
        gsum = fma(lw, wt, gsum);
        o0 = fma(lds32(smem_out, w * 512 + tid), wt, o0);
        o1 = fma(lds32(smem_out, w * 512 + 256 + tid), wt, o1);
    }
    reg f32 inv_l = rcp(gsum);
    ureg u64 obase = ptr_add(out_bf16, head * 512, 2);
    stg16(ptr_add(obase, tid, 2), f32_to_bf16(o0 * inv_l));
    stg16(ptr_add(obase, 256 + tid, 2), f32_to_bf16(o1 * inv_l));
}
