const BLOCK = 256;

kernel[BLOCK, 64] gqa_split_reduce_sigmoid_gate_pdl_exact_bf16(
    global u32* partials_f32, global u32* attn_local_bf16,
    global u32* sequence_of_row, global u32* context_length,
    global u32* row_position, global u32* merged_out_bf16,
    u32 rows
) {
    pdl_wait();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 head = ctaid_x() * 8 + wid;
    reg u32 row = ctaid_y();
    if (row < rows) {
        if (head < 24) {
            reg u32 seq = ldg32_persist(ptr_add(sequence_of_row, row, 4));
            reg u32 limit = ldg32_persist(ptr_add(context_length, seq, 4));
            reg u32 rp_nz = row_position[0] | row_position[1];
            if (rp_nz != 0) {
                reg u32 rp = ldg32_persist(ptr_add(row_position, row, 4));
                if (rp != 0xFFFFFFFF) {
                    reg u32 rp1 = rp + 1;
                    if (rp1 < limit) {
                        limit = rp1;
                    }
                }
            }
            if (limit > 64) {
                reg u32 slen = ((((limit + 767) >> 8) * 21846) >> 16) << 6;
                if (slen < limit) {
                    reg f32 gmax = u32_as_f32(0xFF800000);
                    reg f32 gsum = 0.0f;
                    reg f32 acc0 = 0.0f;
                    reg f32 acc1 = 0.0f;
                    reg f32 acc2 = 0.0f;
                    reg f32 acc3 = 0.0f;
                    reg f32 acc4 = 0.0f;
                    reg f32 acc5 = 0.0f;
                    reg f32 acc6 = 0.0f;
                    reg f32 acc7 = 0.0f;
                    reg u32 lane8 = lane << 3;
                    for (reg u32 s = 0; s < 12; s += 1) {
                        if (s * slen < limit) {
                            reg u32 in_base = ((row * 12 + s) * 24 + head) * 260;
                            reg f32 sm = u32_as_f32(ldg32_stream(ptr_add(partials_f32, in_base + 256, 4)));
                            reg f32 sl = u32_as_f32(ldg32_stream(ptr_add(partials_f32, in_base + 257, 4)));
                            reg f32 prev = gmax;
                            gmax = maxf(prev, sm);
                            reg f32 sc_old = 0.0f;
                            if (f32_as_u32(prev) != 0xFF800000) {
                                sc_old = exp2_ftz((prev - gmax) * 1.4426950408889634f);
                            }
                            reg f32 sc_new = 0.0f;
                            if (f32_as_u32(sm) != 0xFF800000) {
                                sc_new = exp2_ftz((sm - gmax) * 1.4426950408889634f);
                            }
                            gsum = fma(gsum, sc_old, sl * sc_new);
                            reg u32x4 a0 = ldg128_stream(ptr_add(partials_f32, in_base + lane8, 4));
                            reg u32x4 a1 = ldg128_stream(ptr_add(partials_f32, in_base + lane8 + 4, 4));
                            acc0 = fma(acc0, sc_old, u32_as_f32(a0[0]) * sc_new);
                            acc1 = fma(acc1, sc_old, u32_as_f32(a0[1]) * sc_new);
                            acc2 = fma(acc2, sc_old, u32_as_f32(a0[2]) * sc_new);
                            acc3 = fma(acc3, sc_old, u32_as_f32(a0[3]) * sc_new);
                            acc4 = fma(acc4, sc_old, u32_as_f32(a1[0]) * sc_new);
                            acc5 = fma(acc5, sc_old, u32_as_f32(a1[1]) * sc_new);
                            acc6 = fma(acc6, sc_old, u32_as_f32(a1[2]) * sc_new);
                            acc7 = fma(acc7, sc_old, u32_as_f32(a1[3]) * sc_new);
                        }
                    }
                    reg f32 denom = maxf(gsum, 1.0e-20f);
                    reg f32 inv_d = rcp(denom);
                    inv_d = fma(inv_d, fma(-denom, inv_d, 1.0f), inv_d);
                    reg u32x4 gv = ldg128_stream(ptr_add(attn_local_bf16, row * 1792 + (head * 2 + 1) * 32 + lane, 16));

                    reg f32 q0 = acc0 * inv_d;
                    q0 = fma(inv_d, fma(-denom, q0, acc0), q0);
                    reg f32 q1 = acc1 * inv_d;
                    q1 = fma(inv_d, fma(-denom, q1, acc1), q1);
                    reg f32 r0 = bf16_lo(f32_to_bf16(q0));
                    reg f32 r1 = bf16_lo(f32_to_bf16(q1));
                    reg f32 d0 = exp2_ftz(bf16_lo(gv[0]) * -1.4426950408889634f) + 1.0f;
                    reg f32 d1 = exp2_ftz(bf16_hi(gv[0]) * -1.4426950408889634f) + 1.0f;
                    reg f32 s0 = rcp(d0);
                    reg f32 s1 = rcp(d1);
                    s0 = fma(s0, fma(-d0, s0, 1.0f), s0);
                    s1 = fma(s1, fma(-d1, s1, 1.0f), s1);
                    s0 = fma(s0, fma(-d0, s0, 1.0f), s0);
                    s1 = fma(s1, fma(-d1, s1, 1.0f), s1);
                    gv[0] = pack_bf16x2(r0 * s0, r1 * s1);

                    reg f32 q2 = acc2 * inv_d;
                    q2 = fma(inv_d, fma(-denom, q2, acc2), q2);
                    reg f32 q3 = acc3 * inv_d;
                    q3 = fma(inv_d, fma(-denom, q3, acc3), q3);
                    reg f32 r2 = bf16_lo(f32_to_bf16(q2));
                    reg f32 r3 = bf16_lo(f32_to_bf16(q3));
                    reg f32 d2 = exp2_ftz(bf16_lo(gv[1]) * -1.4426950408889634f) + 1.0f;
                    reg f32 d3 = exp2_ftz(bf16_hi(gv[1]) * -1.4426950408889634f) + 1.0f;
                    reg f32 s2 = rcp(d2);
                    reg f32 s3 = rcp(d3);
                    s2 = fma(s2, fma(-d2, s2, 1.0f), s2);
                    s3 = fma(s3, fma(-d3, s3, 1.0f), s3);
                    s2 = fma(s2, fma(-d2, s2, 1.0f), s2);
                    s3 = fma(s3, fma(-d3, s3, 1.0f), s3);
                    gv[1] = pack_bf16x2(r2 * s2, r3 * s3);

                    reg f32 q4 = acc4 * inv_d;
                    q4 = fma(inv_d, fma(-denom, q4, acc4), q4);
                    reg f32 q5 = acc5 * inv_d;
                    q5 = fma(inv_d, fma(-denom, q5, acc5), q5);
                    reg f32 r4 = bf16_lo(f32_to_bf16(q4));
                    reg f32 r5 = bf16_lo(f32_to_bf16(q5));
                    reg f32 d4 = exp2_ftz(bf16_lo(gv[2]) * -1.4426950408889634f) + 1.0f;
                    reg f32 d5 = exp2_ftz(bf16_hi(gv[2]) * -1.4426950408889634f) + 1.0f;
                    reg f32 s4 = rcp(d4);
                    reg f32 s5 = rcp(d5);
                    s4 = fma(s4, fma(-d4, s4, 1.0f), s4);
                    s5 = fma(s5, fma(-d5, s5, 1.0f), s5);
                    s4 = fma(s4, fma(-d4, s4, 1.0f), s4);
                    s5 = fma(s5, fma(-d5, s5, 1.0f), s5);
                    gv[2] = pack_bf16x2(r4 * s4, r5 * s5);

                    reg f32 q6 = acc6 * inv_d;
                    q6 = fma(inv_d, fma(-denom, q6, acc6), q6);
                    reg f32 q7 = acc7 * inv_d;
                    q7 = fma(inv_d, fma(-denom, q7, acc7), q7);
                    reg f32 r6 = bf16_lo(f32_to_bf16(q6));
                    reg f32 r7 = bf16_lo(f32_to_bf16(q7));
                    reg f32 d6 = exp2_ftz(bf16_lo(gv[3]) * -1.4426950408889634f) + 1.0f;
                    reg f32 d7 = exp2_ftz(bf16_hi(gv[3]) * -1.4426950408889634f) + 1.0f;
                    reg f32 s6 = rcp(d6);
                    reg f32 s7 = rcp(d7);
                    s6 = fma(s6, fma(-d6, s6, 1.0f), s6);
                    s7 = fma(s7, fma(-d7, s7, 1.0f), s7);
                    s6 = fma(s6, fma(-d6, s6, 1.0f), s6);
                    s7 = fma(s7, fma(-d7, s7, 1.0f), s7);
                    gv[3] = pack_bf16x2(r6 * s6, r7 * s7);

                    stg128(ptr_add(merged_out_bf16, (row * 24 + head) * 32 + lane, 16), gv);
                }
            }
        }
    }
    pdl_release();
}

kernel[BLOCK, 32] head_certified_reduce_f32(
    global u32* partial_scores, global u32* partial_candidates,
    global u32* output_token_id, global u32* output_score,
    u32 candidate_offset
) {
    shared f32 best_score[8];
    shared u32 best_cand[8];
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg f32 running_best = -3.0e38f;
    reg u32 running_cand = 0xFFFFFFFF;
    if (tid < 128) {
        reg f32 score = u32_as_f32(ldg32_stream(ptr_add(partial_scores, tid, 4)));
        reg u32 cand = ldg32_stream(ptr_add(partial_candidates, tid, 4));
        if (score > running_best) {
            running_best = score;
            running_cand = cand;
        } else {
            if (score == running_best) {
                if (cand < running_cand) {
                    running_best = score;
                    running_cand = cand;
                }
            }
        }
    }
    reg f32 os16 = shfl_down(running_best, 16);
    reg u32 oc16 = shfl_down(running_cand, 16);
    if (os16 > running_best) {
        running_best = os16;
        running_cand = oc16;
    } else {
        if (os16 == running_best) {
            if (oc16 < running_cand) {
                running_best = os16;
                running_cand = oc16;
            }
        }
    }
    reg f32 os8 = shfl_down(running_best, 8);
    reg u32 oc8 = shfl_down(running_cand, 8);
    if (os8 > running_best) {
        running_best = os8;
        running_cand = oc8;
    } else {
        if (os8 == running_best) {
            if (oc8 < running_cand) {
                running_best = os8;
                running_cand = oc8;
            }
        }
    }
    reg f32 os4 = shfl_down(running_best, 4);
    reg u32 oc4 = shfl_down(running_cand, 4);
    if (os4 > running_best) {
        running_best = os4;
        running_cand = oc4;
    } else {
        if (os4 == running_best) {
            if (oc4 < running_cand) {
                running_best = os4;
                running_cand = oc4;
            }
        }
    }
    reg f32 os2 = shfl_down(running_best, 2);
    reg u32 oc2 = shfl_down(running_cand, 2);
    if (os2 > running_best) {
        running_best = os2;
        running_cand = oc2;
    } else {
        if (os2 == running_best) {
            if (oc2 < running_cand) {
                running_best = os2;
                running_cand = oc2;
            }
        }
    }
    reg f32 os1 = shfl_down(running_best, 1);
    reg u32 oc1 = shfl_down(running_cand, 1);
    if (os1 > running_best) {
        running_best = os1;
        running_cand = oc1;
    } else {
        if (os1 == running_best) {
            if (oc1 < running_cand) {
                running_best = os1;
                running_cand = oc1;
            }
        }
    }
    if (lane == 0) {
        sts32(best_score, wid, running_best);
        sts32(best_cand, wid, running_cand);
    }
    barrier();
    if (tid == 0) {
        reg f32 fb = lds32(best_score, 0);
        reg u32 fc = lds32(best_cand, 0);
        unroll (w = 1..8) {
            reg f32 ws = lds32(best_score, w);
            reg u32 wc = lds32(best_cand, w);
            if (ws > fb) {
                fb = ws;
                fc = wc;
            } else {
                if (ws == fb) {
                    if (wc < fc) {
                        fb = ws;
                        fc = wc;
                    }
                }
            }
        }
        stg32(output_token_id, fc + candidate_offset);
        stg32(output_score, f32_as_u32(fb));
    }
}

kernel[BLOCK, 32] stage_embedding_lookup_pdl_bf16x8(
    global u32* embed_weight, global u32* token_ids, global u32* hidden_bf16,
    u32 hidden, u32 vocab_slice_offset, u32 vocab_slice_rows
) {
    pdl_wait();
    pdl_release();
    reg u32 row = ctaid_y();
    reg u32 tok = ldg32_stream(ptr_add(token_ids, row, 4));
    reg u32 local = tok - vocab_slice_offset;
    reg u32 row_bytes = hidden << 1;
    ureg u64 target = ptr_add(hidden_bf16, row, row_bytes);
    reg u32 tid = ctaid_x() * BLOCK + tid_x();
    reg u32 stride = grid_x() * BLOCK;
    reg u32 align_bad = (hidden & 7) | (target[0] & 15);
    if (local < vocab_slice_rows) {
        ureg u64 source = ptr_add(embed_weight, local, row_bytes);
        reg u32 src_bad = align_bad | (source[0] & 15);
        if (src_bad == 0) {
            reg u32 vecs = hidden >> 3;
            for (reg u32 v = tid; v < vecs; v += stride) {
                reg u32x4 val = ldg128_persist(ptr_add(source, v, 16));
                stg128(ptr_add(target, v, 16), val);
            }
            return;
        }
        for (reg u32 k = tid; k < hidden; k += stride) {
            reg u32 val = ldg16_persist(ptr_add(source, k, 2));
            stg16(ptr_add(target, k, 2), val);
        }
        return;
    }
    if (align_bad == 0) {
        reg u32 vecs = hidden >> 3;
        reg u32x4 zero = pack_u32x4(0, 0, 0, 0);
        for (reg u32 v = tid; v < vecs; v += stride) {
            stg128(ptr_add(target, v, 16), zero);
        }
        return;
    }
    for (reg u32 k = tid; k < hidden; k += stride) {
        stg16(ptr_add(target, k, 2), 0);
    }
}

kernel[BLOCK, 24] stage_store_outputs_u32_f32(
    global u32* token_ids_out, global u32* scores_out,
    global u32* tokens, global u32* scores,
    global u32* chain_step, u32 rows
) {
    reg u32 row = ctaid_x() * ntid_x() + tid_x();
    if (row >= rows) { return; }
    reg u32 step = ldg32_stream(chain_step);
    reg u32 base = step * rows + row;
    reg u32 has_tok = token_ids_out[0] | token_ids_out[1];
    if (has_tok != 0) {
        reg u32 t = ldg32_stream(ptr_add(tokens, row, 4));
        stg32(ptr_add(token_ids_out, base, 4), t);
    }
    reg u32 has_sc = scores_out[0] | scores_out[1];
    if (has_sc != 0) {
        reg u32 s = ldg32_stream(ptr_add(scores, row, 4));
        stg32(ptr_add(scores_out, base, 4), s);
    }
}

kernel[BLOCK, 24] stage_chain_advance_u32(
    global u32* token_ids, global u32* tokens, global u32* positions,
    global u32* context_length, global u32* sequence_of_row, u32 rows,
    global u32* chain_step, global u32* distribution_positions, u32 distribution_count
) {
    reg u32 row = ctaid_x() * ntid_x() + tid_x();
    if (row == 0) {
        reg u32 cs = ldg32_stream(chain_step);
        stg32(chain_step, cs + 1);
    }
    if (row < distribution_count) {
        reg u32 dp = ldg32_stream(ptr_add(distribution_positions, row, 4));
        stg32(ptr_add(distribution_positions, row, 4), dp + 1);
    }
    if (row >= rows) { return; }
    reg u32 t = ldg32_stream(ptr_add(tokens, row, 4));
    stg32(ptr_add(token_ids, row, 4), t);
    reg u32 p = ldg32_stream(ptr_add(positions, row, 4)) + 1;
    stg32(ptr_add(positions, row, 4), p);
    reg u32 seq = ldg32_stream(ptr_add(sequence_of_row, row, 4));
    stg32(ptr_add(context_length, seq, 4), p + 1);
}

kernel[BLOCK, 32] stage_last_rows_gather_pdl_bf16x8(
    global u32* row_begin, global u32* row_indices,
    global u32* hidden_bf16, global u32* out_bf16, u32 hidden
) {
    pdl_wait();
    pdl_release();
    reg u32 seq = ctaid_x();
    reg u32 end_idx = ldg32_stream(ptr_add(row_begin, seq + 1, 4)) - 1;
    reg u32 src_row = ldg32_stream(ptr_add(row_indices, end_idx, 4));
    reg u32 row_bytes = hidden << 1;
    ureg u64 src = ptr_add(hidden_bf16, src_row, row_bytes);
    ureg u64 dst = ptr_add(out_bf16, seq, row_bytes);
    reg u32 vecs = hidden >> 3;
    reg u32 step = ntid_x();
    for (reg u32 k = tid_x(); k < vecs; k += step) {
        reg u32x4 v = ldg128_stream(ptr_add(src, k, 16));
        stg128(ptr_add(dst, k, 16), v);
    }
}

kernel[BLOCK, 24] stage_last_rows_scatter_pdl_u32_f32(
    global u32* row_begin, global u32* row_indices,
    global u32* token, global u32* score,
    global u32* out_token, global u32* out_score, u32 sequences
) {
    pdl_wait();
    pdl_release();
    reg u32 seq = ctaid_x() * ntid_x() + tid_x();
    if (seq >= sequences) { return; }
    reg u32 end_idx = ldg32_stream(ptr_add(row_begin, seq + 1, 4)) - 1;
    reg u32 row = ldg32_stream(ptr_add(row_indices, end_idx, 4));
    reg u32 tok = ldg32_stream(ptr_add(token, seq, 4));
    reg u32 sc = ldg32_stream(ptr_add(score, seq, 4));
    stg32(ptr_add(out_token, row, 4), tok);
    stg32(ptr_add(out_score, row, 4), sc);
}

kernel[BLOCK, 32] head_commit_argmax_pdl_f32(
    global u32* candidate_score, global u32* candidate_token,
    u32 tiles, global u32* token_out, global u32* score_out, u32 rows
) {
    shared f32 shared_score[8];
    shared u32 shared_token[8];
    pdl_wait();
    reg u32 row = ctaid_x();
    if (row >= rows) {
        pdl_release();
        return;
    }
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg f32 best = u32_as_f32(0xFF800000);
    reg u32 best_tok = 0xFFFFFFFF;
    reg u32 row_base = row * tiles;
    for (reg u32 idx = tid; idx < tiles; idx += BLOCK) {
        reg f32 sc = u32_as_f32(ldg32_stream(ptr_add(candidate_score, row_base + idx, 4)));
        reg u32 tk = ldg32_stream(ptr_add(candidate_token, row_base + idx, 4));
        if (sc > best) {
            best = sc;
            best_tok = tk;
        } else {
            if (sc == best) {
                if (tk < best_tok) {
                    best = sc;
                    best_tok = tk;
                }
            }
        }
    }
    reg f32 os16 = shfl_down(best, 16);
    reg u32 ot16 = shfl_down(best_tok, 16);
    if (os16 > best) {
        best = os16;
        best_tok = ot16;
    } else {
        if (os16 == best) {
            if (ot16 < best_tok) {
                best = os16;
                best_tok = ot16;
            }
        }
    }
    reg f32 os8 = shfl_down(best, 8);
    reg u32 ot8 = shfl_down(best_tok, 8);
    if (os8 > best) {
        best = os8;
        best_tok = ot8;
    } else {
        if (os8 == best) {
            if (ot8 < best_tok) {
                best = os8;
                best_tok = ot8;
            }
        }
    }
    reg f32 os4 = shfl_down(best, 4);
    reg u32 ot4 = shfl_down(best_tok, 4);
    if (os4 > best) {
        best = os4;
        best_tok = ot4;
    } else {
        if (os4 == best) {
            if (ot4 < best_tok) {
                best = os4;
                best_tok = ot4;
            }
        }
    }
    reg f32 os2 = shfl_down(best, 2);
    reg u32 ot2 = shfl_down(best_tok, 2);
    if (os2 > best) {
        best = os2;
        best_tok = ot2;
    } else {
        if (os2 == best) {
            if (ot2 < best_tok) {
                best = os2;
                best_tok = ot2;
            }
        }
    }
    reg f32 os1 = shfl_down(best, 1);
    reg u32 ot1 = shfl_down(best_tok, 1);
    if (os1 > best) {
        best = os1;
        best_tok = ot1;
    } else {
        if (os1 == best) {
            if (ot1 < best_tok) {
                best = os1;
                best_tok = ot1;
            }
        }
    }
    if (lane == 0) {
        sts32(shared_score, wid, best);
        sts32(shared_token, wid, best_tok);
    }
    barrier();
    if (tid == 0) {
        reg f32 fb = lds32(shared_score, 0);
        reg u32 ft = lds32(shared_token, 0);
        unroll (w = 1..8) {
            reg f32 ws = lds32(shared_score, w);
            reg u32 wt = lds32(shared_token, w);
            if (ws > fb) {
                fb = ws;
                ft = wt;
            } else {
                if (ws == fb) {
                    if (wt < ft) {
                        fb = ws;
                        ft = wt;
                    }
                }
            }
        }
        stg32(ptr_add(token_out, row, 4), ft);
        reg u32 has_sc = score_out[0] | score_out[1];
        if (has_sc != 0) {
            stg32(ptr_add(score_out, row, 4), f32_as_u32(fb));
        }
    }
    pdl_release();
}

kernel[BLOCK, 32] stage_rows_gather_pdl_bf16x8(
    global u32* rows_map, global u32* hidden_bf16, global u32* out_bf16, u32 hidden
) {
    pdl_wait();
    pdl_release();
    reg u32 dst_row = ctaid_x();
    reg u32 src_row = ldg32_stream(ptr_add(rows_map, dst_row, 4));
    reg u32 row_bytes = hidden << 1;
    ureg u64 src = ptr_add(hidden_bf16, src_row, row_bytes);
    ureg u64 dst = ptr_add(out_bf16, dst_row, row_bytes);
    reg u32 step = ntid_x();
    reg u32 align_bad = (hidden & 7) | (src[0] & 15) | (dst[0] & 15);
    if (align_bad == 0) {
        reg u32 vecs = hidden >> 3;
        for (reg u32 k = tid_x(); k < vecs; k += step) {
            reg u32x4 v = ldg128_stream(ptr_add(src, k, 16));
            stg128(ptr_add(dst, k, 16), v);
        }
        return;
    }
    for (reg u32 k = tid_x(); k < hidden; k += step) {
        reg u32 v = ldg16_stream(ptr_add(src, k, 2));
        stg16(ptr_add(dst, k, 2), v);
    }
}

kernel[BLOCK, 24] stage_head_rank_token_pdl_u32(
    global u32* tokens, u32 rows, u32 rank_offset
) {
    pdl_wait();
    pdl_release();
    reg u32 row = ctaid_y();
    if (row < rows) {
        if (tid_x() == 0) {
            reg u32 tok = ldg32_stream(ptr_add(tokens, row, 4));
            if (tok != 0xFFFFFFFF) {
                stg32(ptr_add(tokens, row, 4), tok + rank_offset);
            }
        }
    }
}

kernel[BLOCK, 24] stage_maxloc_pack_pdl_f32_u32(
    global u32* scores, global u32* tokens, global u32* maxloc, u32 rows
) {
    pdl_wait();
    pdl_release();
    reg u32 row = ctaid_y();
    if (row < rows) {
        if (tid_x() == 0) {
            reg u32 sb = ldg32_stream(ptr_add(scores, row, 4));
            reg u32 tok = ldg32_stream(ptr_add(tokens, row, 4));
            reg u32 abs_sb = sb & 0x7FFFFFFF;
            reg u32 ord = 0;
            if (abs_sb <= 0x7F800000) {
                if (sb == 0x80000000) {
                    sb = 0;
                }
                reg u32 sign = sb & 0x80000000;
                if (sign != 0) {
                    ord = sb ^ 0xFFFFFFFF;
                } else {
                    ord = sb ^ 0x80000000;
                }
            }
            reg u32 lo = 0xFFFFFFFF - tok;
            stg64(ptr_add(maxloc, row, 8), pack_u32x2(lo, ord));
        }
    }
}

kernel[BLOCK, 24] stage_maxloc_unpack_pdl_u64(
    global u32* maxloc, global u32* tokens, global u32* scores, u32 rows
) {
    pdl_wait();
    pdl_release();
    reg u32 row = ctaid_y();
    if (row < rows) {
        if (tid_x() == 0) {
            reg u32x2 ml = ldg64_stream(ptr_add(maxloc, row, 8));
            reg u32 tok = 0xFFFFFFFF - ml[0];
            reg u32 ord = ml[1];
            reg u32 sign = ord & 0x80000000;
            reg u32 sb = 0;
            if (sign != 0) {
                sb = ord ^ 0x80000000;
            } else {
                sb = ord ^ 0xFFFFFFFF;
            }
            stg32(ptr_add(tokens, row, 4), tok);
            stg32(ptr_add(scores, row, 4), sb);
        }
    }
}

kernel[BLOCK, 24] stage_combine_pair_bf16(
    global u32* source, global u32* destination, u32 elements
) {
    reg u32 i = ctaid_x() * ntid_x() + tid_x();
    if (i >= elements) { return; }
    reg f32 a = bf16_lo(ldg16_stream(ptr_add(destination, i, 2)));
    reg f32 b = bf16_lo(ldg16_stream(ptr_add(source, i, 2)));
    stg16(ptr_add(destination, i, 2), f32_to_bf16(a + b));
}

kernel[BLOCK, 24] stage_combine_u64_max(
    global u32* source, global u32* destination, u32 elements
) {
    reg u32 i = ctaid_x() * ntid_x() + tid_x();
    if (i >= elements) { return; }
    reg u32x2 sv = ldg64_stream(ptr_add(source, i, 8));
    reg u32x2 dv = ldg64_stream(ptr_add(destination, i, 8));
    reg u32 take = 0;
    if (sv[1] > dv[1]) {
        take = 1;
    } else {
        if (sv[1] == dv[1]) {
            if (sv[0] > dv[0]) {
                take = 1;
            }
        }
    }
    if (take != 0) {
        stg64(ptr_add(destination, i, 8), sv);
    }
}

kernel[BLOCK, 24] stage_tap_copy_bf16(
    global u32* source, global u32* destination,
    u32 rows, u32 dimension, u64 destination_stride
) {
    reg u32 row = ctaid_y();
    reg u32 elem = ctaid_x() * ntid_x() + tid_x();
    if (row < rows) {
        if (elem < dimension) {
            ureg u64 src = ptr_add(source, row, dimension << 1);
            ureg u64 dst = ptr_add(destination, row, destination_stride[0] << 1);
            reg u32 v = ldg16_stream(ptr_add(src, elem, 2));
            stg16(ptr_add(dst, elem, 2), v);
        }
    }
}

kernel[BLOCK, 24] stage_row_lanes_u32(
    global u32* sequence_row_begin, global u32* sequence_row_indices,
    global u32* row_lane, global u32* row_ordinal
) {
    reg u32 lane = ctaid_x();
    reg u32 begin = ldg32_stream(ptr_add(sequence_row_begin, lane, 4));
    reg u32 end = ldg32_stream(ptr_add(sequence_row_begin, lane + 1, 4));
    reg u32 step = ntid_x();
    for (reg u32 k = begin + tid_x(); k < end; k += step) {
        reg u32 idx = ldg32_stream(ptr_add(sequence_row_indices, k, 4));
        stg32(ptr_add(row_lane, idx, 4), lane);
        stg32(ptr_add(row_ordinal, idx, 4), k - begin);
    }
}

kernel[BLOCK, 48] stage_row_dot_pdl_bf16x8(
    global u32* rows_bf16, global u32* weight_bf16, global u32* output_bf16, u32 width
) {
    shared f32 reduce[8];
    pdl_wait();
    pdl_release();
    reg u32 row = ctaid_x();
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    ureg u64 row_ptr = ptr_add(rows_bf16, row, width << 1);
    reg f32 sum = 0.0f;
    reg u32 align_bad = (width & 7) | (row_ptr[0] & 15) | (weight_bf16[0] & 15);
    if (align_bad == 0) {
        reg u32 chunks = width >> 3;
        for (reg u32 c = tid; c < chunks; c += BLOCK) {
            reg u32x4 av = ldg128_stream(ptr_add(row_ptr, c, 16));
            reg u32x4 bv = ldg128_persist(ptr_add(weight_bf16, c, 16));
            unroll (k = 0..4) {
                sum = fma(bf16_lo(av[k]), bf16_lo(bv[k]), sum);
                sum = fma(bf16_hi(av[k]), bf16_hi(bv[k]), sum);
            }
        }
    } else {
        for (reg u32 idx = tid; idx < width; idx += BLOCK) {
            reg f32 a = bf16_lo(ldg16_stream(ptr_add(row_ptr, idx, 2)));
            reg f32 b = bf16_lo(ldg16_persist(ptr_add(weight_bf16, idx, 2)));
            sum = fma(a, b, sum);
        }
    }
    sum = sum + shfl_down(sum, 16);
    sum = sum + shfl_down(sum, 8);
    sum = sum + shfl_down(sum, 4);
    sum = sum + shfl_down(sum, 2);
    sum = sum + shfl_down(sum, 1);
    if (lane == 0) {
        sts32(reduce, wid, sum);
    }
    barrier();
    reg f32 total = 0.0f;
    if (lane < 8) {
        total = lds32(reduce, lane);
    }
    total = total + shfl_down(total, 4);
    total = total + shfl_down(total, 2);
    total = total + shfl_down(total, 1);
    total = shfl_idx(total, 0);
    if (tid == 0) {
        stg16(ptr_add(output_bf16, row, 2), f32_to_bf16(total));
    }
}

kernel[BLOCK, 32] stage_embedding_alias_pdl_bf16x8(
    global u32* embed_weight, global u32* token_ids, global u32* hidden_bf16,
    u32 hidden, u32 vocab_slice_offset, u32 vocab_slice_rows,
    u32 alias_first, u32 alias_count, u32 alias_row
) {
    pdl_wait();
    pdl_release();
    reg u32 row = ctaid_y();
    reg u32 raw_tok = ldg32_stream(ptr_add(token_ids, row, 4));
    reg u32 tok = raw_tok;
    if (raw_tok - alias_first < alias_count) {
        tok = alias_row;
    }
    reg u32 local = tok - vocab_slice_offset;
    reg u32 row_bytes = hidden << 1;
    ureg u64 target = ptr_add(hidden_bf16, row, row_bytes);
    reg u32 tid = ctaid_x() * BLOCK + tid_x();
    reg u32 stride = grid_x() * BLOCK;
    reg u32 align_bad = (hidden & 7) | (target[0] & 15);
    if (local < vocab_slice_rows) {
        ureg u64 source = ptr_add(embed_weight, local, row_bytes);
        reg u32 src_bad = align_bad | (source[0] & 15);
        if (src_bad == 0) {
            reg u32 vecs = hidden >> 3;
            for (reg u32 v = tid; v < vecs; v += stride) {
                reg u32x4 val = ldg128_persist(ptr_add(source, v, 16));
                stg128(ptr_add(target, v, 16), val);
            }
            return;
        }
        for (reg u32 k = tid; k < hidden; k += stride) {
            reg u32 val = ldg16_persist(ptr_add(source, k, 2));
            stg16(ptr_add(target, k, 2), val);
        }
        return;
    }
    if (align_bad == 0) {
        reg u32 vecs = hidden >> 3;
        reg u32x4 zero = pack_u32x4(0, 0, 0, 0);
        for (reg u32 v = tid; v < vecs; v += stride) {
            stg128(ptr_add(target, v, 16), zero);
        }
        return;
    }
    for (reg u32 k = tid; k < hidden; k += stride) {
        stg16(ptr_add(target, k, 2), 0);
    }
}

kernel[BLOCK, 32] head_certified_rescore_f32_bf16(
    global u32* hidden_bf16, global u32* head_weight_bf16,
    global u32* candidate_ids, global u32* candidate_count,
    global u32* partial_scores, global u32* partial_candidates,
    u32 hidden_dimension
) {
    shared f32 best_score[8];
    shared u32 best_cand[8];
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 bx = ctaid_x();
    reg u32 count = ldg32_persist(candidate_count);
    reg u32 pairs = hidden_dimension >> 1;
    for (reg u32 e = tid; e < pairs; e += BLOCK) {
        reg u32 raw = ldg32_persist(ptr_add(hidden_bf16, e, 4));
        dyn_sts32(e << 1, bf16_lo(raw));
        dyn_sts32((e << 1) + 1, bf16_hi(raw));
    }
    barrier();
    reg f32 running_best = -3.0e38f;
    reg u32 running_cand = 0xFFFFFFFF;
    reg u32 row_bytes = hidden_dimension << 1;
    reg u32 pairs4 = pairs & 0xFFFFFF80;
    for (reg u32 slot = bx * 8 + wid; slot < count; slot += 1024) {
        reg u32 cand = ldg32_stream(ptr_add(candidate_ids, slot, 4));
        reg u64 w_ptr = ptr_add(ptr_add(head_weight_bf16, cand, row_bytes), lane, 4);
        reg f32 acc = 0.0f;
        for (reg u32 p = lane; p < pairs4; p += 128) {
            reg u32 r0 = ldg32_persist(w_ptr);
            reg u32 r1 = ldg32_persist(ptr_add(w_ptr, 32, 4));
            reg u32 r2 = ldg32_persist(ptr_add(w_ptr, 64, 4));
            reg u32 r3 = ldg32_persist(ptr_add(w_ptr, 96, 4));
            reg u32 i0 = p << 1;
            acc = fma(dyn_lds32_f32(i0), bf16_lo(r0), acc);
            acc = fma(dyn_lds32_f32(i0 + 1), bf16_hi(r0), acc);
            reg u32 i1 = i0 + 64;
            acc = fma(dyn_lds32_f32(i1), bf16_lo(r1), acc);
            acc = fma(dyn_lds32_f32(i1 + 1), bf16_hi(r1), acc);
            reg u32 i2 = i0 + 128;
            acc = fma(dyn_lds32_f32(i2), bf16_lo(r2), acc);
            acc = fma(dyn_lds32_f32(i2 + 1), bf16_hi(r2), acc);
            reg u32 i3 = i0 + 192;
            acc = fma(dyn_lds32_f32(i3), bf16_lo(r3), acc);
            acc = fma(dyn_lds32_f32(i3 + 1), bf16_hi(r3), acc);
            w_ptr = ptr_add(w_ptr, 128, 4);
        }
        for (reg u32 p = pairs4 + lane; p < pairs; p += 32) {
            reg u32 raw = ldg32_persist(w_ptr);
            acc = fma(dyn_lds32_f32(p << 1), bf16_lo(raw), acc);
            acc = fma(dyn_lds32_f32((p << 1) + 1), bf16_hi(raw), acc);
            w_ptr = ptr_add(w_ptr, 32, 4);
        }
        for (reg u32 el = (pairs << 1) + lane; el < hidden_dimension; el += 32) {
            ureg u64 w_row = ptr_add(head_weight_bf16, cand, row_bytes);
            acc = fma(dyn_lds32_f32(el), bf16_lo(ldg16_persist(ptr_add(w_row, el, 2))), acc);
        }
        acc = acc + shfl_down(acc, 16);
        acc = acc + shfl_down(acc, 8);
        acc = acc + shfl_down(acc, 4);
        acc = acc + shfl_down(acc, 2);
        acc = acc + shfl_down(acc, 1);
        reg f32 score = shfl_idx(acc, 0);
        if (lane == 0) {
            if (score > running_best) {
                running_best = score;
                running_cand = cand;
            } else {
                if (score == running_best) {
                    if (cand < running_cand) {
                        running_best = score;
                        running_cand = cand;
                    }
                }
            }
        }
    }
    reg f32 os16 = shfl_down(running_best, 16);
    reg u32 oc16 = shfl_down(running_cand, 16);
    if (os16 > running_best) {
        running_best = os16;
        running_cand = oc16;
    } else {
        if (os16 == running_best) {
            if (oc16 < running_cand) {
                running_best = os16;
                running_cand = oc16;
            }
        }
    }
    reg f32 os8 = shfl_down(running_best, 8);
    reg u32 oc8 = shfl_down(running_cand, 8);
    if (os8 > running_best) {
        running_best = os8;
        running_cand = oc8;
    } else {
        if (os8 == running_best) {
            if (oc8 < running_cand) {
                running_best = os8;
                running_cand = oc8;
            }
        }
    }
    reg f32 os4 = shfl_down(running_best, 4);
    reg u32 oc4 = shfl_down(running_cand, 4);
    if (os4 > running_best) {
        running_best = os4;
        running_cand = oc4;
    } else {
        if (os4 == running_best) {
            if (oc4 < running_cand) {
                running_best = os4;
                running_cand = oc4;
            }
        }
    }
    reg f32 os2 = shfl_down(running_best, 2);
    reg u32 oc2 = shfl_down(running_cand, 2);
    if (os2 > running_best) {
        running_best = os2;
        running_cand = oc2;
    } else {
        if (os2 == running_best) {
            if (oc2 < running_cand) {
                running_best = os2;
                running_cand = oc2;
            }
        }
    }
    reg f32 os1 = shfl_down(running_best, 1);
    reg u32 oc1 = shfl_down(running_cand, 1);
    if (os1 > running_best) {
        running_best = os1;
        running_cand = oc1;
    } else {
        if (os1 == running_best) {
            if (oc1 < running_cand) {
                running_best = os1;
                running_cand = oc1;
            }
        }
    }
    if (lane == 0) {
        sts32(best_score, wid, running_best);
        sts32(best_cand, wid, running_cand);
    }
    barrier();
    if (tid == 0) {
        reg f32 fb = lds32(best_score, 0);
        reg u32 fc = lds32(best_cand, 0);
        unroll (w = 1..8) {
            reg f32 ws = lds32(best_score, w);
            reg u32 wc = lds32(best_cand, w);
            if (ws > fb) {
                fb = ws;
                fc = wc;
            } else {
                if (ws == fb) {
                    if (wc < fc) {
                        fb = ws;
                        fc = wc;
                    }
                }
            }
        }
        stg32(ptr_add(partial_scores, bx, 4), f32_as_u32(fb));
        stg32(ptr_add(partial_candidates, bx, 4), fc);
    }
}

kernel[1024, 64] head_certified_fp8_score_1024(
    global u32* hidden_bf16, global u32* shadow_payload,
    global u32* shadow_scale_f32, global u32* cert_norm_f32,
    global u32* hidden_norm_f32, global u32* coarse_scores,
    global u32* bounds, u32 candidate_count, u32 hidden_dimension
) {
    reg u32 neuron = (ctaid_x() << 5) + warp_id();
    reg u32 lane = lane_id();
    if (neuron >= candidate_count) { return; }
    reg u32 tiles = hidden_dimension >> 9;
    reg u32 groups_bytes = (hidden_dimension >> 5) << 2;
    reg u32 half_lane = lane >> 1;
    reg u64 scale_ptr = ptr_add(ptr_add(shadow_scale_f32, neuron, groups_bytes), half_lane, 4);
    reg u64 cert_ptr = ptr_add(ptr_add(cert_norm_f32, neuron, groups_bytes), half_lane, 4);
    reg u64 hnorm_ptr = ptr_add(hidden_norm_f32, half_lane, 4);
    reg u64 shadow_ptr = ptr_add(ptr_add(shadow_payload, neuron, hidden_dimension), lane, 16);
    reg u64 hidden_ptr = ptr_add(hidden_bf16, lane, 32);
    reg f32 acc = 0.0f;
    reg f32 bound = 0.0f;
    reg u32 lane_even = lane & 30;
    reg u32 is_even = lane & 1;
    for (reg u32 tile = 0; tile < tiles; tile += 1) {
        reg f32 scale = 0.0f;
        if (is_even == 0) {
            scale = u32_as_f32(ldg32_persist(scale_ptr));
            reg f32 hn = u32_as_f32(ldg32_persist(hnorm_ptr));
            reg f32 cn = u32_as_f32(ldg32_persist(cert_ptr));
            bound = fma(hn, cn, bound);
        }
        scale = shfl_idx(scale, lane_even);
        reg u32x4 sv = ldg128_persist(shadow_ptr);
        reg u32x8 hv = ldg256_persist(hidden_ptr);
        unroll (w = 0..4) {
            reg f32x4 ev = cvt_e4m3x4_f32x4(sv[w]);
            reg u32 h0 = hv[w * 2];
            reg u32 h1 = hv[w * 2 + 1];
            acc = fma(bf16_lo(h0), ev[0] * scale, acc);
            acc = fma(bf16_hi(h0), ev[1] * scale, acc);
            acc = fma(bf16_lo(h1), ev[2] * scale, acc);
            acc = fma(bf16_hi(h1), ev[3] * scale, acc);
        }
        scale_ptr = ptr_add(scale_ptr, 16, 4);
        cert_ptr = ptr_add(cert_ptr, 16, 4);
        hnorm_ptr = ptr_add(hnorm_ptr, 16, 4);
        shadow_ptr = ptr_add(shadow_ptr, 32, 16);
        hidden_ptr = ptr_add(hidden_ptr, 32, 32);
    }
    if ((hidden_dimension & 256) != 0) {
        reg u32 grp = (tiles << 4) + (lane >> 2);
        ureg u64 scale_row = ptr_add(shadow_scale_f32, neuron, groups_bytes);
        ureg u64 cert_row = ptr_add(cert_norm_f32, neuron, groups_bytes);
        ureg u64 shadow_row = ptr_add(shadow_payload, neuron, hidden_dimension);
        reg f32 scale = u32_as_f32(ldg32_persist(ptr_add(scale_row, grp, 4)));
        reg u32 half_idx = (tiles << 6) + lane;
        reg u32x2 sh = ldg64_persist(ptr_add(shadow_row, half_idx, 8));
        reg u32x4 hv = ldg128_persist(ptr_add(hidden_bf16, half_idx, 16));
        unroll (w = 0..2) {
            reg f32x4 ev = cvt_e4m3x4_f32x4(sh[w]);
            reg u32 h0 = hv[w * 2];
            reg u32 h1 = hv[w * 2 + 1];
            acc = fma(bf16_lo(h0), ev[0] * scale, acc);
            acc = fma(bf16_hi(h0), ev[1] * scale, acc);
            acc = fma(bf16_lo(h1), ev[2] * scale, acc);
            acc = fma(bf16_hi(h1), ev[3] * scale, acc);
        }
        if ((lane & 3) == 0) {
            reg f32 hn = u32_as_f32(ldg32_persist(ptr_add(hidden_norm_f32, grp, 4)));
            reg f32 cn = u32_as_f32(ldg32_persist(ptr_add(cert_row, grp, 4)));
            bound = fma(hn, cn, bound);
        }
    }
    acc = acc + shfl_down(acc, 16);
    acc = acc + shfl_down(acc, 8);
    acc = acc + shfl_down(acc, 4);
    acc = acc + shfl_down(acc, 2);
    acc = acc + shfl_down(acc, 1);
    bound = bound + shfl_down(bound, 16);
    bound = bound + shfl_down(bound, 8);
    bound = bound + shfl_down(bound, 4);
    bound = bound + shfl_down(bound, 2);
    bound = bound + shfl_down(bound, 1);
    if (lane == 0) {
        stg32(ptr_add(coarse_scores, neuron, 4), f32_as_u32(acc));
        reg u32 ops = tiles + ((hidden_dimension >> 8) & 1) + 5;
        reg f32 u = u32_to_f32(ops) * 5.9604644775390625e-08f;
        reg f32 d = 1.0f - u;
        reg f32 rd = rcp(d);
        rd = fma(rd, fma(-d, rd, 1.0f), rd);
        reg f32 g = u * rd;
        g = fma(rd, fma(-d, g, u), g);
        bound = bound * (1.0f + g);
        reg u32 bb = f32_as_u32(bound);
        reg u32 nb = bb;
        if (bb == 0x80000000) {
            nb = 1;
        } else {
            if ((bb & 0x7FFFFFFF) < 0x7F800000) {
                nb = bb + 1;
            }
        }
        stg32(ptr_add(bounds, neuron, 4), nb);
    }
}

kernel[BLOCK, 64] head_candidate_256_1024_pdl_bf16(
    global u32* normed_bf16, global u32* head_weight_bf16, global u32* token_ids,
    global u32* candidate_score, global u32* candidate_token,
    u32 rows, u32 hidden, u32 vocabulary
) {
    shared u32 stage[8448];
    shared f32 input_s[128];
    shared f32 shared_score[8];
    shared u32 shared_token[8];
    pdl_wait();
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg u32 tile = ctaid_x();
    reg u32 row = ctaid_y();
    reg u32 gx = grid_x();
    reg u32 has_tok = token_ids[0] | token_ids[1];
    reg f32 best = u32_as_f32(0xFF800000);
    reg u32 best_tok = 0;
    reg u32 row_bytes = hidden << 1;
    ureg u64 act_row = ptr_add(normed_bf16, row, row_bytes);
    reg u32 fast_bad = (hidden & 63) | (head_weight_bf16[0] & 15);
    if (fast_bad == 0) {
        reg u32 chunks = hidden >> 6;
        for (reg u32 sub = 0; sub < 1024; sub += 128) {
            reg u32 base_index = (tile << 10) + sub;
            if (base_index < vocabulary) {
                reg u32 index = base_index + tid;
                reg f32 total = 0.0f;
                reg u32x4 st0 = pack_u32x4(0, 0, 0, 0);
                reg u32x4 st1 = pack_u32x4(0, 0, 0, 0);
                reg u32x4 st2 = pack_u32x4(0, 0, 0, 0);
                reg u32x4 st3 = pack_u32x4(0, 0, 0, 0);
                reg u32 sl0 = tid;
                reg u32 i0 = base_index + (sl0 >> 3);
                if (i0 < vocabulary) {
                    reg u32 t0 = i0;
                    if (has_tok != 0) { t0 = ldg32_persist(ptr_add(token_ids, i0, 4)); }
                    st0 = ldg128_stream(ptr_add(ptr_add(head_weight_bf16, t0, row_bytes), sl0 & 7, 16));
                }
                reg u32 sl1 = tid + 256;
                reg u32 i1 = base_index + (sl1 >> 3);
                if (i1 < vocabulary) {
                    reg u32 t1 = i1;
                    if (has_tok != 0) { t1 = ldg32_persist(ptr_add(token_ids, i1, 4)); }
                    st1 = ldg128_stream(ptr_add(ptr_add(head_weight_bf16, t1, row_bytes), sl1 & 7, 16));
                }
                reg u32 sl2 = tid + 512;
                reg u32 i2 = base_index + (sl2 >> 3);
                if (i2 < vocabulary) {
                    reg u32 t2 = i2;
                    if (has_tok != 0) { t2 = ldg32_persist(ptr_add(token_ids, i2, 4)); }
                    st2 = ldg128_stream(ptr_add(ptr_add(head_weight_bf16, t2, row_bytes), sl2 & 7, 16));
                }
                reg u32 sl3 = tid + 768;
                reg u32 i3 = base_index + (sl3 >> 3);
                if (i3 < vocabulary) {
                    reg u32 t3 = i3;
                    if (has_tok != 0) { t3 = ldg32_persist(ptr_add(token_ids, i3, 4)); }
                    st3 = ldg128_stream(ptr_add(ptr_add(head_weight_bf16, t3, row_bytes), sl3 & 7, 16));
                }
                reg u32 w0 = (sl0 >> 3) * 33 + ((sl0 & 7) << 2);
                sts32(stage, w0, st0[0]);
                sts32(stage, w0 + 1, st0[1]);
                sts32(stage, w0 + 2, st0[2]);
                sts32(stage, w0 + 3, st0[3]);
                reg u32 w1 = (sl1 >> 3) * 33 + ((sl1 & 7) << 2);
                sts32(stage, w1, st1[0]);
                sts32(stage, w1 + 1, st1[1]);
                sts32(stage, w1 + 2, st1[2]);
                sts32(stage, w1 + 3, st1[3]);
                reg u32 w2 = (sl2 >> 3) * 33 + ((sl2 & 7) << 2);
                sts32(stage, w2, st2[0]);
                sts32(stage, w2 + 1, st2[1]);
                sts32(stage, w2 + 2, st2[2]);
                sts32(stage, w2 + 3, st2[3]);
                reg u32 w3 = (sl3 >> 3) * 33 + ((sl3 & 7) << 2);
                sts32(stage, w3, st3[0]);
                sts32(stage, w3 + 1, st3[1]);
                sts32(stage, w3 + 2, st3[2]);
                sts32(stage, w3 + 3, st3[3]);
                if (tid < 64) {
                    sts32(input_s, tid, bf16_lo(ldg16_persist(ptr_add(act_row, tid, 2))));
                }
                barrier();
                for (reg u32 chunk = 0; chunk < chunks; chunk += 1) {
                    reg u32 buf = chunk & 1;
                    reg u32 nbuf = buf ^ 1;
                    if (chunk + 1 < chunks) {
                        reg u32 nfirst = (chunk + 1) << 6;
                        st0 = pack_u32x4(0, 0, 0, 0);
                        st1 = pack_u32x4(0, 0, 0, 0);
                        st2 = pack_u32x4(0, 0, 0, 0);
                        st3 = pack_u32x4(0, 0, 0, 0);
                        if (i0 < vocabulary) {
                            reg u32 t0 = i0;
                            if (has_tok != 0) { t0 = ldg32_persist(ptr_add(token_ids, i0, 4)); }
                            st0 = ldg128_stream(ptr_add(ptr_add(head_weight_bf16, t0, row_bytes), (nfirst >> 3) + (sl0 & 7), 16));
                        }
                        if (i1 < vocabulary) {
                            reg u32 t1 = i1;
                            if (has_tok != 0) { t1 = ldg32_persist(ptr_add(token_ids, i1, 4)); }
                            st1 = ldg128_stream(ptr_add(ptr_add(head_weight_bf16, t1, row_bytes), (nfirst >> 3) + (sl1 & 7), 16));
                        }
                        if (i2 < vocabulary) {
                            reg u32 t2 = i2;
                            if (has_tok != 0) { t2 = ldg32_persist(ptr_add(token_ids, i2, 4)); }
                            st2 = ldg128_stream(ptr_add(ptr_add(head_weight_bf16, t2, row_bytes), (nfirst >> 3) + (sl2 & 7), 16));
                        }
                        if (i3 < vocabulary) {
                            reg u32 t3 = i3;
                            if (has_tok != 0) { t3 = ldg32_persist(ptr_add(token_ids, i3, 4)); }
                            st3 = ldg128_stream(ptr_add(ptr_add(head_weight_bf16, t3, row_bytes), (nfirst >> 3) + (sl3 & 7), 16));
                        }
                    }
                    if (tid < 128) {
                        reg u32 sbase = buf * 4224 + tid * 33;
                        reg u32 ibase = buf << 6;
                        for (reg u32 el = 0; el < 32; el += 1) {
                            reg u32 word = lds32(stage, sbase + el);
                            total = fma(lds32(input_s, ibase + (el << 1)), bf16_lo(word), total);
                            total = fma(lds32(input_s, ibase + (el << 1) + 1), bf16_hi(word), total);
                        }
                    }
                    if (chunk + 1 < chunks) {
                        reg u32 nsbase = nbuf * 4224;
                        sts32(stage, nsbase + w0, st0[0]);
                        sts32(stage, nsbase + w0 + 1, st0[1]);
                        sts32(stage, nsbase + w0 + 2, st0[2]);
                        sts32(stage, nsbase + w0 + 3, st0[3]);
                        sts32(stage, nsbase + w1, st1[0]);
                        sts32(stage, nsbase + w1 + 1, st1[1]);
                        sts32(stage, nsbase + w1 + 2, st1[2]);
                        sts32(stage, nsbase + w1 + 3, st1[3]);
                        sts32(stage, nsbase + w2, st2[0]);
                        sts32(stage, nsbase + w2 + 1, st2[1]);
                        sts32(stage, nsbase + w2 + 2, st2[2]);
                        sts32(stage, nsbase + w2 + 3, st2[3]);
                        sts32(stage, nsbase + w3, st3[0]);
                        sts32(stage, nsbase + w3 + 1, st3[1]);
                        sts32(stage, nsbase + w3 + 2, st3[2]);
                        sts32(stage, nsbase + w3 + 3, st3[3]);
                        if (tid < 64) {
                            sts32(input_s, (nbuf << 6) + tid, bf16_lo(ldg16_persist(ptr_add(act_row, ((chunk + 1) << 6) + tid, 2))));
                        }
                    }
                    barrier();
                }
                if (tid < 128) {
                    if (index < vocabulary) {
                        if (total > best) {
                            best = total;
                            best_tok = index;
                            if (has_tok != 0) {
                                best_tok = ldg32_persist(ptr_add(token_ids, index, 4));
                            }
                        }
                    }
                }
            }
        }
    } else {
        reg u32 tend = (tile + 1) << 10;
        if (tend > vocabulary) {
            tend = vocabulary;
        }
        for (reg u32 idx = (tile << 10) + tid; idx < tend; idx += BLOCK) {
            reg u32 tok = idx;
            if (has_tok != 0) {
                tok = ldg32_persist(ptr_add(token_ids, idx, 4));
            }
            ureg u64 w_row = ptr_add(head_weight_bf16, tok, row_bytes);
            reg f32 total = 0.0f;
            for (reg u32 el = 0; el < hidden; el += 1) {
                total = fma(bf16_lo(ldg16_persist(ptr_add(act_row, el, 2))), bf16_lo(ldg16_stream(ptr_add(w_row, el, 2))), total);
            }
            if (total > best) {
                best = total;
                best_tok = tok;
            }
        }
    }
    reg f32 os16 = shfl_down(best, 16);
    reg u32 ot16 = shfl_down(best_tok, 16);
    if (os16 > best) { best = os16; best_tok = ot16; }
    reg f32 os8 = shfl_down(best, 8);
    reg u32 ot8 = shfl_down(best_tok, 8);
    if (os8 > best) { best = os8; best_tok = ot8; }
    reg f32 os4 = shfl_down(best, 4);
    reg u32 ot4 = shfl_down(best_tok, 4);
    if (os4 > best) { best = os4; best_tok = ot4; }
    reg f32 os2 = shfl_down(best, 2);
    reg u32 ot2 = shfl_down(best_tok, 2);
    if (os2 > best) { best = os2; best_tok = ot2; }
    reg f32 os1 = shfl_down(best, 1);
    reg u32 ot1 = shfl_down(best_tok, 1);
    if (os1 > best) { best = os1; best_tok = ot1; }
    if (lane == 0) {
        sts32(shared_score, wid, best);
        sts32(shared_token, wid, best_tok);
    }
    barrier();
    if (wid == 0) {
        reg f32 fb = u32_as_f32(0xFF800000);
        reg u32 ft = 0xFFFFFFFF;
        if (lane < 8) {
            fb = lds32(shared_score, lane);
            ft = lds32(shared_token, lane);
        }
        reg f32 fs4 = shfl_down(fb, 4);
        reg u32 ft4 = shfl_down(ft, 4);
        if (fs4 > fb) { fb = fs4; ft = ft4; }
        reg f32 fs2 = shfl_down(fb, 2);
        reg u32 ft2 = shfl_down(ft, 2);
        if (fs2 > fb) { fb = fs2; ft = ft2; }
        reg f32 fs1 = shfl_down(fb, 1);
        reg u32 ft1 = shfl_down(ft, 1);
        if (fs1 > fb) { fb = fs1; ft = ft1; }
        if (lane == 0) {
            reg u32 out_idx = row * gx + tile;
            stg32(ptr_add(candidate_score, out_idx, 4), f32_as_u32(fb));
            stg32(ptr_add(candidate_token, out_idx, 4), ft);
        }
    }
    pdl_release();
}

kernel[BLOCK, 32] stage_embedding_whole_pdl_bf16x8(
    global u32* table, global u32* token_ids, global u32* hidden_bf16,
    u32 hidden, u32 vocab, u32 alias_first, u32 alias_count, u32 alias_row
) {
    pdl_wait();
    pdl_release();
    reg u32 row = ctaid_y();
    reg u32 raw_tok = ldg32_stream(ptr_add(token_ids, row, 4));
    reg u32 tok = raw_tok;
    if (raw_tok - alias_first < alias_count) {
        tok = alias_row;
    }
    reg u32 row_bytes = hidden << 1;
    ureg u64 target = ptr_add(hidden_bf16, row, row_bytes);
    reg u32 tid = ctaid_x() * BLOCK + tid_x();
    reg u32 stride = grid_x() * BLOCK;
    reg u32 align_bad = (hidden & 7) | (target[0] & 15);
    if (tok < vocab) {
        ureg u64 source = ptr_add(table, tok, row_bytes);
        reg u32 src_bad = align_bad | (source[0] & 15);
        if (src_bad == 0) {
            reg u32 vecs = hidden >> 3;
            for (reg u32 v = tid; v < vecs; v += stride) {
                reg u32x4 val = ldg128_persist(ptr_add(source, v, 16));
                unroll (k = 0..4) {
                    reg u32 p = val[k];
                    reg u32 lo = p & 0xFFFF;
                    reg u32 hi = p & 0xFFFF0000;
                    if (lo == 0x8000) { lo = 0; }
                    if (hi == 0x80000000) { hi = 0; }
                    val[k] = lo | hi;
                }
                stg128(ptr_add(target, v, 16), val);
            }
            return;
        }
        for (reg u32 k = tid; k < hidden; k += stride) {
            reg u32 val = ldg16_persist(ptr_add(source, k, 2));
            if (val == 0x8000) { val = 0; }
            stg16(ptr_add(target, k, 2), val);
        }
        return;
    }
    if (align_bad == 0) {
        reg u32 vecs = hidden >> 3;
        reg u32x4 zero = pack_u32x4(0, 0, 0, 0);
        for (reg u32 v = tid; v < vecs; v += stride) {
            stg128(ptr_add(target, v, 16), zero);
        }
        return;
    }
    for (reg u32 k = tid; k < hidden; k += stride) {
        stg16(ptr_add(target, k, 2), 0);
    }
}

kernel[BLOCK, 48] head_softmax_pdl_f32(
    global u32* logits, u32 rows, u32 vocabulary, f32 temperature
) {
    shared f32 reduction[8];
    pdl_wait();
    reg u32 row = ctaid_x();
    if (row >= rows) {
        pdl_release();
        return;
    }
    reg u32 tid = tid_x();
    reg u32 wid = warp_id();
    reg u32 lane = lane_id();
    reg f32 clamped_t = maxf(temperature, 1.0e-4f);
    reg f32 rt = rcp(clamped_t);
    rt = fma(rt, fma(-clamped_t, rt, 1.0f), rt);
    rt = fma(rt, fma(-clamped_t, rt, 1.0f), rt);
    ureg u64 row_ptr = ptr_add(logits, row, vocabulary << 2);
    reg f32 local = u32_as_f32(0xFF800000);
    reg u32 align_bad = (vocabulary & 3) | (row_ptr[0] & 15);
    if (align_bad == 0) {
        reg u32 vecs = vocabulary >> 2;
        for (reg u32 idx = tid; idx < vecs; idx += BLOCK) {
            reg u32x4 v = ldg128_stream(ptr_add(row_ptr, idx, 16));
            local = maxf(local, u32_as_f32(v[0]) * rt);
            local = maxf(local, u32_as_f32(v[1]) * rt);
            local = maxf(local, u32_as_f32(v[2]) * rt);
            local = maxf(local, u32_as_f32(v[3]) * rt);
        }
        local = maxf(local, shfl_down(local, 16));
        local = maxf(local, shfl_down(local, 8));
        local = maxf(local, shfl_down(local, 4));
        local = maxf(local, shfl_down(local, 2));
        local = maxf(local, shfl_down(local, 1));
        if (lane == 0) { sts32(reduction, wid, local); }
        barrier();
        reg f32 mx = u32_as_f32(0xFF800000);
        if (lane < 8) { mx = lds32(reduction, lane); }
        mx = maxf(mx, shfl_down(mx, 4));
        mx = maxf(mx, shfl_down(mx, 2));
        mx = maxf(mx, shfl_down(mx, 1));
        mx = shfl_idx(mx, 0);
        barrier();
        reg f32 total = 0.0f;
        reg u32 idx4 = tid;
        for (reg u32 step = 0; idx4 + 768 < vocabulary; step += 1) {
            reg f32 v0 = u32_as_f32(ldg32_stream(ptr_add(row_ptr, idx4, 4)));
            reg f32 v1 = u32_as_f32(ldg32_stream(ptr_add(row_ptr, idx4 + 256, 4)));
            reg f32 v2 = u32_as_f32(ldg32_stream(ptr_add(row_ptr, idx4 + 512, 4)));
            reg f32 v3 = u32_as_f32(ldg32_stream(ptr_add(row_ptr, idx4 + 768, 4)));
            reg f32 e0 = exp2_ftz((v0 * rt - mx) * 1.4426950408889634f);
            reg f32 e1 = exp2_ftz((v1 * rt - mx) * 1.4426950408889634f);
            reg f32 e2 = exp2_ftz((v2 * rt - mx) * 1.4426950408889634f);
            reg f32 e3 = exp2_ftz((v3 * rt - mx) * 1.4426950408889634f);
            stg32(ptr_add(row_ptr, idx4, 4), f32_as_u32(e0));
            stg32(ptr_add(row_ptr, idx4 + 256, 4), f32_as_u32(e1));
            stg32(ptr_add(row_ptr, idx4 + 512, 4), f32_as_u32(e2));
            stg32(ptr_add(row_ptr, idx4 + 768, 4), f32_as_u32(e3));
            total = total + e0;
            total = total + e1;
            total = total + e2;
            total = total + e3;
            idx4 = idx4 + 1024;
        }
        for (reg u32 idx = idx4; idx < vocabulary; idx += BLOCK) {
            reg f32 v = u32_as_f32(ldg32_stream(ptr_add(row_ptr, idx, 4)));
            reg f32 e = exp2_ftz((v * rt - mx) * 1.4426950408889634f);
            stg32(ptr_add(row_ptr, idx, 4), f32_as_u32(e));
            total = total + e;
        }
        total = total + shfl_down(total, 16);
        total = total + shfl_down(total, 8);
        total = total + shfl_down(total, 4);
        total = total + shfl_down(total, 2);
        total = total + shfl_down(total, 1);
        if (lane == 0) { sts32(reduction, wid, total); }
        barrier();
        reg f32 sm = 0.0f;
        if (lane < 8) { sm = lds32(reduction, lane); }
        sm = sm + shfl_down(sm, 4);
        sm = sm + shfl_down(sm, 2);
        sm = sm + shfl_down(sm, 1);
        sm = shfl_idx(sm, 0);
        barrier();
        reg f32 denom = maxf(sm, 1.0e-20f);
        reg f32 inv_d = rcp(denom);
        inv_d = fma(inv_d, fma(-denom, inv_d, 1.0f), inv_d);
        for (reg u32 idx = tid; idx < vecs; idx += BLOCK) {
            reg u32x4 v = ldg128_stream(ptr_add(row_ptr, idx, 16));
            reg f32 x0 = u32_as_f32(v[0]);
            reg f32 q0 = x0 * inv_d;
            q0 = fma(inv_d, fma(-denom, q0, x0), q0);
            reg f32 x1 = u32_as_f32(v[1]);
            reg f32 q1 = x1 * inv_d;
            q1 = fma(inv_d, fma(-denom, q1, x1), q1);
            reg f32 x2 = u32_as_f32(v[2]);
            reg f32 q2 = x2 * inv_d;
            q2 = fma(inv_d, fma(-denom, q2, x2), q2);
            reg f32 x3 = u32_as_f32(v[3]);
            reg f32 q3 = x3 * inv_d;
            q3 = fma(inv_d, fma(-denom, q3, x3), q3);
            stg128(ptr_add(row_ptr, idx, 16), pack_u32x4(f32_as_u32(q0), f32_as_u32(q1), f32_as_u32(q2), f32_as_u32(q3)));
        }
        pdl_release();
        return;
    }
    for (reg u32 idx = tid; idx < vocabulary; idx += BLOCK) {
        local = maxf(local, u32_as_f32(ldg32_stream(ptr_add(row_ptr, idx, 4))) * rt);
    }
    local = maxf(local, shfl_down(local, 16));
    local = maxf(local, shfl_down(local, 8));
    local = maxf(local, shfl_down(local, 4));
    local = maxf(local, shfl_down(local, 2));
    local = maxf(local, shfl_down(local, 1));
    if (lane == 0) { sts32(reduction, wid, local); }
    barrier();
    reg f32 mx = u32_as_f32(0xFF800000);
    if (lane < 8) { mx = lds32(reduction, lane); }
    mx = maxf(mx, shfl_down(mx, 4));
    mx = maxf(mx, shfl_down(mx, 2));
    mx = maxf(mx, shfl_down(mx, 1));
    mx = shfl_idx(mx, 0);
    barrier();
    reg f32 total = 0.0f;
    for (reg u32 idx = tid; idx < vocabulary; idx += BLOCK) {
        reg f32 v = u32_as_f32(ldg32_stream(ptr_add(row_ptr, idx, 4)));
        reg f32 e = exp2_ftz((v * rt - mx) * 1.4426950408889634f);
        stg32(ptr_add(row_ptr, idx, 4), f32_as_u32(e));
        total = total + e;
    }
    total = total + shfl_down(total, 16);
    total = total + shfl_down(total, 8);
    total = total + shfl_down(total, 4);
    total = total + shfl_down(total, 2);
    total = total + shfl_down(total, 1);
    if (lane == 0) { sts32(reduction, wid, total); }
    barrier();
    reg f32 sm = 0.0f;
    if (lane < 8) { sm = lds32(reduction, lane); }
    sm = sm + shfl_down(sm, 4);
    sm = sm + shfl_down(sm, 2);
    sm = sm + shfl_down(sm, 1);
    sm = shfl_idx(sm, 0);
    barrier();
    reg f32 denom = maxf(sm, 1.0e-20f);
    reg f32 inv_d = rcp(denom);
    inv_d = fma(inv_d, fma(-denom, inv_d, 1.0f), inv_d);
    for (reg u32 idx = tid; idx < vocabulary; idx += BLOCK) {
        reg f32 x = u32_as_f32(ldg32_stream(ptr_add(row_ptr, idx, 4)));
        reg f32 q = x * inv_d;
        q = fma(inv_d, fma(-denom, q, x), q);
        stg32(ptr_add(row_ptr, idx, 4), f32_as_u32(q));
    }
    pdl_release();
}
