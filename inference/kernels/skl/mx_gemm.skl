const BLOCK = 256;

kernel[BLOCK, 96] mx_quantize_e4m3_ue8m0(
    global u32* src_bf16, global u32* dst_fp8, global u8* dst_scales,
    u32 total_blocks
) {
    reg u32 tid = ctaid_x() * BLOCK + tid_x();
    reg u32 blk = tid >> 2;
    if (blk >= total_blocks) { return; }

    reg u32 sub = tid & 3;
    reg u32x4 v = ldg128_stream(ptr_add(src_bf16, tid, 16));

    reg f32 f0 = bf16_lo(v[0]);
    reg f32 f1 = bf16_hi(v[0]);
    reg f32 f2 = bf16_lo(v[1]);
    reg f32 f3 = bf16_hi(v[1]);
    reg f32 f4 = bf16_lo(v[2]);
    reg f32 f5 = bf16_hi(v[2]);
    reg f32 f6 = bf16_lo(v[3]);
    reg f32 f7 = bf16_hi(v[3]);

    reg f32 local_max = maxf(maxf(fabsf(f0), fabsf(f1)), maxf(fabsf(f2), fabsf(f3)));
    local_max = maxf(local_max, maxf(maxf(fabsf(f4), fabsf(f5)), maxf(fabsf(f6), fabsf(f7))));
    reg f32 amax = quad_max(local_max);

    reg u32 e8m0 = pow2_ceil_e8m0_bits(amax);
    reg f32 inv_scale = (e8m0 == 0) ? 0.0f : u32_as_f32((254 - e8m0) << 23);

    reg f32 s0 = f0 * inv_scale;
    reg f32 s1 = f1 * inv_scale;
    reg f32 s2 = f2 * inv_scale;
    reg f32 s3 = f3 * inv_scale;
    reg u32 p0 = cvt_f32x2_e4m3x2(s0, s1);
    reg u32 p1 = cvt_f32x2_e4m3x2(s2, s3);

    reg f32 s4 = f4 * inv_scale;
    reg f32 s5 = f5 * inv_scale;
    reg f32 s6 = f6 * inv_scale;
    reg f32 s7 = f7 * inv_scale;
    reg u32 p2 = cvt_f32x2_e4m3x2(s4, s5);
    reg u32 p3 = cvt_f32x2_e4m3x2(s6, s7);

    reg u32x2 out64;
    out64[0] = pack_u16x2(p0, p1);
    out64[1] = pack_u16x2(p2, p3);
    stg64(ptr_add(dst_fp8, tid, 8), out64);

    if (sub == 0) {
        stg8(ptr_add(dst_scales, blk, 1), e8m0);
    }
}
