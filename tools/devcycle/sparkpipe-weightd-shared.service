# The shared weightd unit deployed fleet-wide 2026-09-22 (PR baseline: shared-serving-20260922).
# One per physical Spark; installed at /etc/systemd/system/ by tools/devcycle/weightd_shared_deploy.sh.
# Budgets: device arena 28.5 GiB (28 GiB + 512 MiB overhead, the PR #1082 campaign's declared
# values), finite host MemoryMax, no swap, finite memlock. Private mesh-record directory.
[Unit]
Description=SparkPipe shared weightd (shared-serving-20260922, PR #1082 baseline)
After=network.target

[Service]
Type=simple
User=%i
RuntimeDirectory=sparkpipe-weightd-shared
RuntimeDirectoryMode=0755
WorkingDirectory=/home/%i/sparkpipe/shared-serving-20260922
ExecStartPre=/usr/bin/sha256sum --quiet --strict --check SHA256SUMS
ExecStart=/home/%i/sparkpipe/shared-serving-20260922/bin/sparkpipe_weightd --socket /run/sparkpipe-weightd-shared/weightd.sock --device-bytes-max 30064771072 --mesh-rank %k --mesh-rank-mask 0xffff --mesh-interface rocep1s0f1 --mesh-sgid-index 3 --mesh-dir /run/sparkpipe-weightd-shared/mesh
MemoryMax=12G
MemorySwapMax=0
LimitMEMLOCK=32G
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
