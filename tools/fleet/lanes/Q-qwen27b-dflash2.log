--- /Users/mac/sparkpipe/modules/qwen38_27b_resident_decode_stage/source/spark_qwen38_27b_dspark_format.h
+++ /Users/mac/sparkpipe/modules/qwen38_27b_resident_decode_stage/source/spark_qwen38_27b_dspark_format.h
