diff --git a/inference/kernels/formats/mxfp4.cuh b/inference/kernels/formats/mxfp4.cuh
index 596eaea..daf3132 100644
--- a/inference/kernels/formats/mxfp4.cuh
+++ b/inference/kernels/formats/mxfp4.cuh
@@ -28,11 +28,19 @@
 #define LM_MXFP4_GROUP 32u
 
 // E8M0 is a bare exponent with a bias of 127: the value is 2^(code - 127), and
-// 0xff is the NaN encoding. Decoding through exp2f rather than a table keeps it
-// a single instruction and avoids a load on the hot path.
+// 0xff is the NaN encoding. Decoded as the IEEE exponent field directly -
+// exponent bits are (e+127)<<23, so the value is code<<23 EXACTLY - one
+// instruction instead of the exp2f transcendental (the SparkLmDotRowFp8E8m0
+// receipt: standalone 228 -> 248 GB/s, commit 5b27165). Code 0 keeps the
+// exp2f result bit-for-bit through the same subnormal guard
+// SparkLmDecodeE8m0 carries (2^-127); the 0xff branch stays.
 static __device__ __forceinline__ float LmE8m0ToFloat(uint8_t code)
 {
-	return(code == 0xffu ? __int_as_float(0x7fffffff) : exp2f((float)code - 127.0f));
+	if (code == 0xffu)
+		return(__int_as_float(0x7fffffff));
+	if (code == 0u)
+		return(__uint_as_float(0x00400000u));
+	return(__uint_as_float((uint32_t)code << 23u));
 }
 
