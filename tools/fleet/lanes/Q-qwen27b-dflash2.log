	uint64_t base_position;
	uint64_t sequence_id;
	uint32_t block_count;
	uint32_t token_ids[TEST_QWEN36_DRIVER_CAPTURE_ROWS];
	uint32_t blocks[TEST_QWEN36_DRIVER_CAPTURE_ROWS];
}
