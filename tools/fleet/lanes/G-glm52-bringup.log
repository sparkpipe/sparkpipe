#!/usr/bin/env bash
# Publish GLM5.2 fp8 modules (GPU-validated): buckets + unflagged, then emit model_driver.so
set -x
cd "\$HOME/build/glm52_unified" || exit 9
export PATH=/usr/local/cuda-13.0/bin:\$PATH
export CUDA_HOME=/usr/local/cuda-13.0
REV=b4734de4facf877f85769a911abafc5283eab3d9
CONTRACT_SHA=ec5afd74d2ba0c913474f30d78209b4a49fa87667845f2968039fddad0fead7a
PACK=/home/sparke/srcdata/glm52_tp8_packs/glm52_tp8_rank06.fp8.glms52sp
{
  make build/sparkpipe_model_compile -j"\$(nproc)" && \
  make -C modules/glm52_resident_decode_stage publish_variants \
      EXPERT_CODEC=fp8 MODEL_REVISION="\$REV" CONTRACT_SHA256="\$CONTRACT_SHA" \
      CUDA_HOME=/usr/local/cuda-13.0 \
      MODULE_BATCH_VARIANT_BUCKETS="1 2 4 8 16" \
      STAGE_PACK_PATH="\$PACK" \
      MAX_ACTIVE_SEQUENCES=16 MAX_SEQUENCE_POSITIONS=4096 \
      EXECUTION_ROW_CAPACITY=16 PIPELINE_SLOT_COUNT=2 && \
  make -C modules/glm52_resident_decode_stage publish \
      EXPERT_CODEC=fp8 MODEL_REVISION="\$REV" CONTRACT_SHA256="\$CONTRACT_SHA" \
      CUDA_HOME=/usr/local/cuda-13.0 \
      STAGE_PACK_PATH="\$PACK" \
      MAX_ACTIVE_SEQUENCES=16 MAX_SEQUENCE_POSITIONS=4096 \
      EXECUTION_ROW_CAPACITY=16 PIPELINE_SLOT_COUNT=2 && \
  rm -rf "\$HOME/glm52_package" && \
  ./build/sparkpipe_model_compile \
      --model examples/model_descriptions/glm52_resident_decode_stage_fp8_firmware.json \
      --library build/module_library \
      --output "\$HOME/glm52_package" \
      --include include && \
  find "\$HOME/glm52_package" -name "model_driver.so" -exec ls -la {} \; && \
  echo PUBLISH_ALL_OK
} > "\$HOME/build/glm52_publish.log" 2>&1
exit \$?
