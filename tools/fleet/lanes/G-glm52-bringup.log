#!/usr/bin/env bash
set -x
cd "$HOME/build/glm52_unified" || exit 9
export PATH=/usr/local/cuda-13.0/bin:$PATH
export CUDA_HOME=/usr/local/cuda-13.0
{
  rm -rf "$HOME/glm52_package" &&   ./build/sparkpipe_model_compile \
      --model examples/model_descriptions/glm52_resident_decode_stage_fp8_firmware.json \
      --library build/module_library \
      --output "$HOME/glm52_package" \
      --include include \
      --cc-arg -L/usr/local/cuda-13.0/lib64 \
      --cc-arg -L/usr/lib/aarch64-linux-gnu \
      --cc-arg -lcuda \
      --cc-arg -lcudart \
      --cc-arg -lstdc++ \
      --cc-arg -lm \
      --cc-arg -ldl \
      --cc-arg -pthread \
      --cc-arg /home/sparke/build/glm52_unified/build/libsparkpipe_core.a \
      --cc-arg /home/sparke/build/glm52_unified/build/libsparkpipe_model_common.a && \
  find "$HOME/glm52_package" -name "model_driver.so" | head -3 &&   echo PUBLISH_ALL_OK
} > "$HOME/build/glm52_package_compile.log" 2>&1
exit $?===PKGDIR===
