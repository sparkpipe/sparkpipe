[Unit]
Description=Generate this node's SSH and initramfs SSH host keys
DefaultDependencies=no
After=local-fs.target
Before=ssh.service ssh-emergency.service
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/lib/sparkpipe/host-keys
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
