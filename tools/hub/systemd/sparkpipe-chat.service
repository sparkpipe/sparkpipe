[Unit]
Description=SparkPipe OpenAI chat layer over the engine API
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/sparkpipe-chat
ExecStart=/usr/bin/python3 chat_frontend.py --config config.json --host 0.0.0.0 --port 8433
StandardOutput=append:%h/sparkpipe-chat/chat.log
StandardError=append:%h/sparkpipe-chat/chat.log
Restart=always
RestartSec=2
MemoryMax=4G

[Install]
WantedBy=default.target
