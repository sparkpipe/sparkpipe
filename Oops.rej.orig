+
+/* Per-entry law for the DSpark drafter pack, mirroring the main loader:
+ * the compiled kind table pins the shape, byte accounting pins both declared
+ * extents against that shape, group-size zero matches the plain classes and
+ * both spans must sit inside the file. Duplicate bindings are refused by the
+ * seen-bits sweep and cross-entry aliasing by SweepDirectory in
+ * LoadDsparkPack. Drafter tensors ship BF16 only (the stagepack minter
+ * writes format 0 for every kind); the compressed formats belong to the main
+ * pack's RANS path and have no drafter consumer. Shapes are pinned BEFORE
+ * byte accounting, so the flat byte helpers are never reached with
+ * file-controlled dimensions. */
+static SparkStatus SparkQwen36ModuleValidateDsparkEntry(const SparkQwen36StagePackEntry *entry,uint64_t file_bytes)
+{
+	uint32_t rows,columns;
+	if ( entry->tensor_kind >= SPARK_QWEN36_DSPARK_TENSOR_KIND_COUNT || (entry->layer_index >= SPARK_QWEN36_DSPARK_LAYER_COUNT && entry->layer_index != 0xFFFFFFFFu) )
+		return(SPARK_STATUS_VALIDATION_FAILED);
+	if ( entry->weight_format != SPARK_QWEN36_RESIDENT_DECODE_STAGE_WEIGHT_FORMAT_BF16 || entry->scale_group_size != 0u )
+		return(SPARK_STATUS_VALIDATION_FAILED);
+	SparkQwen36DsparkKindShape(entry->tensor_kind,&rows,&columns);
+	if ( entry->rows != rows || entry->columns != columns )
+		return(SPARK_STATUS_VALIDATION_FAILED);
+	if ( entry->payload_bytes != SparkQwen36StagePackPayloadBytes(entry->weight_format,rows,columns) || entry->scale_bytes != SparkQwen36StagePackScaleBytes(entry->weight_format,rows,columns) )
+		return(SPARK_STATUS_VALIDATION_FAILED);
+	if ( entry->payload_offset > file_bytes || entry->payload_bytes > file_bytes - entry->payload_offset )
+		return(SPARK_STATUS_VALIDATION_FAILED);
+	if ( entry->scale_bytes != 0u && (entry->scale_offset > file_bytes || entry->scale_bytes > file_bytes - entry->scale_offset) )
+		return(SPARK_STATUS_VALIDATION_FAILED);
 	return(SPARK_STATUS_OK);
 }
 
