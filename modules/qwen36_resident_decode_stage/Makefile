	SPARK_QWEN36_STAGE_MTP=$(MTP_LAYER_COUNT) \
	SPARK_QWEN36_STAGE_GDN_SNAPSHOT_SLOTS=$(GDN_SNAPSHOT_SLOT_COUNT) \
	SPARK_QWEN36_STAGE_KV_STORE=$(KV_PROVIDER) \
